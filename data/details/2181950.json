  "hooks": [
    {
      "text": "从九名干员中组建三人队，可打破守卫、突击、专家的标准职业配比",
      "dimension": "玩法",
      "excerpt": "Assemble Your Crew Assemble your crew of 3 from 9 steadfast operators, split into 3 core archetypes: Guardian, Assault, and Specialist. Choose to field a classic party with one of each archetype, or mix things up with unconventional compositions. Any combination is viable, provided you have the skill to guide them through the trials of Zerzura City.",
      "url": "https://store.steampowered.com/app/2181950/",
      "label": "证据原文片段"
    },
    {
      "text": "每名干员牌组含至少八张签名牌与十二个自由槽，三套牌需跨角色协同",
      "dimension": "玩法",
      "excerpt": "Fight With CCG-Style Decks Each operator comes with their own deck containing at least 8 signature cards and at least 12 free slots. These resistance fighters are all armed to the teeth: each customisable deck must contain at least 20 cards; and any exposed weaknesses means certain death. To succeed, exploit the synergies between your decks and devise inspired new tactics to defeat your foes.",
      "url": "https://store.steampowered.com/app/2181950/",
      "label": "证据原文片段"
    },
    {
      "text": "用Mnemosynth把卡牌永久写入收藏，并通过Failsafe带到下一轮",
      "dimension": "玩法",
      "excerpt": "Meta-progression Earn Mnemosynth through your runs, and use these synthetic memories to permanently imprint cards into your collection through the Failsafe system. The added cards can be carried over to the next run, greatly enhancing your deck’s power.",
      "url": "https://store.steampowered.com/app/2181950/",
      "label": "证据原文片段"
    }
  ],
