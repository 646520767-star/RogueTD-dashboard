  "hooks": [
    {
      "text": "集齐昼夜遗物后召出王冠终局",
      "dimension": "玩法",
      "excerpt": "Somewhere out there — scattered across dangerous terrain, hidden in the dark — are relics. Find them all, and the Crown appears. Claim it, if you can survive what comes next.",
      "url": "https://store.steampowered.com/app/4632470/",
      "label": "证据原文片段"
    },
    {
      "text": "每一步消耗饥饿并用营火跨昼夜",
      "dimension": "玩法",
      "excerpt": "Hunger is your most dangerous enemy. Every step costs you. Rest at campfires to bridge the day/night cycle, scavenge for food, and choose your fights carefully — wolves, bandits, wraiths, bog hags, and worse are all hunting their own meal.",
      "url": "https://store.steampowered.com/app/4632470/",
      "label": "证据原文片段"
    },
    {
      "text": "遗物装备随机Build并跨局解锁修正",
      "dimension": "玩法",
      "excerpt": "Relics and equipment drop with unique bonuses. Each run, you shape a different build — then carry the best lessons forward through meta-progression modifiers unlocked across runs.",
      "url": "https://store.steampowered.com/app/4632470/",
      "label": "证据原文片段"
    }
  ],
