  "hooks": [
    {
      "text": "符文会改写每一种能力，可让剑刃连锁闪电、火球分裂并在施法时喷出冰柱",
      "dimension": "玩法",
      "excerpt": "Define your build and playstyle with runes that change how every ability works by integrating them into your attacks, spells, wards, and ultimates. Add chain lightning to your sword and burst enemies into poison clouds. Multiply your fireball spell and erupt ice pillars from the ground when you cast it.",
      "url": "https://store.steampowered.com/app/3219180/",
      "label": "证据原文片段"
    },
    {
      "text": "世界没有地图标记或引导，寻路本身也是Build的一部分，并能发现秘密通道与捷径",
      "dimension": "玩法",
      "excerpt": "The Unknown Lands are vast, full of secret passages, hidden relics, and strange sights. The world unravels more and more with each run as you make new discoveries and solve riddles to unlock power and shortcuts. No map-markers, no hand-holding. Pathfinding is a part of your build as well.",
      "url": "https://store.steampowered.com/app/3219180/",
      "label": "证据原文片段"
    },
    {
      "text": "永久神龛与锻炉会扩展力量和符文槽，还能跨局升级并定向选择适合构筑的祝福",
      "dimension": "玩法",
      "excerpt": "Discover permanent shrines and forges that expand your power and rune slots. Upgrade them for future runs and target the blessings best suited to your build as you grow in skill and knowledge.",
      "url": "https://store.steampowered.com/app/3219180/",
      "label": "证据原文片段"
    }
  ],
