  "hooks": [
    {
      "text": "无形的灵体可附身并控制任意友方植物或动物，以不同自然单位守护核心。",
      "dimension": "玩法",
      "excerpt": "The Wisp is invisible, but it can possess and control any friendly plant or animal it finds.",
      "url": "https://store.steampowered.com/app/1594210/",
      "label": "证据原文片段"
    },
    {
      "text": "每关在探索备战与塔防守卫两个阶段之间轮换，先收集生物和成长物再抵御入侵。",
      "dimension": "玩法",
      "excerpt": "Each level plays in a series of \"phases\", alternating between Preparation (Roguelike/Exploration oriented) and Defense (Tower Defense oriented). You start by exploring a level, defeating monsters, finding new creatures, collecting resources, and finding new Growths you can use to defend your Chrysalis. Then, the monsters invade, altering the level and sending waves of enemies to attack the Chrysalis.",
      "url": "https://store.steampowered.com/app/1594210/",
      "label": "证据原文片段"
    },
    {
      "text": "突变系统把不同物种组合成新生物，并继承独特能力和变形路线。",
      "dimension": "玩法",
      "excerpt": "Mutation: a complex mutation system combines different species to create new creatures with unique sets of abilities and metamorphoses. You'll still be finding new creatures with new abilities after dozens of playthroughs!",
      "url": "https://store.steampowered.com/app/1594210/",
      "label": "证据原文片段"
    }
  ],
