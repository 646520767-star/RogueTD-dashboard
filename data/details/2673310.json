  "hooks": [
    {
      "text": "从扭蛋机抽取可爱战士，让不同英雄改变每轮生存体验",
      "dimension": "玩法",
      "excerpt": "Who do you call when the city is attacked by monsters ? Right, the Gacha Fighters ! In this bullet heaven survivor, pull your character from your gacha machine, and destroy your enemies with cuteness ♡",
      "url": "https://store.steampowered.com/app/2673310/",
      "label": "证据原文片段"
    },
    {
      "text": "把钥匙扣当武器收集升级，并融合珍珠奶茶、麻薯等物品强化装备",
      "dimension": "玩法",
      "excerpt": "Keychains ? No ! They are weapons ! Collect and upgrade them to see what they do. Choose your weapons carefully, from the machine gun, to the magic wand and not the Buble-Canon Choose your items wisely to maximize your statistics. Collecter les Bubble Teas ! Mochis ! Fuse items to have more powerful ones !",
      "url": "https://store.steampowered.com/app/2673310/",
      "label": "证据原文片段"
    },
    {
      "text": "在每轮主动选择路线、环境和最终挑战的首领",
      "dimension": "玩法",
      "excerpt": "In this genre of vampire survivor, we want to give the player the possibility to choose their path, their environment as well as the boss to face.",
      "url": "https://store.steampowered.com/app/2673310/",
      "label": "证据原文片段"
    }
