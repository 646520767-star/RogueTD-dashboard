  "hooks": [
    {
      "text": "在网格上统筹资源与布局，让建筑之间形成防线协同",
      "dimension": "玩法",
      "excerpt": "Build defense facilities on the grid map to fend off endless waves of enemies. Strategically manage resources and layouts, create strong synergies between your buildings, and survive wave after wave of attacks.",
      "url": "https://store.steampowered.com/app/4645200/",
      "label": "证据原文片段"
    },
    {
      "text": "随机强化会改写攻击模式、触发效果与整套构筑方向",
      "dimension": "玩法",
      "excerpt": "After leveling up, you can purchase random augments. These power-ups don't just increase your stats; they alter attack patterns, trigger special effects, and shift your entire build strategy, ensuring every run has a unique progression path.",
      "url": "https://store.steampowered.com/app/4645200/",
      "label": "证据原文片段"
    },
    {
      "text": "战斗资源购买随机卡牌，每次取舍需适配强化与战场",
      "dimension": "玩法",
      "excerpt": "Use resources gained from battles to buy random cards, flexibly adapting your development direction based on your current augments and the battlefield situation. Every purchase is a trade-off, and these choices will ultimately determine how your build takes shape.",
      "url": "https://store.steampowered.com/app/4645200/",
      "label": "证据原文片段"
    }
  ],
