  "hooks": [
    {
      "text": "可射断僵尸腿部、击穿护甲并针对弱点换武器，肢体破坏直接参与控场",
      "dimension": "玩法",
      "excerpt": "Cripple enemies by blasting off a leg, punch through armor, exploit weak points, and adapt to different types of enemies with the right weapons and gear.",
      "url": "https://store.steampowered.com/app/3003120/",
      "label": "证据原文片段"
    },
    {
      "text": "死亡重置世界但保留技能点、武器零件和蓝图，用于永久解锁并逐轮深入",
      "dimension": "玩法",
      "excerpt": "Death resets the world, but not your progress. Earn skill points, weapon parts, and blueprints to unlock skills, grow stronger, and push deeper on every attempt.",
      "url": "https://store.steampowered.com/app/3003120/",
      "label": "证据原文片段"
    },
    {
      "text": "存活越久僵尸就越强、更聪明且种类更多，同时危险提升会同步提高奖励",
      "dimension": "玩法",
      "excerpt": "The longer you survive, the dead grow stronger, smarter, and more varied. Greater danger also means greater rewards.",
      "url": "https://store.steampowered.com/app/3003120/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
