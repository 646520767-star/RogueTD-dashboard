  "hooks": [
    {
      "text": "最多三人联机，把武器、能力与协作组合用于共斗Boss",
      "dimension": "玩法",
      "excerpt": "Team up with up to three players and fight through fast-paced sci-fi roguelite missions together. Combine weapons, abilities, and teamwork to survive intense battles and powerful bosses.",
      "url": "https://store.steampowered.com/app/3125690/",
      "label": "证据原文片段"
    },
    {
      "text": "变化任务中收集升级，每次运行重新塑造战斗流派",
      "dimension": "玩法",
      "excerpt": "Jump into ever-changing missions, collect powerful upgrades, and build a new combat style every run. Adapt your loadout, survive enemy waves, and push deeper toward the boss.",
      "url": "https://store.steampowered.com/app/3125690/",
      "label": "证据原文片段"
    },
    {
      "text": "冲刺、劈砍、射击与技能连用，靠时机和站位穿越怪潮",
      "dimension": "玩法",
      "excerpt": "Dash, strike, shoot, and unleash powerful skills in intense side-scrolling battles. Master movement, timing, and positioning to survive against relentless enemies.",
      "url": "https://store.steampowered.com/app/3125690/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "动画仍需要在正式版前改进。",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Would like to see animations improved by it's full release",
          "url": "https://store.steampowered.com/curator/42708058-Average-Gaming-Enjoyer/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "动漫美学与动作表现融合漂亮。",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "a beautiful blend of anime aesthetics and hardcore action.",
          "url": "https://store.steampowered.com/curator/45013120-Kitty-Cat-Reviews/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "格挡和闪避判定很少生效，生效时也迟缓。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Blocking and dodging frame rarely works and when it does it slow.",
          "url": "https://steamcommunity.com/profiles/76561199667596309/recommended/3125690/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "死亡后必须从头开始，缺少Boss后检查点让进度感很弱。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "dying after finishing the first boss and unlocking the second area just makes me restart the whole thing",
          "url": "https://steamcommunity.com/profiles/76561199730203642/recommended/3125690/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "角色差异感和个性不明显",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "I dont feel any difference with any character, no personality",
          "url": "https://steamcommunity.com/id/electricit/recommended/3125690/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "动作能量条会在连招中途打断节奏。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "一套丝滑连招还没打完的情况下突然弹出个能量不足从而被打断节奏",
          "url": "https://steamcommunity.com/profiles/76561199098195080/recommended/3125690/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "整体游玩手感很差",
