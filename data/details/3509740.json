  "hooks": [
    {
      "text": "战斗压缩在三乘三格中，站位和战场选择用于应对随机生成的敌方编队。",
      "dimension": "玩法",
      "excerpt": "The battle scene is presented in the form of 3x3 cells. Place the units correctly on it, choose the battlefield and win against a randomly generated enemy units.",
      "url": "https://store.steampowered.com/app/3509740/",
      "label": "证据原文片段"
    },
    {
      "text": "角色可持续升级，用游戏货币在商店购买武器，并每天挑战首领。",
      "dimension": "玩法",
      "excerpt": "Upgrade your characters, buy weapons in the store for in-game currency, and perform daily boss battles.",
      "url": "https://store.steampowered.com/app/3509740/",
      "label": "证据原文片段"
    },
    {
      "text": "死后被抛入人类自毁后的黑暗平行世界，第二次生命发生在极权殖民地废土。",
      "dimension": "题材",
      "excerpt": "Dark parallel world in which humanity has destroyed itself. And only small colonies have survived the last centuries holding on to power at the expense of the totalitarian regime of government. You were thrown here after your death, is this how you were given a second chance?",
      "url": "https://store.steampowered.com/app/3509740/",
      "label": "证据原文片段"
    }
  ],
