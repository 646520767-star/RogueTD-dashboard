  "hooks": [
    {
      "text": "选择受诅咒英雄穿越神明试炼，在神话敌潮中获胜后成为被选中的巨人杀手。",
      "dimension": "题材",
      "excerpt": "Choose one of the damned heroes and attempt to pass the Gods' test by fighting your way through waves of mythical adversaries. If you succeed in all the trials, you will become the chosen Jotunnslayer.",
      "url": "https://store.steampowered.com/app/2820820/",
      "label": "证据原文片段"
    },
    {
      "text": "每轮会插入额外任务，要求完成特定目标或克服附加障碍后再抵达最终挑战。",
      "dimension": "玩法",
      "excerpt": "Take on challenging missions during each run to test your skills and enrich your journey through the mythic realms. These quests may involve completing specific objectives or overcoming additional obstacles as you battle relentless enemies on your way to the final challenge.",
      "url": "https://store.steampowered.com/app/2820820/",
      "label": "证据原文片段"
    },
    {
      "text": "跨局成长会解锁特长、技能、武器和奖励，用于定制流派并提高后续生存率。",
      "dimension": "玩法",
      "excerpt": "Improve your abilities with meta-progression systems that offer unlockable perks, in-game skills, or upgrades. As you progress further, you'll gain access to new abilities, weapons, and bonuses that allow you to customize your playstyle and improve your chances of survival.",
      "url": "https://store.steampowered.com/app/2820820/",
      "label": "证据原文片段"
    }
  ],
