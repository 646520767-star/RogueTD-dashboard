  "hooks": [
    {
      "text": "钻机一开始加油就会引来巨型虫潮，必须提前用路障和狭窄火力口守住阵地。",
      "dimension": "玩法",
      "excerpt": "Once you start fueling your drill, a massive swarm of monsters will attack you. Setup defensive barricades and choke points to survive.",
      "url": "https://store.steampowered.com/app/2746030/",
      "label": "证据原文片段"
    },
    {
      "text": "向黑暗扩张既扩大资源控制面，也要收集镭为钻机供能，把每次基地经营转成更深下钻。",
      "dimension": "玩法",
      "excerpt": "Clear out and expand into as much of the darkness as you can. The more resources you control, the more powerful you can become. Your goal is to collect as much Radium to fuel your drill as you can. The more you collect, the deeper you can go.",
      "url": "https://store.steampowered.com/app/2746030/",
      "label": "证据原文片段"
    },
    {
      "text": "每关结束后，所有单位和建筑都能换武器、护甲和升级，任务表现决定可制作装备的货币。",
      "dimension": "玩法",
      "excerpt": "After every level, all units and buildings can be customized with different weapons, armour and upgrades. The better you do in each mission, the more currency you have to craft new equipment.",
      "url": "https://store.steampowered.com/app/2746030/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "肉鸽部分仍需改进",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The rogue-like aspect could be improved",
          "url": "https://steamcommunity.com/profiles/76561197968658621/recommended/2746030",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "后期流程过于相似且重复",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the path to the endgame got a bit too samey and repetitive.",
          "url": "https://steamcommunity.com/profiles/76561197968658621/recommended/2746030",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "资源经济缺少深度",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "There's almost zero depth in the resource economy.",
          "url": "https://steamcommunity.com/profiles/76561198107476105/recommended/2746030/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "流程前30至60分钟难度过低",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "it takes 30-60 minutes of play in a run for the game to become harder than dead easy.",
          "url": "https://steamcommunity.com/profiles/76561198107476105/recommended/2746030/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "无敌隐形敌人会瞬移摧毁总部",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "invincible, invisible enemies will teleport to your HQ and instantly kill it.",
          "url": "https://steamcommunity.com/id/8underr/recommended/2746030/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "无法查看总资源产量",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "no way to tell how many resources you are producing in total.",
          "url": "https://steamcommunity.com/profiles/76561198046921710/recommended/2746030/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "基地建设与防守带来长时间乐趣",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "endless hours of fun setting up bases and defending them.",
          "url": "https://store.steampowered.com/curator/45348146-Truxton%2527s-Emporium/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "RTS塔防过程紧张刺激",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
