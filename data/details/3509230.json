  "hooks": [
    {
      "text": "目标不再是将军，而是吃光全盘棋子；拖太久棋盘还会自行崩塌",
      "dimension": "玩法",
      "excerpt": "In this game, victory isn’t about capturing just the king; it’s about capturing every single piece on the board through masterful synergies! But be careful, if you waste too many moves the board will crumble around you…",
      "url": "https://store.steampowered.com/app/3509230/",
      "label": "证据原文片段"
    },
    {
      "text": "用150多种Gambit改写棋规，造出强化象群或让对手连续跳过回合",
      "dimension": "玩法",
      "excerpt": "Discover over 150+ powerful Gambits that alter the rules and properties of your run. Want a wacky army of supercharged bishops? Or to see how many times you can make your enemy skip a turn?",
      "url": "https://store.steampowered.com/app/3509230/",
      "label": "证据原文片段"
    },
    {
      "text": "把额外棋子藏在盘外预备区，在关键时刻突然部署改写局势",
      "dimension": "玩法",
      "excerpt": "Learn and exploit a dynamic reserve system that lets you store extra chess pieces off-board. Deploy them at the perfect moment to catch your adversary off guard.",
      "url": "https://store.steampowered.com/app/3509230/",
      "label": "证据原文片段"
    }
  ],
