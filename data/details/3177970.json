  "hooks": [
    {
      "text": "用可视化编程逻辑连接器官并直接调试技能",
      "dimension": "玩法",
      "excerpt": "Use simple programming logic to build organ links. The skill building process is highly visualized and can be easily debugged.",
      "url": "https://store.steampowered.com/app/3177970/",
      "label": "证据原文片段"
    },
    {
      "text": "数百种器官还能突变出附加词缀",
      "dimension": "玩法",
      "excerpt": "The game includes hundreds of organs with different functions. Each organ can also be mutated to obtain additional affixes which can further generate more unpredictable changes.",
      "url": "https://store.steampowered.com/app/3177970/",
      "label": "证据原文片段"
    },
    {
      "text": "把未知生物的器官和基因铺成血肉逃生路",
      "dimension": "题材",
      "excerpt": "The organs and genes of unknown creatures can be your power. Make good use of them and create yourself a path of flesh and blood.",
      "url": "https://store.steampowered.com/app/3177970/",
      "label": "证据原文片段"
    }
  ],
