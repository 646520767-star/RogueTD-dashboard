  "hooks": [
    {
      "text": "用手指直接绘制元素法术，重叠配方会涌现意外连锁",
      "dimension": "玩法",
      "excerpt": "Every spell is built from elemental patterns cast directly with your fingers. Recipes can overlap and combine , sparking strategies that reward clever play and experimentation.",
      "url": "https://store.steampowered.com/app/3057670/",
      "label": "证据原文片段"
    },
    {
      "text": "八名以上角色分别扭转同一套法术施放规则",
      "dimension": "玩法",
      "excerpt": "8+ playable characters, each bending the spellcasting system in unique ways",
      "url": "https://store.steampowered.com/app/3057670/",
      "label": "证据原文片段"
    },
    {
      "text": "越狱不是为了救世，而是赶去参加侄女的生日派对",
      "dimension": "故事",
      "excerpt": "You’re a wizard. A not-so-heroic wizard imprisoned for wizard crime, awoken from your wizard slumber by an invitation from your niece. Escape from jail and traverse a hostile world crawling with danger.",
      "url": "https://store.steampowered.com/app/3057670/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "细致血腥的画面展现出明确创意愿景。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Its art is gory and detailed, and there is a beautiful heart of a creative vision here.",
          "url": "https://steamcommunity.com/id/Theophrastus1/recommended/3057670/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "美术风格受到喜爱。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "I love the artstyle",
          "url": "https://steamcommunity.com/profiles/76561198115205471/recommended/3057670/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "美术表现非常出色。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the art is just outstanding.",
          "url": "https://steamcommunity.com/profiles/76561198046600940/recommended/3057670/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "诅咒伤害被认为调得过高。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the curse damage (which is way overtuned IMO)",
          "url": "https://steamcommunity.com/profiles/76561198033780124/recommended/3057670/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "选择之间缺少形成实质差异的空间。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "There's not enough opportunities to create meaningful differences in the choices you make.",
          "url": "https://steamcommunity.com/profiles/76561197982000431/recommended/3057670/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "通关一个法师后，后续角色可以复用同一策略，导致严重重复。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "After playing through with the first mage and winning, you can effectively mirror the strategy with subsequent mages.",
          "url": "https://steamcommunity.com/profiles/76561197982000431/recommended/3057670/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "手指经济与符印机制没有得到有意义的深入发展。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The core mechanisms of the game (finger economy + sigils matter) is not meaningfully built upon by the game",
          "url": "https://steamcommunity.com/id/Theophrastus1/recommended/3057670/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "角色构筑普遍依赖相同道具。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "all the wizards pretty much needed the same items",
          "url": "https://steamcommunity.com/profiles/76561198115205471/recommended/3057670/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "当前状态下游玩不够有趣。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "it's not really fun to play at the current state",
          "url": "https://steamcommunity.com/profiles/76561198033780124/recommended/3057670/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "卡牌战斗的触感与怪异感独树一帜。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Pluto's particular flavour of card-based combat feels tactile and off-kilter in an unparalleled way.",
          "url": "https://youtu.be/rSWDjObGUtc",
          "label": "证据原文片段"
        }
      ]
    }
  ],
