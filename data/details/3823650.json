  "hooks": [
    {
      "text": "在反乌托邦直播秀中杀怪赚观众打赏，再把收入押进升级赌博",
      "dimension": "玩法",
      "excerpt": "Roguelike shooter set in a dystopian, livestreamed gameshow. Obliterate waves of deformed freaks, earn donations from your sadistic audience and gamble your earnings for upgrades.",
      "url": "https://store.steampowered.com/app/3823650/",
      "label": "证据原文片段"
    },
    {
      "text": "推进越深围观者越多，Boss战被包装成观众等待的死亡 spectacle",
      "dimension": "题材",
      "excerpt": "The further you get, the more viewers arrive to witness your inevitable demise. They are here for the main event. The boss fights will be a spectacle.",
      "url": "https://store.steampowered.com/app/3823650/",
      "label": "证据原文片段"
    },
    {
      "text": "清房后进入中枢先缴税，再把剩余现金赌成武器或能力升级",
      "dimension": "玩法",
      "excerpt": "Once you clear a room you can enter the HUB , this is where you pay your tax and gamble away the rest of your hard earned cash. Hoping to get a new weapon or ability upgrade.",
      "url": "https://store.steampowered.com/app/3823650/",
      "label": "证据原文片段"
    }
