  "hooks": [
    {
      "text": "30多种陷阱与爪牙混合自动武器和手动时机机关守卫邪恶城堡",
      "dimension": "玩法",
      "excerpt": "Slay the good guys with your choice of over 30 delightfully devious traps and minions! Strategically mix-n-match your arsenal with wicked weapons that fire automatically and manually-activated traps that require precision timing to pack a painful punch!",
      "url": "https://store.steampowered.com/app/2888470/",
      "label": "证据原文片段"
    },
    {
      "text": "90关解谜塔防之外还有随机肉鸽模式，可逐步扩建城堡与获取噩梦能力",
      "dimension": "玩法",
      "excerpt": "Break Bad and defend your dark domain across 90 puzzling stages, or take on the nefarious new roguelite mode: Dr. Lord Evilstein's Roguevenge ! In this new mode, the challenge is ramped up, and no two attempts are the same. Choose how your castle expands as you advance, grow your trap arsenal during each run, and collect mighty Nightmare powers to make the heroes pray for a quick Game Over...",
      "url": "https://store.steampowered.com/app/2888470/",
      "label": "证据原文片段"
    },
    {
      "text": "英雄掉落装备带有恶人加成，但有限槽位迫使玩家反复调整构筑",
      "dimension": "玩法",
      "excerpt": "Collect loot from fallen heroes to deck out your Dark Lord and his control room! Each item includes a Baddie Bonus upgrade -- but your equipment spots are limited, so prepare to tinker with different diabolical builds.",
      "url": "https://store.steampowered.com/app/2888470/",
      "label": "证据原文片段"
    }
  ],
