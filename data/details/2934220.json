  "hooks": [
    {
      "text": "移动城市必须持续前进，通过市政厅、塔楼与防御结构边走边挡住黑暗军团",
      "dimension": "玩法",
      "excerpt": "The city must endure! Choose from a selection of town halls, place towers and create your own builds to maximise destruction. Equip defensive structures to repel monsters from the gates and keep the city moving forward, else the darkness will consume you!",
      "url": "https://store.steampowered.com/app/2934220/",
      "label": "证据原文片段"
    },
    {
      "text": "英雄阵亡不等于结束，只要城市尚存就能迅速重返战场继续守卫",
      "dimension": "玩法",
      "excerpt": "The City Still Stands: Even if the Hero falls, it’s not game over! A run only ends once the city is destroyed, so quickly jump back into the fight before all hope is lost.",
      "url": "https://store.steampowered.com/app/2934220/",
      "label": "证据原文片段"
    },
    {
      "text": "木材维持引擎并提高塔效，石料负责修复，黄金用于扩建移动要塞",
      "dimension": "玩法",
      "excerpt": "Keep the city stocked: Gather wood to keep the engines burning and increase tower efficiency, chisel stone to help repair and rebuild, and mine gold to expand your moving fortress of destruction.",
      "url": "https://store.steampowered.com/app/2934220/",
      "label": "证据原文片段"
    }
  ],
