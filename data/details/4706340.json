  "hooks": [
    {
      "text": "无限泡泡怪潮中收集资源持续压注",
      "dimension": "玩法",
      "excerpt": "A fast-paced roguelike extraction arcade game where every run is a gamble between greed and survival. Pop endless waves of bubbles, collect resources, build powerful synergies, and push your luck as chaos fills the arena. The longer you survive, the stronger you become. The stronger you become, the more you risk losing.",
      "url": "https://store.steampowered.com/app/4706340/",
      "label": "证据原文片段"
    },
    {
      "text": "五十余强化触发清屏连锁与多种流派",
      "dimension": "玩法",
      "excerpt": "Features 50+ upgrades to create broken builds Massive chain reactions and screen-clearing chaos Endless combo possibilities 9+ challenging bosses Risk vs reward extraction system Permanent progression and unlocks Every run is different As the arena fills with bubbles, runs become increasingly chaotic. Stronger builds can trigger large chain reactions and explosions that completely change the pace of a run. Different upgrade combinations lead to different playstyles. Some builds focus on survivability and consistency, while others are built around high-risk scaling and massive score bursts.",
      "url": "https://store.steampowered.com/app/4706340/",
      "label": "证据原文片段"
    },
    {
      "text": "越晚撤离奖励越高但可能全部丢失",
      "dimension": "玩法",
      "excerpt": "Extraction checkpoints become more valuable the longer a run survives. Staying longer gives access to stronger upgrades and higher rewards, but also increases the chance of losing everything before extracting.",
      "url": "https://store.steampowered.com/app/4706340/",
      "label": "证据原文片段"
    }
  ],
