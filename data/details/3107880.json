  "hooks": [
    {
      "text": "在程序生成的森林里自行确定目标并搜寻侏儒，让探索路线与追踪任务每局变化",
      "dimension": "玩法",
      "excerpt": "The opportunity to explore the forest well in search of gnomes and feel like a real knight - A specific goal of the game that you choose yourself - Procedurally generated world and high replayability",
      "url": "https://store.steampowered.com/app/3107880/",
      "label": "证据原文片段"
    },
    {
      "text": "五个关卡串联九名剧情角色，玩家决定会导向六种结局与意外转折",
      "dimension": "故事",
      "excerpt": "Five levels, five gnomes, nine story characters - Six endings depending on your decision - Unexpected plot twists",
      "url": "https://store.steampowered.com/app/3107880/",
      "label": "证据原文片段"
    },
    {
      "text": "用轻量低多边形视觉塑造阴郁骑士氛围，并把森林搜寻作为主要空间体验",
      "dimension": "画风",
      "excerpt": "Immerse yourself in the atmosphere of a gloomy medieval dark fantasy and try to find all the gnomes. Meet various characters on your way and try to figure out what happened to this damned world that you yourself (in fact, we) created. Game Features - Stylish low-poly graphics that won't overload your computer - The opportunity to explore the forest well in search of gnomes and feel like a real knight",
      "url": "https://store.steampowered.com/app/3107880/",
      "label": "证据原文片段"
    }
  ],
