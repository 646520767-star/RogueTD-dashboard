  "hooks": [
    {
      "text": "多层城塞通过动态传送带补给防御塔，并用墙体减速、陷阱削弱持续来袭的敌人。",
      "dimension": "玩法",
      "excerpt": "A unique layered tower defence puzzle game. Build your citadels to keep the base safe. Use dynamic conveyors to ensure that your towers are being replenished. Use walls to slow the relentless charge of the attackers. Place traps to get a strategic edge over your foes...",
      "url": "https://store.steampowered.com/app/2499130/",
      "label": "证据原文片段"
    },
    {
      "text": "少量简单组件可在多层堡垒中相互叠加，涌现出分形式的大规模复杂布局。",
      "dimension": "玩法",
      "excerpt": "The emergent possibilities for your multilayer forts is massive, where a host of simple components build on each other to allow for massive complexity.",
      "url": "https://store.steampowered.com/app/2499130/",
      "label": "证据原文片段"
    },
    {
      "text": "简洁霓虹画面、极简操作和舒缓音乐共同营造可慢节奏规划防线的氛围。",
      "dimension": "画风",
      "excerpt": "A minimalist twist on tower defence games, with nice clean visuals, simple controls, relaxing tunes and fractal like possibilities to expand your bases.",
      "url": "https://store.steampowered.com/app/2499130/",
      "label": "证据原文片段"
    }
  ],
