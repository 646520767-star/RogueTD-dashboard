  "hooks": [
    {
      "text": "每次掷骰都在继续贪分与及时存分之间押注",
      "dimension": "玩法",
      "excerpt": "Dice Have No Eyes is a dice-rolling Balatro-like fever dream about greed management. Every roll carries a chance for glory. But every roll carries a risk of bust.",
      "url": "https://store.steampowered.com/app/4535880/",
      "label": "证据原文片段"
    },
    {
      "text": "给骰子喂饺子并收集改写规则的饰品",
      "dimension": "玩法",
      "excerpt": "Feed your dice dumplings, collect game bending trinkets, roll too much and lose it all.",
      "url": "https://store.steampowered.com/app/4535880/",
      "label": "证据原文片段"
    },
    {
      "text": "通关后替换强化骰子，用饰品拼出破格协同",
      "dimension": "玩法",
      "excerpt": "Improve and swap your dice with each cleared level. Collect trinkets and discover broken synergies.",
      "url": "https://store.steampowered.com/app/4535880/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "视觉表现令人享受",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the music and visuals are a treat.",
          "url": "https://store.steampowered.com/curator/45666918-Indiana-Jonas/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "诡异可爱的美术风格充满魅力。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "to much charm and oozes a really lovely yet bizarre aesthetic",
          "url": "https://steamcommunity.com/id/bigthinkin/recommended/4535880/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "可爱、时尚且迷人。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "one of the cutest, most stylish and charming games I have ever played.",
          "url": "https://steamcommunity.com/profiles/76561198095195290/recommended/4535880/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "推运气机制过于惩罚。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "this level of punishing push-your-luck.",
          "url": "https://store.steampowered.com/curator/43616869-not_normal/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "无法关闭或撤销不适合自身玩法的升级。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "We should certainly be able to disable or undo upgrades not suited to our playstyle",
          "url": "https://steamcommunity.com/profiles/76561198095195290/recommended/4535880/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "饰品过于情境化，常常无用。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "trinkets that are too situational to be useful.",
          "url": "https://steamcommunity.com/id/u1tv/recommended/4535880/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "缺少关键便利功能破坏近乎上瘾的循环。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the absence of some important QOL is so disruptive to the almost-addictive gameplay loop",
          "url": "https://steamcommunity.com/profiles/76561198095195290/recommended/4535880/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "掷骰子体验极其舒适。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "rolling dice the most cozy experience ever.",
          "url": "https://steamcommunity.com/profiles/76561199372924219/recommended/4535880/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "适合作为休闲冲分游戏反复游玩。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "my go-to for casual score-attack play.",
          "url": "https://steamcommunity.com/profiles/76561198011614926/recommended/4535880/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "核心玩法简单但非常扎实。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "its core gameplay is simple yet very solid.",
          "url": "https://steamcommunity.com/profiles/76561198011614926/recommended/4535880/",
          "label": "证据原文片段"
        }
