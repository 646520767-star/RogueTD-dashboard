  "hooks": [
    {
      "text": "用20余种建筑发展北欧村庄，在经济扩张与迎击敌潮之间持续分配资源。",
      "dimension": "玩法",
      "excerpt": "With over 20 buildings offering diverse strategic development options through unique upgrades and meta-progression, find the balance between economic growth and defending Nordhold.",
      "url": "https://store.steampowered.com/app/3028310/",
      "label": "证据原文片段"
    },
    {
      "text": "9座特色塔、100余项升级与数百种英雄组合，共同拼出高度可调的防线构筑。",
      "dimension": "玩法",
      "excerpt": "9 towers with unique abilities offer numerous customization options. Fine-tune your tactics to protect Nordhold effectively. 100+ custom upgrades offer versatile customization options, providing strategic depth and countless combinations. Which general should defend Nordhold? Choose from hundreds of hero combinations!",
      "url": "https://store.steampowered.com/app/3028310/",
      "label": "证据原文片段"
    },
    {
      "text": "神谕会抛出风险收益抉择：承受五波强化敌人换高奖励，或让五波建塔成本下降。",
      "dimension": "玩法",
      "excerpt": "The oracle always gives you a different choice, for example: 5 waves of stronger enemies, which also offer higher rewards, or 5 waves of cheaper tower construction?",
      "url": "https://store.steampowered.com/app/3028310/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "玩法存在大量重复",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "a large amount of repetitive gameplay.",
          "url": "https://youtu.be/cpEVJohYERc",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "局外成长削弱整体体验",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the game would be better served without the metaprogression.",
          "url": "https://store.steampowered.com/curator/45492874-Tenkiei-Recommends/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "所有建筑被账号进度锁定",
