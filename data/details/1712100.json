  "hooks": [
    {
      "text": "驾驶不只靠撞击，还能推挤、加速冲撞和侧顶，把赛车变成贴身金属格斗。",
      "dimension": "玩法",
      "excerpt": "Metal‑on‑metal car combat – crash, shove, boost and side‑bash rivals",
      "url": "https://store.steampowered.com/app/1712100/",
      "label": "证据原文片段"
    },
    {
      "text": "在随机路线图上规划商店落点，途中修车、换武器并安装80余种可解锁特性。",
      "dimension": "玩法",
      "excerpt": "Strategically plan your route so you can reach Shops. In these safe havens you can repair your car, swap weapons, or install one of the 80+ unlockable perks.",
      "url": "https://store.steampowered.com/app/1712100/",
      "label": "证据原文片段"
    },
    {
      "text": "加速冲进赛道尸潮可以劈开人海，但一旦减速被围，废土变异者会徒手拆毁车辆。",
      "dimension": "玩法",
      "excerpt": "Boost into the hordes of humanoid husks swarming the track, parting the waves of Wasted like a Moses on wheels! But be careful not to get stuck in the high tide: too many Wasteds will surround your car and smash it to bits with the remains of their raw hands.",
      "url": "https://store.steampowered.com/app/1712100/",
      "label": "证据原文片段"
    }
