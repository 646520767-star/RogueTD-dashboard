  "hooks": [
    {
      "text": "枪械没有换弹或补充弹药机制，武器耗尽后仍可用光束刀进行近身战。",
      "dimension": "玩法",
      "excerpt": "There is no reloading or refilling ammunition. Even if you don't have a gun, you can utilize a beam knife for close quarter combat.",
      "url": "https://store.steampowered.com/app/2516990/",
      "label": "证据原文片段"
    },
    {
      "text": "射程内武器自动锁定敌人，冲刺期间无敌，可把冲刺时机用于穿越弹幕。",
      "dimension": "玩法",
      "excerpt": "Unlike twin-stick shooters, your weapon automatically aims at the enemy when within range. You're invincible while dashing. Use this to dodge enemy bullets.",
      "url": "https://store.steampowered.com/app/2516990/",
      "label": "证据原文片段"
    },
    {
      "text": "简单与普通模式保留解锁成长，专家模式则完全取消继承，只检验玩家操作。",
      "dimension": "玩法",
      "excerpt": "There are unlockable elements that can be carried over in easy and normal game modes. In expert mode, there are no carry over elements at all. Use only your skills as a player to break your enemies.",
      "url": "https://store.steampowered.com/app/2516990/",
      "label": "证据原文片段"
    }
  ],
