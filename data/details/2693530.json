  "hooks": [
    {
      "text": "在彩色石盘上画出路径，依次经过法术条件即可按顺序施法",
      "dimension": "玩法",
      "excerpt": "In combat you draw a path across the stone board, and where it passes over the requirements for your spells, they will be cast in order.",
      "url": "https://store.steampowered.com/app/2693530/",
      "label": "证据原文片段"
    },
    {
      "text": "没有操作时限，但敌人会用状态效果干扰法术与石盘布局",
      "dimension": "玩法",
      "excerpt": "While there is no time pressure, enemies will fight back! Attacking you not only with damage and harmful status effects, but also affecting your spells and stone grid.",
      "url": "https://store.steampowered.com/app/2693530/",
      "label": "证据原文片段"
    },
    {
      "text": "用新法术、法术附魔、耐力和施法能力持续重构魔法书",
      "dimension": "玩法",
      "excerpt": "As you progress, you upgrade with new spells, new enchantments for those spells, and increases to your stamina or casting ability. Build the perfect spell book! And fight past monsters and bosses, deeper into the procedurally generated dungeons.",
      "url": "https://store.steampowered.com/app/2693530/",
      "label": "证据原文片段"
    }
  ],
