  "hooks": [
    {
      "text": "玻璃头法师在物理驱动的3D竞技场中互相轰碎，让每次碰撞、爆炸和失控位移都改变对局",
      "dimension": "玩法",
      "excerpt": "CRACKED is a fast-paced, 3D PvP roguelike where glass-headed mages go head-to-head (or head-to-shards) in chaotic arena duels. Inspired by Rounds and powered by physics-based combat, every fight is unpredictable, explosive, and wildly replayable.",
      "url": "https://store.steampowered.com/app/3917010/",
      "label": "证据原文片段"
    },
    {
      "text": "每回合结束从古怪升级中选取一项，持续叠加追踪火球、喷气背包、毒云等失衡组合",
      "dimension": "玩法",
      "excerpt": "After every round, choose from a pool of powerful, quirky upgrades that stack into outrageous builds — from homing fireballs and jet packs to rapid-fire chaos or poison clouds.",
      "url": "https://store.steampowered.com/app/3917010/",
      "label": "证据原文片段"
    },
    {
      "text": "既可单人决斗也可扩展到四对四组队混战，用同一套短局规则承载不同人数的竞技",
      "dimension": "玩法",
      "excerpt": "Play solo or team up in 1v1 all the way to 4v4 showdowns.",
      "url": "https://store.steampowered.com/app/3917010/",
      "label": "证据原文片段"
    }
  ],
