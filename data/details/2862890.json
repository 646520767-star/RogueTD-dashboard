  "hooks": [
    {
      "text": "从十名独特角色中选择起点，每个角色以不同玩法向月球攀升",
      "dimension": "玩法",
      "excerpt": "Become the Moon is a challenging, deckbuilding auto battler. Choose from 10 unique characters, each with their own distinct playstyles. Assemble a team of powerful minions & cast cosmic spells where every run takes you one step closer to the moon.",
      "url": "https://store.steampowered.com/app/2862890/",
      "label": "证据原文片段"
    },
    {
      "text": "每轮选牌组合随从、法术和遗物，叠加协同与增益形成超强牌组",
      "dimension": "玩法",
      "excerpt": "Assemble unique decks of minions, spells, and relics. Each round, you’ll be able to draft new cards to grow your arsenal, build overpowered synergies and buff your minions. Collect powerful relics to overclock your deck, and shoot for the stars!",
      "url": "https://store.steampowered.com/app/2862890/",
      "label": "证据原文片段"
    },
    {
      "text": "开战前摆放、交换和重排随从并施放战斗法术，铃响后自动决出结果",
      "dimension": "玩法",
      "excerpt": "Take on foes in chaotic auto battles. Strategically place, swap and reshuffle minions, and tactically cast battle spells to adapt to each fight. Optimise your board for each battle, however once that bells rings, your fate is out of your hands…",
      "url": "https://store.steampowered.com/app/2862890/",
      "label": "证据原文片段"
    }
  ],
