  "hooks": [
    {
      "text": "冲刺本身就是近战攻击，还能混合主动技能，在机器人群中用时机扭转战局。",
      "dimension": "玩法",
      "excerpt": "Turn each dash into a punchy close range attacks or mix in special skills to defeat as many enemies as possible. The right skill at the right moment could turn the tide of battle!",
      "url": "https://store.steampowered.com/app/3262100/",
      "label": "证据原文片段"
    },
    {
      "text": "地下实验室里救出的每只动物都会成为聚落新伙伴，帮助扩张基地并挑战更强威胁。",
      "dimension": "玩法",
      "excerpt": "Rescue adorable animals trapped in underground labs. Each victory brings a new furry ally to your settlement, helping you grow stronger and expand your base to take on even greater threats.",
      "url": "https://store.steampowered.com/app/3262100/",
      "label": "证据原文片段"
    },
    {
      "text": "动物伙伴各有采石、搬运等生产能力，并会随等级带来新配方，把救援转化为装备制造链。",
      "dimension": "玩法",
      "excerpt": "Every rescued animal has a unique ability that shapes your strategy. Stone gathering hedgehogs, item transporting sugar gliders, and many more friends help you collect resources and craft powerful gear while you are off fighting in the dungeons.",
      "url": "https://store.steampowered.com/app/3262100/",
      "label": "证据原文片段"
    }
  ],
