  "hooks": [
    {
      "text": "三台机甲拥有完全不同牌组机制：枪手机枪爆破、Stinger贴身忍袭、Keeper施法召唤",
      "dimension": "玩法",
      "excerpt": "Take command of the Gunner Mech to unleash an endless flurry of bullets and explosions, get up close and personal with the ninja-like Stinger Mech, or unleash the powerful spells and summons of the Keeper Mech!",
      "url": "https://store.steampowered.com/app/2097570/",
      "label": "证据原文片段"
    },
    {
      "text": "失误或错过完美连招时可消耗Chrono Token倒转时间，重新改写当前战局",
      "dimension": "玩法",
      "excerpt": "Missed a perfect combo or found yourself cornered by the invaders? Use a Chrono Token to rewind time and rewrite your fate.",
      "url": "https://store.steampowered.com/app/2097570/",
      "label": "证据原文片段"
    },
    {
      "text": "每局结束会解锁新卡牌与驾驶员，同时把更致命的敌人与Boss加入未来流程",
      "dimension": "玩法",
      "excerpt": "After each run, unlock powerful new cards, pilots, and deadlier enemies and bosses that raise the stakes in future battles.",
      "url": "https://store.steampowered.com/app/2097570/",
      "label": "证据原文片段"
    }
  ],
