  "hooks": [
    {
      "text": "程序生成地图上超过2.5万名敌人同时冲击城堡，逼迫城建与军团协同",
      "dimension": "玩法",
      "excerpt": "Over 25 THOUSAND of them will storm your castle on procedurally generated maps. To survive, you must build fortifications, raise armies, master engineering, economy, and even magic (the active pause spell included).",
      "url": "https://store.steampowered.com/app/1272320/",
      "label": "证据原文片段"
    },
    {
      "text": "箭矢与投石均进行物理模拟，射线会被自家城墙挡住，必须预留视野和撤退通道",
      "dimension": "玩法",
      "excerpt": "Every arrow, catapult stone and enemy launched skywards is physically modeled, making for a tactile and coherent battlefield. Just make sure your troops have towers to shoot from and clear lines of sight, or you might find your best-laid plans embarrassingly blunted by your own fortifications. Consider your gates, your lines of advancement and retreat.",
      "url": "https://store.steampowered.com/app/1272320/",
      "label": "证据原文片段"
    },
    {
      "text": "农业不足会让士兵饿死，尸体不掩埋会引发瘟疫，感染者还必须及时治疗",
      "dimension": "玩法",
      "excerpt": "Engage in agriculture and farming, or food can become scarce, and your soldiers can starve on the battlefield. Build houses, bury fallen soldiers and peasants to prevent plague, and treat the infected when death comes knocking.",
      "url": "https://store.steampowered.com/app/1272320/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "城墙强度过低，削弱建城防守玩法。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "城墙太弱导致与其造城墙不如直接造兵升本",
          "url": "https://steamcommunity.com/profiles/76561198254108866/recommended/1272320/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "缺少明确敌袭路线指引。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "缺少敌袭路线指引",
          "url": "https://steamcommunity.com/id/stfhjerry/recommended/1272320/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "关卡流程依赖背板且重复。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "游戏就变得要背板，流程化，很没意思。",
          "url": "https://steamcommunity.com/profiles/76561198310827984/recommended/1272320/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "玩家成长速度跟不上逐波增强的敌袭。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "玩家的成长跟不上游戏内难度的提升",
          "url": "https://steamcommunity.com/id/stfhjerry/recommended/1272320/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "防守成功缺乏奖励，失误惩罚过重。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "防住没奖励失误有惩罚",
          "url": "https://steamcommunity.com/id/stfhjerry/recommended/1272320/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "策略深度足够，同时容易快速上手。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Deep enough to be strategic, simple enough to jump in fast.",
          "url": "https://store.steampowered.com/curator/43939488-Gamer-Detective/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "轻量RTS结合经营建设的核心体验有趣。",
