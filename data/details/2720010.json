  "hooks": [
    {
      "text": "把传统 Roguelike 的规模、深度和挑战压缩进 60 分钟内可完成的单局",
      "dimension": "玩法",
      "excerpt": "The series overarching goal has been to create a truly massive game with all the scope, depth and challenge we've come to expect from traditional roguelikes but with runs that are completable in 60 minutes or less.",
      "url": "https://store.steampowered.com/app/2720010/",
      "label": "证据原文片段"
    },
    {
      "text": "甚至能零升级、零装备或全程无伤通关，强调知识与操作高于数值",
      "dimension": "玩法",
      "excerpt": "Players have beaten the game without ever leveling up their character, without ever equipping an item and even without taking a single hit!",
      "url": "https://store.steampowered.com/app/2720010/",
      "label": "证据原文片段"
    },
    {
      "text": "回合战仍要求近乎持续移动，用走位闪弹、侧避近战、脱离爆炸与毒云",
      "dimension": "玩法",
      "excerpt": "Movement Focused in which you can move to dodge projectiles, side step melee attacks, avoid explosions, escape from deadly clouds, run circles around slow moving brutes and dive head first into the enemy back line. You should be in a state of near constant motion.",
      "url": "https://store.steampowered.com/app/2720010/",
      "label": "证据原文片段"
    }
  ],
