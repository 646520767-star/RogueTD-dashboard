  "hooks": [
    {
      "text": "先布置追随者再亲自并肩作战，让英雄和防线互相掩护",
      "dimension": "玩法",
      "excerpt": "Strategically place your followers, then fight alongside them as you cover each other, repel enemies, and combine your strength to unleash chaos across the field.",
      "url": "https://store.steampowered.com/app/3975750/",
      "label": "证据原文片段"
    },
    {
      "text": "盟友阵亡后可以复活重整，但城门一旦被毁整局立即结束",
      "dimension": "玩法",
      "excerpt": "your allies can revive and regroup after death, but the city gate’s demise is final.",
      "url": "https://store.steampowered.com/app/3975750/",
      "label": "证据原文片段"
    },
    {
      "text": "用恶魔Boss遗物把追随者进化为终极形态，逆转不断升级的攻势",
      "dimension": "玩法",
      "excerpt": "Each hard-won mystic relic can be used to evolve your followers into their ultimate forms, turning the tides of battle against ever-growing threats.",
      "url": "https://store.steampowered.com/app/3975750/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "界面显得粗糙且操作笨拙",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The UI is also extremly clanky",
          "url": "https://steamcommunity.com/id/sdfrog/recommended/3975750/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "战斗视觉表现令人满意",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "satisfying combat visuals",
          "url": "https://vaporlens.app/app/3975750/the_gate_must_stand",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "敌人攻击栅栏而不走预留缺口，使塔防策略失效",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "怪物并不会绕过栅栏走我留好的缺口，而是会尝试攻击栅栏，这让塔防策略荡然无存",
          "url": "https://steamcommunity.com/profiles/76561198134605407/recommended/3975750/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "高难度缺少有效策略解法",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Very repetitive game loop, and incredibly difficult at higher difficulties with no good strategies to get around it.",
          "url": "https://steamcommunity.com/profiles/76561198047411409/recommended/3975750/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "跨地图后主角成长重置，使前期推进缺少意义",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "三张地图打下来敌人在成长，主角每次直接回到解放前，所以前几张图打完的意义在哪",
          "url": "https://steamcommunity.com/profiles/76561198100966718/recommended/3975750/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "敌人有时会卡住不动",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Enemies get sometimes stuck on things and never move",
          "url": "https://steamcommunity.com/id/sdfrog/recommended/3975750/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "解锁越多会让构筑池更杂、成型更困难",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "解锁越多越杂，全解锁后成型难度大了一半",
          "url": "https://steamcommunity.com/profiles/76561199867726475/recommended/3975750/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "角色复活后缺少无敌保护，容易再次被秒杀",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "角色起来就秒，没有复活无敌保护",
          "url": "https://steamcommunity.com/profiles/76561198100966718/recommended/3975750/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "成型后会出现卡顿和掉帧",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "成型后却开始卡顿掉帧起来了",
          "url": "https://steamcommunity.com/profiles/76561199867726475/recommended/3975750/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "未获得主动技能时仍会出现无效的主动技能词条",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "没有抽到主动技能之前竟然能刷到主动技能加攻速、减CD的词条",
          "url": "https://steamcommunity.com/profiles/76561198100966718/recommended/3975750/",
          "label": "证据原文片段"
        }
      ]
    }
