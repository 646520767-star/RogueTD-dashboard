  "hooks": [
    {
      "text": "卡牌不是打出去，而是作为士兵在战场上向敌阵行军",
      "dimension": "玩法",
      "excerpt": "In The Royal Writ, you don't just play cards - you command them on the battlefield. Place your loyal subjects strategically as they advance toward the enemy, dealing damage.",
      "url": "https://store.steampowered.com/app/3333700/",
      "label": "证据原文片段"
    },
    {
      "text": "越过敌方基地前未能取胜的卡牌会永久牺牲，并留下本局传奇",
      "dimension": "玩法",
      "excerpt": "But beware: any card that reaches the enemy base before victory is permanently destroyed and removed from your deck for the rest of your run. Sacrifice isn't just a risk - it's an essential strategy that creates memorable sub-stories with each run.",
      "url": "https://store.steampowered.com/app/3333700/",
      "label": "证据原文片段"
    },
    {
      "text": "绘本式动物王国把中世纪荒诞与黑色幽默画在同一战场",
      "dimension": "画风",
      "excerpt": "Charming Art Style - Picture-book visuals blend with medieval absurdity and dark humor",
      "url": "https://store.steampowered.com/app/3333700/",
      "label": "证据原文片段"
    }
