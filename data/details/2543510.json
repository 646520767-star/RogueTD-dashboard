  "hooks": [
    {
      "text": "全队投票决定下一轮敌人变异",
      "dimension": "玩法",
      "excerpt": "Between each mission, players must vote between a random selection of mutations that will grant enemies new traits and abilities. Fortunately, this choice will also offer the players immediate or long-term benefits, making the decision less obvious but more critical.",
      "url": "https://store.steampowered.com/app/2543510/",
      "label": "证据原文片段"
    },
    {
      "text": "在贪婪与撤退间赌每份奖励",
      "dimension": "玩法",
      "excerpt": "Every second counts, and every reward is associated with a risk. Success must be found in the delicate sweet spot between boldness and greed.",
      "url": "https://store.steampowered.com/app/2543510/",
      "label": "证据原文片段"
    },
    {
      "text": "职业增益与枪械模组联动构筑",
      "dimension": "玩法",
      "excerpt": "Choose a loadout that fits your style and then mod it with upgrades to your personal preference. A clever combination of perks and gun mods will turn you into an unstoppable mutant killing machine in no time.",
      "url": "https://store.steampowered.com/app/2543510/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "后期画面信息过度拥挤。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Visual clutter gets insane later on",
          "url": "https://steamcommunity.com/id/66674444/recommended/2543510/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "玩法容易变得无聊且重复。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "It's just so wildly boring and repetitive",
          "url": "https://www.youtube.com/shorts/KrvFgfWcpsk",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "长期游玩缺少有效局外成长。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "无任何局外成长",
          "url": "https://steamcommunity.com/profiles/76561198321937969/recommended/2543510/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "角色升级效果偏弱。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the upgrades for your character are a little underwhelming",
          "url": "https://steamcommunity.com/id/Luna___/recommended/2543510/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "部分周目过度依赖随机性。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Some runs depend heavily on RNG",
          "url": "https://steamcommunity.com/id/66674444/recommended/2543510/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "武器和升级平衡不完善。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Balance between weapons/upgrades isn’t perfect",
          "url": "https://steamcommunity.com/id/66674444/recommended/2543510/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "屏幕过于拥挤时性能会下降。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Performance can dip when the screen gets too crowded",
          "url": "https://steamcommunity.com/id/66674444/recommended/2543510/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "内容解锁过程可能显得重复刷取。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Can feel grindy when unlocking content",
          "url": "https://steamcommunity.com/id/66674444/recommended/2543510/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "角色等级成长过程过于肝。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "游戏太肝",
          "url": "https://steamcommunity.com/profiles/76561198331682271/recommended/2543510/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "不同角色、武器和解锁形成可持续的体验循环。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "解锁新角色-通关-解锁新武器-新武器还会给之前通关过的角色新体验，这样一个良性循环可以持续很久",
          "url": "https://steamcommunity.com/id/Cagliostroo/recommended/2543510/",
          "label": "证据原文片段"
        }
      ]
    }
