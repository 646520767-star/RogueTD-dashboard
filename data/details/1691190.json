  "hooks": [
    {
      "text": "先用舰炮打掉敌船关键模块，再把优势带入登船战",
      "dimension": "玩法",
      "excerpt": "Encounters begin with Sea Battles where you can use cannons to target key areas of enemy ships. Both your ship and the enemy's have distinct buffs that can be destroyed.",
      "url": "https://store.steampowered.com/app/1691190/",
      "label": "证据原文片段"
    },
    {
      "text": "把敌人钉向障碍、推入尖刺，或借绳索摆荡抢占位置",
      "dimension": "玩法",
      "excerpt": "Use your crew's unique abilities to maneuver and pin enemies against obstacles for fatal damage. Leverage the environment by pushing enemies into spikes, grabbing one-time weapons, or swinging into position with ropes.",
      "url": "https://store.steampowered.com/app/1691190/",
      "label": "证据原文片段"
    },
    {
      "text": "召唤海妖、巨型蜗牛与克拉肯，用不同控场能力支援登船",
      "dimension": "玩法",
      "excerpt": "Summon 3 sea monsters to assist in the boarding phase: The Kraken crushes nearby enemies. The Mermaid disrupts and pushes enemies in any direction. The Giant Snail drops a deadly spiked obstacle on the deck.",
      "url": "https://store.steampowered.com/app/1691190/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
