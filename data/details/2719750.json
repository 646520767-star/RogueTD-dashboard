  "hooks": [
    {
      "text": "在程序生成的小行星表面进行360度建造，必须顺应每颗星体的形状用手绘管线优化物流。",
      "dimension": "玩法",
      "excerpt": "Place buildings on procedurally generated asteroids and build your own little worlds floating in space. Use each asteroid's unique shape and available surface to create the perfect production network. Take the role of a cosmic pioneer and strategically place and connect production facilities with hand-drawn-pipes to optimize your resource flow.",
      "url": "https://store.steampowered.com/app/2719750/",
      "label": "证据原文片段"
    },
    {
      "text": "把生产链扩展到整个恒星系，持续优化自动化网络，也可以停下来观看太空工厂自行运转。",
      "dimension": "玩法",
      "excerpt": "Establish an ever-growing network of production chains throughout your star system. Improve and optimize, or sit back and watch the satisfying rhythm of your bustling space factory.",
      "url": "https://store.steampowered.com/app/2719750/",
      "label": "证据原文片段"
    },
    {
      "text": "以kurzgesagt视频为灵感打造鲜艳太空美术，并让大量鸟类角色贯穿视觉表达。",
      "dimension": "画风",
      "excerpt": "a vibrant art style inspired by kurzgesagt videos (and lots of birds, of course)",
      "url": "https://store.steampowered.com/app/2719750/",
      "label": "证据原文片段"
    }
  ],
