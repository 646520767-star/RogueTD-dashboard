  "hooks": [
    {
      "text": "利用地图高低地形与特殊格，亲手规划能困住敌人的塔防迷宫",
      "dimension": "玩法",
      "excerpt": "Use the maps' topography and special tiles to optimize your maze.",
      "url": "https://store.steampowered.com/app/2224640/",
      "label": "证据原文片段"
    },
    {
      "text": "30张独特手工地图坚持固定设计，不使用程序属性或电脑生成波次",
      "dimension": "玩法",
      "excerpt": "Discover new towers and monsters as you embark on an adventure that will take you through 30 unique maps. Created by a small independent team, handcrafted with passion and precision. Artisan TD features no procedural statistics or computer-generated waves.",
      "url": "https://store.steampowered.com/app/2224640/",
      "label": "证据原文片段"
    },
    {
      "text": "把农场嵌入防御迷宫，以占用布局空间换取小型经济收益",
      "dimension": "玩法",
      "excerpt": "You'll be able to manage a small economy, taking the risk of integrating farms into your mazes.",
      "url": "https://store.steampowered.com/app/2224640/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "怪物细节过多，导致辨识度不足",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "monsters were a little too detailed making them less distinguishable",
          "url": "https://steamcommunity.com/id/quebecdragon/recommended/2224640/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "3D画面有吸引力。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Attractive 3d graphics",
          "url": "https://steamcommunity.com/id/quebecdragon/recommended/2224640/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "游戏对GPU的负载异常高",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The game is weirdly demanding for your GPU",
          "url": "https://steamcommunity.com/id/quebecdragon/recommended/2224640/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "关卡迫使玩家按固定时机、位置和塔型解题",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "只能在正确的时间在正确的位置摆上正确的塔",
          "url": "https://steamcommunity.com/id/Kaibutsu97/recommended/2224640/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "很多地图不按开发者意图摆放就会失败。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "any decision to use certain maze/tower layouts other than what the developers intended will lead to almost certain doom",
          "url": "https://steamcommunity.com/id/magusx777/recommended/2224640/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "玩法要求记忆固定序列",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "you’re memorising a sequence.",
          "url": "https://steamcommunity.com/id/eastpaw/recommended/2224640/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "缺乏跨地图可迁移的策略技能。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "No transferable skill between maps.",
          "url": "https://steamcommunity.com/id/eastpaw/recommended/2224640/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "低穿甲数值使装甲敌人处理痛苦。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "低到离谱的穿甲数值让人玩起来非常难受。",
          "url": "https://steamcommunity.com/id/Kaibutsu97/recommended/2224640/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "无伤通关容错几乎为零。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "想无伤通关基本没有容错",
          "url": "https://steamcommunity.com/id/Kaibutsu97/recommended/2224640/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "策略与塔选择限制过强。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "extremely restricting with its strategy and towers",
          "url": "https://steamcommunity.com/id/solsgon/recommended/2224640/",
          "label": "证据原文片段"
        }
      ]
    }
