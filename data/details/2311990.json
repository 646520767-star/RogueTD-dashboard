  "hooks": [
    {
      "text": "玩家本身就是台球，用物理击球把怪物球撞入球洞或关卡陷阱",
      "dimension": "玩法",
      "excerpt": "The roguelike dungeon crawler where you're a billiard ball! Push monster balls into holes or traps in randomly generated levels.",
      "url": "https://store.steampowered.com/app/2311990/",
      "label": "证据原文片段"
    },
    {
      "text": "关卡之间从一百多件可无限叠加的物品中选取，通过重复效果制造失衡Build",
      "dimension": "玩法",
      "excerpt": "Between levels, draft from a wide variety of 100+ items with game-changing effects (all of which are stackable) to find combos, build synergies and refine your playstyle !",
      "url": "https://store.steampowered.com/app/2311990/",
      "label": "证据原文片段"
    },
    {
      "text": "可选择二十至三十分钟的十层完整地牢、半层数高战利品Delve或单层随机装备突袭",
      "dimension": "玩法",
      "excerpt": "Play a full 10-level dungeon crawl in 20-30 minutes , or choose the condensed Delve Mode with half the levels but extra loot, or tackle a single-level raid with random items.",
      "url": "https://store.steampowered.com/app/2311990/",
      "label": "证据原文片段"
    }
