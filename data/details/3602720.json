  "hooks": [
    {
      "text": "最多六人在线合作，利用全物理物件与流畅移动抢钱并逃离The Grind。",
      "dimension": "玩法",
      "excerpt": "An online co-op horror game with up to 6 players. Use fully physics-based objects and fluid movement to grab some cash and escape The Grind.",
      "url": "https://store.steampowered.com/app/3602720/",
      "label": "证据原文片段"
    },
    {
      "text": "深入设施能获得更多现金，但失败损失也同步上升，所得资金用于装备和角色成长。",
      "dimension": "玩法",
      "excerpt": "The deeper you go into The Grind the more you stand to gain - and the more likely you are to lose. Use cash to customize your grabba, buy items and ensure you’ve got what you need to get out in the green.",
      "url": "https://store.steampowered.com/app/3602720/",
      "label": "证据原文片段"
    },
    {
      "text": "合作撤离后还要协商如何分钱，队友关系可能因分赃转为竞争。",
      "dimension": "玩法",
      "excerpt": "When all’s said and done, how’ll you split up the cash? Do your best to make sure negotiations don’t go sideways - or make sure you’re the one who comes out on top.",
      "url": "https://store.steampowered.com/app/3602720/",
      "label": "证据原文片段"
    }
  ],
