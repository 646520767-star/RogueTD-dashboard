  "hooks": [
    {
      "text": "把肉鸽牌组构筑与快节奏塔防合成同一套战斗循环",
      "dimension": "玩法",
      "excerpt": "Cubic Cosmos combines roguelike deck building with fast-paced tower defense gameplay.",
      "url": "https://store.steampowered.com/app/3332600/",
      "label": "证据原文片段"
    },
    {
      "text": "组合棋子触发团队协同与长连招，可一击清空整片战场",
      "dimension": "玩法",
      "excerpt": "Team up pawns to unlock incredible synergies and clear whole battlefields in a single shot!",
      "url": "https://store.steampowered.com/app/3332600/",
      "label": "证据原文片段"
    },
    {
      "text": "十二名三职业英雄、两百四十余张卡牌与五十余件遗物扩展构筑空间",
      "dimension": "玩法",
      "excerpt": "Clear runs to unlock 12 different heroes across 3 classes with unique abilities. With 240+ cards, create lethal combinations that are unique to you! Explore unique effect combos with 50+ equippable Relics.",
      "url": "https://store.steampowered.com/app/3332600/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
