          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "前三章难度几乎无法区分，缺少有效挑战曲线。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "难度1-8肉眼可见的分辨不出。",
          "url": "https://steamcommunity.com/profiles/76561198955340110/recommended/3332600/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "构筑刚成型时一局就接近结束，爽感展开不足。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "后面2 3层刚刚成型，想爽一爽，结果这一把就快结束了。",
          "url": "https://steamcommunity.com/profiles/76561198196527422/recommended/3332600/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "重复游玩性低，约十小时后内容很快耗尽。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "所以本作可重复游玩性极低，寿命很短。",
          "url": "https://steamcommunity.com/profiles/76561198955340110/recommended/3332600/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "每局第一层卡牌重复，爬升过程折磨。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "每一把第一层都是那几个卡，艰难爬完第一层",
          "url": "https://steamcommunity.com/profiles/76561198196527422/recommended/3332600/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "高难下多数英雄构筑需要多次重开并依赖极佳开局。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "七成以上的英雄BD都要至少重开十几次后的天胡局才勉强能过第二层。",
          "url": "https://steamcommunity.com/profiles/76561199040001350/recommended/3332600/",
          "label": "证据原文片段"
        }
      ]
    },
