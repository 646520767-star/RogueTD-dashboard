  "hooks": [
    {
      "text": "用100多种防御设施和300多条升级路线拼出机械鸡防线",
      "dimension": "玩法",
      "excerpt": "Diverse Cluckmechs, endless combinations. Unleash your creativity with over 100 defensive structures and 300+ upgrade paths!",
      "url": "https://store.steampowered.com/app/2453360/",
      "label": "证据原文片段"
    },
    {
      "text": "从重火力战斗鸡到布置陷阱的肌肉鼠，每名动物英雄打法不同",
      "dimension": "玩法",
      "excerpt": "From the firepower of the Warcluck to the trap-laying expertise of the Mouscle, each Character has unique skills and tactics.",
      "url": "https://store.steampowered.com/app/2453360/",
      "label": "证据原文片段"
    },
    {
      "text": "基地和防御设施可自由落位，亲手规划敌人的行进路线",
      "dimension": "玩法",
      "excerpt": "Enjoy complete freedom to place your defenses and base anywhere on the map. Strategically plan your enemy's route and build your defenses accordingly.",
      "url": "https://store.steampowered.com/app/2453360/",
      "label": "证据原文片段"
    }
  ],
