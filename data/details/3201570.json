  "hooks": [
    {
      "text": "VR中左手掌舵、右手控帆，用双手配合直接驾驭风力和船向",
      "dimension": "玩法",
      "excerpt": "The operation of sailboats in the game is not so complicated. Just control the rudder with your left hand and the sail with your right hand to flexibly control the sailboat and enjoy the pleasure of riding the wind and waves.",
      "url": "https://store.steampowered.com/app/3201570/",
      "label": "证据原文片段"
    },
    {
      "text": "既可沿固定航线竞赛，也能自由寻宝，每次变化的风向会重写航行策略",
      "dimension": "玩法",
      "excerpt": "Here, you can participate in sailing competitions along a fixed route, or embark on treasure hunting adventures at will. The wind direction is different every time, which can bring more fun and freshness.",
      "url": "https://store.steampowered.com/app/3201570/",
      "label": "证据原文片段"
    },
    {
      "text": "物理帆船模拟真实海浪，单条赛道会连续经历顺风、逆风与侧风阶段",
      "dimension": "玩法",
      "excerpt": "■Realistic ocean wave effects ■A fully physics based sailing experience ■Each competition route will go through stages of downwind, headwind, and crosswind",
      "url": "https://store.steampowered.com/app/3201570/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "画面仅达到预算价位的尚可水平。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The visuals are okay for this budget price.",
          "url": "https://steamcommunity.com/id/FastLawyer/recommended/3201570/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "声音内容几乎只有海浪声，令人失望。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The sounds are pretty much just the ocean wave sounds, which was disappointing.",
          "url": "https://steamcommunity.com/id/FastLawyer/recommended/3201570/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "海面效果真实且不错。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "这个海的效果还挺真实的，还不错哦",
          "url": "https://steamcommunity.com/profiles/76561198777145517/recommended/3201570/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "船帆控制较难掌握，导致体验无聊。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "too difficult to catch the right control with a sail. So it's boring.",
          "url": "https://store.steampowered.com/curator/32247615-VR-Goldgrabbers/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "比赛中船会无故偏离航线。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "my sail boat would be knocked off course, like in a collision, but without seeing what hit me.",
          "url": "https://steamcommunity.com/id/FastLawyer/recommended/3201570/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "体验可能显得漫无目的。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "make the game feel aimless",
          "url": "https://steamcommunity.com/id/xxadonisxx/recommended/3201570/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "玩家操作与船只反馈不一致。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the feedback between player actions and the boat’s response is not always consistent.",
          "url": "https://steamcommunity.com/id/xxadonisxx/recommended/3201570/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "环境缺少变化且容易显得静态。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "this lack of variety can make the world feel static",
          "url": "https://steamcommunity.com/id/xxadonisxx/recommended/3201570/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "控制方式过于基础并削弱沉浸感。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The controls are just too basic and they really bring down the immersion",
          "url": "https://steamcommunity.com/id/FastLawyer/recommended/3201570/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "整体游戏有趣且物有所值。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "found it quite fun. I like it! I feel like it's worth it.",
          "url": "https://steamcommunity.com/profiles/76561198704229157/recommended/3201570/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
