  "hooks": [
    {
      "text": "每次开局都会在本机生成一张全新的64平方公里荒野",
      "dimension": "玩法",
      "excerpt": "A brand new 64km2 world is generated on your PC every time you start the game.",
      "url": "https://store.steampowered.com/app/2943740/",
      "label": "证据原文片段"
    },
    {
      "text": "雨水会浸湿衣物和篝火，雷暴破坏地形，暴雪带来失温风险",
      "dimension": "玩法",
      "excerpt": "Rain can soak your clothes and drench your fires. Thunderstorms can wreak havoc on the terrain. Blizzards bring snow and the danger of hypothermia.",
      "url": "https://store.steampowered.com/app/2943740/",
      "label": "证据原文片段"
    },
    {
      "text": "没有任务标记或小地图，只能依靠地图、指南针、天空与地形辨认方向",
      "dimension": "玩法",
      "excerpt": "No guides. No markers telling you where to go next. Just your instincts, your tools, and your choices. You will need to read your map, use your compass, keep an eye on the sky, and adapt to the terrain and the weather if you want to survive.",
      "url": "https://store.steampowered.com/app/2943740/",
      "label": "证据原文片段"
    }
  ],
