  "hooks": [
    {
      "text": "上帝用左轮解决不平等、再把枪械与炸药交给教会的荒诞宗教讽刺",
      "dimension": "题材",
      "excerpt": "When the Revolver is not equal enough, He invested the Holy Church, Granting them all the Firearms, Dynamites and Service lines. Since then, Whenever the world suffer, He can just turn off the phone and pretend to be dead.",
      "url": "https://store.steampowered.com/app/1153150/",
      "label": "证据原文片段"
    },
    {
      "text": "战斗修女在千敌围城中坚持十五分钟，靠随机特长与道具即时成型",
      "dimension": "玩法",
      "excerpt": "As the Battle Sister of Holy Church, Sweep out your enemies with Various guns and abilities! Survive 15 minutes in the siege of thousand enemies. Build character from random perks & items.. and curse the game when you got bad luck.",
      "url": "https://store.steampowered.com/app/1153150/",
      "label": "证据原文片段"
    },
    {
      "text": "十二种以上基础枪械各带特长与升级，首领固定在第5、10、15分钟出现",
      "dimension": "玩法",
      "excerpt": "More than 12 basic guns with unique perks and upgrades.. Some of them are just weak anyway. Meet the random bosses at the 5th, 10th and 15th minute.. Help them get a new life!",
      "url": "https://store.steampowered.com/app/1153150/",
      "label": "证据原文片段"
    }
  ],
