  "hooks": [
    {
      "text": "收集漫画分镜并把它们排进页面，分镜摆放顺序直接生成当回合行动序列。",
      "dimension": "玩法",
      "excerpt": "Collect manga “panels” and arrange them on a page to fight! Each turn, you receive new panels. Placing them on the page creates your action sequence. Place panels according to the situation, build the ultimate page, and defeat your enemies!",
      "url": "https://store.steampowered.com/app/3187880/",
      "label": "证据原文片段"
    },
    {
      "text": "战斗受伤会在页面留下无法放置分镜的破洞，必须在回合限制内绕开版面损伤完成击杀。",
      "dimension": "玩法",
      "excerpt": "Damage during battles is represented as holes in the page. You cannot place panels in areas where there are holes. Carefully evaluate each situation and defeat all enemies within the turn limit!",
      "url": "https://store.steampowered.com/app/3187880/",
      "label": "证据原文片段"
    },
    {
      "text": "三名角色分别以枪械近战、机动作战、陷阱与子弹形成差异化解题风格。",
      "dimension": "玩法",
      "excerpt": "Experience three unique characters, each with their own style: Akira – A genius hitman who masters gunfire and melee. Yoko – Akira’s partner who uses mobile attacks to outsmart enemies. Suzuki – A cold-blooded assassin who uses traps and bullets to defeat enemies.",
      "url": "https://store.steampowered.com/app/3187880/",
      "label": "证据原文片段"
    }
  ],
