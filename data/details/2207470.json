  "hooks": [
    {
      "text": "守住法力水晶，并用召唤法术围绕水晶搭建火山炮台与精灵巢穴",
      "dimension": "玩法",
      "excerpt": "Huge crystals rising from the ground are your source of mana. Protect them and (optionally, if your build includes such spells) build your base around them with spells that summon different types of buildings - mini volcanoes that bombard enemies from afar, or spirit dwellings that spawn powerful sprites to fight for you.",
      "url": "https://store.steampowered.com/app/2207470/",
      "label": "证据原文片段"
    },
    {
      "text": "世界遭受的机器腐化越少，关卡结算奖励越丰厚",
      "dimension": "玩法",
      "excerpt": "Reap as many rewards as you can - the less corruption your world has suffered, the more rewards you will receive!",
      "url": "https://store.steampowered.com/app/2207470/",
      "label": "证据原文片段"
    },
    {
      "text": "自选核心法术、附加能力并升级属性，动态组建专属法术书",
      "dimension": "玩法",
      "excerpt": "Dynamic spellbook creation: Choose core spells, add powers to them, and upgrade their properties to create a unique spellbook. Pick powers that complement each other and quickly eliminate your enemies to limit the amount of corruption they can spread across the world.",
      "url": "https://store.steampowered.com/app/2207470/",
      "label": "证据原文片段"
    }
