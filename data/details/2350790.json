  "hooks": [
    {
      "text": "规划地牢路线并整理背包，使深入探索收益最大化",
      "dimension": "玩法",
      "excerpt": "Trust your adventurer instincts to plot a clever route, then carefully arrange your loot to maximize profits. Remember: the further you delve, the greater the rewards. How far will you dare to go?",
      "url": "https://store.steampowered.com/app/2350790/",
      "label": "证据原文片段"
    },
    {
      "text": "观察顾客、自主定价，并借事件与特性叠加销售势能",
      "dimension": "玩法",
      "excerpt": "Deck out the shop, read your customers, and set your own price to score the perfect deal. Cash in on special events while unlocking perks to build sales momentum. Battered scrap or shiny relic, their value isn’t fixed; it’s decided by you!",
      "url": "https://store.steampowered.com/app/2350790/",
      "label": "证据原文片段"
    },
    {
      "text": "投资村民设施获得装备升级，并反向吸引新顾客",
      "dimension": "玩法",
      "excerpt": "Invest in the townsfolks’ establishments to obtain better weapons, armor, and upgrades. As the village thrives and grows more vibrant, new people (and money!) will be drawn towards your shop.",
      "url": "https://store.steampowered.com/app/2350790/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
