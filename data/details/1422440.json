  "hooks": [
    {
      "text": "用模块化零件和预制蓝图逐块搭建自由堡垒",
      "dimension": "玩法",
      "excerpt": "A highly modular building system allows you to design your fortresses exactly as you desire – one piece at a time, with blueprints you have designed in advance, or using community creations shared by other players.",
      "url": "https://store.steampowered.com/app/1422440/",
      "label": "证据原文片段"
    },
    {
      "text": "利用承重结构坍塌同时威胁敌我并制造大规模压杀机会",
      "dimension": "玩法",
      "excerpt": "Keep an eye on structural integrity and load-bearing columns as falling pieces will kill friend and foe alike, often creating unique opportunities to crush numerous enemies with cleverly placed vulnerabilities.",
      "url": "https://store.steampowered.com/app/1422440/",
      "label": "证据原文片段"
    },
    {
      "text": "白天探索扩建，入夜前布置兵力迎击恐魔浪潮",
      "dimension": "玩法",
      "excerpt": "Spend your days exploring the world and pursuing the growth of your fortress, but as the sun starts to set, you would be wise to position your forces in preparation for the night’s onslaught.",
      "url": "https://store.steampowered.com/app/1422440/",
      "label": "证据原文片段"
    }
  ],
