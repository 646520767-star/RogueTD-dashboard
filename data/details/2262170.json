  "hooks": [
    {
      "text": "献祭身体部位会增加机制与难度，也可积累压力反转为新能力",
      "dimension": "玩法",
      "excerpt": "Each body part sacrificed will add new mechanics and will change the game in a meaningful way. Each sacrifice will increase your stress level, with enough stress you can reverse a sacrifice to gain a new ability instead.",
      "url": "https://store.steampowered.com/app/2262170/",
      "label": "证据原文片段"
    },
    {
      "text": "额外奖励竞技场会用特殊规则强迫玩家改变打法",
      "dimension": "玩法",
      "excerpt": "In some arenas you can figh for additional rewards. In such cases, enemies will spawn with a special rule-set, forcing you to strategize and change your play style to complete the rule objective.",
      "url": "https://store.steampowered.com/app/2262170/",
      "label": "证据原文片段"
    },
    {
      "text": "武器可改变地图，血液枪以生命作弹药并惩罚失误",
      "dimension": "玩法",
      "excerpt": "Each weapon provides a unique gameplay experience, some can even alter the maps themselves. The gun selection ranges from a simple revolver to a demented gun which consumes your blood for ammo and punishes you each time you miss.",
      "url": "https://store.steampowered.com/app/2262170/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "视觉设计对独立开发作品而言非常出色",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The visual design is honestly outstanding for a free game by a solo dev.",
          "url": "https://steamcommunity.com/profiles/76561199280599516/recommended/2262170/",
          "label": "证据原文片段"
        }
      ]
    },
