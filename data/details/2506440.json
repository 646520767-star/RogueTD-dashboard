  "hooks": [
    {
      "text": "五职业各带三棵专属天赋树，总计超过150项天赋支撑长期养成",
      "dimension": "玩法",
      "excerpt": "5 classes - play as a fighter, a priest, a sorcerer, a paladin, or a witch, each with 3 unique talent trees and 150+ talents in total.",
