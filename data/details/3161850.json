  "hooks": [
    {
      "text": "可任意上调或下调英雄、武器和技能的数值，用双向改造重写每局规则与构筑",
      "dimension": "玩法",
      "excerpt": "Boosting lets you increase or decrease any value of your hero, weapons and abilities, giving you complete freedom to reinterpret the game in new and exciting ways.",
      "url": "https://store.steampowered.com/app/3161850/",
      "label": "证据原文片段"
    },
    {
      "text": "十二种起始武器与法术继续叠加普通和传奇升级，传奇强化还会解锁新的改造方式",
      "dimension": "玩法",
      "excerpt": "12 unique starting weapons and spells. Tons of upgrades to them, but we don't want to spoil just how many. Even more legendary upgrades that give new ways to boost your hero.",
      "url": "https://store.steampowered.com/app/3161850/",
      "label": "证据原文片段"
    },
    {
      "text": "穿越敌群试炼抵达最终首领后，还能把生存成绩投入全球排行榜竞争",
      "dimension": "玩法",
      "excerpt": "An intimidating gauntlet of enemies on your journey to the final boss. A global Leaderboard to compete for the spot of top survivor.",
      "url": "https://store.steampowered.com/app/3161850/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "酸液池视觉不像酸液且难以发现。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Acid pool does not look like acid, i could barely tell it existed",
          "url": "https://steamcommunity.com/id/NaClFueled/recommended/3161850/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "部分图形表现过于粗糙。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "quite a bit of graphics are simply too primitive",
          "url": "https://steamcommunity.com/id/SemyonTheGreat/recommended/3161850/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "键鼠移动体验很差。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the movement is horrible on MnK",
          "url": "https://steamcommunity.com/id/NaClFueled/recommended/3161850/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "闪避移动仍显得卡顿。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "movement jank on dodges",
          "url": "https://steamcommunity.com/id/NaClFueled/recommended/3161850/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "死亡原因缺乏说明。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "I can't see how I died in multiple runs",
          "url": "https://steamcommunity.com/profiles/76561198087690287/recommended/3161850/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "获得目标增强过度依赖运气。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "too much luck regarding if you get the boosts you want",
          "url": "https://steamcommunity.com/id/zurreco/recommended/3161850/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "玩家碰撞箱位置异常。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the hitbox for the player character just... feels a bit off",
          "url": "https://steamcommunity.com/id/NaClFueled/recommended/3161850/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "属性与技能描述糟糕。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "terrible stat/skill descriptions",
          "url": "https://steamcommunity.com/id/zurreco/recommended/3161850/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "召唤流等玩法会出现明显卡顿。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Last update really made some gameplays lag (speccialy summon builds).",
          "url": "https://steamcommunity.com/profiles/76561198038161253/recommended/3161850/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "冲刺进入敌人后可能被卡住。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "enemies getting stuck in your character if you dash into them",
          "url": "https://steamcommunity.com/id/NaClFueled/recommended/3161850/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "特效叠加可能严重降低帧率。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
