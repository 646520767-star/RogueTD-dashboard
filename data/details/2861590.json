  "hooks": [
    {
      "text": "人格被保存进意识模块后困在金属躯壳，驾驶探测车寻找灾变真相",
      "dimension": "故事",
      "excerpt": "After your ship crashed, your personality was preserved in a special consciousness module thanks to an experimental programme, but you remain a prisoner of the metal shell. Use the rovers to survive, reconnect with the orbital station, and solve the mysteries of the catastrophe that changed everything.",
      "url": "https://store.steampowered.com/app/2861590/",
      "label": "证据原文片段"
    },
    {
      "text": "用不同模块改造探测车，让同一载具适配采矿或战斗任务",
      "dimension": "玩法",
      "excerpt": "Make weapons, modules and equipment from the resources you gather to upgrade your machines and fortify your base. Build and modify rovers with the help of various modules that you can adapt for different tasks, from mining to fighting.",
      "url": "https://store.steampowered.com/app/2861590/",
      "label": "证据原文片段"
    },
    {
      "text": "给运输探测车分配采集、建造和防御职责，把重复作业自动化",
      "dimension": "玩法",
      "excerpt": "Assign transport rovers to resource gathering, construction, and defence tasks. Plan actions and appoint roles to machines to focus on strategy.",
      "url": "https://store.steampowered.com/app/2861590/",
      "label": "证据原文片段"
    }
