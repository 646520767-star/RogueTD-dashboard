  "hooks": [
    {
      "text": "每个地形像素都参与沙土与流体模拟，可改造地貌借重力反制异形液体",
      "dimension": "玩法",
      "excerpt": "In Creeper World IXE you will liberate and explore hundreds of worlds in this real-time strategy game where the enemy is a fluid and every pixel of the terrain is simulated. Terraform through dozens of terrain types to use gravity and nature against the enemy.",
      "url": "https://store.steampowered.com/app/2257010/",
      "label": "证据原文片段"
    },
    {
      "text": "单靠火力无法根除Creeper，必须摧毁发生器并同时激活星球全部IXE核心",
      "dimension": "玩法",
      "excerpt": "The only way to stop the creeper is to find and destroy the emitters and destroy the IXE Cores on each planet. Only by finding all of the cores and activating them simultaneously will The Creeper be destroyed and the planet saved.",
      "url": "https://store.steampowered.com/app/2257010/",
      "label": "证据原文片段"
    },
    {
      "text": "内置RPL脚本支持自制单位、任务与控制模块并分享给社区",
      "dimension": "玩法",
      "excerpt": "Create and play custom maps with new and original units made by the community or yourself! 2D-pixel graphics are married with a detailed and robust custom map and unit creation system, so nearly anyone with an idea can make a unit or a mission and share it with others. Use built-in control modules, or craft your own with robust built-in RPL scripting.",
      "url": "https://store.steampowered.com/app/2257010/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "像素视觉被认为缺乏价值。",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "pixelshït garbage",
          "url": "https://store.steampowered.com/curator/28898588-True-Game-Truths/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "核心战斗与旧作相比变化有限。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the core aspects of combat are the same as always",
          "url": "https://steamcommunity.com/id/FruitNDoggie/recommended/2257010",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "系统预设舰船与解法，偏离系列核心。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The game deciding what ships you have and how you approach the issue is not the creeper core.",
          "url": "https://steamcommunity.com/profiles/76561198386189957/recommended/2257010/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "推进过程需要长时间等待，体验无聊。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "ages and ages of staring at the screen slowly waiting",
          "url": "https://steamcommunity.com/profiles/76561197999529427/recommended/2257010/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "不如系列前作好玩。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "确实不如前几作好玩",
          "url": "https://steamcommunity.com/id/JC_Chen/recommended/2257010/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "每张地图接近只有一种解法。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "there is really only 1 solution the game wants you to implement",
          "url": "https://steamcommunity.com/profiles/76561197999529427/recommended/2257010/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "每关流程变成选项有限的重复刷取。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "this game is just a grind every level, with very limited options",
          "url": "https://steamcommunity.com/profiles/76561198799662808/recommended/2257010/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "流体机制独特，挑战性与回报感兼具。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "a unique fluid-based mechanic. It’s challenging yet rewarding",
          "url": "https://store.steampowered.com/curator/45298661-Thumb-Tactics/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "系列持续提供有挑战且有趣的时刻。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "You gave me so many challenging and fun moments.",
          "url": "https://steamcommunity.com/id/pozoro/recommended/2257010/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "A+B合成机制具有进一步开发潜力。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "新加的“A+B得到C”的合成功能感觉有可以开发的地方",
          "url": "https://steamcommunity.com/id/JC_Chen/recommended/2257010/",
          "label": "证据原文片段"
        }
      ]
    }
