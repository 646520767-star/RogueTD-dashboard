  "hooks": [
    {
      "text": "最多六名送货哥布林跨平台协作，在队友被逐个猎杀前完成矿井派送",
      "dimension": "玩法",
      "excerpt": "Team up with up to 5 other players in online co-op (crossplay supported). Coordinate, deliver, and survive - or watch your coworkers get picked off one by one.",
      "url": "https://store.steampowered.com/app/3743090/",
      "label": "证据原文片段"
    },
    {
      "text": "物理VR世界叠加空间音频和近距离语音，可搬包裹、叠人甚至互相拍打",
      "dimension": "玩法",
      "excerpt": "Built for VR with a physics based world, spatial audio, and proximity voice chat. Haul a variety of parcels, climb on other players or give them a slap of encouragement",
      "url": "https://store.steampowered.com/app/3743090/",
      "label": "证据原文片段"
    },
    {
      "text": "部分怪物会伪装成队友并模仿其行为，必须识别模式或把同伴当诱饵",
      "dimension": "玩法",
      "excerpt": "Face off against terrifying entities, some may even look and act like your teammates. Learn their patterns - or feed them your friends.",
      "url": "https://store.steampowered.com/app/3743090/",
      "label": "证据原文片段"
    }
