  "hooks": [
    {
      "text": "没有枪械、魔法或刀剑，唯一需要掌握的武器是一颗未来感十足的致命足球。",
      "dimension": "玩法",
      "excerpt": "Instead of guns, magic or swords you have only one weapon to master: your futuristic ball of death.",
      "url": "https://store.steampowered.com/app/2206240/",
      "label": "证据原文片段"
    },
    {
      "text": "精准控球要结合房间角度、空间布局与不同敌人的行为，把环境本身转化为攻击路线。",
      "dimension": "玩法",
      "excerpt": "Leverage the angles and layout of the rooms as well as the behavior of the different enemy types to create a barrage of violence.",
      "url": "https://store.steampowered.com/app/2206240/",
      "label": "证据原文片段"
    },
    {
      "text": "可解锁的多名角色和多种独特球体，让每次跑局都能尝试不同构筑与操控流派。",
      "dimension": "玩法",
      "excerpt": "With a variety of different, unlockable characters as well as a multitude of unique balls, each run you will find many builds and different playstyles to experiment with.",
      "url": "https://store.steampowered.com/app/2206240/",
      "label": "证据原文片段"
    }
  ],
