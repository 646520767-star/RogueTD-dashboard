  "hooks": [
    {
      "text": "重建13人星际亡命帮，每人都有专属武器、特技与成长树",
      "dimension": "玩法",
      "excerpt": "Wild Bastards has you travel from planet to planet to recruit, manage and gun sling with a team of 13 outlaws, each of whom has their own weaponry, special power, and growth tree.",
      "url": "https://store.steampowered.com/app/1660840/",
      "label": "证据原文片段"
    },
    {
      "text": "帮派成员会结仇，出战前还得先处理人际关系",
      "dimension": "故事",
      "excerpt": "The gang know each other well, but that doesn’t mean they like each other. It’s your job to manage their dynamic relationships, but good luck getting feuding outlaws to ride together.",
      "url": "https://store.steampowered.com/app/1660840/",
      "label": "证据原文片段"
    },
    {
      "text": "先勘察星球地形、敌人与特性，再挑对应亡命徒落地",
      "dimension": "玩法",
      "excerpt": "Evaluate each planet’s terrain, enemies, and traits before selecting which gang members you want to land there. Collect items, level up, and use special locations carefully to turn the odds in your favor!",
      "url": "https://store.steampowered.com/app/1660840/",
      "label": "证据原文片段"
    }
  ],
