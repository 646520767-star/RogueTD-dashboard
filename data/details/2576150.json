  "hooks": [
    {
      "text": "死亡丢身体，脊柱能力永久保留",
      "dimension": "玩法",
      "excerpt": "In this hellish environment, death means losing not only the items you’re carrying, but even your own Body. But all hope is not lost. Mastery abilities are etched into your very Spine, permanently growing and never taken away.",
      "url": "https://store.steampowered.com/app/2576150/",
      "label": "证据原文片段"
    },
    {
      "text": "左右手双武器破防接高冲击处决",
      "dimension": "玩法",
      "excerpt": "Switch between left and right weapons depending on the situation, or wield both simultaneously to perform a powerful guard break. When an enemy’s guard is shattered and they’re left vulnerable, unleash a flashy, high-impact deathblow to finish them off!",
      "url": "https://store.steampowered.com/app/2576150/",
      "label": "证据原文片段"
    },
    {
      "text": "限时轮回重置会刷新装备、敌人与场景",
      "dimension": "玩法",
      "excerpt": "The trial has a set time limit, and when it expires, the entire world undergoes reincarnation. In other words, it resets. What happens when the world resets? A new one emerges! Each new world may bring unseen equipment, enemies, and fields.",
      "url": "https://store.steampowered.com/app/2576150/",
      "label": "证据原文片段"
    }
  ],
