  "hooks": [
    {
      "text": "在超越时间的图书馆中修补克苏鲁世界的破碎时间线",
      "dimension": "故事",
      "excerpt": "\"Depersonalization\" is a role-playing game based on the Cthulhu Mythos. In the game, you will find yourself in a timeless library beyond the river of time.",
      "url": "https://store.steampowered.com/app/1477070/",
      "label": "证据原文片段"
    },
    {
      "text": "像跑团调查员一样搜集线索、掷骰检定并逼近真相",
      "dimension": "玩法",
      "excerpt": "In each module, you will play as an investigator, collecting clues, rolling dice for success in checks, triggering events, and gradually approaching (or distancing yourself from) the truth of the story.",
      "url": "https://store.steampowered.com/app/1477070/",
      "label": "证据原文片段"
    },
    {
      "text": "用内置故事编辑器创作并发布自己的模组",
      "dimension": "玩法",
      "excerpt": "The game features a powerful story editor, allowing creators the freedom to craft all content within the game.",
      "url": "https://store.steampowered.com/app/1477070/",
      "label": "证据原文片段"
    }
  ],
