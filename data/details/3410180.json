  "hooks": [
    {
      "text": "装备属于不同套装，凑齐规定件数即可解锁独特套装加成",
      "dimension": "玩法",
      "excerpt": "Looting equipment will be your main task. Each piece is part of a set and equipping enough pieces of a set will unlock unique bonuses.",
      "url": "https://store.steampowered.com/app/3410180/",
      "label": "证据原文片段"
    },
    {
      "text": "技能树每局重新变化，可能提供通用能力、直接增幅或突破特定构筑上限",
      "dimension": "玩法",
      "excerpt": "You will be able to acquire special skills from a tree that changes every game. Skills can offer you general utility, an increase in power or make one specific build go beyond its limits.",
      "url": "https://store.steampowered.com/app/3410180/",
      "label": "证据原文片段"
    },
    {
      "text": "每个区域终点都有具备专属能力的Boss，迫使沿途选择为终战服务",
      "dimension": "玩法",
      "excerpt": "At the end of each region a boss will try to stop you from completing your quest. This powerful enemies have special abilities and will test your strength, so make the right choices at every step of your journey to make sure no one will stand in your way!",
      "url": "https://store.steampowered.com/app/3410180/",
      "label": "证据原文片段"
    }
  ],
