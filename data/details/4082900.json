  "hooks": [
    {
      "text": "没有传统波次的短篇增量塔防，主打放松推进",
      "dimension": "玩法",
      "excerpt": "castle idler is a short, relaxing incremental tower defense game with no waves.",
      "url": "https://store.steampowered.com/app/4082900/",
      "label": "证据原文片段"
    },
    {
      "text": "沿蜿蜒路径部署多种塔并持续升级",
      "dimension": "玩法",
      "excerpt": "deploy a variety of towers along winding paths and continuously upgrade them.",
      "url": "https://store.steampowered.com/app/4082900/",
      "label": "证据原文片段"
    },
    {
      "text": "声望升级会让防御力量呈指数级增强",
      "dimension": "玩法",
      "excerpt": "unlock powerful prestige upgrades that make your defenses exponentially stronger.",
      "url": "https://store.steampowered.com/app/4082900/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "极简像素风清晰且协调。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "minimalist pixel art style that prioritizes clarity and charm",
          "url": "https://steamcommunity.com/id/xxadonisxx/recommended/4082900/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "每次进入新关卡都要重新部署塔，造成不必要重复操作。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "当你进入下一关之后就要对塔重新部署",
          "url": "https://steamcommunity.com/id/Nekonekon/recommended/4082900/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "增量成长缺少指数提升的满足感。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "几乎体验不到增量游戏那种“指数级成长”的快感",
          "url": "https://steamcommunity.com/id/Nekonekon/recommended/4082900/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "自动出怪与零部署时间让玩家来不及观察新地图。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "在你新到一张图、布局还没看清的情况下，怪已经开始冒尖了。",
          "url": "https://steamcommunity.com/id/Nekonekon/recommended/4082900/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "天赋树构筑简单粗暴，主要只有易伤和数值。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "实际天赋树的构筑也相当简单粗暴",
          "url": "https://steamcommunity.com/id/Nekonekon/recommended/4082900/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "索敌只能选择前后，容易导致防线失控。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "仅能选择前后的脑溢血索敌",
          "url": "https://steamcommunity.com/id/Nekonekon/recommended/4082900/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "通关后缺少重玩或无尽模式。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "an option to go back and play the levels all over after finishing the final one",
          "url": "https://steamcommunity.com/id/doktor-x/recommended/4082900/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "声望循环缺乏满足感",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The prestige loop is unsatisfying and the tower defense is very basic.",
          "url": "https://steamcommunity.com/profiles/76561197996181041/recommended/4082900/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "击杀后强制进入下一关，无法返回刷取。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "you are always forced to go the next level and can't go back",
          "url": "https://steamcommunity.com/id/diufool/recommended/4082900/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "后期生命成长迫使玩家依赖单一武器。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "meaning you have to use that one weapon",
          "url": "https://steamcommunity.com/id/diufool/recommended/4082900/",
          "label": "证据原文片段"
        }
      ]
    }
