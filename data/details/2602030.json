  "hooks": [
    {
      "text": "同时控制持剑机甲与神枪手太空青蛙，在反向弹幕战中让两个角色共同作战。",
      "dimension": "玩法",
      "excerpt": "A sword-wielding mech. A sharpshooting space frog. Control both characters simultaneously against the forces of Entropy in this reverse bullet hell roguelike.",
      "url": "https://store.steampowered.com/app/2602030/",
      "label": "证据原文片段"
    },
    {
      "text": "支持单人或在线合作，队友可围绕协同构筑并肩作战，也可竞争最高分。",
      "dimension": "玩法",
      "excerpt": "Play by yourself, or bring your friends along for a genre-bending online co-op experience! Become best buddies with synergetic builds or prove yourself champion in the contest for high score.",
      "url": "https://store.steampowered.com/app/2602030/",
      "label": "证据原文片段"
    },
    {
      "text": "空枪可直接掷向敌人，长矛能串烧目标，还有武装垃圾车和蜂群枪等荒诞武器。",
      "dimension": "玩法",
      "excerpt": "Is your shotgun out of ammo? Throw it at your enemies! Feeling hungry? Use your spear as a shish-kabob. Unlock dozens of customizable options to power up and create your own playstyle. From weaponized garbage trucks to a gun that shoots bees, Entropy Survivors is overflowing with unique weapons, abilities, and upgrades that’ll make you ask “What?”",
      "url": "https://store.steampowered.com/app/2602030/",
      "label": "证据原文片段"
    }
  ],
