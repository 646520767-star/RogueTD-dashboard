  "hooks": [
    {
      "text": "角色、贴纸、印章与消耗字块共同决定每局实验",
      "dimension": "玩法",
      "excerpt": "Each run is shaped by four pillars: your Character, your Sticker upgrades, your Stamp loadout and the consumable Tiles you bring into each fight.",
      "url": "https://store.steampowered.com/app/3856460/",
      "label": "证据原文片段"
    },
    {
      "text": "单词会逐渐崩坏成数字、棋子甚至无限虚空",
      "dimension": "题材",
      "excerpt": "Starts as Boggle, ends as Schrödinger - Cursed Words is a roguelike adventure about writing words... for a while…until words become NUM83R5, or ♔♘♙, or the i nfinite void.",
      "url": "https://store.steampowered.com/app/3856460/",
      "label": "证据原文片段"
    },
    {
      "text": "基础局五阶段每段两战一Boss，通关后王冠难度再改规则",
      "dimension": "玩法",
      "excerpt": "A base level run features five stages, each one with two encounters and a boss. Beat Stage 5 to win the run, then take on special Challenges and Crown difficulty tiers that redefine the rules and push your creativity.",
      "url": "https://store.steampowered.com/app/3856460/",
      "label": "证据原文片段"
    }
  ],
