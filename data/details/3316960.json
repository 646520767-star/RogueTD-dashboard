  "hooks": [
    {
      "text": "同时经营移动牌组与战斗牌组，用双牌组规划每一步",
      "dimension": "玩法",
      "excerpt": "Master two unique decks - one for movement and one for combat.",
      "url": "https://store.steampowered.com/app/3316960/",
      "label": "证据原文片段"
    },
    {
      "text": "用Relocate等位移卡调整站位，在牌局中绕开并智取敌人",
      "dimension": "玩法",
      "excerpt": "Use cards like Relocate to navigate the battlefield and outwit enemies.",
      "url": "https://store.steampowered.com/app/3316960/",
      "label": "证据原文片段"
    },
    {
      "text": "以金色与蓝色的集中配色呈现神圣与亵渎、光明与黑暗的对照",
      "dimension": "画风",
      "excerpt": "With a focused palette of gold and blue, the game immerses players in the stark contrasts that define its world, its Godwoken, and their enemies.",
      "url": "https://store.steampowered.com/app/3316960/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "战斗场景中的角色辨识度不足",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "每个角色都在六边形中，特别不是特别鲜明",
          "url": "https://steamcommunity.com/id/SHARK0222/recommended/3316960/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "立绘质量仍需提升",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "立绘如果能更好一点就非常不错了",
          "url": "https://steamcommunity.com/id/SHARK0222/recommended/3316960/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "动画卡牌与故事场景增强了氛围",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the animated cards/story scenes give it a nice atmosphere",
          "url": "https://steamcommunity.com/profiles/76561198716768878/recommended/3316960/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "通关后缺少再次挑战的意愿",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "打完后，让玩家觉得没有再次挑战的意向",
          "url": "https://steamcommunity.com/id/SHARK0222/recommended/3316960/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "流程约三至五小时，过短",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The game can be completed in about three to five hours. On top of that, it's very easy and offers little to no challenge.",
          "url": "https://steamcommunity.com/profiles/76561197979642016/recommended/3316960/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "游戏很容易，几乎没有挑战",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The game can be completed in about three to five hours. On top of that, it's very easy and offers little to no challenge.",
          "url": "https://steamcommunity.com/profiles/76561197979642016/recommended/3316960/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "敌人AI表现很差",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The AI is simply bad.",
          "url": "https://steamcommunity.com/profiles/76561197979642016/recommended/3316960/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "无法获得本局已赚取的奖励和经验",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "You don't receive the rewards or experience (XP) you've earned.",
          "url": "https://steamcommunity.com/profiles/76561197979642016/recommended/3316960/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "卡牌同时用于移动与攻击，使玩家持续权衡站位和牌组",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "you use cards to move around the map and to do attacks so you are always thinking both about positioning and using your deck correctly",
          "url": "https://steamcommunity.com/profiles/76561198062140377/recommended/3316960/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "六边形地图、移动卡和站位让战斗更有趣",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The hex map, movement cards, and positioning make fights more interesting.",
          "url": "https://steamcommunity.com/profiles/76561198716768878/recommended/3316960/",
          "label": "证据原文片段"
        }
      ]
    }
