  "hooks": [
    {
      "text": "从荒地白手建设聚落，并随进度逐步解锁新建筑和作战单位，把边疆发展成城镇",
      "dimension": "玩法",
      "excerpt": "Transform barren lands into bustling settlements! Start with basic structures and gradually unlock new buildings and units as you progress.",
      "url": "https://store.steampowered.com/app/2346410/",
      "label": "证据原文片段"
    },
    {
      "text": "从两百多张卡牌中构筑城建牌组，出牌时机直接影响应对危机和建设效率",
      "dimension": "玩法",
      "excerpt": "Choose from over 200 unique cards to construct your perfect deck. Use your cards with skill and timing to overcome challenges and build your town efficiently.",
      "url": "https://store.steampowered.com/app/2346410/",
      "label": "证据原文片段"
    },
    {
      "text": "每个月末敌军都会进攻亲手建成的城镇，必须提前加固防线应对逐月增强的波次",
      "dimension": "玩法",
      "excerpt": "At the end of each month, enemies will attempt to destroy the town you so carefully built! Fortify your defenses and repel increasingly powerful waves of attackers!",
      "url": "https://store.steampowered.com/app/2346410/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "视觉表现比同类参考更有吸引力。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "I found this more fun and visually compelling.",
          "url": "https://steamcommunity.com/id/Zubon/recommended/2346410/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "自然阵营明显强于王国阵营",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "自然比王国强太多了很多强牌还是通用的，卡牌太少了",
          "url": "https://steamcommunity.com/profiles/76561198352362538/recommended/2346410/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "每轮反复做同一件事，变化很少",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "you will be doing the same thing every single round with very little to no variation.",
          "url": "https://steamcommunity.com/id/EEE69420/recommended/2346410/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "后期几关流程较固定",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "不过这个游戏到后面几关流程就比较固定了",
          "url": "https://steamcommunity.com/profiles/76561198309965495/recommended/2346410/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "地图未在开局完全揭示，中途才告知另一侧也会出怪",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "一开始开图不开全，打到一半开图告诉你另一边也出怪",
          "url": "https://steamcommunity.com/profiles/76561198971630202/recommended/2346410/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "友军AI经常做出送死行为",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Your units are especially suicidal",
          "url": "https://steamcommunity.com/id/EEE69420/recommended/2346410/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "挑战类型多样，为战斗增加思考和动态变化。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "a nice variety of challenges which add an intellectual component and help with dynamic battles.",
          "url": "https://store.steampowered.com/curator/44992038-General-Gamers-Playground/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "用城墙改变怪物路线是较有策略性的环节",
