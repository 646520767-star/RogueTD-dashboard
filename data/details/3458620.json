  "hooks": [
    {
      "text": "每次轮回都从人生道路选择展开，不同抉择会通向不同的修仙经历与仙缘路线。",
      "dimension": "故事",
      "excerpt": "在这个传统又带点梗的修仙背景下，你将从出生开始就要抉择你的人生道路，不同的选择或许会让你走上不一样的修仙人生，面对罕见的仙缘奇遇到底能否抓住机会？",
      "url": "https://store.steampowered.com/app/3458620/",
      "label": "证据原文片段"
    },
    {
      "text": "上百种五行法术可按成长方向安排上阵与释放顺序，再搭配丹药和法器形成流派。",
      "dimension": "玩法",
      "excerpt": "在修炼途中，我们提供了上百种五行属性的法术可以修习，你可以根据自己的成长方向，合理安排法术的上阵以及释放顺序，搭配各种仙丹和法器神通，以最强的姿态面对宿敌之战！",
      "url": "https://store.steampowered.com/app/3458620/",
      "label": "证据原文片段"
    },
    {
      "text": "死亡后以轮回点强化下一世初始属性，并可重置天赋与灵根重新规划成长。",
      "dimension": "玩法",
      "excerpt": "每次轮回都能使用轮回点提升自身初始属性，也能重置初始天赋和灵根，带着上一世的记忆选择正确的道路，开启你的修仙开挂人生，逆天改命！",
      "url": "https://store.steampowered.com/app/3458620/",
      "label": "证据原文片段"
    }
  ],
