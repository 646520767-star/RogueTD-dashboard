  "hooks": [
    {
      "text": "用全局冷却、技能时机、装备效果和团队机制处理，浓缩复刻高难MMO团本。",
      "dimension": "玩法",
      "excerpt": "Combat is deliberately similar to tab-target MMORPGs, being based around global cooldowns, effective skill usage, gear effects, and resolving boss mechanics through teamwork.",
      "url": "https://store.steampowered.com/app/2132850/",
      "label": "证据原文片段"
    },
    {
      "text": "1至4只兔子可共同出征，单人时原本需要协作的机制会替换成高强度弹幕。",
      "dimension": "玩法",
      "excerpt": "Anywhere from 1 to 4 rabbits can embark together. If you venture out alone, mechanics that normally require cooperation will be replaced with intense bullet hell attacks.",
      "url": "https://store.steampowered.com/app/2132850/",
      "label": "证据原文片段"
    },
    {
      "text": "随机战利品之间存在强力套装组合，还会制造队友争抢关键装备的团本趣味。",
      "dimension": "玩法",
      "excerpt": "Certain sets of items combo very well together... so make sure your allies don't roll on something you really need!",
      "url": "https://store.steampowered.com/app/2132850/",
      "label": "证据原文片段"
    }
  ],
