  "hooks": [
    {
      "text": "卡牌分别负责生产、资源、工事和军力，放置时机与位置共同决定王国发展。",
      "dimension": "玩法",
      "excerpt": "Your journey is guided by your collection of cards, each with a specific purpose. Some cards help you build crucial structures, like food production, resources, and fortifications. Others strengthen your military forces. Your leadership hinges on using these cards wisely, and choosing the right moments and places to play them.",
      "url": "https://store.steampowered.com/app/2655590/",
      "label": "证据原文片段"
    },
    {
      "text": "白昼发展后要以军队和城墙抵御持续黑暗带来的围城威胁。",
      "dimension": "玩法",
      "excerpt": "In this ever-changing kingdom, peace is a rare luxury, as the relentless darkness continually menaces your realm. Prepare your army for defense and construct impenetrable walls to repel the sieges.",
      "url": "https://store.steampowered.com/app/2655590/",
      "label": "证据原文片段"
    },
    {
      "text": "火焰、寒冰等元素法术卡可在战斗中直接扭转攻防局势。",
      "dimension": "玩法",
      "excerpt": "Unleash the elemental forces at your command with powerful spell cards. From fiery infernos to icy blasts, wield magic to turn the tides of battle in your favor.",
      "url": "https://store.steampowered.com/app/2655590/",
      "label": "证据原文片段"
    }
  ],
