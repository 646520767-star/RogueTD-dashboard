  "hooks": [
    {
      "text": "十二种以上士兵占用不同背包格数，有限空间中的排布直接决定防线强度",
      "dimension": "玩法",
      "excerpt": "With over 12 unique soldier types, you must strategically arrange your forces within a limited grid space—just like organizing a backpack—to fend off wave after wave of zombie attacks.",
      "url": "https://store.steampowered.com/app/4754260/",
      "label": "证据原文片段"
    },
    {
      "text": "开战后士兵自动形成密集弹幕，玩家通过资源分配、站位与技能组合维持防线",
      "dimension": "玩法",
      "excerpt": "When battle begins, your soldiers automatically attack, forming a dense bullet hell firing net. Zombies surge from the beach ahead. You must allocate resources, position your troops wisely, and combine their skills to ensure your line holds.",
      "url": "https://store.steampowered.com/app/4754260/",
      "label": "证据原文片段"
    },
    {
      "text": "失败仍保留战斗资源，用于开箱、升王与士兵，并在八档难度中收集碎片进化单位",
      "dimension": "玩法",
      "excerpt": "Can’t get past a wave? No problem! Every battle earns you resources → open chests → upgrade the King and your soldiers. The game features 8 difficulty levels: Earn soldier shards with each run Upgrade existing soldiers Unlock higher-tier units",
      "url": "https://store.steampowered.com/app/4754260/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "明亮多彩的画面增强了游玩乐趣",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The visuals are bright and colorful, which makes the gameplay even more enjoyable.",
          "url": "https://store.steampowered.com/curator/38771580-Escape-to-Game/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "可爱画风带来怀旧掌机感",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "画风可爱得简单小游戏，玩起来有一种童年拿那种老手机玩得感觉",
          "url": "https://steamcommunity.com/profiles/76561199178910465/recommended/4754260/",
          "label": "证据原文片段"
        }
      ]
    },
    {
