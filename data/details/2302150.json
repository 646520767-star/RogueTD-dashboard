  "hooks": [
    {
      "text": "持续让圆盘反弹既用于击败敌人，也会触发Relic力量并形成弹球式协同",
      "dimension": "玩法",
      "excerpt": "Juggle your disks to defeat your enemies as you progress through the circles of hell and confront relentless demonic bosses. In each run, acquire powerful relics that will assist you in your escape. Juggle the disks to unleash the power they hold and discover the synergies that will truly set you free.",
      "url": "https://store.steampowered.com/app/2302150/",
      "label": "证据原文片段"
    },
    {
      "text": "事件节点可在获得光点、商店购物、治疗和高风险神秘事件之间选择，收益也可能反过来阻碍逃亡",
      "dimension": "玩法",
      "excerpt": "Choose between acquiring motes of light, purchasing items in the shop, receiving a much-needed heal, or risking it all with unique mystery events that can either reward or hinder your ascent.",
      "url": "https://store.steampowered.com/app/2302150/",
      "label": "证据原文片段"
    },
    {
      "text": "失败时收集的Radiant Shards不会浪费，可投入下一轮永久提高逃离地狱的机会",
      "dimension": "玩法",
      "excerpt": "You may have gambled on a risky juggle that put you in harm's way and ended your run. Don't fret; the Radiant Shards you collect during your attempts can be used to empower your next run.",
      "url": "https://store.steampowered.com/app/2302150/",
      "label": "证据原文片段"
    }
  ],
