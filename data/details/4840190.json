  "hooks": [
    {
      "text": "在100波、20名Boss的弹幕战中逐步发现自己并非穿越虚空，而是身处其体内",
      "dimension": "故事",
      "excerpt": "100 waves, 20 bosses, and the slow realization that the sector you're purging isn't a sector. You are not crossing the void. You are inside it.",
      "url": "https://store.steampowered.com/app/4840190/",
      "label": "证据原文片段"
    },
    {
      "text": "每十波三选一规则突变，以吸血弹、弹射、连锁闪电或引力井组合破局构筑",
      "dimension": "玩法",
      "excerpt": "Every 10 waves you pick 1 of 3 mutations that bend the rules: vampiric rounds, ricochet, chain lightning, gravity wells. No two runs build the same. Find a synergy that breaks the game and ride it to wave 100.",
      "url": "https://store.steampowered.com/app/4840190/",
      "label": "证据原文片段"
    },
    {
      "text": "全球玩家共享同一世界Boss血池，个人伤害共同推进并面对狂暴阶段",
      "dimension": "玩法",
      "excerpt": "WORLD BOSS - one giant boss, one health pool shared by every player in the world. Your damage counts. It has enrage phases.",
      "url": "https://store.steampowered.com/app/4840190/",
      "label": "证据原文片段"
    }
  ],
