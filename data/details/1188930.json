  "hooks": [
    {
      "text": "最多四人调查队共享卡组协同，技能与天赋全部转成战斗卡牌",
      "dimension": "玩法",
      "excerpt": "Recruit up to 4 party members and synergize each card you have to win the battle! All skills and perks will appear as cards during the battle. It is up to you to customize your own characters!",
      "url": "https://store.steampowered.com/app/1188930/",
      "label": "证据原文片段"
    },
    {
      "text": "团灭会清空当局所得，但持续游玩会逐步开放更多选项",
      "dimension": "玩法",
      "excerpt": "Unlike classic RPGs, everything you gain will reset when your party is eliminated. However, you will discover more options as you play through the game.",
      "url": "https://store.steampowered.com/app/1188930/",
      "label": "证据原文片段"
    },
    {
      "text": "收集散落的时间碎片重启钟楼，才能让扭曲世界恢复运转",
      "dimension": "故事",
      "excerpt": "There is only one way to restore the world: collecting the Time Shades scattered around the Twisted Land and running the Clock Tower. The world will return to its peaceful days if the Clock Tower starts to tick again…",
      "url": "https://store.steampowered.com/app/1188930/",
      "label": "证据原文片段"
    }
  ],
