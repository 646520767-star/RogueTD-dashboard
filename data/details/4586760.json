  "hooks": [
    {
      "text": "所有防御塔都必须从零搭建，系统不提供任何预制塔方案",
      "dimension": "玩法",
      "excerpt": "You will need to build EVERY tower. No presets.",
      "url": "https://store.steampowered.com/app/4586760/",
      "label": "证据原文片段"
    },
    {
      "text": "弹道模组可分裂、叠加、反弹、连锁与倍增，把单塔扩展成百万级组合空间",
      "dimension": "玩法",
      "excerpt": "Build your towers and mod your projectiles — split it, add it, bounce it, chain it, multiply it! A true 1 tower = 1,000,000+ builds.",
      "url": "https://store.steampowered.com/app/4586760/",
      "label": "证据原文片段"
    },
    {
      "text": "三十三种模组各自拥有阶级、MK升级、B面功能与三项天赋，并继续进入高级制作和长期研究",
      "dimension": "玩法",
      "excerpt": "33 mods, each with tiers, MK upgrades, a B-Side function, and 3 unique perks - Research, advanced mod crafting, and long-term progression.",
      "url": "https://store.steampowered.com/app/4586760/",
      "label": "证据原文片段"
    }
  ],
