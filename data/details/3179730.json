  "hooks": [
    {
      "text": "白天造迷宫，夜晚用恐怖牌改变走廊猎杀访客",
      "dimension": "玩法",
      "excerpt": "By day, meticulously design the labyrinthine layout of your mansion, transforming it into a death trap that no human can escape. As night falls, lure unwitting explorers into your home, where you'll use a deck of terrifying cards to summon spirits, shift hallways, and unleash spine-chilling horrors.",
      "url": "https://store.steampowered.com/app/3179730/",
      "label": "证据原文片段"
    },
    {
      "text": "累积紧张与疯狂，同时守护宅邸心脏房",
      "dimension": "玩法",
      "excerpt": "Build tension and drive your guests toward madness, all while protecting your Heart room—the core of your malevolent power.",
      "url": "https://store.steampowered.com/app/3179730/",
      "label": "证据原文片段"
    },
    {
      "text": "抽取疯狂访客精华扩建房间与招致更强目标",
      "dimension": "玩法",
      "excerpt": "Once you've driven the explorers mad with fear, extract their essence to grow your mansion. Use it to unlock new rooms, expand your haunting powers, and attract more dangerous—and rewarding—targets.",
      "url": "https://store.steampowered.com/app/3179730/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "题材配套美术风格独到",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "独特的题材本身和同样独到的美术风格",
          "url": "https://steamcommunity.com/profiles/76561198090490140/recommended/3179730/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "UI简洁明快且功能区清晰",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "UI更是简洁明快，让人一眼便知使用时的功能区域",
          "url": "https://steamcommunity.com/profiles/76561198090490140/recommended/3179730/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "实际上只有一种有效策略",
