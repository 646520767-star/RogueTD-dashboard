  "hooks": [
    {
      "text": "四人桌把霰弹枪轮盘变成谈判场，玩家可以讨价还价、求饶和背叛直到只剩赢家。",
      "dimension": "玩法",
      "excerpt": "Shoot Your Friends Take a seat at the new 4-way multiplayer table. Bargain. Beg. Betray. Become the ultimate victor. Walk away rich.",
      "url": "https://store.steampowered.com/app/2835570/",
      "label": "证据原文片段"
    },
    {
      "text": "标准流程约十五到二十分钟，要在三轮中与庄家对赌并争取带走奖金。",
      "dimension": "玩法",
      "excerpt": "Literally Mindblowing Gameplay 15 to 20-minute intense playtime. Enter the arena, go three rounds against The Dealer, and walk away with the prize. Or don't.",
      "url": "https://store.steampowered.com/app/2835570/",
      "label": "证据原文片段"
    },
    {
      "text": "Double or Nothing模式允许继续押上已有成果，把存活时间变成不断加码的风险。",
      "dimension": "玩法",
      "excerpt": "Double or Nothing Press your luck in the new Double or Nothing mode. How long can you last?",
      "url": "https://store.steampowered.com/app/2835570/",
      "label": "证据原文片段"
    }
  ],
