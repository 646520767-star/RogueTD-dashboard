  "hooks": [
    {
      "text": "扮演会魔法的虾从黏液沼泽逃进紫水晶洞穴，最后攀登蘑菇巫师塔击败终极Boss",
      "dimension": "故事",
      "excerpt": "Battle your way out of a slimy swamp, escape amethyst caves, before climbing the Mushroom Wizard's Tower to defeat the final boss. Collect upgrades and power ups along your quest to become the most powerful Shrimp this world has ever seen!",
      "url": "https://store.steampowered.com/app/2334500/",
      "label": "证据原文片段"
    },
    {
      "text": "积累Krill点强化虾角色，再进入Cauldron挑战更高难度",
      "dimension": "玩法",
      "excerpt": "Gain Krill points to power up your Shrimp and take on the game at harder difficulties in the Cauldron!",
      "url": "https://store.steampowered.com/app/2334500/",
      "label": "证据原文片段"
    },
    {
      "text": "用随机地块自行铺出每区路线，可在战后放营火稳健恢复，也可一路只铺敌人格追求最大力量并承担更高死亡风险",
      "dimension": "玩法",
      "excerpt": "Choose your own path out of each area with a unique randomly generated tile system. Leverage your tiles to your tactical advantage by putting a campfire after an enemy encounter. Or say \"f*** it\" and put down only enemy tiles up until the boss, gaining the most amount of power possible but with a higher risk of death!",
      "url": "https://store.steampowered.com/app/2334500/",
      "label": "证据原文片段"
    }
  ],
