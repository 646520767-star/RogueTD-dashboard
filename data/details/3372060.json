  "hooks": [
    {
      "text": "击败恶魔后夺走其招牌能力，直接装进自己的卡组",
      "dimension": "玩法",
      "excerpt": "Better yet, you get to keep and use your opponents' signature abilities in your own deck!",
      "url": "https://store.steampowered.com/app/3372060/",
      "label": "证据原文片段"
    },
    {
      "text": "用Mod卡反复编辑武器卡，边打边重组手牌与状态效果",
      "dimension": "玩法",
      "excerpt": "Equip Mod Cards to enhance and modify your Weapon Cards — edit, experiment, adapt, and reformulate your hand and card combinations as you go and refine your personal playstyle!",
      "url": "https://store.steampowered.com/app/3372060/",
      "label": "证据原文片段"
    },
    {
      "text": "《神曲》结局之后，但丁失忆重返地狱，再次攀向天堂寻找答案",
      "dimension": "故事",
      "excerpt": "Hell Maiden picks up from the ending of the original Divine Comedy by Dante Alighieri. Dante is now inexplicably back in Hell after having reached Paradiso — and she's lost all her memories to boot!",
      "url": "https://store.steampowered.com/app/3372060/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "高饱和武器特效铺满画面且缺少透明度调节，造成视觉不适。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "后期没有透明度调节，满屏高饱和武器特效，眼睛都要瞎了",
          "url": "https://steamcommunity.com/profiles/76561199021326397/recommended/3372060/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "90年代动漫美术方向精致且完成度高。",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "just insane polish and 90s anime art direction.",
          "url": "https://www.youtube.com/watch?v=ixd7xRkdioY",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "复古画风与音乐共同形成赏心悦目的高水准演出。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "复古画风音乐共同演绎出的高水准演出赏心悦目",
          "url": "https://steamcommunity.com/profiles/76561199801069185/recommended/3372060/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "开场演出本身就被认为值回游戏价格。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The opening intro alone is worth the price of the entire game",
          "url": "https://steamcommunity.com/profiles/76561199110684712/recommended/3372060/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "牌组构筑深度和宽度低于同类热门作品。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "目前呈现的游戏内容无论是和幸存者本体相比还是和市面上的热门类幸存者游戏相比仍有一些牌组构筑深度和宽度上的差距。",
          "url": "https://steamcommunity.com/profiles/76561199801069185/recommended/3372060/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "第二关成长曲线相较第一关明显不合理。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "这游戏第二关和第一关成长曲线不合理",
          "url": "https://steamcommunity.com/profiles/76561198785257082/recommended/3372060/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "局外成长极慢，升级所需货币过高。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "局外成长巨慢，一把撤出来几十个货币，需要7500才能点一级弹幕数量。",
          "url": "https://steamcommunity.com/profiles/76561199021326397/recommended/3372060/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "卡牌升级机制为幸存者玩法增加了独特构筑变化。",
