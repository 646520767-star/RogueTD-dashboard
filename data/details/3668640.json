  "hooks": [
    {
      "text": "四年四季中每季地块和回合都有限，必须精算播种收割以完成租约",
      "dimension": "玩法",
      "excerpt": "Your journey spans four years, each with its four seasons. With limited turns and plots per season, you'll plan your sowing and harvesting to hit contract goals. Pay your land rent, and your farm will thrive.",
      "url": "https://store.steampowered.com/app/3668640/",
      "label": "证据原文片段"
    },
    {
      "text": "马铃薯流派堆肥力或删牌爆发，番茄流派则随晴雨天气即时变阵",
      "dimension": "玩法",
      "excerpt": "As Potato Ox, choose between stacking fertility for explosive yields or using removal to trigger combos. As Tomato Ox, adapt to a shifting weather system—sun and rain change the game.",
      "url": "https://store.steampowered.com/app/3668640/",
      "label": "证据原文片段"
    },
    {
      "text": "有限农田各有翻倍产量、加速成熟、掉落金币或滋生杂草等地块特性",
      "dimension": "玩法",
      "excerpt": "Limited plots, limited turns. But no two plots are alike—some double yields, some grow faster, some drop bonus coins, and some just love sprouting weeds. It's not much land, but every choice counts.",
      "url": "https://store.steampowered.com/app/3668640/",
      "label": "证据原文片段"
    }
  ],
