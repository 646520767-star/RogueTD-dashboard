  "hooks": [
    {
      "text": "从六大 Dude 家族的 42 种单位中组队，探索超过 85 万种阵容组合",
      "dimension": "玩法",
      "excerpt": "Choose from a wild cast of 42 Unique Dudes across 6 Dude Families: Undead Dudes, Employed Dudes, Warrior Dudes, Fantasy Dudes, Sci-Fi Dudes, and Action Dudes. Setup your Team to mix and match Dude Types and form ridiculous synergies",
      "url": "https://store.steampowered.com/app/3934270/",
      "label": "证据原文片段"
    },
    {
      "text": "数百件遗物会扭曲战斗规则，首领饰品还能把特效绑定到整个 Dude 类型",
      "dimension": "玩法",
      "excerpt": "Collect hundreds of Dude Relics that warp the rules of battle. Make your Wizard Dudes fling a volley of fireballs when they move, your Ninja Dudes enter stealth when in danger, or your Finance Dudes generate cash with a life insurance policy on your other Dudes. Defeat Act Bosses to earn Trinkets - powerful items assigned to a Dude Type that enable game breaking strategies.",
      "url": "https://store.steampowered.com/app/3934270/",
      "label": "证据原文片段"
    },
    {
      "text": "在输出、承伤与指挥角色间配平队伍，对抗从幼童到神明的升级敌潮",
      "dimension": "玩法",
      "excerpt": "Each Dude has their place in battle, from dishing out damage to tanking it to commanding other Dudes. Find the right balance between offense and defense, and see if your team can make it all the way to the final act. Face escalating enemy waves—from toddlers to wolves to gorillas to gods",
      "url": "https://store.steampowered.com/app/3934270/",
      "label": "证据原文片段"
    }
  ],
