  "hooks": [
    {
      "text": "从棺中醒来调查自己的死亡，在时间循环中寻找脱身方法并重拾记忆。",
      "dimension": "故事",
      "excerpt": "Investigate your own death, find ways to break free from a time loop, choose a hero who will ascend to the throne and rule the Northern gate!",
      "url": "https://store.steampowered.com/app/1232580/",
      "label": "证据原文片段"
    },
    {
      "text": "登上北境王座后的选择会决定哥布林、兽人与精灵的存亡和统治地位。",
      "dimension": "故事",
      "excerpt": "Will the goblins remain slaves, or will they rule over the orcs in the Crimson Steppes? Will the elves be wiped from the face of the earth? Who will become the dominating force in the Northern Gate?",
      "url": "https://store.steampowered.com/app/1232580/",
      "label": "证据原文片段"
    },
    {
      "text": "收集强力神器构筑牌组，再用成型卡组挑战争夺王权的派系领袖。",
      "dimension": "玩法",
      "excerpt": "Collect powerful artifacts, build unbeatable decks and fight the leaders of factions that try to dispute your authority.",
      "url": "https://store.steampowered.com/app/1232580/",
      "label": "证据原文片段"
    }
