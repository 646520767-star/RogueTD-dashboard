  "hooks": [
    {
      "text": "多屏远程指挥以有限指令间接控场",
      "dimension": "玩法",
      "excerpt": "Instead of a classic top-down view of the battlefield, you operate from a remote command center surrounded by screens and data feeds. You can give orders to your troops from a list of instructions but will have a limited range of direct actions to impact the battlefield. Xenopurge is more about anticipation and planning, than reaction and control.",
      "url": "https://store.steampowered.com/app/2983410/",
      "label": "证据原文片段"
    },
    {
      "text": "按指挥风格招募并配装战术小队",
      "dimension": "玩法",
      "excerpt": "As the mission unfolds, you'll have the chance to bring in new squad members with their own starting tactical methods. Gear them up to fit your command style — shaping a team built for your tactical needs.",
      "url": "https://store.steampowered.com/app/2983410/",
      "label": "证据原文片段"
    },
    {
      "text": "随机设施承载搜索护送撤离摧毁任务",
      "dimension": "玩法",
      "excerpt": "Procedurally generated maps ensure no two missions are the same, with variable layouts, enemies, keeping each run unpredictable. Combined with diverse objectives like search, escort, extraction, and destruction, every mission becomes a fresh tactical challenge.",
      "url": "https://store.steampowered.com/app/2983410/",
      "label": "证据原文片段"
    }
  ],
