  "hooks": [
    {
      "text": "从仙灵、巨龙、树人到亡灵与兽人组队，用职业协同扭转自动战局",
      "dimension": "玩法",
      "excerpt": "Build a squad of units from a wide variety of fighters - from Fae, Dragons and Treefolk to Skeletons, Ghouls, and Orcs! Collect a team of Tanks, Healers, Mages, Engineers and more - using their synergies to turn the tide of battle in your favor.",
      "url": "https://store.steampowered.com/app/1652250/",
      "label": "证据原文片段"
    },
    {
      "text": "解锁以扩展机制深度而非数值碾压为目标，并可自行关闭新增内容",
      "dimension": "玩法",
      "excerpt": "Gain new Perks, Units, Items, and more, with an Unlock system that prioritizes expanding depth instead of granting more power. Each of these unlocks can be disabled, so you can ramp up the new systems and mechanics at your own pace.",
      "url": "https://store.steampowered.com/app/1652250/",
      "label": "证据原文片段"
    },
    {
      "text": "通关锦标赛后挑战递增难度与新机制，或参加异步PvP",
      "dimension": "玩法",
      "excerpt": "Once you’ve proven yourself in the Grand Tournament, try scaling the Challenge Climb, which adds both challenging difficulty increases and exciting new mechanics to the trials ahead. Or, try your hand at Asynchronous PVP - battle players from around the world in a true display of tactics and strategy!",
      "url": "https://store.steampowered.com/app/1652250/",
      "label": "证据原文片段"
    }
