  "hooks": [
    {
      "text": "生物特征消失后由时间操控技术复活，把死亡直接纳入空间站循环",
      "dimension": "玩法",
      "excerpt": "Through advanced time-manipulation, you’re brought back to life whenever your bio-metrics are no longer detected.",
      "url": "https://store.steampowered.com/app/3032830/",
      "label": "证据原文片段"
    },
    {
      "text": "收集死者记忆碎片可下载遗失技能，并把进度带过一次次电梯下行",
      "dimension": "玩法",
      "excerpt": "In the future where humans are able to download new abilities on demand, the station is now scattered with memory fragments from the fallen. Each one having the potential of being a lost skill or talent waiting to be unlocked. Every run offers a new pivoted challenge with ever-changing pathways to explore, and pits you against hordes of enemies. Each ride down the station's elevators carries forward progress from the memory fragments you scavenge along your exploration.",
      "url": "https://store.steampowered.com/app/3032830/",
      "label": "证据原文片段"
    },
    {
      "text": "越往空间站深处下潜，环境会愈发阴森，遭遇的敌人也越来越不像人类",
      "dimension": "玩法",
      "excerpt": "The deeper you descend into the station, the environments become more haunting, and the enemies less human.",
      "url": "https://store.steampowered.com/app/3032830/",
      "label": "证据原文片段"
    }
  ],
