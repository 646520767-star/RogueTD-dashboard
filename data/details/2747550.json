  "hooks": [
    {
      "text": "死亡后仍保留本局赚取的现金，可兑换永久强化与新内容，让失败也推动长期成长。",
      "dimension": "玩法",
      "excerpt": "Even after death, you keep your hard-earned money which can be exchanged for persistent improvements and unlockable content, allowing you to progress further while adding depth to the overall gameplay.",
      "url": "https://store.steampowered.com/app/2747550/",
      "label": "证据原文片段"
    },
    {
      "text": "多名能力各异的角色搭配大量武器与技能，可反复试验不同生存构筑。",
      "dimension": "玩法",
      "excerpt": "Bloodshed boasts a diverse roster of playable characters, each with distinct abilities and playstyles, providing a personalized gameplay experience. With a vast selection of weapons and skills at your disposal, you can experiment with various builds to discover the ideal strategy for your survival.",
      "url": "https://store.steampowered.com/app/2747550/",
      "label": "证据原文片段"
    },
    {
      "text": "射击可在自动开火与手动瞄准间切换，自由选择幸存者式割草或传统FPS操控。",
      "dimension": "玩法",
      "excerpt": "Swappable Shooting Modes: Use auto-shooting for a more Survivors-like experience, or “switch to manual” to aim and shoot your way!",
      "url": "https://store.steampowered.com/app/2747550/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "实际体验过于混乱",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "in reality it's too messy.",
          "url": "https://steamcommunity.com/id/get_voice/recommended/2747550/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "许多升级效果实用性低。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "a lot of the upgrades feel useless",
          "url": "https://steamcommunity.com/profiles/76561199000580319/recommended/2747550/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "升级缺少协同，难以形成独特构筑。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "None of the upgrades lend themselves to unique builds",
          "url": "https://steamcommunity.com/profiles/76561198070505235/recommended/2747550/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "相关功能每次使用后都需要重新购买",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "每次都需要重新购买",
          "url": "https://steamcommunity.com/profiles/76561198309707902/recommended/2747550/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "移动与枪械手感非常满足。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The movement and gunplay is super satisfying",
          "url": "https://steamcommunity.com/id/needbetterlink/recommended/2747550/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "把九十年代射击节奏转为幸存者玩法的效果优秀。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the best at translating frantic 90's shooter action into the whole survivor genre",
          "url": "https://steamcommunity.com/id/needbetterlink/recommended/2747550/",
          "label": "证据原文片段"
        }
