  "hooks": [
    {
      "text": "角斗士阵亡会永久消失，连身上装备也一并失去",
      "dimension": "玩法",
      "excerpt": "But beware - permadeath is on. If a gladiator falls, they and their equipment are lost forever, adding high stakes to every decision.",
      "url": "https://store.steampowered.com/app/2507820/",
      "label": "证据原文片段"
    },
    {
      "text": "格子战斗按先攻行动，用行动点走位、技能、道具与陷阱算杀局",
      "dimension": "玩法",
      "excerpt": "Combat unfolds in turn-based battles on a grid, where units act in order of initiative. Strategically move your gladiators, attack, and position them to outsmart and outmaneuver your opponents. Use your action points wisely - unleash powerful weapon or class abilities, make use of items like potions and magical scrolls, or set traps on the ground to catch enemies off guard.",
      "url": "https://store.steampowered.com/app/2507820/",
      "label": "证据原文片段"
    },
    {
      "text": "战间经营海岸城市，用医务室、市场和纪念碑支撑复仇队伍",
      "dimension": "玩法",
      "excerpt": "Between battles, use your hard-earned gold to build and upgrade city buildings, unlocking new tools and services to aid you in your quest for vengeance. From the infirmary, where your gladiators can recover, to the bustling market for trading items, and even a grand monument to honor fallen gladiators.",
      "url": "https://store.steampowered.com/app/2507820/",
      "label": "证据原文片段"
    }
  ],
