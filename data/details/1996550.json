    {
      "text": "翻滚自带无敌帧，攻击可弹开敌招，削空架势后再处决",
      "dimension": "玩法",
      "excerpt": "Dodge to move and gain invulnerability frames! Hit enemy attacks with your own to deflect & clank with theirs! Break down enemy poise to stagger them and go in for the kill!",
      "url": "https://store.steampowered.com/app/1996550/",
      "label": "证据原文片段"
    },
    {
      "text": "城墙和陷阱会被敌人从底部拆毁，倒塌时甚至同时压死敌我",
      "dimension": "玩法",
      "excerpt": "Put up walls and lay traps to delay and destroy the enemy! But beware; for the enemy will tear at your defenses from the ground up! If your structures weaken and crumble, the enemy (and yourself) will get crushed under it's weight!",
      "url": "https://store.steampowered.com/app/1996550/",
      "label": "证据原文片段"
    },
    {
      "text": "继承前代冠军的骨髓，把属性、物品与遗物传给下一轮后裔",
      "dimension": "玩法",
      "excerpt": "Pass down attributes, items, and relics by inheriting the marrow of your previous champions! Build your list of legacies & train better parents, so that you can overcome even steeper obstacles!",
      "url": "https://store.steampowered.com/app/1996550/",
      "label": "证据原文片段"
    }
