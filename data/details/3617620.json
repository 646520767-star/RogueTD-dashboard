  "hooks": [
    {
      "text": "把不同效果的贴纸自由贴上卡牌，亲手制作整套牌组",
      "dimension": "玩法",
      "excerpt": "Create your own cards with a colorful catalogue of stickers combining their effects.",
      "url": "https://store.steampowered.com/app/3617620/",
      "label": "证据原文片段"
    },
    {
      "text": "在酷炫度拔河对战中积累优势，并用FEVER倍率关键翻盘",
      "dimension": "玩法",
      "excerpt": "It’s time for a tug-of-war of coolness! Play your cards right to gain favor over your rivals and leave them in awe of your creations! Make use of the FEVER multiplier to turn the tide at the right moment!",
      "url": "https://store.steampowered.com/app/3617620/",
      "label": "证据原文片段"
    },
    {
      "text": "卡战间穿插寻宝、自动贩卖机、抓娃娃与邻里故事事件",
      "dimension": "玩法",
      "excerpt": "Between card battles you can take part in all sorts of activities to spice up your deck. Dig for hidden prizes in Treasure Hunts! Try your luck at the Vending Machine for that perfect super shiny sticker! Get to know your friends around the neighborhood in Story Events! Grab some new toys at the Claw Machine!",
      "url": "https://store.steampowered.com/app/3617620/",
      "label": "证据原文片段"
    }
  ],
