  "hooks": [
    {
      "text": "13层闹鬼酒店会根据顶层首领改变结构，探索中同步搜集卡牌、金币和装备",
      "dimension": "玩法",
      "excerpt": "This ever-changing 3D hotel changes depending on the boss which awaits them in the penthouse. Gather cards, gold, and gear while navigating the eerie corridors on the way to the top.",
      "url": "https://store.steampowered.com/app/1727590/",
      "label": "证据原文片段"
    },
    {
      "text": "三名青少年的组合同时决定初始牌组、关系剧情与绕过危险事件的个人能力",
      "dimension": "玩法",
      "excerpt": "Your trio of teenagers determines your start deck and so much more. Watch their relationships unfold as they answer riddles, discover their own backstories and use their individual strengths to bypass risky dilemmas.",
      "url": "https://store.steampowered.com/app/1727590/",
      "label": "证据原文片段"
    },
    {
      "text": "死亡会继续解锁角色、首领和事件，胜负都能获得灵魂点定制下一次酒店之旅",
      "dimension": "玩法",
      "excerpt": "Death is encouraged in this deranged experiment! Unlock new characters, bosses, and events by playing multiple times and exploring different strategies. Learn how to collect more cards and gear by perusing the Library. Win or lose, earn Spirit points to spend on customizing your next trip through the hotel.",
      "url": "https://store.steampowered.com/app/1727590/",
      "label": "证据原文片段"
    }
  ],
