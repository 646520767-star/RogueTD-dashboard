  "hooks": [
    {
      "text": "双方为飞船累积能量并进行正面对冲，以冲击波胜负取代偷袭",
      "dimension": "玩法",
      "excerpt": "Both sides accumulate Power for their own spaceship and compete in a fair shockwave battle to determine who the winner is! This is the recognized way of battle in the LONESTAR Universe, without any surprise attacks!",
      "url": "https://store.steampowered.com/app/2056210/",
      "label": "证据原文片段"
    },
    {
      "text": "不同飞船各有专长和近百种专属单位，更多单位需要在旅途中逐步获得",
      "dimension": "玩法",
      "excerpt": "Each spaceship has its own expertise and possesses nearly a hundred exclusive units! (Note: The Association only provides initial units; other units need to be obtained by hunters during their journey.)",
      "url": "https://store.steampowered.com/app/2056210/",
      "label": "证据原文片段"
    },
    {
      "text": "完成悬赏后进入带薪休假事件，在选择中获取下一段航程所需资源",
      "dimension": "玩法",
      "excerpt": "Every time you complete a Bounty Mission, the Association will offer a period of paid leave. During your vacation, you will encounter various unique events, make choices, and obtain resources.",
