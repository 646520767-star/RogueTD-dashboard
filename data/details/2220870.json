  "hooks": [
    {
      "text": "出口钥匙藏在宝箱或小首领身上",
      "dimension": "玩法",
      "excerpt": "Find the exit key in chests or from mini bosses",
      "url": "https://store.steampowered.com/app/2220870/",
      "label": "证据原文片段"
    },
    {
      "text": "护甲与对应神器融合后会释放装备槽",
      "dimension": "玩法",
      "excerpt": "Armor comes in sets that have a matching artifact To fuse armor with it's artifact, you simply max the artifact's level and it will free up a slot",
      "url": "https://store.steampowered.com/app/2220870/",
      "label": "证据原文片段"
    },
    {
      "text": "武器状态效果既能协同也可能互相抵消",
      "dimension": "玩法",
      "excerpt": "Weapon status effects can harmonize or cancel out, so choose them carefully",
      "url": "https://store.steampowered.com/app/2220870/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "游戏节奏缓慢且操作笨拙。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "slow and clunky",
          "url": "https://store.steampowered.com/curator/45690639-SJ%2527s-Survivor-Rogue-lite-Library/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "局外成长速度过慢。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The meta progression takes so long",
          "url": "https://steamcommunity.com/id/Krye/recommended/2220870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "单人推进过程经常乏味。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "It's often tedious to progress solo",
          "url": "https://steamcommunity.com/id/dirigibletomato/recommended/2220870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "单人模式惩罚过重且数值过高。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the game is just too punishing and overtuned to be fun solo",
          "url": "https://steamcommunity.com/id/epixdude/recommended/2220870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "远程敌人的不可躲避自动命中攻击可在两击内杀死玩家",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "ranged enemies auto-hit you with undodgeable attacks that kill you in two hits.",
          "url": "https://steamcommunity.com/id/Krye/recommended/2220870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "许多武器只是原有武器的换模复制。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "every other weapon is a clone of the original but with a different model.",
          "url": "https://steamcommunity.com/id/bardcicero/recommended/2220870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "大量武器表现很差。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "a lot of weapons seem downright bad",
          "url": "https://steamcommunity.com/id/dirigibletomato/recommended/2220870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "界面混乱且提供的信息过少。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the game gives you very little information through its kinda messy UI.",
          "url": "https://steamcommunity.com/id/dirigibletomato/recommended/2220870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "玩法容易上手且非常容易令人沉迷。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "very simple to pick up and super addictive!",
          "url": "https://store.steampowered.com/curator/40788472-Tobugis/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "内容与玩法机制具有较高深度。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "extremely deep in content and game mechanic",
          "url": "https://store.steampowered.com/curator/40788472-Tobugis/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
