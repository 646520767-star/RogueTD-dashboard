  "hooks": [
    {
      "text": "六十五名英雄、三百二十五件物品、一百五十件遗物和六十种起源共同支撑大量协同构筑。",
      "dimension": "玩法",
      "excerpt": "With 65 heroes, 325 items, 150 relics and 60 origins, every run will be unique and challenging! Hero and team building have been designed with flexibility and freedom at their core which allows you to discover and create unique synergetic builds every single run!",
      "url": "https://store.steampowered.com/app/1830970/",
      "label": "证据原文片段"
    },
    {
      "text": "自动战斗之间要管理资源、选择地图路线、调整构筑并规划站位和战斗阶段。",
      "dimension": "玩法",
      "excerpt": "In between the automated combats, you will have to cleverly guide your heroes through the adventure by making the smart decisions! Manage your resources, choose the optimal path in the map, make powerful builds, and strategically position and plan the combat phase!",
      "url": "https://store.steampowered.com/app/1830970/",
      "label": "证据原文片段"
    },
    {
      "text": "五档难度、无尽冲层和二十种挑战分别检验构筑上限与策略掌握。",
      "dimension": "玩法",
      "excerpt": "Progress through 5 difficulties which will challenge your knowledge and strategy! Push your builds to their limit in the endless mode, a mode where you try to reach the highest floor! Experience the game in diverse and fun new ways with the 20 available challenges!",
      "url": "https://store.steampowered.com/app/1830970/",
      "label": "证据原文片段"
    }
  ],
