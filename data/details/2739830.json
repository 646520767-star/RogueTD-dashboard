  "hooks": [
    {
      "text": "罗马亡灵军团最终必须二选一：接受恶魔力量，或反抗皇帝并恢复人性。",
      "dimension": "故事",
      "excerpt": "By the end of the campaign, you'll have to choose: do you want to become a powerful demon, or will you reject the might of Emperor Sulla and restore your humanity?",
      "url": "https://store.steampowered.com/app/2739830/",
      "label": "证据原文片段"
    },
    {
      "text": "回合战场同时运用掩体、陷阱、夹击、监视射击和机会攻击，把地图转化为战术优势。",
      "dimension": "玩法",
      "excerpt": "Use covers, traps, flanking and an in-depth overwatch and opportunity system and turn the entire battlefield to your advantage like a master tactician.",
      "url": "https://store.steampowered.com/app/2739830/",
      "label": "证据原文片段"
    },
    {
      "text": "重建新罗马并用有限资源配置英雄设施，让要塞为不同任务提供针对性准备。",
      "dimension": "玩法",
      "excerpt": "Build up and expand the city of Nova Roma. Make sure that your stronghold has the right facilities for your heroes that prepare them for different quests. But beware! Resources are scarce and you have to manage Nova Roma thoughtfully to keep it afloat.",
      "url": "https://store.steampowered.com/app/2739830/",
      "label": "证据原文片段"
    }
  ],
