  "hooks": [
    {
      "text": "在镇民口碑与审判官关注之间求生，危险逼近时还能逃往另一座城镇",
      "dimension": "玩法",
      "excerpt": "You’ll practice your craft in a town where good rumors spread just as fast as bad ones, with the latter quickly reaching the ears of inquisitors. Balancing your popularity among townsfolk and the inquisitors’ growing attention is essential for survival here. And if your witch’s intuition tells you the end is near, you can always find refuge in another town—there are plenty nearby.",
      "url": "https://store.steampowered.com/app/2251010/",
      "label": "证据原文片段"
    },
    {
      "text": "为访客选择不同药水会直接改变事件进程与人物命运",
      "dimension": "故事",
      "excerpt": "A vast array of potions, each capable of leading to a unique story outcome;",
      "url": "https://store.steampowered.com/app/2251010/",
      "label": "证据原文片段"
    },
    {
      "text": "已解锁药水会跨越不同结局继承到下一次生命循环",
      "dimension": "玩法",
      "excerpt": "Unlocked potions, no matter how each story ends, will carry over to your next life cycle.",
      "url": "https://store.steampowered.com/app/2251010/",
      "label": "证据原文片段"
    }
  ],
