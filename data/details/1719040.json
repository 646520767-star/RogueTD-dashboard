  "hooks": [
    {
      "text": "饥饿小鼠遇见有意识的油脂怪，变身小怪物反抗猫群统治",
      "dimension": "题材",
      "excerpt": "You are a hungry mouse, scrounging for scraps in the sewers, when you meet a magical sentient fatberg who teaches you to transform into a mighty little Morsel. With your new powers, set off to dangerous upper worlds where you battle against the cats' oppressive forces and collect new Morsels, strategically swapping as you go.",
      "url": "https://store.steampowered.com/app/1719040/",
      "label": "证据原文片段"
    },
    {
      "text": "随时切换捕获的Morsel，每只怪物都有独立能力、异常与强化特质",
      "dimension": "玩法",
      "excerpt": "- Fight enemies using your rotating roster of captured Morsels, switching between them at any time - Each Morsel has its own abilities and strengths, and can become afflicted with ailments or boosted with power-ups and quirks",
      "url": "https://store.steampowered.com/app/1719040/",
      "label": "证据原文片段"
    },
    {
      "text": "隐藏奖励关会切换独立画风，并加入意外的玩法变体",
      "dimension": "画风",
      "excerpt": "Multiple hidden bonus levels with unique art styles and surprising gameplay twists",
      "url": "https://store.steampowered.com/app/1719040/",
      "label": "证据原文片段"
    }
  ],
