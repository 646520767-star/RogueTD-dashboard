  "hooks": [
    {
      "text": "鼠标光标始终处于行动中心，主动摧毁、收集并在每局持续变强",
      "dimension": "玩法",
      "excerpt": "Your cursor stays at the center of the action as you actively destroy, collect, and grow stronger every run.",
      "url": "https://store.steampowered.com/app/4288460/",
      "label": "证据原文片段"
    },
    {
      "text": "升级可组合连锁闪电、环绕球、爆炸、光束、治疗与连锁反应",
      "dimension": "玩法",
      "excerpt": "Unlock upgrades that transform your build with chain lightning, orbiting orbs, explosions, beams, healing effects, and powerful chain reactions.",
      "url": "https://store.steampowered.com/app/4288460/",
      "label": "证据原文片段"
    },
    {
      "text": "生成助手与产出生物质的Minicore，维护网络加速整体成长",
      "dimension": "玩法",
      "excerpt": "Spawn helper units, grow biomass-producing Minicores, and maintain your evolving network to accelerate your progression.",
      "url": "https://store.steampowered.com/app/4288460/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "简单玩法仍营造出有效氛围",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the atmosphere is surprisingly effective for such a simple game",
          "url": "https://store.steampowered.com/curator/46062711-CriticalHit-Reviews/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "每阶段强制重置破坏乐趣",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "you are being forced to reset everytime the moment the \"fun\" begin",
          "url": "https://steamcommunity.com/id/EliranTheThird/recommended/4288460/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "需要持续主动照看关卡且不好玩",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "requires a lot of active babysitting to play levels and that's not fun",
          "url": "https://steamcommunity.com/profiles/76561198123715440/recommended/4288460/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "完整游戏流程过短",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "overall the game was too short in my opinion",
          "url": "https://steamcommunity.com/profiles/76561198102776887/recommended/4288460/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "最终机制刚融合时游戏就结束",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Just when all the mechanics came together in the end at the final level, it felt like it ended too soon.",
          "url": "https://steamcommunity.com/profiles/76561198102776887/recommended/4288460/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "升级速度慢且多数缺乏意义",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Upgrades are super slow and mostly meaningless",
          "url": "https://steamcommunity.com/id/EliranTheThird/recommended/4288460/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "每阶段不同机制学习体验很好",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the different mechanics on each stage feel great to learn",
          "url": "https://steamcommunity.com/id/t3mp0ralflux/recommended/4288460/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "作为增量游戏玩法有变化",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The gameplay was decent and varied for an incremental game",
          "url": "https://steamcommunity.com/profiles/76561198102776887/recommended/4288460/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "升级树难度节奏恰当",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the upgrade tree doesn't feel too easy or hard to progress through",
          "url": "https://steamcommunity.com/id/t3mp0ralflux/recommended/4288460/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "病毒成长前提有趣",
      "dimension": "主题",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "a neat premise",
          "url": "https://steamcommunity.com/id/cracatoa/recommended/4288460/",
