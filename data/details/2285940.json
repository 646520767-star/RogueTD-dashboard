  "hooks": [
    {
      "text": "镰刀强调快速收割，巨斧强调力量压制，武器选择直接决定战斗节奏。",
      "dimension": "玩法",
      "excerpt": "Pick a weapon that best suits your combat style. Use a swift scythe to quickly cut down your enemies or wield a great axe to overwhelm them with power.",
      "url": "https://store.steampowered.com/app/2285940/",
      "label": "证据原文片段"
    },
    {
      "text": "死亡后保留收集的灵魂购买永久升级，让角色在每次重开后继续变强。",
      "dimension": "玩法",
      "excerpt": "Death is not the end in Hollow Survivors. Utilize the souls you gather to purchase permanent upgrades from other Hollows, ensuring that you grow stronger with each run.",
      "url": "https://store.steampowered.com/app/2285940/",
      "label": "证据原文片段"
    },
    {
      "text": "所选灵魂卡会同步改变角色外观，不同构筑组合呈现不同造型。",
      "dimension": "画风",
      "excerpt": "Each soul-card you select directly influences your character's appearance . Every unique combination creates a distinct look for the player.",
      "url": "https://store.steampowered.com/app/2285940/",
      "label": "证据原文片段"
    }
  ],
