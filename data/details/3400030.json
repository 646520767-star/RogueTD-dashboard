  "hooks": [
    {
      "text": "每局从十二生肖少女中选择三人，阴阳属性组合会解锁不同法器。",
      "dimension": "玩法",
      "excerpt": "In each run, choose 3 Zodiac Maidens. Pay attention to their Yin-Yang attributes — different combinations unlock unique magic artifacts. The right artifacts will double your efficiency!",
      "url": "https://store.steampowered.com/app/3400030/",
      "label": "证据原文片段"
    },
    {
      "text": "选择楼层事件卡会提高首领警觉，可先绕路准备，也可提前挑战换取更大奖励。",
      "dimension": "玩法",
      "excerpt": "During each floor’s battle, selecting an event card will alert the floor’s boss. Plan your route carefully: prepare before the boss fully notices you, or challenge it early for greater rewards!",
      "url": "https://store.steampowered.com/app/3400030/",
      "label": "证据原文片段"
    },
    {
      "text": "战斗同时考虑站位、五行生克、攻防与被动反制，并通过移动方块触发三消连锁。",
      "dimension": "玩法",
      "excerpt": "Consider positioning, Five Elements cycle (mutual promotion and restraint), attack/defense attributes, and passive counters. Move tiles to trigger match-3 combos, command Maidens, and crush foes with high-damage chains!",
      "url": "https://store.steampowered.com/app/3400030/",
      "label": "证据原文片段"
    }
  ],
