  "hooks": [
    {
      "text": "固定双节点从五种武器中搭配塔防",
      "dimension": "玩法",
      "excerpt": "In Idle Protocol, you equip exactly 2 active Nodes (Towers) to face the swarm. Choose from 5 distinct weapons, including:",
      "url": "https://store.steampowered.com/app/4596860/",
      "label": "证据原文片段"
    },
    {
      "text": "系统重启换循环点并推进BIOS六角树",
      "dimension": "玩法",
      "excerpt": "Hit an economic wall? Perform a System Reboot to prestige and earn Cycles. Spend your Cycles in the BIOS—a massive Hexagonal Grid Layout skill tree—to unlock game-changing Ultimate abilities like \"Infinite Loop\" or \"Supernova\". Defeating Bosses also grants Upgrade Points (Chips) for the Circuit tab to further optimize your build.",
      "url": "https://store.steampowered.com/app/4596860/",
      "label": "证据原文片段"
    },
    {
      "text": "五百波后用五项残酷协议挑战终局",
      "dimension": "玩法",
      "excerpt": "Reach Wave 500 to unlock the true endgame: Quarantine Protocols. Initiate a run with up to 5 brutal modifiers—like the No-Click Protocol or Monocore restrictions—to prove your architectural mastery and unlock exclusive Alternate Skins for your nodes.",
      "url": "https://store.steampowered.com/app/4596860/",
      "label": "证据原文片段"
    }
