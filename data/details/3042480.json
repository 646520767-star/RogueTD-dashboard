  "hooks": [
    {
      "text": "敌人被击杀后掉落肉，肉再用于召唤新防守者，形成直观的击杀增援循环。",
      "dimension": "玩法",
      "excerpt": "Player call defenders. Defenders kill enemies. Enemies bring meat. Meat bring new defenders.",
      "url": "https://store.steampowered.com/app/3042480/",
      "label": "证据原文片段"
    },
    {
      "text": "通过阻滞敌人创造击杀窗口，并以石头和木棍维持原始时代的防线。",
      "dimension": "玩法",
      "excerpt": "Hold enemy. Easier to kill. Stones and sticks - friends. Be caveman. See it? Kill it. Eat it!",
      "url": "https://store.steampowered.com/app/3042480/",
      "label": "证据原文片段"
    },
    {
      "text": "怪物与防守者都被置于卡通化史前环境中，作为主线《Age of Defense》的序章。",
      "dimension": "画风",
      "excerpt": "The most addicting tower defense game, packed with monsters and tough defenders, all of which fit perfectly into the cartoonish environment. Prehistory is a prologue for the main story Age of Defense.",
      "url": "https://store.steampowered.com/app/3042480/",
      "label": "证据原文片段"
    }
