  "hooks": [
    {
      "text": "骑着住在飞鲸上的飞狗，与朋友穿越手绘、程序生成的苏斯式天空旅程",
      "dimension": "画风",
      "excerpt": "In Flock of Dogs, ride flying dogs that live on a flying whale. Together with your friends, go on a hand-drawn, procedurally-generated, Dr. Seussian, roguelike road trip through the sky.",
      "url": "https://store.steampowered.com/app/812380/",
      "label": "证据原文片段"
    },
    {
      "text": "喂养并升级狗群，以飞鲸作为移动战斗站，再下洞穴挑战巨型兽王",
      "dimension": "玩法",
      "excerpt": "Feed, water, and level up your dogs Pilot a flying whale that acts as your mobile battle station Descend into caves to fight boss battles against massive Cave Beasts",
      "url": "https://store.steampowered.com/app/812380/",
      "label": "证据原文片段"
    },
    {
      "text": "购买者提供免费好友席位，多个拥有者还能叠加席位组成四人队伍",
      "dimension": "玩法",
      "excerpt": "A Friend Slot allows one of your online friends to join you for free! Anyone can download the \"Flock of Dogs - Friend's Pass\" and then join the game of someone who purchased Flock of Dogs. One Friend Slot comes with purchase Invite any friend (and each time, it can be a different friend) Friend Slots stack, so if two people own the game and are playing together, 2 more friends can join them using the Friend's Pass to make a team of 4.",
      "url": "https://store.steampowered.com/app/812380/",
      "label": "证据原文片段"
    }
  ],
