  "hooks": [
    {
      "text": "有限建造槽中布置并升级塔楼、城墙、兵营和经济建筑，每个位置都影响防线完整性。",
      "dimension": "玩法",
      "excerpt": "Base Building: Construct and upgrade towers, walls, barracks, and economy structures to strengthen your defenses. Limited build slots mean every choice matters.",
      "url": "https://store.steampowered.com/app/2994990/",
      "label": "证据原文片段"
    },
    {
      "text": "建筑类型可触发自动战斗式职业协同，并叠加人类、兽人和精灵的专属阵营强化。",
      "dimension": "玩法",
      "excerpt": "Class Synergies: Combine building types to unlock powerful auto-battler-inspired class bonuses and define your playstyle. Faction Perks: Choose between Human, Orc, and Elf structures to unlock unique faction-specific upgrades and strategies.",
      "url": "https://store.steampowered.com/app/2994990/",
      "label": "证据原文片段"
    },
    {
      "text": "玩家不只负责建城，还会亲自以英雄身份和军队并肩作战，用技能与站位守住战线。",
      "dimension": "玩法",
      "excerpt": "Real-Time Combat: Fight alongside your army as a powerful hero, using abilities and positioning to hold the line during chaotic battles.",
      "url": "https://store.steampowered.com/app/2994990/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "可爱且漂亮的视觉受到肯定。",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Cute, engaging and simply beautiful",
          "url": "https://store.steampowered.com/curator/44870240-What-does-the-Fox-plays/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "美术比同类作品更讨喜。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "i liked the art here better than Thronefall.",
          "url": "https://steamcommunity.com/id/-Aralyn-/recommended/2994990/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "严重漏洞会阻止购买建筑和英雄释放技能。",
