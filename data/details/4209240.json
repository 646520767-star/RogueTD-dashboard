  "hooks": [
    {
      "text": "每局阵容完全靠抽卡和掷骰形成，强度由命运决定，同一Boss可能被神抽碾压也可能反向碾压玩家",
      "dimension": "玩法",
      "excerpt": "RNG-Driven Auto Battler: Every run is decided by draws and rolls. Build your formation entirely through gacha, and let fate decide your power. Sometimes you dominate the boss — sometimes the boss dominates you.",
      "url": "https://store.steampowered.com/app/4209240/",
      "label": "证据原文片段"
    },
    {
      "text": "战场规模从四对四扩张到六十对六十，并用弹幕、暗杀和回旋攻击在大军团中瞬间改写胜负",
      "dimension": "玩法",
      "excerpt": "Massive-Scale Battles: Fight battles ranging from 4v4 skirmishes to 60v60 all-out battles. Unleash Barrage firepower, precise Assassinations, or deadly Boomerang attacks that turn the tide in an instant.",
      "url": "https://store.steampowered.com/app/4209240/",
      "label": "证据原文片段"
    },
    {
      "text": "26名可玩角色、105件神器套装与336名可收集英雄组成超大抽取池，支撑每轮不同阵容",
      "dimension": "玩法",
      "excerpt": "All About Luck includes: -26 playable characters with unique skills -105 Piece God Artifact Set -336 distinct heroes to collect and command",
      "url": "https://store.steampowered.com/app/4209240/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "长时间游玩容易感觉重复。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "长时间游玩可能会感觉重复",
          "url": "https://steamcommunity.com/id/cwfengs/recommended/4209240?snr=1_5_9__402",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "长战斗可能陷入大量治疗牌循环。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "我这边只剩治疗了所以要挂90+回合",
          "url": "https://steamcommunity.com/profiles/76561198099537540/recommended/4209240/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "加速功能需要抽卡解锁，令人烦躁。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "加速功能需要抽卡获得就更烦人了",
          "url": "https://steamcommunity.com/profiles/76561198890426413/recommended/4209240/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "长流程中机制缺乏变化，容易厌倦。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "一局的游戏流程很长，所以在长时间机制没有很大变化的情况下，会容易腻",
          "url": "https://steamcommunity.com/profiles/76561198890426413/recommended/4209240/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "部分神器会对实力产生负提升。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "神器对实力负提升",
          "url": "https://steamcommunity.com/id/1294969979/recommended/4209240/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "胜利也缺乏成就感。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "即便玩家胜利了，也没有多少成就感",
          "url": "https://steamcommunity.com/id/TioPlato40/recommended/4209240/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "重生点奖励过少。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "重生点给的比较吝啬",
