  "hooks": [
    {
      "text": "先鉴定遗物推断对自己或队友的效果，再画图记录用途，或牺牲遗物换取深入地堡。",
      "dimension": "玩法",
      "excerpt": "Identify forgotten artefacts to deduce their effects on you or on your friends. Draw descriptive pictures to not forget what they do or sacrifice them to go deeper into the bunkers.",
      "url": "https://store.steampowered.com/app/3604800/",
      "label": "证据原文片段"
    },
    {
      "text": "越深入地堡，房间、陷阱与遗物本身都更危险，探索深度直接放大死亡风险。",
      "dimension": "玩法",
      "excerpt": "While delving deeper and deeper into the bunkers, rooms will get more dangerous, traps that keep scavenger at bay will be more frequent and artefacts will be more and more lethal.",
      "url": "https://store.steampowered.com/app/3604800/",
      "label": "证据原文片段"
    },
    {
      "text": "玩家能画脸、配饰、光标和遗物图示；死后留下的绘画可能帮助队友，也可能故意误导他们。",
      "dimension": "玩法",
      "excerpt": "Draw anything you want to represent yourself. Draw your face, accessories, your own cursor... You may also draw something for artefacts that could be helpful for yourself or for your friends that collect them from your remains. They could also deceive them into chaotic situations.",
      "url": "https://store.steampowered.com/app/3604800/",
      "label": "证据原文片段"
    }
  ],
