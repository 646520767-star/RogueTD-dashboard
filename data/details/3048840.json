  "hooks": [
    {
      "text": "调味卡牌与厨具共同改写味道和遭遇规则",
      "dimension": "玩法",
      "excerpt": "Season your cards to change their flavour and unlock powerful abilities. Equip cookware that bends the rules of every encounter, and shape your deck around the flavour chains you want to pull off.",
      "url": "https://store.steampowered.com/app/3048840/",
      "label": "证据原文片段"
    },
    {
      "text": "按怪物喜恶排序五味连锁避免公主被吃",
      "dimension": "玩法",
      "excerpt": "Every dish carries one of five flavours: salty, sour, savoury, bitter, or sweet. Match each Horror's cravings, chain the right flavours in the right order, and watch hunger snowball. Every Horror has favourites and things they despise. Learn them, exploit them, and serve the perfect meal.",
      "url": "https://store.steampowered.com/app/3048840/",
      "label": "证据原文片段"
    },
    {
      "text": "主线跨局保留解锁成果并叠加模式修正",
      "dimension": "玩法",
      "excerpt": "Take the long road in the main campaign with persistent progression, where unlocked recipes, abilities, and seasonings carry between runs. Play Vanilla for the standard experience or crank it up with Spicy mode. Stack modifiers like Culinary and Gourmet to twist each run further.",
      "url": "https://store.steampowered.com/app/3048840/",
      "label": "证据原文片段"
    }
  ],
