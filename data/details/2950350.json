  "hooks": [
    {
      "text": "战斗中收集材料和货币解锁武器与驱魔能力，数十类武器配方需靠实战取得后自由组合",
      "dimension": "玩法",
      "excerpt": "Collect materials and currency during battle to unlock new weapons and Exorcism Powers. Your arsenal includes: A lightsaber straight out of a sci-fi film Sacred relic weapons born from ancient legends Even an adorable cat-themed weapon!? Combine dozens of weapon types to craft your own build. But nothing comes for free—every recipe must be earned through combat.",
      "url": "https://store.steampowered.com/app/2950350/",
      "label": "证据原文片段"
    },
    {
      "text": "六名区域首领分别取材全球地方神话，并拥有独立超自然能力与战斗性格",
      "dimension": "题材",
      "excerpt": "Six beautifully deadly bosses. Each inspired by local myths around the world, armed with unique supernatural abilities and unforgettable personalities.",
      "url": "https://store.steampowered.com/app/2950350/",
      "label": "证据原文片段"
    },
    {
      "text": "猎人网络可招募新可玩角色，每人拥有独立能力、技能觉醒和战斗身份",
      "dimension": "玩法",
      "excerpt": "Hunter Network System. Recruit new playable hunters, each with their own abilities, skill awakenings, and unique combat identity.",
      "url": "https://store.steampowered.com/app/2950350/",
      "label": "证据原文片段"
    }
