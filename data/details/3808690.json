  "hooks": [
    {
      "text": "化身病原体，在人体内部与免疫系统展开细胞级双摇杆战争",
      "dimension": "题材",
      "excerpt": "In Pathogenic, you are the disease. Experience a visceral 2D roguelike twin-stick shooter where you play as a lone parasite fighting a desperate war against the immune system.",
      "url": "https://store.steampowered.com/app/3808690/",
      "label": "证据原文片段"
    },
    {
      "text": "夺取并移植细胞器，用鞭毛、线粒体与尖刺拼装病原体",
      "dimension": "玩法",
      "excerpt": "Loot, graft, and assemble your parasite from dozens of unique organelles. Combine flagella for movement, mitochondria for power, secretors for ranged attacks, and spikes for melee combat.",
      "url": "https://store.steampowered.com/app/3808690/",
      "label": "证据原文片段"
    },
    {
      "text": "穿行程序生成的肺部、心脏与大脑，在人体器官中探索不同生态",
      "dimension": "题材",
      "excerpt": "Navigate the procedurally generated organic landscape of the human body. Travel through distinct biomes like the branching pathways of the lungs, the pulsating chambers of the heart, and the complex neural network of the brain.",
      "url": "https://store.steampowered.com/app/3808690/",
      "label": "证据原文片段"
    }
  ],
