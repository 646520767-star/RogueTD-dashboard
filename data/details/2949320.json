  "hooks": [
    {
      "text": "最多四人在线协作，带领超过100名角色在横版战场展开大规模混战。",
      "dimension": "玩法",
      "excerpt": "Ratatan is a rhythm roguelike action game that combines rhythm games and side-scrolling action, with online co-op gameplay supporting up to 4 players. An intense battle unfolds with over 100 characters fighting in a massive melee.",
      "url": "https://store.steampowered.com/app/2949320/",
      "label": "证据原文片段"
    },
    {
      "text": "按节奏输入指令驱动部队，还要实时判断下令位置、角色站位与撤退时机。",
      "dimension": "玩法",
      "excerpt": "Feel the beat and use rhythm sequences in time to order your Cobuns in the direction you want them to go. Since the Ratatans can be moved freely, your judgement to decide where to give orders, where to position the ratatan, and when to retreat is critical.",
      "url": "https://store.steampowered.com/app/2949320/",
      "label": "证据原文片段"
    },
    {
      "text": "以强调动态表现的2D动画塑造角色，让每次行动都带有鲜明活泼的个性。",
      "dimension": "画风",
      "excerpt": "We want to emphasize the unique performance of 2D animation and put lively personality into the action.",
      "url": "https://store.steampowered.com/app/2949320/",
      "label": "证据原文片段"
    }
  ],
