  "hooks": [
    {
      "text": "炼金炮塔可彼此组合，直接合成无人机工厂、迫击炮等新防御设施",
      "dimension": "玩法",
      "excerpt": "Alchemic Turret System – Employ a vast array of defensive turrets during your journey, where combining them creates everything from drone factories to mortars.",
      "url": "https://store.steampowered.com/app/2769780/",
      "label": "证据原文片段"
    },
    {
      "text": "自行建造并改装武装载具，用它穿越高压地下生态环境",
      "dimension": "玩法",
      "excerpt": "Ship-Building Mechanics: Create and customize powerful warships to traverse challenging environments.",
      "url": "https://store.steampowered.com/app/2769780/",
      "label": "证据原文片段"
    },
    {
      "text": "只带改装吸尘器的清洁机器人，要一路下潜地核把被拖近太阳的星球“打扫”归位",
      "dimension": "故事",
      "excerpt": "You are a small, unassuming cleaning bot that desires nothing more than a neat and tidy home. But ever since the planet was dragged closer to the sun by a monomaniacal tech nerd, dust and death swirl across the surface, making for a very messy situation. If your house will ever be clean again, you need to fix the world.",
      "url": "https://store.steampowered.com/app/2769780/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "鼠标移到屏幕边缘会触发恼人的伪暂停。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the game pseudo-pauses if you move it too close to the edge",
          "url": "https://steamcommunity.com/id/Azaraki/recommended/2769780/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "大量机制复杂且难以理解",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "too many complicated confusing things in it and goes out of it's way to make them hard to figure out",
          "url": "https://steamcommunity.com/id/amaron/recommended/2769780/",
          "label": "证据原文片段"
        }
      ]
    },
    {
