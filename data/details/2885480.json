  "hooks": [
    {
      "text": "从海面捡起瓶盖并粘成炮塔，继续拼装出能够伸展与变形的自制战舰",
      "dimension": "玩法",
      "excerpt": "Gather the scattered caps, glue them into a powerful turret, and craft a giant battleship capable of extending and transforming!",
      "url": "https://store.steampowered.com/app/2885480/",
      "label": "证据原文片段"
    },
    {
      "text": "派对PVP采用三轮锦标赛，所选战舰与随机地图共同迫使玩家在猛攻和发育之间重新定策略",
      "dimension": "玩法",
      "excerpt": "In the Party PVP mode, experience the intense and exhilarating three-round tournament, challenging multiple meticulously designed map stages. The selection of your battleship and the random map will jointly determine your subsequent tactical strategy—will you charge recklessly or develop cautiously?",
      "url": "https://store.steampowered.com/app/2885480/",
      "label": "证据原文片段"
    },
    {
      "text": "单人或多人共同守卫Nymph营地，对抗连续海怪攻势，并用稀有祝福与遗物强化旗舰",
      "dimension": "玩法",
      "excerpt": "Collect rare blessings and relics to fortify your BattleCap flagship and embark on an unprecedented naval battle! Defend the Nymph's camp against waves of enemy assaults! In addition to solo challenges, you can also invite friends to collaborate, sharing the pressure from the sea monsters and offering mutual support.",
      "url": "https://store.steampowered.com/app/2885480/",
      "label": "证据原文片段"
    }
  ],
