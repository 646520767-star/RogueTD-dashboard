  "hooks": [
    {
      "text": "城堡内NPC商店分别负责天赋塑形、装备准备和每轮强化",
      "dimension": "玩法",
      "excerpt": "RULE YOUR CASTLE, GROW YOUR POWER Within your castle walls, a host of loyal NPCs stand ready to serve your rise. Visit the Talent Shop to shape your build, the Item Shop to prepare for the battles ahead, and many more allies who exist solely to sharpen your edge. Every run brings new upgrades — and with each choice, you carve a darker legacy.",
      "url": "https://store.steampowered.com/app/3668370/",
      "label": "证据原文片段"
    },
    {
      "text": "向古老图腾献出金币，换取技能、卷轴和足以逆转战局的秘密力量",
      "dimension": "玩法",
      "excerpt": "SACRIFICE YOUR RICHES TO AWAKEN FORGOTTEN POWERS Ancient totems respond only to those who give willingly. Exchange your hard-earned gold for power beyond mortal limits — skills, scrolls, and secrets that could turn the tide of any battle.",
      "url": "https://store.steampowered.com/app/3668370/",
      "label": "证据原文片段"
    },
    {
      "text": "声望提升会扩大吸血鬼领主影响力，并召来更强、更致命的随从参战",
      "dimension": "玩法",
      "excerpt": "EMBRACE YOUR POWER AS THE VAMPIRE LORD Summon loyal companions to fight by your side and unleash chaos upon your enemies. As your reputation grows, so does your influence — calling forth stronger, deadlier allies bound to your dark will.",
      "url": "https://store.steampowered.com/app/3668370/",
      "label": "证据原文片段"
    }
  ],
