  "hooks": [
    {
      "text": "把前几局制造的枪装进无人机，作为下一名克隆士兵的支援火力",
      "dimension": "玩法",
      "excerpt": "Beyond Survival Experience the innovative roguelite where your previous gun builds aren't just memories—they're your backup! Deploy guns crafted from past runs in drones to assist the next grunt. Every run is a story, but each gun is a heroic saga.",
      "url": "https://store.steampowered.com/app/2086430/",
      "label": "证据原文片段"
    },
    {
      "text": "从空投收集疯狂枪械部件，拼出突破常规物理的武器组合",
      "dimension": "玩法",
      "excerpt": "Assemble the Unthinkable Break the game with your creativity. Collect insane weapon parts from airdrops and craft combinations so powerful, so bizarre, they have to be seen to be believed. Create your dream weapon, or a nightmarish contraption that defies all laws of physics and common sense.",
      "url": "https://store.steampowered.com/app/2086430/",
      "label": "证据原文片段"
    },
    {
      "text": "DNA改造影响未来克隆体，并可调整无人机AI与升级掉落",
      "dimension": "玩法",
      "excerpt": "Bio-Engineer your Evolution Delve into unique progression systems where DNA modifications can evolve your future clones. Tailor your abilities and your drone's AI to complement your playstyle, and optimize your upgrade drops for pivotal enhancements.",
      "url": "https://store.steampowered.com/app/2086430/",
      "label": "证据原文片段"
    }
  ],
