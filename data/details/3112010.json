  "hooks": [
    {
      "text": "点击揭开地牢暗区，每一步都可能翻出敌人、特殊事件或神秘洞穴",
      "dimension": "玩法",
      "excerpt": "Click to reveal your path through the shadows of the dungeon. They could reveal a fierce enemy, an extraordinary event, a cave of mysteries, or...!",
      "url": "https://store.steampowered.com/app/3112010/",
      "label": "证据原文片段"
    },
    {
      "text": "收集四大阵营数百只冈布奥并将其链接，让出征成员借用彼此能力形成队伍协同",
      "dimension": "玩法",
      "excerpt": "Hundreds of unique Gumballs to collect and upgrade, from four different factions and all with unique abilities and skillsets! Link gumballs together to borrow their powers during expeditions!",
      "url": "https://store.steampowered.com/app/3112010/",
      "label": "证据原文片段"
    },
    {
      "text": "二十多个主题地牢各自配置惊喜机制，并把彩蛋藏在可见与隐藏路径中鼓励全图探索",
      "dimension": "玩法",
      "excerpt": "Explore over twenty different dungeons, each with their own themes and surprise mechanics! A Labyrinthian hoard of easter eggs for you to stumble across and enjoy! Make sure to explore every path (both visible and hidden ones)!",
      "url": "https://store.steampowered.com/app/3112010/",
      "label": "证据原文片段"
    }
  ],
