  "hooks": [
    {
      "text": "五至十分钟的短局采用大规模自动战斗与轻量指挥，只需守住总部并摧毁敌方。",
      "dimension": "玩法",
      "excerpt": "We offer a simplified economy system, massive automated battles with light command, and a fun simplified upgrade system. Play in short bursts as matches last between 5-10 minutes!",
      "url": "https://store.steampowered.com/app/3124850/",
      "label": "证据原文片段"
    },
    {
      "text": "用宏观命令设定单位路径，或放手让部队自动占领关键点。",
      "dimension": "玩法",
      "excerpt": "Set paths for units or let them autonomously capture crucial points.",
      "url": "https://store.steampowered.com/app/3124850/",
      "label": "证据原文片段"
    }
  ],
