  "hooks": [
    {
      "text": "快节奏枪战中可踢飞敌人并格挡其投射物。",
      "dimension": "玩法",
      "excerpt": "Fast paced combat! - Use a wide array of weapons to destroy your enemies! You can even kick enemies and parry their projectiles!",
      "url": "https://store.steampowered.com/app/2863690/",
      "label": "证据原文片段"
    },
    {
      "text": "积攒肾上腺素启动Twilight Mode暂停时间，创造压制敌人的窗口。",
      "dimension": "玩法",
      "excerpt": "Stop time! - With Twilight Mode, you can use your built up adrenaline to stop time and gain a huge advantage over your foes!",
      "url": "https://store.steampowered.com/app/2863690/",
      "label": "证据原文片段"
    },
    {
      "text": "每场首领战后从三项强化中择一，逐步获得双倍伤害、加速换弹或飞行等能力。",
      "dimension": "玩法",
      "excerpt": "Upgrade system - At the end of every boss fight, you get to chose between 1 of 3 upgrades, double damage, 2x reload speed and flight are just some of the abilities you can gain!",
      "url": "https://store.steampowered.com/app/2863690/",
      "label": "证据原文片段"
    }
  ],
