  "hooks": [
    {
      "text": "二十五名单位随机落位，胜负取决于民兵构成而非站位操控",
      "dimension": "玩法",
      "excerpt": "Once on the battlefield, 25 of your troops will deploy randomly. You have no control over where they go, which means that it's the composition of your militia that's most important.",
      "url": "https://store.steampowered.com/app/2358770/",
      "label": "证据原文片段"
    },
    {
      "text": "士兵把平民练成军队，魅魔把他们转化为吸能吸血鬼",
      "dimension": "玩法",
      "excerpt": "Will you pick the Soldier who will turn your citizens into hard-bitten troops, or the Succubus, who will turn them into power-leeching Vampires? If you dabble in the occult, bring along a Priest to channel the power of your Undead.",
      "url": "https://store.steampowered.com/app/2358770/",
      "label": "证据原文片段"
    },
    {
      "text": "战术核弹集中全军火力，并把部队变成放射废料与变种人",
      "dimension": "玩法",
      "excerpt": "Backed into a corner by Nyarlathotep? Deploy a Tactical Nuke to concentrate your militia's attacks into a single mega blast. Sure, it'll turn them into Radioactive Waste, but that's how you get Mutants.",
      "url": "https://store.steampowered.com/app/2358770/",
      "label": "证据原文片段"
    }
  ],
