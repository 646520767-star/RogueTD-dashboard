  "hooks": [
    {
      "text": "每次点击都会推动游戏继续进化，并逐步解锁等级、能力与按钮构筑",
      "dimension": "玩法",
      "excerpt": "The more you click the button, the more the game evolves. Level up, acquire new abilities, choose your playstyle, and build a powerful button!",
      "url": "https://store.steampowered.com/app/2577760/",
      "label": "证据原文片段"
    },
    {
      "text": "可无限游玩并几乎收齐全部能力，最终让屏幕进入能力全面叠加的失控状态",
      "dimension": "玩法",
      "excerpt": "The game can be played indefinitely, allowing you to acquire (almost) every single ability, which will then cause there to be way too much stuff going at once.",
      "url": "https://store.steampowered.com/app/2577760/",
      "label": "证据原文片段"
    },
    {
      "text": "四种结局对构筑偏好不同，需要围绕目标结局反向选择能力",
      "dimension": "玩法",
      "excerpt": "The game can be beaten via 1 of 4 endings. Some builds will make certain endings easier than others, which encourages you to choose specific abilities for whatever ending you will attempt.",
      "url": "https://store.steampowered.com/app/2577760/",
      "label": "证据原文片段"
    }
  ],
