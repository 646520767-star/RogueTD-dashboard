  "hooks": [
    {
      "text": "物品效果由摆放位置、触发点方向与连接条件共同决定，移动物品即可改变触发频率和路线。",
      "dimension": "玩法",
      "excerpt": "Item effects depend not only on stats, but on trigger point direction and linkage conditions from positioning. Change positions to alter frequency and routes, creating your own chain rhythm.",
      "url": "https://store.steampowered.com/app/4478640/",
      "label": "证据原文片段"
    },
    {
      "text": "不同形状与尺寸的物品争夺有限格位，玩家需权衡主动触发和被动效果来优化空间组合。",
      "dimension": "玩法",
      "excerpt": "Items vary in shape and size. Weigh active triggers against passive effects, carefully managing limited slots to find the optimal combination.",
      "url": "https://store.steampowered.com/app/4478640/",
      "label": "证据原文片段"
    },
    {
      "text": "各英雄专属物品会建立不同系统，并以 20 档难度和机制型怪物检验构筑深度。",
      "dimension": "玩法",
      "excerpt": "Each hero's exclusive items build different systems. Multiple tactical combinations meet 20 difficulty levels and unique mechanic monsters, relentlessly testing the depth of your builds.",
      "url": "https://store.steampowered.com/app/4478640/",
      "label": "证据原文片段"
    }
