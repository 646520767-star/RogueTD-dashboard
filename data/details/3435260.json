  "hooks": [
    {
      "text": "收集新骰子及其配套遗物，让每次投掷叠出不断增长的力量与复杂效果",
      "dimension": "玩法",
      "excerpt": "Engage in a game of Dice with the mysterious entity - collect new dice and their paired relics to warp your rolls into ever increasing layers of power and complexity.",
      "url": "https://store.steampowered.com/app/3435260/",
      "label": "证据原文片段"
    },
    {
      "text": "把当前点数入账才能伤害Death，但若继续贪掷越过风险线，就会失去本轮全部收益",
      "dimension": "玩法",
      "excerpt": "Bank your points to deal damage to your opponent, and pass before you push your luck too far or you'll lose it all!",
      "url": "https://store.steampowered.com/app/3435260/",
      "label": "证据原文片段"
    },
    {
      "text": "解锁职业与核心机制之外，还能开启新遗物和对Death的对话路线来影响结局",
      "dimension": "玩法",
      "excerpt": "Unlock new classes and experiment with their core mechanics , unlock new relics and even dialogue paths with your mythical foe to influence the outcome!",
      "url": "https://store.steampowered.com/app/3435260/",
      "label": "证据原文片段"
    }
  ],
