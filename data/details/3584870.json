  "hooks": [
    {
      "text": "把墨西哥摔角包装成复古卡通战术对战，重点从按键连打转向轻松但深入的阵容策略。",
      "dimension": "题材",
      "excerpt": "Lucha Chess is a strategy roguelike with the flair of Mexican wrestling and the charm of retro cartoons. Instead of button-mashing action, you’ll dive into chill but deep tactical battles, building the ultimate team of eccentric heroes.",
      "url": "https://store.steampowered.com/app/3584870/",
      "label": "证据原文片段"
    },
    {
      "text": "英雄、装备与遗物可大量交叉组合，用于寻找能打破常规平衡的阵容协同。",
      "dimension": "玩法",
      "excerpt": "Experiment with countless combinations of heroes items, and relics to unleash broken synergies.",
      "url": "https://store.steampowered.com/app/3584870/",
      "label": "证据原文片段"
    },
    {
      "text": "每场比赛都要在进攻爆发与防守拖延间权衡，并决定突破前排还是直接打击后排。",
      "dimension": "玩法",
      "excerpt": "Will you find the perfect balance between offensive power and defensive stall? Will you smash through the enemy frontline or strike straight at their backline? The choice is yours every match!",
      "url": "https://store.steampowered.com/app/3584870/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "敌人强度会突然过高，像是无法避免的失败。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "about once a run, the enemy is way way overtuned. You can be wiping the floor for 10 battles straight, and suddenly, you get completely mopped in 8 seconds. Feels like it's just an auto-loss",
          "url": "https://steamcommunity.com/id/fpyre/recommended/3584870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "对局可能卡死，重新进入后仍无法继续。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "游戏直接卡主，无法继续，退出再进更是只能回到原对局，但是空白画面啥也没有，点啥都没有用，只能退出，再重进也是一样",
          "url": "https://steamcommunity.com/profiles/76561198070956983/recommended/3584870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "中文机器翻译质量很差。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "中文机翻有点离谱",
          "url": "https://steamcommunity.com/profiles/76561198132794091/recommended/3584870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "刷牌随机性过强，连续刷新也可能拿不到目标角色。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "有时候你刷新四五次商店都不会出一个人物 随机性太大",
          "url": "https://steamcommunity.com/profiles/76561198894976169/recommended/3584870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "敌人种类和挑战不足，削弱重复游玩的动力。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "there isn't enough enemy variety or challenge to justify replaying",
          "url": "https://steamcommunity.com/profiles/76561198019151196/recommended/3584870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "霸王龙技能曾无法升级并导致死档重开。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "霸王龙好像有bug，技能点不了升级，然后永远卡住只能重开，拿了就死档。",
          "url": "https://steamcommunity.com/profiles/76561198274084755/recommended/3584870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "游玩一段时间后会频繁卡顿。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "优化很差，玩一段时间后就会时不时卡顿。",
          "url": "https://steamcommunity.com/profiles/76561198274084755/recommended/3584870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "战术对战节奏有活力，并带来新鲜感。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Неожиданно бодро и тактически свежо.",
          "url": "https://store.steampowered.com/curator/32826090-Gaming-Grandma/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "围绕羁绊组建协同队伍是最有趣的部分。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "that's the most fun part, building a synergistic team",
          "url": "https://steamcommunity.com/id/fpyre/recommended/3584870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "装备升级后的数值反馈容易带来爽感。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "装备数值感觉很大方，升级后比较容易爽。",
          "url": "https://steamcommunity.com/profiles/76561198274084755/recommended/3584870/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
