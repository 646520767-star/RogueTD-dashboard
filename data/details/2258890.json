  "hooks": [
    {
      "text": "街机式MMO弹幕战允许随时加入或退出，与数十名玩家共同挑战数百种Boss和精英并争夺传奇战利品。",
      "dimension": "玩法",
      "excerpt": "A fast-paced, arcade-like gameplay, you can jump in and out of the game anytime you want, easy to learn but challenging. Together with dozens of players, you will face hundreds of bosses and elite monsters with unique combat methods, defeat them, collect legendary loot, or be defeated...",
      "url": "https://store.steampowered.com/app/2258890/",
      "label": "证据原文片段"
    },
    {
      "text": "死亡本身会推动英雄成长，数百种装备再与技能、天赋和伙伴组合成不同构筑。",
      "dimension": "玩法",
      "excerpt": "The heroes of Xanadu Land will grow with you, their death will make you stronger, up to hundreds kinds of equipments, as well as a wealth of skills, talents, fellows, can be formed into different builds, PC players and even mobile players together to achieve legend.",
      "url": "https://store.steampowered.com/app/2258890/",
      "label": "证据原文片段"
    }
  ],
