  "hooks": [
    {
      "text": "在人群中找出长着自己脸的分身，赶在它刺杀你之前锁定目标",
      "dimension": "玩法",
      "excerpt": "Your clone is hiding among the crowd, ready to kill you when you’re most vulnerable. Endure procedural paranoia as you search to find your doppelganger before they find you.",
      "url": "https://store.steampowered.com/app/2506530/",
      "label": "证据原文片段"
    },
    {
      "text": "搜刮武器并管理有限弹药；刺杀失手就会失去暗中跟踪的机会",
      "dimension": "玩法",
      "excerpt": "Scavenge for weapons, manage limited ammo, and prepare carefully to strike. If your assassination fails, you’ll lose the opportunity to stalk from the shadows.",
      "url": "https://store.steampowered.com/app/2506530/",
      "label": "证据原文片段"
    },
    {
      "text": "最多8名玩家共享同一张脸，在混乱中组队或单独判断彼此身份",
      "dimension": "玩法",
      "excerpt": "In multiplayer, step into the chaos with up to eight players who all share the same face. Compete in teams or go solo as you try to figure out who’s who before it’s too late.",
      "url": "https://store.steampowered.com/app/2506530/",
      "label": "证据原文片段"
    }
  ],
