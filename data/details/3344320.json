  "hooks": [
    {
      "text": "每场战斗只能使用开局手牌，并必须在单个回合内消灭全部敌人",
      "dimension": "玩法",
      "excerpt": "Win every battle using only the cards in your opening hand to defeat all enemies in a single turn.",
      "url": "https://store.steampowered.com/app/3344320/",
      "label": "证据原文片段"
    },
    {
      "text": "用牌越少奖励越高，若被敌人卡住则可花钱洗牌并重新抽取",
      "dimension": "玩法",
      "excerpt": "Using as few cards as possible will earn you more rewards, and if you get stuck on an enemy, you can use money to shuffle and draw.",
      "url": "https://store.steampowered.com/app/3344320/",
      "label": "证据原文片段"
    },
    {
      "text": "击败更强敌人赚取更多金钱，再持续升级牌组直至清空地牢",
      "dimension": "玩法",
      "excerpt": "Upgrade your deck using the money you earn! Defeat stronger enemies to earn more money! Repeat this process until you clear the dungeon!",
      "url": "https://store.steampowered.com/app/3344320/",
      "label": "证据原文片段"
    }
  ],
