  "hooks": [
    {
      "text": "转动轮盘决定回合制战斗结果，通过下注、特殊能力和道具在计划与运气间求平衡",
      "dimension": "玩法",
      "excerpt": "Roulette Dungeon is a turn-based roguelike where you spin a roulette wheel to defeat your enemies. Master the balance between strategic planning and unpredictable luck by placing bets, using special abilities, and collecting items to outsmart your foes and conquer the dungeon.",
      "url": "https://store.steampowered.com/app/3399930/",
      "label": "证据原文片段"
    },
    {
      "text": "不同角色拥有专属能力与优势，海量道具组合可把同一轮盘机制导向不同流派",
      "dimension": "玩法",
      "excerpt": "A variety of characters, each with their own abilities & strengths! Countless different item combinations leading to a vast amount of unique playstyles!",
      "url": "https://store.steampowered.com/app/3399930/",
      "label": "证据原文片段"
    },
    {
      "text": "下注赚取更多筹码后，可把筹码投入升级、老虎机、猜壳游戏等不同风险收益渠道",
      "dimension": "玩法",
      "excerpt": "Place bets to earn more chips & increase your chances of success! Spend your well earned chips for upgrades, on the slot machine, to play the shell game & more!",
      "url": "https://store.steampowered.com/app/3399930/",
      "label": "证据原文片段"
    }
