  "hooks": [
    {
      "text": "向被灰烬覆盖的星球表面洒水，在清洗过程中探索并恢复生态。",
      "dimension": "玩法",
      "excerpt": "Drop water on the ash-covered planetary surface to explore and restore it.",
      "url": "https://store.steampowered.com/app/3441280/",
      "label": "证据原文片段"
    },
    {
      "text": "探索收集到的资源会持续扩展浇灌能力，让恢复范围和效率不断成长。",
      "dimension": "玩法",
      "excerpt": "Use gathered resources to expand your many abilities and grow ever more powerful.",
      "url": "https://store.steampowered.com/app/3441280/",
      "label": "证据原文片段"
    },
    {
      "text": "在飞船上经营一座温馨的小型太空花园。",
      "dimension": "题材",
      "excerpt": "Grow your own cozy little garden ... on a spaceship!",
      "url": "https://store.steampowered.com/app/3441280/",
      "label": "证据原文片段"
    }
  ],
