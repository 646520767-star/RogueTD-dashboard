  "hooks": [
    {
      "text": "上百种武学与数百种计略可按成长方向组合成上阵方案，为每场战斗定制应对策略",
      "dimension": "玩法",
      "excerpt": "游戏包含上百种武学招式和数百种计略，玩家可以根据自己的成长方向，选择合适的技能组合与上阵计略，在战斗中制定独特的应对方案，击败敌人。",
      "url": "https://store.steampowered.com/app/3395140/",
      "label": "证据原文片段"
    },
    {
      "text": "上百个随机事件中的每次选择都会改变角色成长和进程，需在珍贵奖励与潜在危机间判断",
      "dimension": "玩法",
      "excerpt": "游戏拥有上百个随机事件，每一次选择都会对角色成长和游戏进程产生影响。是接受挑战获取珍贵奖励，还是谨慎避开潜在危机？每个决定都将为你的冒险带来独特的变化。",
      "url": "https://store.steampowered.com/app/3395140/",
      "label": "证据原文片段"
    },
    {
      "text": "有限资源和机会迫使在专精单一武学流派与多领域平衡发展间取舍",
      "dimension": "玩法",
      "excerpt": "面对众多武学招式与成长方向，你需要在有限的资源和机会中做出最优决策，是专注于某一武学流派的精进，还是尝试多领域的平衡发展？一切取决于你的策略与规划。",
      "url": "https://store.steampowered.com/app/3395140/",
      "label": "证据原文片段"
    }
