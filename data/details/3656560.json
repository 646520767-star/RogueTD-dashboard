  "hooks": [
    {
      "text": "不是逐张出牌，而是一次编排整手符文，让触发顺序直接决定连锁伤害",
      "dimension": "玩法",
      "excerpt": "Unlike traditional card games, where you play one card at a time, in Runeveil, you play the whole hand, where the sequence of the runes is the most important.",
      "url": "https://store.steampowered.com/app/3656560/",
      "label": "证据原文片段"
    },
    {
      "text": "开战前即可看见奖励，把当前战斗选择提前纳入终局牌组规划",
      "dimension": "玩法",
      "excerpt": "You can see your fight rewards from the beginning. Start your strategy to build the ultimate deck from the start!",
      "url": "https://store.steampowered.com/app/3656560/",
      "label": "证据原文片段"
    },
    {
      "text": "符文叠加遗物、药水与附魔，堆乘区甚至制造无限循环",
      "dimension": "玩法",
      "excerpt": "Collect ancient Artifacts , use magical Potions , and apply Enchantments to your runes. Stack multipliers, trigger infinite loops, and create a build so powerful that even the Arena Kings tremble.",
      "url": "https://store.steampowered.com/app/3656560/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "部分玩家认为可重玩性不足。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "it didn't feel very replayable.",
          "url": "https://steamcommunity.com/profiles/76561197976463750/recommended/3656560/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "后两名法师体验不如前两名。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "First two mages were fun, didn't enjoy the second two.",
          "url": "https://steamcommunity.com/profiles/76561197976463750/recommended/3656560/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "中途混合不同牌组类型增加构筑复杂度。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the ability to mix deck types in the middle of a run adds a neat complexity",
          "url": "https://steamcommunity.com/profiles/76561198047299679/recommended/3656560/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "职业差异与各职业内部协同都很丰富。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "solid variety between classes and a variety of synergies within each class to build around",
          "url": "https://steamcommunity.com/profiles/76561198047299679/recommended/3656560/",
          "label": "证据原文片段"
        }
      ]
    }
