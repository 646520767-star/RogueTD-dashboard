  "hooks": [
    {
      "text": "利用水电联动、可燃地形与武器克制操纵战场并击破护甲",
      "dimension": "玩法",
      "excerpt": "TACTICAL TURN-BASED COMBAT Engage in challenging grid-based battles where every move and combo demands precision. Leverage elemental effects to manipulate the battlefield - electrify soaked enemies, ignite flammable terrain, and exploit every opportunity. Account for enemy armor and strike with the right weapon to break through and gain the advantage.",
      "url": "https://store.steampowered.com/app/2530490/",
      "label": "证据原文片段"
    },
    {
      "text": "从九名多职能角色中组成五人队，并在升级时组合200余项技能",
      "dimension": "玩法",
      "excerpt": "BUILD YOUR PARTY Recruit allies and build a squad of 5 from 9 versatile characters - each blending multiple combat roles with unique skills, weapon sets, and personalities. As you level up, earn and upgrade over 200 skills to create deadly team compositions and game-winning builds.",
      "url": "https://store.steampowered.com/app/2530490/",
      "label": "证据原文片段"
    },
    {
      "text": "分叉地图随机生成事件、隐藏奖励与危险遭遇，每一步都会改变后续策略",
      "dimension": "玩法",
      "excerpt": "EVER-CHANGING JOURNEYS No two runs are the same. Choose your path across a winding map full of random events, hidden rewards, and dangerous encounters. Every step along the island’s forking paths will present new possibilities that can shift your entire strategy. Plan your path carefully, but be ready to adapt, as some choices can lead to powerful rewards, while others hide unplanned encounters.",
      "url": "https://store.steampowered.com/app/2530490/",
      "label": "证据原文片段"
    }
  ],
