  "hooks": [
    {
      "text": "角色从专属武器和一级起步，拾取经验升级后打开商店购买或强化装备",
      "dimension": "玩法",
      "excerpt": "Start off at level 1 with only your character's unique weapon. As you fight mobs, they will drop XP, which you can collect to level up. Leveling up opens up a shop where you can purchase new equips or upgrade your current ones in order to become stronger.",
      "url": "https://store.steampowered.com/app/2099220/",
      "label": "证据原文片段"
    },
    {
      "text": "五十多名Boss各有独立攻击和能力，并按关卡配置不同Boss组合",
      "dimension": "玩法",
      "excerpt": "Fight 50+ unique bosses! Explore the catalogue of items! As you play, bosses will appear, each with their own unique attacks and abilities. Each stage has their own set of bosses.",
      "url": "https://store.steampowered.com/app/2099220/",
      "label": "证据原文片段"
    },
    {
      "text": "三十多名可玩角色分别拥有专属技能和玩法，角色选择直接改变合作分工",
      "dimension": "玩法",
      "excerpt": "Currently, there are 30+ playable characters. As the game is still in Early Access, we have plans to continually add more and more playable characters, each with their own unique set of skills and playstyles for you to try.",
      "url": "https://store.steampowered.com/app/2099220/",
      "label": "证据原文片段"
    }
  ],
