  "hooks": [
    {
      "text": "把陷阱、电力、自动炮塔与自动门整合进可破坏的僵尸防御堡垒",
      "dimension": "玩法",
      "excerpt": "Design your fort to include traps, electric power, auto turrets, automated doors, gadgets and defensive positions to survive the undead in a fully destructible and moldable world.",
      "url": "https://store.steampowered.com/app/251570/",
      "label": "证据原文片段"
    },
    {
      "text": "建筑与地形遵循真实结构稳定性，受损或设计不良会因自重坍塌",
      "dimension": "玩法",
      "excerpt": "Buildings and terrain formations can collapse under their own weight from structural damage or poor building design with real structural stability.",
      "url": "https://store.steampowered.com/app/251570/",
      "label": "证据原文片段"
    },
    {
      "text": "可在固定战役与随机世界间选择，随机地图包含城市、洞穴等700多个地点",
      "dimension": "玩法",
      "excerpt": "Play the campaign world, or dive back in a randomly-generated world with cities, towns, lakes, mountains, valleys, roads, caves and over 700 unique locations.",
      "url": "https://store.steampowered.com/app/251570/",
      "label": "证据原文片段"
    }
  ],
