  "hooks": [
    {
      "text": "九位黑化民间传说英雄各有独立玩法，包括狼人小红帽与堕落孙悟空",
      "dimension": "玩法",
      "excerpt": "Play as 9 heroes, each with a unique twist and individual gameplay, including Little Red Riding Hood, who suffers from lycanthropy; Sun Wukong, the fallen monkey king; the Snow Queen with her evil powers; and many other familiar characters who have a darker side and are more violent than you might remember.",
      "url": "https://store.steampowered.com/app/2071280/",
      "label": "证据原文片段"
    },
    {
      "text": "每章只有三天三夜强化角色，时间耗尽就必须迎战章节Boss",
      "dimension": "玩法",
      "excerpt": "You have 3 days and 3 nights to increase your power. Face the chapter boss when you feel ready… or when you no longer have a choice.",
      "url": "https://store.steampowered.com/app/2071280/",
      "label": "证据原文片段"
    },
    {
      "text": "黑暗奇幻氛围与漫画书视觉结合，重塑熟悉童话的阴暗面",
      "dimension": "画风",
      "excerpt": "Ravenswatch is a meticulously crafted combination of a dark fantasy atmosphere with a comic book style.",
      "url": "https://store.steampowered.com/app/2071280/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "角色绘制、动画与特效表现优秀。",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Excellent drawing, beautiful characters, their animations and effects",
          "url": "https://store.steampowered.com/curator/43939488-Gamer-Detective/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "局内奖励不值得投入整轮时间。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the rewards don't feel worth the runs.",
          "url": "https://steamcommunity.com/id/thatdiesel/recommended/2071280?snr=1_5_9__402",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "肉鸽玩法失衡，首轮后容易乏味。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "unbalanced roguelite game play that is bland after the first run.",
          "url": "https://youtu.be/Llft2-W2B00",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "网络问题破坏合作体验。",
      "dimension": "技术/性能",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "fails to provide a gratifying co-op experience due to network troubles",
          "url": "https://youtu.be/Llft2-W2B00",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "后期构筑深度不足。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "后期构筑也感觉不到有多深",
          "url": "https://steamcommunity.com/profiles/76561199155289443/recommended/2071280/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "游戏缺少关键机制引导",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the game doesn't really help you learn a lot of the really important aspects at all.",
          "url": "https://steamcommunity.com/profiles/76561198018474937/recommended/2071280/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "全局限时机制令人烦躁。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "有个败笔就是限时的设计，逼着玩家做取舍，就很烦",
          "url": "https://steamcommunity.com/profiles/76561198352669513/recommended/2071280/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "前期角色能力过弱",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "角色前期跟残疾人没区别",
          "url": "https://steamcommunity.com/profiles/76561199155289443/recommended/2071280/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "关闭限时会阻止成就和更高难度解锁。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "如果你选择删掉时间限制，不仅无法解锁成就，连更高难度都无法解锁。",
          "url": "https://steamcommunity.com/profiles/76561199092153933/recommended/2071280/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "战斗与特殊招式令人满足。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "satisfying combat and special moves",
          "url": "https://www.youtube.com/watch?v=ItYz_7ZP3m0",
          "label": "证据原文片段"
        }
      ]
    }
