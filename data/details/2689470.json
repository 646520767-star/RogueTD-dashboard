  "hooks": [
    {
      "text": "穿越十个动态变化关卡，连建筑本身都会追逐并吞噬玩家",
      "dimension": "玩法",
      "excerpt": "Survive a Living Nightmare: Battle through 10 dynamic, ever-changing levels filled with bloodthirsty enemies who won’t stop until you’re dead. The building itself is your enemy and it’s trying to consume you.",
      "url": "https://store.steampowered.com/app/2689470/",
      "label": "证据原文片段"
    },
    {
      "text": "高速奔跑中收集兼具回血与货币功能的罐头，囤积后释放毁灭攻击",
      "dimension": "玩法",
      "excerpt": "Run, Fight, and Adapt: Speed is your only ally as you race against a constantly shifting environment. Keep an eye out for cans , which serve as both health boosts and currency for powerful upgrades. Stack them up and unleash a devastating attack when you need it most.",
      "url": "https://store.steampowered.com/app/2689470/",
      "label": "证据原文片段"
    },
    {
      "text": "用强硬电子节拍与侵略性合成器强化混乱超现实的恐怖氛围",
      "dimension": "画风",
      "excerpt": "Pulse-Pounding OST: Feel the adrenaline surge with a hard-hitting electronic soundtrack that keeps you on edge. The relentless beats and aggressive synths mirror the intensity of the gameplay, immersing you deeper into the chaotic, surreal world of CRUEL .",
      "url": "https://store.steampowered.com/app/2689470/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "游戏视觉效果很棒。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "this game looks amazing",
          "url": "https://steamcommunity.com/profiles/76561199490558788/recommended/2689470/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "内容流程仅约一小时。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "a very short experience taking about an hour to finish",
          "url": "https://youtu.be/W_NC1_avqSw",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "陷阱与敌人生成会破坏冲锋节奏。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the traps, shadow creatures, crows and monkeys just kills all momentum",
          "url": "https://steamcommunity.com/profiles/76561199490558788/recommended/2689470/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "高速转动镜头容易导致眩晕。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "各种高速转视角很有可能让你头晕脑胀",
          "url": "https://steamcommunity.com/profiles/76561198164709459/recommended/2689470/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "门后生成爆炸敌人令人恼火。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "spawning an explosive enemy on the other side of the door is lame",
          "url": "https://steamcommunity.com/profiles/76561198215346008/recommended/2689470/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "无尽模式后期每层过长，体验熬人。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "每一层都非常长不是说不能打只是太熬人",
          "url": "https://steamcommunity.com/profiles/76561198164709459/recommended/2689470/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "瞄准辅助只锁身体，实用性很差。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Aim assist is worthless. It aims for body shots only",
          "url": "https://steamcommunity.com/profiles/76561199875380807/recommended/2689470/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "近战武器缺乏吸引力。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "游戏的近战武器就没那么出彩了",
          "url": "https://steamcommunity.com/profiles/76561198164709459/recommended/2689470/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "追逐火焰造成过强压力。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the fire feature makes it impossible for me to get good. It adds so much stress.",
          "url": "https://steamcommunity.com/profiles/76561199875380807/recommended/2689470/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "开局没有说明需要踢门。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "it doesn't tell you to kick the door open",
          "url": "https://steamcommunity.com/profiles/76561199875380807/recommended/2689470/",
          "label": "证据原文片段"
        }
      ]
    }
