    {
      "text": "把动作词、修饰词和元素词拼成自定义招式",
      "dimension": "玩法",
      "excerpt": "Create custom attacks by combining words up to the limit of your spirit level. The more spirit you have, the more slots you have to place words into and the more powerful and complex actions you can take.",
      "url": "https://store.steampowered.com/app/1575810/",
      "label": "证据原文片段"
    },
    {
      "text": "用荣誉方式击败对手，把宿敌变朋友并获得战斗加成",
      "dimension": "玩法",
      "excerpt": "Defeating an opponent with honor can turn the most heated of rivals into the fastest of friends! Befriend your rivals to earn their words of encouragement in the form of useful Pep Ups which can be equipped to give you special bonuses in combat.",
      "url": "https://store.steampowered.com/app/1575810/",
      "label": "证据原文片段"
    },
    {
      "text": "十集动漫式宇宙冒险，每集地图随机生成战斗与事件",
      "dimension": "故事",
      "excerpt": "It plays out across 10 “episodes”, each of which takes between 60-90 minutes to complete. Each episode features a map to explore with procedurally generated battles, special events and other secrets to find along with the main story events.",
      "url": "https://store.steampowered.com/app/1575810/",
      "label": "证据原文片段"
    }
