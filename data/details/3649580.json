  "hooks": [
    {
      "text": "每回合选择攻击或部署，但严寒会让单位行动一轮后撤退，只有坚固建筑和强力战士能持续守线",
      "dimension": "玩法",
      "excerpt": "Each turn, choose whether to attack or position your troops. Beware—the harsh cold forces your units to retreat after a single turn, leaving only your sturdiest structures and strongest warriors to stand the test of time.",
      "url": "https://store.steampowered.com/app/3649580/",
      "label": "证据原文片段"
    },
    {
      "text": "五百多张卡牌可跨四个独特阵营混搭，不同玩法体系组合后会产生额外协同",
      "dimension": "玩法",
      "excerpt": "A massive pool of over 500 cards to mix and match. Four unique factions , each with distinct playstyles and surprising synergy when combined.",
      "url": "https://store.steampowered.com/app/3649580/",
      "label": "证据原文片段"
    },
    {
      "text": "一百多座可升级建筑能重塑整个战场，并要承受七十多类敌人的连续冲击",
      "dimension": "玩法",
      "excerpt": "Over 100 upgradable buildings to reshape the entire battlefield. More than 70 enemies —can you withstand their overwhelming assault?",
      "url": "https://store.steampowered.com/app/3649580/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "AI生成视觉使作品显得仓促粗制。",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Visuals were A.I. Generated. It's just quickly made shovelware slop.",
          "url": "https://store.steampowered.com/curator/45016979-A.I.-Police/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "UI仅达到勉强可看的程度。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "ui也仅仅是能看的程度",
          "url": "https://steamcommunity.com/profiles/76561198254777839/recommended/3649580/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "冰封世界视觉氛围优美。",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "a beautifully frozen world",
          "url": "https://youtu.be/raDMtQYWinQ",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "游戏平衡性很差。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Balance-wise it is terrible",
          "url": "https://store.steampowered.com/curator/38553778-All-about-Strategy-Games/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "后期存在等待敌人缓慢刷新的垃圾时间。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "后期存在一些垃圾时间，明明你已经秒天秒地了，却要一直等敌人缓慢出怪",
          "url": "https://steamcommunity.com/profiles/76561198160190735/recommended/3649580/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "玩家与敌方缺少交互。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "和敌方缺少交互，突出一个你打你的我打我的",
          "url": "https://steamcommunity.com/profiles/76561198160190735/recommended/3649580/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "稀有卡出现概率过低。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "稀有卡出现几率太低",
          "url": "https://steamcommunity.com/profiles/76561198955340110/recommended/3649580/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "新鲜感消退很快。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "新鲜感很容易过去",
          "url": "https://steamcommunity.com/profiles/76561198160190735/recommended/3649580/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "支线事件与Boss完全缺少引导。",
