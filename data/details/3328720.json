  "hooks": [
    {
      "text": "自定义潮玩娃娃的动作组后投入自动战斗，物理碰撞会把对手真实地撞飞",
      "dimension": "玩法",
      "excerpt": "Not only can you design personalized dolls, but you can also experience realistic physical collision effects in battle, sending your enemies flying. Customize the move sets for each doll and become the champion of the arena.",
      "url": "https://store.steampowered.com/app/3328720/",
      "label": "证据原文片段"
    },
    {
      "text": "积累积分开启盲盒，随机获得角色、武器和服装，并有机会抽出隐藏异色版本",
      "dimension": "玩法",
      "excerpt": "After earning a certain amount of points, you can open blind boxes to receive characters, weapons, and outfits, with a chance to get hidden variants.",
      "url": "https://store.steampowered.com/app/3328720/",
      "label": "证据原文片段"
    },
    {
      "text": "技能芯片可编排娃娃出招顺序，组合连击、控制效果和残局反杀套路",
      "dimension": "玩法",
      "excerpt": "Customize the order of moves with different types of skill chips. You can unleash amazing combos, control effects, and even pull off a comeback to finish off your opponent!",
      "url": "https://store.steampowered.com/app/3328720/",
      "label": "证据原文片段"
    }
  ],
