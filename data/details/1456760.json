  "hooks": [
    {
      "text": "导入并裁剪自己的音乐，由编辑器自动生成可游玩的节拍",
      "dimension": "玩法",
      "excerpt": "Shoot to your own beat with the custom music feature. Simply upload & trim your track or leave it as it is in our in-game editor to auto generate beats that suit your play style.",
      "url": "https://store.steampowered.com/app/1456760/",
      "label": "证据原文片段"
    },
    {
      "text": "按节拍射击可提高伤害并缩短冷却，同时叠加蓄力、倍率和穿甲效果",
      "dimension": "玩法",
      "excerpt": "Maximise your damage and shorten your cooldown time by shooting in sync. Master the art of charged shots, damage multipliers, armour piercing rounds, and more!",
      "url": "https://store.steampowered.com/app/1456760/",
      "label": "证据原文片段"
    },
    {
      "text": "在霓彩关卡中串联跑墙、滑铲、二段跳、兔跳和抓钩移动",
      "dimension": "玩法",
      "excerpt": "Wall run, slide, double jump, bunny hop, and grapple hook your way through technicolour levels to give your enemies the runaround.",
      "url": "https://store.steampowered.com/app/1456760/",
      "label": "证据原文片段"
    }
  ],
