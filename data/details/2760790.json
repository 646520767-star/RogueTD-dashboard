  "hooks": [
    {
      "text": "取消走路与社交，把建造、采集、收获和升级全部压缩为点击操作",
      "dimension": "玩法",
      "excerpt": "You don't have to waste time walking from one place to another because there's no walking here; everything is done by clicking. There's no social aspect either, so you are focused on building, gathering, harvesting, and upgrading.",
      "url": "https://store.steampowered.com/app/2760790/",
      "label": "证据原文片段"
    },
    {
      "text": "从小块土地起步，用多种赚钱路线扩张农场并偿付不断上涨的租金",
      "dimension": "玩法",
      "excerpt": "Your main goal is to earn money for the increasing rent. The initial small amount of land and capabilities quickly transform into a large farm. A countless number of ways to make money ensures that everyone will find something for themselves.",
      "url": "https://store.steampowered.com/app/2760790/",
      "label": "证据原文片段"
    },
    {
      "text": "每轮随机生成资源与地图，升级时从三个随机选项中即时调整农场策略",
      "dimension": "玩法",
      "excerpt": "▪ Randomized resources and map layouts make every run a fresh new adventure. ▪ Choose one of three random upgrades each time you level up — adapt your farming strategy on the fly!",
      "url": "https://store.steampowered.com/app/2760790/",
      "label": "证据原文片段"
    }
  ],
