  "hooks": [
    {
      "text": "把相同出身或相同职责的骷髅放上战场会触发团队特效，形成数百种搭配",
      "dimension": "玩法",
      "excerpt": "Placing skeletons from the same background or with the same role on the battlefield will grant special effects to your team. There are hundreds of possible combinations and matchups.",
      "url": "https://store.steampowered.com/app/3349800/",
      "label": "证据原文片段"
    },
    {
      "text": "骷髅被任何单次攻击命中都会立刻粉碎，必须及时捡回散骨复活以免全队瓦解",
      "dimension": "玩法",
      "excerpt": "But watch out - skeletons will immediately shatter if they take even a SINGLE hit. Don’t worry, skeletons never die. You can bring them back to life by collecting their scattered bones. Hurry to gather those bones before your entire team breaks apart!",
      "url": "https://store.steampowered.com/app/3349800/",
      "label": "证据原文片段"
    },
    {
      "text": "首领战之间会插入随机事件，事件奖励可继续强化骷髅牌组",
      "dimension": "玩法",
      "excerpt": "Encounter a variety of events between boss battles. Enhance your deck with the rewards you earn from these events!",
      "url": "https://store.steampowered.com/app/3349800/",
      "label": "证据原文片段"
    }
  ],
