  "hooks": [
    {
      "text": "退休老人只想安静玩数独，却被邻居不断打扰，只好克隆、变异单位并把入侵者全部吓走",
      "dimension": "故事",
      "excerpt": "After a long and laborious life, Mr. Gaffer just wants to spend his days playing sudoku, far away from anything that bothers him. But his peace is constantly interrupted by his annoying neighbors, so he'll have to face one last battle. It's time to clone, mutate, and scare them all away!",
      "url": "https://store.steampowered.com/app/3165500/",
      "label": "证据原文片段"
    },
    {
      "text": "三种差异舞台组成90关，通关后还能进入动态生成的无尽模式或极高难度噩梦模式继续挑战",
      "dimension": "玩法",
      "excerpt": "Stages: 3 completely different stages with unique features, for a total of 90 levels! Endless Mode: In this mode, you can play dynamically generated levels. How far will you go? Nightmare Mode: Ultra-challenging levels where your skills will be tested to the max.",
      "url": "https://store.steampowered.com/app/3165500/",
      "label": "证据原文片段"
    },
    {
      "text": "内置可调难度的完整数独游戏，解题不仅让Mr. Gaffer开心，还能为主防守流程赚取额外奖励",
      "dimension": "玩法",
      "excerpt": "Sudoku: To keep Mr. Gaffer happy, we’ve included a fully functional sudoku game where you can customize the difficulty and earn extra rewards.",
      "url": "https://store.steampowered.com/app/3165500/",
      "label": "证据原文片段"
    }
  ],
