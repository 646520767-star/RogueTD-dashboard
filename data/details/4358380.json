  "hooks": [
    {
      "text": "六边形地块不受地形限制，可依直觉自由摆放",
      "dimension": "玩法",
      "excerpt": "Unlike other city- and hex-tile building games, in Qianli you won’t be limited by any terrain restrictions. Place each piece freely, following only your instinct. You may be chasing a high score, or simply enjoying a peaceful session of beauty and creation: the choice is yours.",
      "url": "https://store.steampowered.com/app/4358380/",
      "label": "证据原文片段"
    },
    {
      "text": "道路接水生成码头，山峰旁小径显现古寺门扉",
      "dimension": "玩法",
      "excerpt": "But magic happens when certain tiles meet: a path reaching water forms a dock, a trail near a famed peak reveals the gates of an ancient temple.",
      "url": "https://store.steampowered.com/app/4358380/",
      "label": "证据原文片段"
    },
    {
      "text": "以《千里江山图》为源的中国水墨青绿画卷",
      "dimension": "画风",
      "excerpt": "Qianli: The Vastscape Scroll offers its unique twist to the genre along with a breathtaking art style, inspired by A Thousand Li of Rivers and Mountains, one of the most beautiful masterpieces of Chinese ink and watercolor art.",
      "url": "https://store.steampowered.com/app/4358380/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
