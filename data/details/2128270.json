  "hooks": [
    {
      "text": "混合文化、职业与宗教，组合出1000多种开局英雄",
      "dimension": "玩法",
      "excerpt": "Merge culture, class and religion to establish a starting hero, unlock more options as you play, with 1000+ potential combinations",
      "url": "https://store.steampowered.com/app/2128270/",
      "label": "证据原文片段"
    },
    {
      "text": "从50多种元素能力与带特殊效果的武器护甲中自由配装",
      "dimension": "玩法",
      "excerpt": "Customize your hero with 50+ elementally-aligned powers such as Pyrokinesis, Necromancy, Blood Retort, Obedient Ice... Discover and freely equip unique weapons and armor with impactful abilities",
      "url": "https://store.steampowered.com/app/2128270/",
      "label": "证据原文片段"
    },
    {
      "text": "叠加触发效果制造破格构筑，让藤蔓穿刺联动闪电或传送心灵光束",
      "dimension": "玩法",
      "excerpt": "Explosive synergies await... A \"broken build sandbox\" - create devastating combos by combining triggered effects. Shoot bolts of lightning when you pierce enemies with vines, teleport while emitting psychic beams, etc...",
      "url": "https://store.steampowered.com/app/2128270/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "视觉外观非常丑陋。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "its really ugly looking",
          "url": "https://steamcommunity.com/id/Gamer_In_Crisis/recommended/2128270/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "复古审美和怀旧感仍然讨喜。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "I still like the aesthetic and retro nostalgia",
          "url": "https://steamcommunity.com/id/mgsygaming/recommended/2128270/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "音效设计表现满分。",
      "dimension": "音频",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Sound Design 10/10",
          "url": "https://steamcommunity.com/profiles/76561198032083511/recommended/2128270/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "游戏几乎会自行运行，令人无聊。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "There's not a lot to actually do in game, it plays itself",
          "url": "https://steamcommunity.com/id/hankjwebaltin/recommended/2128270/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "实际操作参与度很低。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The lack of input from the player become readily apparent",
          "url": "https://steamcommunity.com/id/Orangebluehue/recommended/2128270/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "开局一次性倾倒过量信息。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the game throw a metric ♥♥♥♥ ton of information about stats, character classes/races, items",
          "url": "https://steamcommunity.com/id/MetaKnightmare25/recommended/2128270/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "构筑判断所需信息量过大。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "there's just too much information to dive into to determine whether a build is successful or not",
          "url": "https://steamcommunity.com/id/mgsygaming/recommended/2128270/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "战斗体验浅薄，大多数时间只需按TAB。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the actual gameplay experience is shallow and doesn't offer much since you're just going to be pressing TAB most of the time",
          "url": "https://steamcommunity.com/id/Orangebluehue/recommended/2128270/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "多数跑局体验趋同。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "most runs end up feeling pretty samey",
          "url": "https://steamcommunity.com/id/mgsygaming/recommended/2128270/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "实际游玩缺乏乐趣。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "playing it doesn't inspire much joy",
          "url": "https://steamcommunity.com/id/mgsygaming/recommended/2128270/",
          "label": "证据原文片段"
        }
      ]
    }
