          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "NPC事件每次回城只触发一个，流程繁琐",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Only getting one NPC event per return to the academy is really annoying.",
          "url": "https://steamcommunity.com/id/Eryvac9638/recommended/1793330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "治疗资源过于有限",
