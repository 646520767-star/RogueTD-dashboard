  "hooks": [
    {
      "text": "战斗中采集并现场炼药，可饮用、投掷或装入药水枪产生三种用途",
      "dimension": "玩法",
      "excerpt": "Gather ingredients and brew them up into powerful potions in the midst of battle! Use the potions to climb further into The Tower, by drinking and temporarily boosting yourself, throwing to affect the enemies and environment around you, or loading into your weapon to upgrade your potion gun!",
      "url": "https://store.steampowered.com/app/1793330/",
      "label": "证据原文片段"
    },
    {
      "text": "用药水能力叠出连招，再靠徽章与新配方塑造个人炼金流派",
      "dimension": "玩法",
      "excerpt": "Achieve mastery over alchemy by utilizing potion abilities to create fierce combos! Unlock unique badges and learn new potion recipes to create your own unique playstyle!",
      "url": "https://store.steampowered.com/app/1793330/",
      "label": "证据原文片段"
    },
    {
      "text": "与同学和教授聊天、送礼与相处，用友谊推进炼金学院生活",
      "dimension": "故事",
      "excerpt": "Get to know your fellow classmates and professors. Converse with them, try to impress them with a gift or spend your days hanging out with them! Deepening your friendships is the key to enjoying the student life at the Alchemy Academy!",
      "url": "https://store.steampowered.com/app/1793330/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
