  "hooks": [
    {
      "text": "疯狂系统会扭曲视听并在队伍中制造猜疑，玩家逐渐无法确认眼前是真实还是幻觉。",
      "dimension": "玩法",
      "excerpt": "Unpredictable threats distort your senses, blur the line between reality and illusion, and sow paranoia within your group. Soon you can no longer trust what you see and what you hear.",
      "url": "https://store.steampowered.com/app/2569760/",
      "label": "证据原文片段"
    },
    {
      "text": "每次出航前与船长签契约，用带回的宝藏换装备，再由队伍分配武器并选择丛林区域。",
      "dimension": "玩法",
      "excerpt": "Sign a contract with the captain to receive gear in exchange for the treasures you bring back, split weapons and equipment among your party, and choose which area of the jungle to explore next.",
      "url": "https://store.steampowered.com/app/2569760/",
      "label": "证据原文片段"
    },
    {
      "text": "用空间语音在危险中定位协作，找到废弃堡垒日志后还能把堡垒解锁为后续远征起点。",
      "dimension": "玩法",
      "excerpt": "Once on the mainland, you are on your own, relying on spatialized voice chat to coordinate against unpredictable threats and gather what riches you can. Discover abandoned forts during your expedition and recover their logbooks to unlock them as new starting point for future expeditions.",
      "url": "https://store.steampowered.com/app/2569760/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "怪物类型过度使用僵尸，洛夫克拉夫特式恐怖不足",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "it over uses zombies and not enough Lovecraftian horrors",
          "url": "https://steamcommunity.com/profiles/76561198055300240/recommended/2569760/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "美术与氛围表现极佳",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The game's aesthetic and atmosphere is absolutely supreme.",
          "url": "https://steamcommunity.com/profiles/76561198055300240/recommended/2569760/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "多捡财宝没有额外收益，削弱深入探索动力",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "多捡财宝没有收益达到任务目标就可以撤，多给的15的代币根本没用，没有深入探索的动力",
          "url": "https://steamcommunity.com/profiles/76561198297645286/recommended/2569760/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "新地图参照物不足，容易迷路",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "地图可用参照物不多，不带地图经常迷路",
          "url": "https://steamcommunity.com/profiles/76561198297645286/recommended/2569760/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "远征之间几乎没有保留内容，缺少长期成长",
