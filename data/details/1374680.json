  "hooks": [
    {
      "text": "一至四人靠近距离语音在裂隙中协作，还能自由选择第一或第三人称视角。",
      "dimension": "玩法",
      "excerpt": "1–4 PLAYER SURVIVAL WITH PROX CHAT Play solo or with up to three friends to tackle the horrors of each rift. Coordination is key, survival is not guaranteed. Proximity voice chat enabled. Supports both third and first person play.",
      "url": "https://store.steampowered.com/app/1374680/",
      "label": "证据原文片段"
    },
    {
      "text": "裂隙每次重组生态、布局和随机危险，深入后威胁持续升级并迫使队伍改计划。",
      "dimension": "玩法",
      "excerpt": "No two expeditions are the same. Each rift generates new biomes, shifting layouts, randomised hazards, and escalating threats that force your team to adapt.",
      "url": "https://store.steampowered.com/app/1374680/",
      "label": "证据原文片段"
    },
    {
      "text": "重力手套能一次抓、搬和投掷多个物体，异界原料还要冒险运去裂隙站出售。",
      "dimension": "玩法",
      "excerpt": "Use the Gravity Gauntlet to grab, carry, and throw multiple objects at once. Harvest bizarre rift-grown ingredients and sell them at rift stations while surviving the creatures that stalk each dimension.",
      "url": "https://store.steampowered.com/app/1374680/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "闪烁的异空间特效会造成刺眼不适。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the flashing dimensions effects cause me and my friends while streaming the game was constantly being blinded",
          "url": "https://steamcommunity.com/profiles/76561198379647996/recommended/1374680/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "当前版本Bug较多。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "there is a lot of bugs in the game",
          "url": "https://steamcommunity.com/profiles/76561198379647996/recommended/1374680/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "目标不清晰，削弱了继续刷取的动力。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "that the was no obvious goal why we was going on these crawls",
          "url": "https://steamcommunity.com/profiles/76561198379647996/recommended/1374680/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "缺少新手引导导致上手困难。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "这游戏目前最大的问题其实是没什么新手引导",
          "url": "https://steamcommunity.com/id/yvbanfan/recommended/1374680/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "当前缺乏持续成长感。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "without any sense of progression",
          "url": "https://steamcommunity.com/id/Gnomenclature0/recommended/1374680/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "敌人与玩家能力失衡，限制了有效玩法。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "新手引导的缺失，和敌人与我方的不平衡强度就限制了游戏的玩法",
          "url": "https://steamcommunity.com/id/yvbanfan/recommended/1374680/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "怪物带来的紧张感有效。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the monsters stay tense",
          "url": "https://store.steampowered.com/curator/45167821-Gaming-Pulse/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "与朋友共同游玩总体有趣。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "overall, it’s fun to play with friends.",
          "url": "https://steamcommunity.com/id/holdown/recommended/1374680/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "与同类作品相比仍能提供不同体验。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "it is different enough from REPO at the moment where if I'm playing REPO, and I get bored of it, I could happily come to this game and play something similar, but have a different experience and vice versa.",
          "url": "https://steamcommunity.com/profiles/76561198389047104/recommended/1374680/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
