  "hooks": [
    {
      "text": "武器与无人机自动射击，玩家仍要破解、冲刺和掐点放技能",
      "dimension": "玩法",
      "excerpt": "Your weapons and drones fight for you, auto-shooting the endless enemies. You'll still be busy though hacking devices, dashing out of bullet hells, and using timely special abilities!",
      "url": "https://store.steampowered.com/app/2738940/",
      "label": "证据原文片段"
    },
    {
      "text": "可购买追踪与爆炸词条，并把武器升级成巨型版本",
      "dimension": "玩法",
      "excerpt": "Weapons are also affected by buyable traits such as making all projectiles home-in or explode in boomy fires! Weapons can even be upgraded to form powerful mega weapons!",
      "url": "https://store.steampowered.com/app/2738940/",
      "label": "证据原文片段"
    },
    {
      "text": "主动技能甚至可召更多敌人，用风险换额外资源",
      "dimension": "玩法",
      "excerpt": "Equip abilities to manually trigger a variety of special effects, such as spawn friendly droids, heal, or spawn more enemies to boost your resources!",
      "url": "https://store.steampowered.com/app/2738940/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "界面切换时出现噪点般画面，观看不适。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "切换界面时画面会像噪点一样，看着不舒服",
          "url": "https://steamcommunity.com/id/YeezusDY/recommended/2738940/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "原有画风让老玩家感到熟悉。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "如同老家一般熟悉的画风",
          "url": "https://steamcommunity.com/id/za_warudo/recommended/2738940/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "武器特质获取缺少自主性。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "you have very little agency when it comes to acquiring these traits",
          "url": "https://steamcommunity.com/id/GodofDucks/recommended/2738940/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "该Boss缺乏创意且非常无聊",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the least inspired and most boring boss I think I have ever faced",
          "url": "https://steamcommunity.com/id/GodofDucks/recommended/2738940/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "锁定物品可能占用商店选项",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Your shop options can be taken up with locked items!",
          "url": "https://steamcommunity.com/id/GodofDucks/recommended/2738940/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "实际运行时很难看清哪些系统正在生效。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "It's a bit hard to see what's actually working",
          "url": "https://steamcommunity.com/profiles/76561197990898412/recommended/2738940/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "多个系统操作别扭或缺乏乐趣。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Lots of systems exist in this game that are awkward or just unfun.",
          "url": "https://steamcommunity.com/id/GodofDucks/recommended/2738940/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "内容量与独特性足以和前作区分。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "lots of content and enough unique about it to differentiate itself from Boneraiser Minions",
          "url": "https://steamcommunity.com/id/hray9/recommended/2738940?snr=1_5_9__402",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "游戏节奏快且兼具乐趣与挑战。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The game moves pretty fast; a lot faster than many other games in the genre. Fun and challenging survivors-like.",
          "url": "https://store.steampowered.com/curator/39664028-Fire-Under-Five/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
