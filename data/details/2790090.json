  "hooks": [
    {
      "text": "取消固定职责与硬克制，并允许比赛中途更换能力即时重组战术",
      "dimension": "玩法",
      "excerpt": "Ditch the roles, hard counters and last hits in Sirocco. Rally your team as you swap abilities mid-match, load up auto-firing weapons , and craft strategies on the fly.",
      "url": "https://store.steampowered.com/app/2790090/",
      "label": "证据原文片段"
    },
    {
      "text": "自动开火与经济系统把重点从补刀NPC转向团战和站位",
      "dimension": "玩法",
      "excerpt": "Sirocco utilizes an auto-fire mechanic and economic system that promotes team fighting and positioning over last hitting NPCs.",
      "url": "https://store.steampowered.com/app/2790090/",
      "label": "证据原文片段"
    },
    {
      "text": "团队经济确保无论个人战绩10比0还是0比10，每名队友仍对胜利关键",
      "dimension": "玩法",
      "excerpt": "In Sirocco, teams win, not individuals, so whether you are 10-0 or 0-10, our economic system ensures all your friends are critical to achieving victory.",
      "url": "https://store.steampowered.com/app/2790090/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "声音设计强化张力、冲击与临场感",
      "dimension": "音频",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The sound design helps build tension, deliver impact, and make each moment feel alive on the water.",
          "url": "https://steamcommunity.com/id/Darroweve/recommended/2790090/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "舰船设计各具个性。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the boat designs? Just awesome.",
          "url": "https://steamcommunity.com/id/Darroweve/recommended/2790090/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "同类武器不能重复使用",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "武器只能2个，同样的武器还不能用，技能比武器强",
          "url": "https://steamcommunity.com/id/249009092/recommended/2790090/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "中程武器偏弱，远程武器主导战斗",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Mid-range weapons feel particularly underpowered—right now, the combat meta is dominated by long-range weapons.",
          "url": "https://steamcommunity.com/profiles/76561198013535636/recommended/2790090/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "匹配等待至少五分钟",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "一匹配就5分钟起步，还没有亚洲服务器。",
          "url": "https://steamcommunity.com/id/yjfuy/recommended/2790090/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "友方与敌方技能难以区分",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "it's hard to tell the difference between teammate and enemy abilities",
          "url": "https://steamcommunity.com/id/Darroweve/recommended/2790090/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "高分段排队时间可能较长",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Queue times, especially at higher MMR, can get long.",
          "url": "https://steamcommunity.com/id/Darroweve/recommended/2790090/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "可探索的玩法风格很多",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Lots of fun playstyles to explore",
          "url": "https://store.steampowered.com/curator/34183438-JabberJon%2527s-Hideout/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "不同舰船身份明确，覆盖刺客、坦克、辅助和远程等玩法。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "each with a clear identity and purpose — from assassin-style boats to tanky frontliners, supportive builds, long-range snipers, and close-combat bruisers.",
          "url": "https://steamcommunity.com/id/Darroweve/recommended/2790090/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "游戏容易让玩家长时间沉浸投入",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "I've sat and played all day without realizing it.",
          "url": "https://steamcommunity.com/profiles/76561198041321203/recommended/2790090/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
