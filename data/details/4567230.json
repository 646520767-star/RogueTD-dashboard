  "hooks": [
    {
      "text": "每局矿井重新生成，需同时管理体力、有限背包和倒计时，把矿物运回容器才能转化为下局深挖能力",
      "dimension": "玩法",
      "excerpt": "Carve through a freshly generated mine every time, manage your stamina and limited backpack space, haul your finds back to the container before time runs out, and turn every successful trip into upgrades that let you dig deeper on the next run.",
      "url": "https://store.steampowered.com/app/4567230/",
      "label": "证据原文片段"
    },
    {
      "text": "流程明确取消死亡和损失惩罚，把撤离采矿设计成不会真正惩罚玩家的舒适旅程",
      "dimension": "题材",
      "excerpt": "You cannot die, you cannot lose. This is a cozy journey that never actually punishes you. (And you can touch cows)",
      "url": "https://store.steampowered.com/app/4567230/",
      "label": "证据原文片段"
    },
    {
      "text": "收集册追踪四百余种发现物，完整收集后可成为地下大师",
      "dimension": "玩法",
      "excerpt": "Collections - Keep track of your discoveries and complete the full collection of 400+ items to become the Master of the Underground.",
      "url": "https://store.steampowered.com/app/4567230/",
      "label": "证据原文片段"
    }
  ],
