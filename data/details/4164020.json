  "hooks": [
    {
      "text": "随机神明授予八十种秘技构筑每局能力组合",
      "dimension": "玩法",
      "excerpt": "A roguelike action game where you grow stronger with each run! Obtain Secret Skills from gods who randomly appear as you progress through the stages to boost your abilities and stats! With a whopping 80 different Secret Skills available, discover your ultimate build and mow down the swarms of enemies!",
      "url": "https://store.steampowered.com/app/4164020/",
      "label": "证据原文片段"
    },
    {
      "text": "悟空速度、八戒力量与悟净远程三种战斗风格切换",
      "dimension": "玩法",
      "excerpt": "Master 3 distinct fighting styles! You'll start with only the speed-focused Sun Wukong, but as you progress through the story, you'll unlock the power-focused Zhu Bajie and the long-range Sha Wujing! Freely choose between the three Kunios and utilize their unique traits to conquer each stage!",
      "url": "https://store.steampowered.com/app/4164020/",
      "label": "证据原文片段"
    },
    {
      "text": "热血系列角色改演西游人物并轮流助战或担任Boss",
      "dimension": "故事",
      "excerpt": "Familiar faces from the River City series join the fray! Series regulars make their appearances one after another as characters from Journey to the West! Sometimes they will aid Kunio's crew on their journey, while other times they will stand in your way as bosses... Don't miss the hilarious banter that unfolds throughout the story!",
      "url": "https://store.steampowered.com/app/4164020/",
      "label": "证据原文片段"
    }
  ],
