  "hooks": [
    {
      "text": "聚落必须赶在Ginnungagap吞噬前推进，失败后带着知识重启循环",
      "dimension": "玩法",
      "excerpt": "Players’ settlements will constantly be in a race against time to avoid the Ginnungagap. Each failure will bring them back to the beginning of their adventure, where they can start anew with more knowledge and a better mastery of the game mechanics.",
      "url": "https://store.steampowered.com/app/2071430/",
      "label": "证据原文片段"
    },
    {
      "text": "永久可定制枢纽Holt解锁新机制与跨局升级，帮助部族重建",
      "dimension": "玩法",
      "excerpt": "The Holt is your permanent, customizable home and acts as the main hub of the game. Unlock new mechanics and permanent upgrades that will help you rebuild your tribe!",
      "url": "https://store.steampowered.com/app/2071430/",
      "label": "证据原文片段"
    },
    {
      "text": "每轮开始增删建筑卡，牌组直接决定该循环可用建筑与发展机会",
      "dimension": "玩法",
      "excerpt": "Before each run, add and remove building cards to your deck to create different challenges and opportunities each time.",
      "url": "https://store.steampowered.com/app/2071430/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "控制器支持故障到无法使用。",
