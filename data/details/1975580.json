  "hooks": [
    {
      "text": "白天采资源修马车，夜里守车还要维持篝火",
      "dimension": "玩法",
      "excerpt": "While daytime is all about collecting resources and improving your trusty wagon, things get risky during the night. When the sun sets, bandit bunnies and badgers rally to attack! The feline friends must defend their wagon while ensuring their beacon fire does not die out.",
      "url": "https://store.steampowered.com/app/1975580/",
      "label": "证据原文片段"
    },
    {
      "text": "可叠加高风险挑战换大奖，也可走安全采集路线",
      "dimension": "玩法",
      "excerpt": "Extra rewards await if they decide to go for challenging encounters! Will you keep stacking challenges to try and go for the biggest prize? On the other hand, going a safer route might allow for more risk-free collection of resources.",
      "url": "https://store.steampowered.com/app/1975580/",
      "label": "证据原文片段"
    },
    {
      "text": "一至四人可本地、纯在线或本地在线混合合作",
      "dimension": "玩法",
      "excerpt": "Multiplayer sessions in Wild Woods can be played locally, fully online, or with a mix of local and online players!",
      "url": "https://store.steampowered.com/app/1975580/",
      "label": "证据原文片段"
    }
  ],
