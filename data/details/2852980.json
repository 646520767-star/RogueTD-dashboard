  "hooks": [
    {
      "text": "用骷髅牌组召起亡灵军团",
      "dimension": "玩法",
      "excerpt": "Build your skulls deck, raise skeletons and other scum to defeat settlements desecrated by life.",
      "url": "https://store.steampowered.com/app/2852980/",
      "label": "证据原文片段"
    },
    {
      "text": "指挥三十余种亡灵兵种",
      "dimension": "玩法",
      "excerpt": "Harness the dark powers of necromancy and command an army of more than 30 undead minion types.",
      "url": "https://store.steampowered.com/app/2852980/",
      "label": "证据原文片段"
    },
    {
      "text": "手工像素世界演绎死灵征服",
      "dimension": "画风",
      "excerpt": "Pixel Art Visuals . Immerse yourself in a beautifully hand-crafted world brought to life through stunning pixel-art graphics.",
      "url": "https://store.steampowered.com/app/2852980/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "战斗音乐单调无聊。",
      "dimension": "音频",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the \"music\" during the fights, even the boss fights, is just really boring",
          "url": "https://steamcommunity.com/id/yaddah/recommended/2852980/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "美术风格让人联想到《循环英雄》并成为购买动力。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The art style reminded me of loop hero -which was one of the primary reasons i bought it.",
          "url": "https://steamcommunity.com/profiles/76561199105332300/recommended/2852980/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "当前体验非常乏味。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "It felt so dull in its current state.",
          "url": "https://store.steampowered.com/curator/41005226-CATS-GAMING-REVIEWS/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "游戏几乎不可能失败。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "impossible to lose",
          "url": "https://steamcommunity.com/profiles/76561198083805057/recommended/2852980/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "设计与宣传内容存在明显不符。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "POORLY DESIGNED AND FALSELY ADVERTISED",
          "url": "https://steamcommunity.com/id/RealGamerJL/recommended/2852980/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "后期体验越来越重复。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "后面越发重复",
          "url": "https://steamcommunity.com/profiles/76561198321363227/recommended/2852980/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "单位多样性因低难度而失去意义。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "There is a lot of unit variety, but it almost doesn't matter because the game is so easy",
          "url": "https://steamcommunity.com/id/yaddah/recommended/2852980/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "单位多数只是换皮且缺乏功能差异。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the vast majority of them are essentially reskins",
          "url": "https://steamcommunity.com/id/RealGamerJL/recommended/2852980/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "难度平衡几乎不存在。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "difficulty balance is practically non-existent",
          "url": "https://steamcommunity.com/id/RealGamerJL/recommended/2852980/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "战斗很快变得重复。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The fights become repetitive relatively quickly.",
          "url": "https://steamcommunity.com/id/yaddah/recommended/2852980/",
          "label": "证据原文片段"
        }
      ]
    }
