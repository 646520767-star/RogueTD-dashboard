      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "完全把测试时最重要的爽感给消磨掉了",
          "url": "https://steamcommunity.com/profiles/76561199081601072/recommended/3784030/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "道具格子过少限制构筑",
      "dimension": "玩法",
