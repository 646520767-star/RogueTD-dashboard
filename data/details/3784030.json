  "hooks": [
    {
      "text": "Seed Coin遇到Water Coin会在推币机里长出摇钱树，Cat Coin则会追猎所有Rat Coin换取额外票券",
      "dimension": "玩法",
      "excerpt": "Combine Seed Coins with Water Coins to grow a money tree right inside your machine. Drop a Cat Coin to hunt down every last Rat Coin and rack up extra tickets.",
      "url": "https://store.steampowered.com/app/3784030/",
      "label": "证据原文片段"
    },
    {
      "text": "一百五十件道具可改变整局走向，还能给常用硬币镀特殊涂层增强效果并解锁更狂野连招",
      "dimension": "玩法",
      "excerpt": "Uncover 150 unique items that can dramatically shift the course of your run. Stack multipliers, spawn coins with extra points, or simply shake the machine when you're running dry. Apply special plating to your favorite coins to enhance their effects and unlock even wilder combos.",
      "url": "https://store.steampowered.com/app/3784030/",
      "label": "证据原文片段"
    },
    {
      "text": "不同角色拥有主题硬币和独立玩法，例如浣熊经理专攻数学连锁，生物学家专攻动物硬币",
      "dimension": "玩法",
      "excerpt": "Play as one of several unique characters, each with their own set of themed coins and playstyle. Take on the role of a greedy raccoon manager who excels at math-based combos, or a quirky biologist who specializes in animal-based coins. Every character offers a fresh and wildly different way to play.",
      "url": "https://store.steampowered.com/app/3784030/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "多数特殊代币需要留在台面或到下一回合才生效",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "为什么大多数特殊代币一定要在台子上才生效甚至是下一回合生效",
          "url": "https://steamcommunity.com/profiles/76561198140788449/recommended/3784030/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "随机性会直接决定能否过关",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "随机性应该是决定我用什么方式通过这一关，而不是直接决定我能不能通过这一关",
          "url": "https://steamcommunity.com/profiles/76561198098754611/recommended/3784030/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "回合制限制了推币爽感",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "回合制确实有点限制爽点",
          "url": "https://steamcommunity.com/profiles/76561198368236399/recommended/3784030/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "正式版削弱了测试版的核心爽感",
