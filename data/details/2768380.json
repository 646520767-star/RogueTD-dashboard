  "hooks": [
    {
      "text": "把士兵、工程师或驯兽师骑到恐龙背上，每种人龙组合都有专属能力",
      "dimension": "玩法",
      "excerpt": "Assign human units (soldier, engineer, tamer) to one of your dinos and let them ride! Each human/dino combination has powerful and unique special abilities.",
      "url": "https://store.steampowered.com/app/2768380/",
      "label": "证据原文片段"
    },
    {
      "text": "让雌雄恐龙进入繁育站，后代可能突变，甚至鼓励跨种杂交",
      "dimension": "玩法",
      "excerpt": "Put a male/female pair of dinos in your breeding station and let nature do its thing! The offspring may surprise you. Cross breeding with genetic mutations is encouraged.",
      "url": "https://store.steampowered.com/app/2768380/",
      "label": "证据原文片段"
    },
    {
      "text": "用食物、干扰甚至求偶引诱敌对恐龙，驯服后反过来加入己方",
      "dimension": "玩法",
      "excerpt": "Lure in enemy dinosaurs with food, distractions, or sex. Once tamed, they will fight alongside you.",
      "url": "https://store.steampowered.com/app/2768380/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "美术表现一般且略显模糊。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "游戏的美术这方面确实一般，甚至有点糊糊的。",
          "url": "https://steamcommunity.com/profiles/76561198824787295/recommended/2768380/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "复古RTS美学受到高度赞赏。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "awesome retro RTS vibe and aesthetic",
          "url": "https://steamcommunity.com/profiles/76561197971691873/recommended/2768380/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "缺少快速编队工具",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Another issue is the absence of quick formation tools.",
          "url": "https://steamcommunity.com/id/Pawkt/recommended/2768380/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "DNA局外天赋效果弱，缺乏真实成长感。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The perks you can buy with DNA don't do much, and don't feel as if you're getting real progression",
          "url": "https://steamcommunity.com/profiles/76561198001821238/recommended/2768380/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "地图解锁要求反复挑战同一地图。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "creating a grind system where you have to replay the same maps on higher difficulties",
          "url": "https://steamcommunity.com/id/our_lady_in_shadow/recommended/2768380/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "自有建筑无法驻军限制了战术选择。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "there’s no option to garrison your units inside watch towers or most of the buildings you construct.",
          "url": "https://steamcommunity.com/id/Pawkt/recommended/2768380/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "玩法具有吸引力。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "really engaging gameplay.",
          "url": "https://store.steampowered.com/curator/45013120-Kitty-Cat-Reviews/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "资源管理执行出色",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Executed well with hectic battles & surprisingly good resource management.",
          "url": "https://www.cshpicone.com/gaming/bite-sized-game-reviews/bsr-repterra",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "游戏能提供严肃挑战",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "still manages to deliver a serious challenge",
          "url": "https://steamcommunity.com/id/Pawkt/recommended/2768380/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "多种系统并未让玩法过度复杂，仍易于上手。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Despite the variety, Repterra isn’t bogged down by complexity. It’s accessible",
          "url": "https://steamcommunity.com/id/Pawkt/recommended/2768380/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
