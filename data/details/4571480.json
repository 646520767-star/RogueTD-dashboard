  "hooks": [
    {
      "text": "把建筑卡拖入网格后会自动产兵，相同建筑还能叠成更高星级来强化部队。",
      "dimension": "玩法",
      "excerpt": "drag building cards from your hand onto the construction grid, and buildings automatically produce units for battle. Stack identical buildings to upgrade their star level—the higher the star, the stronger the units.",
      "url": "https://store.steampowered.com/app/4571480/",
      "label": "证据原文片段"
    },
    {
      "text": "萌军依靠高科技装备与精锐单位，肃军强调机械蛮力，两边拥有专属兵种和建筑卡。",
      "dimension": "玩法",
      "excerpt": "Moe Army excels with high-tech gear and elite units, while Su Army dominates with mechanized brute force. From light skirmishers to heavy fortresses, from ground assaults to aerial support, each faction has exclusive units and building cards.",
      "url": "https://store.steampowered.com/app/4571480/",
      "label": "证据原文片段"
    },
    {
      "text": "网格布局要在集中升星和扩大生产之间取舍，每次建造都会改变军队结构。",
      "dimension": "玩法",
      "excerpt": "Plan your layout wisely: focus on upgrading or spread your production? Every build decision shapes your army.",
      "url": "https://store.steampowered.com/app/4571480/",
      "label": "证据原文片段"
    }
  ],
