      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Visually beautiful and engaging game",
          "url": "https://steamcommunity.com/profiles/76561198287224508/recommended/2849680/",
          "label": "证据原文片段"
        }
      ]
    },
