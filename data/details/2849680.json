  "hooks": [
    {
      "text": "自动开火，只操纵城市炮塔与清屏核弹",
      "dimension": "玩法",
      "excerpt": "Easy To Learn : firing happens automatically, just steer the city's turret and launch the occasional sky-clearing nuclear warhead.",
      "url": "https://store.steampowered.com/app/2849680/",
      "label": "证据原文片段"
    },
    {
      "text": "升级树可走轨道炮、护盾、无人机或核武路线",
      "dimension": "玩法",
      "excerpt": "Sizable Upgrade Tree : progress is fast and allows you to pick strategies to suit your playing style — beef up your rail gun into a multi-barrel death machine, strengthen your shield's auto defense abilities, deploy and configure an array of autonomous battle drones and laser turrets, or go all out on aggression and see out Utopia's final days with a stockpile of nukes and a shotgun the size of a building.",
      "url": "https://store.steampowered.com/app/2849680/",
      "label": "证据原文片段"
    },
    {
      "text": "自研V99引擎呈现复古现代矢量街机画面",
      "dimension": "画风",
      "excerpt": "Laser-Shiny : built with our own V99 graphics engine, bringing you the retro-modern vector arcade style you didn't know you needed yet.",
      "url": "https://store.steampowered.com/app/2849680/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "视觉表现漂亮且有吸引力。",
