  "hooks": [
    {
      "text": "无需真实充值也能模拟战力暴涨与满屏掉落",
      "dimension": "玩法",
      "excerpt": "No need for actual recharges. You can still enjoy the pay - to - win - level excitement of skyrocketing combat power and full - screen item drops .",
      "url": "https://store.steampowered.com/app/3861280/",
      "label": "证据原文片段"
    },
    {
      "text": "古今灵体组合会触发专属羁绊并决定战力上限",
      "dimension": "玩法",
      "excerpt": "Different spirit beings can trigger exclusive synergy effects when combined. Strengthen and upgrade the spirit beings to create your own “overpowered team”. Strategic combinations determine the upper limit of your combat effectiveness!",
      "url": "https://store.steampowered.com/app/3861280/",
      "label": "证据原文片段"
    },
    {
      "text": "通关后把全部进度转为启动点并继承到无限周目",
      "dimension": "玩法",
      "excerpt": "All gameplay progress (tasks, kills, equipment, collections, lottery times...) will be converted into “start - up points” and inherited to the next new game after clearing the current one! Use the points to directly start the “high - speed level - clearing mode”, clearing one level per second and skipping the development stage.",
      "url": "https://store.steampowered.com/app/3861280/",
      "label": "证据原文片段"
    }
  ],
