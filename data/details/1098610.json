  "hooks": [
    {
      "text": "在巨型游戏公司一路攀升，把职场内耗做成卡组爬塔",
      "dimension": "题材",
      "excerpt": "Work your way to the top of a cutthroat game studio in this retro roguelike deckbuilder!",
      "url": "https://store.steampowered.com/app/1098610/",
      "label": "证据原文片段"
    },
    {
      "text": "200多种技能与天赋叠加不断变化的日程，让每次职业生涯都不同",
      "dimension": "玩法",
      "excerpt": "Build Your Deck : Over 200 skills & talents with an ever-changing schedule ensures that every career run will be unique !",
      "url": "https://store.steampowered.com/app/1098610/",
      "label": "证据原文片段"
    },
    {
      "text": "滚动生命值、失控理智与循环抽牌共同制造高压连招决策",
      "dimension": "玩法",
      "excerpt": "The rolling health system will keep you on your toes while your sanity may result in unpredictable effects. Cycling allows you to strategically draw new skills and prepare satisfying combos.",
      "url": "https://store.steampowered.com/app/1098610/",
      "label": "证据原文片段"
    }
  ],
