  "hooks": [
    {
      "text": "所有玩家每天面对同一组地牢，可直接比较各自在当日布局中的探索表现。",
      "dimension": "玩法",
      "excerpt": "Every player gets the same dungeons each day — see how you fare against others!",
      "url": "https://store.steampowered.com/app/4579170/",
      "label": "证据原文片段"
    },
    {
      "text": "撤离成功带回的物品永久保留，留在地牢中的装备则永久失去。",
      "dimension": "玩法",
      "excerpt": "Whatever you bring back, you keep. Whatever the dungeon keeps, it keeps forever.",
      "url": "https://store.steampowered.com/app/4579170/",
      "label": "证据原文片段"
    },
    {
      "text": "光照、噪音和弹药都会影响生存，玩家需判断正面交战还是潜行绕过敌人。",
      "dimension": "玩法",
      "excerpt": "Light matters. Noise matters. Ammunition matters. Engage enemies for think you can beat — or sneak by them if you can't.",
      "url": "https://store.steampowered.com/app/4579170/",
      "label": "证据原文片段"
    }
  ],
