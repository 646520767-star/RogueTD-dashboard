  "hooks": [
    {
      "text": "四名特工追查设施秘密与个人谜团",
      "dimension": "故事",
      "excerpt": "Step into the shoes of Agents Red, Boy Scout, Beaker, and Scalpel, as they fight to unearth the buried secrets of Section 13… and solve a few personal mysteries of their own.",
      "url": "https://store.steampowered.com/app/2111870/",
      "label": "证据原文片段"
    },
    {
      "text": "单人或三人小队可开启友军伤害",
      "dimension": "玩法",
      "excerpt": "Tackle the mission solo or with up to two squad-mates. And with optional friendly fire, it’s up to you whether you’d like a more forgiving experience, or chaotic fun with mad-science weapons.",
      "url": "https://store.steampowered.com/app/2111870/",
      "label": "证据原文片段"
    },
    {
      "text": "恐惧值过高会在任务中触发恐慌发作",
      "dimension": "玩法",
      "excerpt": "But keep an eye on your Fear level, or risk a debilitating mid-mission panic attack!",
      "url": "https://store.steampowered.com/app/2111870/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "关卡布局不随机。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Doesn't randomize it's level layout",
          "url": "https://steamcommunity.com/id/StrangelyEroticSoda/recommended/2111870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "可用枪械数量有限。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Limited number of guns",
          "url": "https://steamcommunity.com/id/stabyermaw/recommended/2111870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "闪避无法穿过敌人，容易被身体堵死。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the dodge doesn't go through them",
          "url": "https://steamcommunity.com/id/airuu/recommended/2111870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "换弹会被所有动作取消。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "reloading is cancelled by every action you perform",
          "url": "https://steamcommunity.com/id/stabyermaw/recommended/2111870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "随机技能质量差会导致后期无法推进。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "技能稍微出的烂点后期根本就没法玩",
          "url": "https://steamcommunity.com/profiles/76561198348634143/recommended/2111870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "地图布局基本固定。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the maps are also static",
          "url": "https://steamcommunity.com/profiles/76561198005864269/recommended/2111870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "武器平衡性极差。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "武器平衡性极差",
          "url": "https://steamcommunity.com/profiles/76561198348634143/recommended/2111870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "局内升级数量有限且受兑换券限制。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "limited number of per-run upgrades which are gated behind arbitrary \"coupons\"",
          "url": "https://steamcommunity.com/id/stabyermaw/recommended/2111870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "瞄准会把移动速度降至爬行。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "aiming so you make your hits count slows your movement to a crawl",
          "url": "https://steamcommunity.com/profiles/76561198005864269/recommended/2111870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "多数枪械单人模式无法正常使用。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Most guns are basically unusable solo",
          "url": "https://steamcommunity.com/id/stabyermaw/recommended/2111870/",
          "label": "证据原文片段"
        }
      ]
    }
