  "hooks": [
    {
      "text": "仅用摩斯输入与火炮两种控制，通过点划信号在动态字符网格上作战",
      "dimension": "玩法",
      "excerpt": "MORSE is a wave based strategy game elegantly operated with just two controls, Morse and Artillery: Enter dots and dashes to navigate an ever changing grid of letters and numbers.",
      "url": "https://store.steampowered.com/app/1976860/",
      "label": "证据原文片段"
    },
    {
      "text": "敌舰隐藏在黑暗中，炮击闪光既造成威胁也承担临时或永久照明侦察",
      "dimension": "玩法",
      "excerpt": "German ships are shrouded by the cover of darkness, illuminate their positions using the flash of your artillery strikes. Distant vessels will briefly brighten, land a blast close enough and warships will be permanently revealed.",
      "url": "https://store.steampowered.com/app/1976860/",
      "label": "证据原文片段"
    },
    {
      "text": "每波后用点或划二选一升级卡，叠加炮弹、水雷与侦察强化",
      "dimension": "玩法",
      "excerpt": "After successfully repelling each assault, pick between a pair of upgrade cards to bolster your arsenal, chosen with either a dot or a dash. Unlock new deadly types of artillery shell, improve your sea mines or enhance your reconnaissance. Upgrades stack so choose wisely!",
      "url": "https://store.steampowered.com/app/1976860/",
      "label": "证据原文片段"
    }
  ],
