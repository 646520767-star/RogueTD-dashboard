  "hooks": [
    {
      "text": "搜索隐藏Skull Altars强化武器、护甲与角色力量",
      "dimension": "玩法",
      "excerpt": "Unlock new weapons and armor and find hidden Skull Altars to upgrade your power., and arm yourself for the endless journey ahead.",
      "url": "https://store.steampowered.com/app/2259260/",
      "label": "证据原文片段"
    },
    {
      "text": "每次死亡后学习重来，挑战强度随尝试持续增加",
      "dimension": "玩法",
      "excerpt": "Fight, die, learn, and rise again as the challenge intensifies with every attempt.",
      "url": "https://store.steampowered.com/app/2259260/",
      "label": "证据原文片段"
    },
    {
      "text": "以粗粝低多边形视觉致敬PS1时代",
      "dimension": "画风",
      "excerpt": "Tyrants Realm is not just a roguelite, it’s a homage to the gritty, low-poly visuals of the PS1 era.",
      "url": "https://store.steampowered.com/app/2259260/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "PS1式视觉被部分玩家认为丑陋。",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Ugly visuals as a feature?",
          "url": "https://store.steampowered.com/curator/8036387-Gamers-for-pure-games/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "PS1画面与纹理很有魅力。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "very charming PS1 graphics and textures!",
          "url": "https://steamcommunity.com/profiles/76561198010779009/recommended/2259260/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "粗粝的复古画面很棒。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The crunchy graphics are great",
          "url": "https://steamcommunity.com/id/CLuch/recommended/2259260/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "最优解会把玩家导向相同构筑。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "railroad you into the same build every time",
          "url": "https://steamcommunity.com/id/CLuch/recommended/2259260/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "战斗控制过于不稳定。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "overly wonky combat control.",
          "url": "https://steamcommunity.com/id/CyanideHeadache/recommended/2259260/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "敌人种类明显不足。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "There is a distinct lack of enemy variety",
          "url": "https://steamcommunity.com/id/CLuch/recommended/2259260/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "锁定功能反而妨碍战斗。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "锁了不如不锁。",
          "url": "https://steamcommunity.com/id/OnlyAttack/recommended/2259260/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "锁定时角色会遮挡敌人动作。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "锁定的时候会直接挡住怪物的动作",
          "url": "https://steamcommunity.com/id/OnlyAttack/recommended/2259260/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "漏洞会直接毁掉整局。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "certain bugs being completely run-ruining.",
          "url": "https://steamcommunity.com/id/darkests_skies/recommended/2259260/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "护甲特效弱到难以影响玩法。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "didn't feel like the effects were big enough to impact the game noticeably.",
          "url": "https://steamcommunity.com/id/CLuch/recommended/2259260/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "鼠标控制会无故卡住。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The mouse controls seem to constantly get stuck for no reason",
          "url": "https://steamcommunity.com/id/darkests_skies/recommended/2259260/",
          "label": "证据原文片段"
        }
      ]
    }
