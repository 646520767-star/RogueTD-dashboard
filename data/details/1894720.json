  "hooks": [
    {
      "text": "把特技连段与击杀合并计分，落地后按整段分数直接结算经验。",
      "dimension": "玩法",
      "excerpt": "Combine your trick combo with kills to earn even more points. Once you land your combo, gain experience points as high as the combo score.",
      "url": "https://store.steampowered.com/app/1894720/",
      "label": "证据原文片段"
    },
    {
      "text": "恶魔赐礼以卡牌形式出现，玩家按构筑需要选牌组建本局牌组。",
      "dimension": "玩法",
      "excerpt": "Demonic Offerings come in the form of cards. Build your deck by choosing the right cards for your build.",
      "url": "https://store.steampowered.com/app/1894720/",
      "label": "证据原文片段"
    },
    {
      "text": "驾驶链锯动力越野摩托在怪物竞技场完成翻转、抓板、磨杆与手动平衡连招。",
      "dimension": "玩法",
      "excerpt": "Ride your chainsaw driven pit bike through a monster filled arena! Perform gnarly tricks like flips, grabs, grinds and manuals and combine them all into the sickest combo the underworld has ever seen.",
      "url": "https://store.steampowered.com/app/1894720/",
      "label": "证据原文片段"
    }
  ],
