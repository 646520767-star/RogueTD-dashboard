  "hooks": [
    {
      "text": "升级武器与魔王遗物塑造战斗风格，让独特攻击节奏和遗物强化触发连锁反应",
      "dimension": "玩法",
      "excerpt": "Purchase and upgrade a wide variety of weapons and Demon King relics to craft your own combat style. Each weapon has its own attack rhythm, projectile effects, and humorous personality, while relic enhancements can trigger unexpected and wildly satisfying chain reactions.",
      "url": "https://store.steampowered.com/app/3902210/",
      "label": "证据原文片段"
    },
    {
      "text": "每座地牢拥有独立规则、环境、机制和Boss，直接改变战斗节奏与挑战方式",
      "dimension": "玩法",
      "excerpt": "Every dungeon features its own unique rules. Different environments, mechanics, and bosses create completely different combat pacing and challenges.",
      "url": "https://store.steampowered.com/app/3902210/",
      "label": "证据原文片段"
    },
    {
      "text": "破败小村聚集荒诞又讨喜的魔族角色，以奇幻喜剧包装征服旅程",
      "dimension": "题材",
      "excerpt": "This is Laby’s Village—a little run-down, yet full of absurd and lovable characters. A world filled with humor, weirdness, and adventure.",
      "url": "https://store.steampowered.com/app/3902210/",
      "label": "证据原文片段"
