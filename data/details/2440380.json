  "hooks": [
    {
      "text": "丢弃装备时吸收其神话力量，在战斗中即时把淘汰物转成短期增幅",
      "dimension": "玩法",
      "excerpt": "Continuously manage your loot to become stronger right in the battle by absorbing the mythical power of the items you discard - even if for a mere moment, but with dedication it’s enough to ascend to near godhood and kill whatever twisted creature stands in your way.",
      "url": "https://store.steampowered.com/app/2440380/",
      "label": "证据原文片段"
    },
    {
      "text": "寻找重铸装备获取独特强化，并放逐多余战利品刷新商店选项",
      "dimension": "玩法",
      "excerpt": "Use potions and tomes to boost your power, seek out reforged items for unique and enhanced gear, and banish excess loot to refresh the shop with better options.",
      "url": "https://store.steampowered.com/app/2440380/",
      "label": "证据原文片段"
    },
    {
      "text": "150余件战利品与27余项属性、Keystone和十名角色形成组合空间",
      "dimension": "玩法",
      "excerpt": "Key features: 150+ unique loot items with many variations of characteristics that have a synergistic effect to create unique builds 27+ stats like Toxicity, Strength, Wisdom, Faith, Recovery, and more, which can be combined with loot and keystones for a unique strategy and tactics 10 characters with their abilities",
      "url": "https://store.steampowered.com/app/2440380/",
      "label": "证据原文片段"
    }
  ],
