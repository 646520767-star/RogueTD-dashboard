  "hooks": [
    {
      "text": "可同时召唤多只功能不同的助手猫，例如用德鲁伊猫缠根减速并持续伤害",
      "dimension": "玩法",
      "excerpt": "Unique Helper Cats: Each helper has its own special abilities and characteristics. For example, summon the Druid Cat to slow down enemies with roots and deal periodic damage. And who said you can summon only one helper?",
      "url": "https://store.steampowered.com/app/2929730/",
      "label": "证据原文片段"
    },
    {
      "text": "每局独立强化助手猫，可提升伤害、增加弹体并解锁猫咪专属升级",
      "dimension": "玩法",
      "excerpt": "Upgrade System: Upgrade your helpers during each run. Increase damage, add more projectiles, and unlock other unique upgrades for each cat.",
      "url": "https://store.steampowered.com/app/2929730/",
      "label": "证据原文片段"
    },
    {
      "text": "击败敌人获得金币，用于跨局强化主角与助手猫，让后续尝试持续变强",
      "dimension": "玩法",
      "excerpt": "Meta-Progression: Collect coins from defeated enemies to upgrade your character and helper cats between runs, making each new attempt more powerful.",
      "url": "https://store.steampowered.com/app/2929730/",
      "label": "证据原文片段"
    }
