  "hooks": [
    {
      "text": "咖啡豆刺客可在第一人称与第三人称间展开roguelike枪战",
      "dimension": "玩法",
      "excerpt": "You are Killer Bean, a rogue assassin coffee bean, who takes out the trash in this world, one bullet at a time. This is a first person / third person action roguelike.",
      "url": "https://store.steampowered.com/app/1597080/",
      "label": "证据原文片段"
    },
    {
      "text": "遭影子机构背叛后，孤身追杀更强的影子豆军团",
      "dimension": "故事",
      "excerpt": "After being betrayed by the Shadow Agency and learning the truth about their evil ways, Killer Bean has made it his life goal to destroy them. Yet this is easier said than done, as Killer Bean will face armies of enemies, and mysterious Shadow Beans who are better trained and more powerful than him.",
      "url": "https://store.steampowered.com/app/1597080/",
      "label": "证据原文片段"
    },
    {
      "text": "随机武器技能搭配载具、机甲与布娃娃物理混战",
      "dimension": "玩法",
      "excerpt": "Randomized weapon skills Enemy vehicles, aircraft, and mechs Ragdolls and physics combat galore",
      "url": "https://store.steampowered.com/app/1597080/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "当前版本更像概念验证而非完整游戏。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "feels more like a proof of concept rather than an actual, playable game",
          "url": "https://steamcommunity.com/id/aye_yuhh/recommended/1597080/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "按键输入有时完全失效。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "sometimes button inputs straight up don't work",
          "url": "https://steamcommunity.com/id/Beinglonelydoesthingstoyou/recommended/1597080/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "肉鸽数值升级对玩法影响很小。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "meaningless stat upgrades that have little to no impact on gameplay",
          "url": "https://steamcommunity.com/id/MrBlaha/recommended/1597080/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "敌人会生成在墙内。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "enemies spawn in walls",
          "url": "https://steamcommunity.com/id/Beinglonelydoesthingstoyou/recommended/1597080/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "角色控制的核心手感表面上很有乐趣。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the core feeling of controlling Killer Bean is fun on the surface",
          "url": "https://steamcommunity.com/id/MrBlaha/recommended/1597080/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "枪战与临场策略本身很有趣。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the gunplay and strats you have to come up with is also very fun",
          "url": "https://steamcommunity.com/id/Beinglonelydoesthingstoyou/recommended/1597080/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
