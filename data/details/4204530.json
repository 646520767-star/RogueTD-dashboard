  "hooks": [
    {
      "text": "被贬骑士要在危险夜班中执行村民的琐碎命令，用完成任务赚取荣誉和生存物资。",
      "dimension": "玩法",
      "excerpt": "You and your fellow knights must earn honor for items and your survival, by braving the darkness of the night to fulfill the villager’s demeaning requests: retrieve forgotten items for the village drunk, feed the horses for the forgetful farmers, catch fish in the lake for the hungry, mine gems in the forest caves for the greedy merchant.",
      "url": "https://store.steampowered.com/app/4204530/",
      "label": "证据原文片段"
    },
    {
      "text": "夜晚推进后敌人与新恐怖会持续增加，需要靠躲避、武器和陷阱完成职责。",
      "dimension": "玩法",
      "excerpt": "As you progress further, more enemies and new horrors appear to stop you from fulfilling your duties to the kingdom. Use your wits to evade them, and acquire weapons and traps at the merchant to fend them off.",
      "url": "https://store.steampowered.com/app/4204530/",
      "label": "证据原文片段"
    },
    {
      "text": "队友被黑夜带走后，救援会把更多荣誉与生命置于风险中，合作因此带有取舍。",
      "dimension": "玩法",
      "excerpt": "Band together with other knights to aid in your search, but be careful if they are taken by the night. Why risk your life for theirs, when even more honor could be lost?",
      "url": "https://store.steampowered.com/app/4204530/",
      "label": "证据原文片段"
    }
  ],
