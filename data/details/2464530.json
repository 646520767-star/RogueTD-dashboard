  "hooks": [
    {
      "text": "以闪电般速度迎战同屏最多300名敌人的汹涌群潮",
      "dimension": "玩法",
      "excerpt": "Stand against waves of enemies unlike anything you’ve seen before; face up to 300 foes on screen at once, still able to move at Lightning speed.",
      "url": "https://store.steampowered.com/app/2464530/",
      "label": "证据原文片段"
    },
    {
      "text": "带回战利品到大师堡垒净化强化，再次投入战斗",
      "dimension": "玩法",
      "excerpt": "I return to the Master’s Citadel, cleansing what I’ve gathered, sharpening the edge of my soul. And once more, I plunge back into the fray, unbroken, stronger than ever.",
      "url": "https://store.steampowered.com/app/2464530/",
      "label": "证据原文片段"
    },
    {
      "text": "化身无面法师召来的武器，重塑被瘟疫摧毁的黑暗世界",
      "dimension": "题材",
      "excerpt": "Born of the will of a faceless mage, I exist for one purpose alone: to become the weapon that reshapes a world ravaged by plague.",
      "url": "https://store.steampowered.com/app/2464530/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "视觉表现令人印象深刻。",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The visuals are also rather impressive",
          "url": "https://store.steampowered.com/curator/32199709-Fun-Fab-Game-Reviews/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "蘑菇洞后的前进路径指引不清。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The way forward once you enter the mushroom cave was not clear",
          "url": "https://steamcommunity.com/profiles/76561198055902046/recommended/2464530/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "第三章探索秘密的回报很少。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "with very little reward to exploration for secrets.",
          "url": "https://steamcommunity.com/profiles/76561198055902046/recommended/2464530/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "玩家原有武器被全部禁用",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "但为什么要把我所有武器都ban了？",
          "url": "https://steamcommunity.com/profiles/76561198975475301/recommended/2464530/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "正式版相比Demo新增内容过少。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "相比demo只多了一个序章，基本没有新内容",
          "url": "https://steamcommunity.com/profiles/76561198317875720/recommended/2464530/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "死亡后不能在天空节点复活，重跑路程浪费时间。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Just let me respawn at a sky node instead of making me go through 500 teleporters",
          "url": "https://steamcommunity.com/id/DocMitchell/recommended/2464530/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "暴风雪任务点相距过远，中间缺少有效事件。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "These blizzards are so far apart from each other, with nothing happening on the journey in-between.",
          "url": "https://steamcommunity.com/profiles/76561198055902046/recommended/2464530/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "该区域虽然更大，却因此显得更空旷",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Even though this area as a whole was bigger, it was emptier because of it.",
          "url": "https://steamcommunity.com/profiles/76561198055902046/recommended/2464530/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "整体玩法是作品最突出的优点",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "gameplay - that's where the gold hidden.",
          "url": "https://store.steampowered.com/curator/32199709-Fun-Fab-Game-Reviews/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "第一章的难度提升节奏适合学习系统。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The difficulty goes up at a good rate for you to learn the ropes",
          "url": "https://steamcommunity.com/profiles/76561198055902046/recommended/2464530/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
