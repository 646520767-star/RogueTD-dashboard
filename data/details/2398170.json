  "hooks": [
    {
      "text": "用机枪钻头直接轰开岩土，在地下采矿同时击退威胁",
      "dimension": "玩法",
      "excerpt": "Blast your way through rocks and dirt with your machinegun drill. Carve through the ground to uncover precious ores and defeat menacing foes.",
      "url": "https://store.steampowered.com/app/2398170/",
      "label": "证据原文片段"
    },
    {
      "text": "把稀有宝石、矿石与遗物投入旋翼机升级，逐步解锁新能力",
      "dimension": "玩法",
      "excerpt": "Uncover ancient relics and artefacts hidden in the deep. Amass a fortune in rare gems & ores. Invest in powerful upgrades and unlock new abilities, turning your humble gyrocopter into a fearsome force to be reckoned with.",
      "url": "https://store.steampowered.com/app/2398170/",
      "label": "证据原文片段"
    },
    {
      "text": "失败轮次仍保留成长，并通过大地图解锁程序生成矿井与不同地下生态",
      "dimension": "玩法",
      "excerpt": "Explore a diverse range of biomes, from treacherous volcanic caverns to lush overgrown underground forests, each with its own unique challenges and rewards. Intense mining action with fast-paced blasting Constant progress - even failed runs aren't punishing Diverse biomes to explore Purchase upgrades to overpower your gyrocopter Navigate the overworld to unlock new mine shafts Collect and loot rare gems, ores, and artefacts to upgrade your gear and abilities Endless replayability with procedurally generated levels",
      "url": "https://store.steampowered.com/app/2398170/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "约六成进度后节奏明显变慢。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the pacing slows down a ton at around 60% completion",
          "url": "https://steamcommunity.com/id/dscota/recommended/2398170/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "关卡结构缺乏逻辑。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the level structure makes no sense",
          "url": "https://steamcommunity.com/id/Ble3azy/recommended/2398170/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "肉鸽强化组件缺少联动。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "肉鸽强化组件缺少联动",
          "url": "https://steamcommunity.com/profiles/76561199566621853/recommended/2398170/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "后半段关卡目标严重不足。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "half of the game left to explore that has barely any objectives",
          "url": "https://steamcommunity.com/id/Matrixas/recommended/2398170/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "后半段流程退化为反复向下挖。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "dig straight down for several minutes and complete the level, rinse and repeat.",
          "url": "https://steamcommunity.com/id/Matrixas/recommended/2398170/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "局内升级难以形成流派。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "局内升级也搭配不出什么流派",
          "url": "https://steamcommunity.com/profiles/76561198136793637/recommended/2398170/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "局外升级只有数值增长。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "局外升级全都只是提高数值",
          "url": "https://steamcommunity.com/profiles/76561198136793637/recommended/2398170/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "升级缓慢且需要刷取。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "upgrades are slow and take some grinding for.",
