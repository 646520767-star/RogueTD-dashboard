  "hooks": [
    {
      "text": "每局十五分钟，从新手快速堆成毁灭机器，战斗和移动都强调高速。",
      "dimension": "玩法",
      "excerpt": "Rise from rookie to god of destruction in intense 15 minute runs Fast-paced combat and movement",
      "url": "https://store.steampowered.com/app/2607870/",
      "label": "证据原文片段"
    },
    {
      "text": "主动与被动能力之外，还能召唤盟友、布置炮塔、拾取特殊武器并升级首领战利品。",
      "dimension": "玩法",
      "excerpt": "Choose from a wide range of active and passive abilities, summon powerful allies like Bernard, the elephant warrior, or Sandy, the giant sandworm lady. Deploy deadly turrets, collect special weapons, loot and upgrade powerful items, face mighty bosses, and dodge the onslaught of incoming rockets!",
      "url": "https://store.steampowered.com/app/2607870/",
      "label": "证据原文片段"
    },
    {
      "text": "无尽浮空岛世界由狐狸战士、超音速战龟与喷气背包小熊组成反抗三人组。",
      "dimension": "题材",
      "excerpt": "You play as Aryx, a fearless fox fighter who is accompanied by his supersonic turtle mount and Brian, a tiny but wise bear with a jetpack. Together, the heroic trio steps up to face the entire demonic war machine.",
      "url": "https://store.steampowered.com/app/2607870/",
      "label": "证据原文片段"
    }
  ],
