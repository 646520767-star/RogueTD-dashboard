  "hooks": [
    {
      "text": "通过编辑记忆并嵌入精华宝石改变效果，可造出近战远程射手或自爆法师等反常构筑。",
      "dimension": "玩法",
      "excerpt": "You can edit your memories to create your own unique character. Utilize memories from your past to defeat enemies in combat. Attach mysterious gems called Essences to your memories to grant special effects and create powerful synergies. A ranged carry with ridiculously powerful melee attacks? A self-destructing mage? Everything is possible!",
      "url": "https://store.steampowered.com/app/3275270/",
      "label": "证据原文片段"
    },
    {
      "text": "程序生成的梦境世界每局重组居民、任务、事件与隐藏秘密。",
      "dimension": "玩法",
      "excerpt": "Procedurally generated worlds filled with dream inhabitants, quests, various events, and hidden secrets await you. The diverse secrets within this world will provide a new experience with each run.",
      "url": "https://store.steampowered.com/app/3275270/",
      "label": "证据原文片段"
    },
    {
      "text": "最多四人合作，并通过治疗、增益和群体控制等交互形成团队配合。",
      "dimension": "玩法",
      "excerpt": "Shape of Dreams offers a complete experience in single-player, but also supports co-op multiplayer for up to 4 players. Experience exceptional cooperative gameplay through rich interaction systems including healing, buffs, crowd control, and more!",
      "url": "https://store.steampowered.com/app/3275270/",
      "label": "证据原文片段"
    }
