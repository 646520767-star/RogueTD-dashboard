  "hooks": [
    {
      "text": "四名驾驶员各管机甲子系统，用时间轴逐秒排兵布阵",
      "dimension": "玩法",
      "excerpt": "Command a four-pilot squad, each controlling a different Mech subsystem. Dodge, fire, deploy coolant, or unleash special tactics using the game’s unique Timeline System, where every second counts and every action shapes the flow of battle.",
      "url": "https://store.steampowered.com/app/2525510/",
      "label": "证据原文片段"
    },
    {
      "text": "任务间让驾驶员结盟或结怨，关系会反过来影响战斗生死",
      "dimension": "故事",
      "excerpt": "Between missions, your airship becomes home. Cook, train, or relax as your pilots bond, form rivalries, and grow through their experiences. Each relationship influences how they fight—and how they survive.",
      "url": "https://store.steampowered.com/app/2525510/",
      "label": "证据原文片段"
    },
    {
      "text": "拼装机甲要权衡装甲、热量与弹药，但驾驶员死亡不可逆",
      "dimension": "玩法",
      "excerpt": "Collect and assemble Mech parts to build your perfect war machine. Balance protection, heat, and ammo to match your playstyle, and unlock new Mech frames with unique strengths and loadouts. Your Mech can be rebuilt—your pilots cannot.",
      "url": "https://store.steampowered.com/app/2525510/",
      "label": "证据原文片段"
    }
  ],
