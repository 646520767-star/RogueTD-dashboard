  "hooks": [
    {
      "text": "英雄可把笨重防御塔缩成便携形态，战斗中重新摆放整条防线",
      "dimension": "玩法",
      "excerpt": "Fran has the ability to use Wish Power to shrink bulky defense towers into portable forms and rearrange them on the battlefield.",
      "url": "https://store.steampowered.com/app/2064610/",
      "label": "证据原文片段"
    },
    {
      "text": "五名Whicken战士可被强化并转化为十五种高阶Spirit Tower",
      "dimension": "玩法",
      "excerpt": "The five humble Whicken tribe warriors can be empowered and transformed into 15 different advanced Spirit Towers, resurrecting the glory of past battlefields!",
      "url": "https://store.steampowered.com/app/2064610/",
      "label": "证据原文片段"
    },
    {
      "text": "祭司Pani拥有九种英雄形态，可在关键战斗中变身扭转局势",
      "dimension": "玩法",
      "excerpt": "Pani, with her 9 different forms, is your most reliable companion in adventure and battle, although she has a temper.",
      "url": "https://store.steampowered.com/app/2064610/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "PC端画面被认为模糊。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "画面在PC端看来糊的一批",
          "url": "https://steamcommunity.com/profiles/76561198089004613/recommended/2064610/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "像素奇幻塔防画面华丽。",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "a gorgeous pixel art fantasy tower defense game.",
          "url": "https://store.steampowered.com/curator/38906726-frumpy-frands/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "内容量偏少且定价过高。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "价格太高，内容太少",
          "url": "https://steamcommunity.com/profiles/76561199215712793/recommended/2064610/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "第五章敌人种类明显少于前面章节。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Chapter 5 is the final area in the game yet has less enemies than any other area by a huge margin.",
          "url": "https://steamcommunity.com/profiles/76561198381896775/recommended/2064610/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "狙击塔强到可以通刷多数关卡，平衡较差。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "狙击塔可以刷几乎所有关卡，过于超模",
          "url": "https://steamcommunity.com/profiles/76561199215712793/recommended/2064610/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "建造者移动缓慢，让建塔和升级变成耗时事务。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "a slow cumbersome builder that makes the most basic tasks like building towers and upgrading them a time consuming chore.",
          "url": "https://steamcommunity.com/profiles/76561198027845400/recommended/2064610/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "英雄工具包强弱高度不均，选择常被效率而非乐趣支配。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "you’re picking them based 99% on which has the most efficient skills",
          "url": "https://steamcommunity.com/profiles/76561198381896775/recommended/2064610/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "隐藏秘密和彩蛋带来很多快乐时刻。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "gives you a lot of joy and funny moments as you discover hidden secrets and easter eggs",
          "url": "https://store.steampowered.com/curator/45004419-Emotional-Gaming/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "整体玩法有趣且有个性。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "It’s fun, unique, funny",
          "url": "https://steamcommunity.com/profiles/76561198381896775/recommended/2064610/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "移动塔位为塔防玩法增加了有趣变化。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "repositioning your towers, which adds an interesting twist to the TD genre.",
          "url": "https://steamcommunity.com/profiles/76561198838673390/recommended/2064610/",
          "label": "证据原文片段"
        }
      ]
    }
