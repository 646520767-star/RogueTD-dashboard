  "hooks": [
    {
      "text": "潜入包含52个站点的暗网，扫描网页与源码寻找能救命的隐藏拼图碎片。",
      "dimension": "玩法",
      "excerpt": "Browse the dark net, with access to 52 websites, and uncover hidden pieces to a puzzle that will grant you life... assuming you can find them all.",
      "url": "https://store.steampowered.com/app/3869850/",
      "label": "证据原文片段"
    },
    {
      "text": "与四名NPC竞速交易，可花钱拖慢或永久清除对手，但他们也能用同样手段反击。",
      "dimension": "玩法",
      "excerpt": "Chat with users (NPCs) to buy / sell goods & services. Manage when to progress yourself and when to attack those (NPCs) in the race with you. Pay up to either slow or try to remove them permanently from the competition, but remember they can do the same to you.",
      "url": "https://store.steampowered.com/app/3869850/",
      "label": "证据原文片段"
    },
    {
      "text": "遭入侵时可反黑客赚取DOS币，或升级防火墙求稳，但防守会放弃这笔收益。",
      "dimension": "玩法",
      "excerpt": "Successfully counter hacks to earn DOS Coin OR block intrusions with firewall upgrades, but miss out on earnings. Contend with multiple hacking minigames that will test your reaction speed, typing ability, and puzzle solving skills.",
      "url": "https://store.steampowered.com/app/3869850/",
      "label": "证据原文片段"
    }
  ],
