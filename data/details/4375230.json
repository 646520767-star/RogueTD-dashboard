  "hooks": [
    {
      "text": "没有固定版本阵容，每场从随机武将池临场组建最适合战场的队伍",
      "dimension": "玩法",
      "excerpt": "There are no fixed meta formations. Each match presents you with a challenging selection of warlords. Choose wisely and build the formation best suited to each unique battlefield.",
      "url": "https://store.steampowered.com/app/4375230/",
      "label": "证据原文片段"
    },
    {
      "text": "利用武将羁绊和技能跨越历史阵营，组成逆转战局的梦之队",
      "dimension": "玩法",
      "excerpt": "Warlord affinities and skills create powerful synergies. Build dream teams that transcend historical alliances and turn the tide of battle.",
      "url": "https://store.steampowered.com/app/4375230/",
      "label": "证据原文片段"
    },
    {
      "text": "开战前读取敌阵，在网格中针对兵种克制、技能射程和伏兵摆将",
      "dimension": "玩法",
      "excerpt": "Study your opponent’s formation in advance and place your generals on the grid-based battlefield to counter their strategy. Success depends on reading unit counters, skill ranges, and potential for ambushes.",
      "url": "https://store.steampowered.com/app/4375230/",
      "label": "证据原文片段"
    }
