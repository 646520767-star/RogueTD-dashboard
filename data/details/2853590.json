  "hooks": [
    {
      "text": "协调舰炮、模块与反应堆能量分配，把古老星舰改造成战争机器",
      "dimension": "玩法",
      "excerpt": "Your starship is a mighty and terrible vessel, brimming with arcane technology and devastating weapons. Harness your ship's weapons, modules, and reactor power to maximize your combat potential.",
      "url": "https://store.steampowered.com/app/2853590/",
      "label": "证据原文片段"
    },
    {
      "text": "把升级件排列成连锁组合以精准拆船，但敌舰同样会反向构筑组合",
      "dimension": "玩法",
      "excerpt": "Arrange your upgrades into powerful combos and use them to surgically dismantle your enemies. But watch out. They can do exactly the same to you.",
      "url": "https://store.steampowered.com/app/2853590/",
      "label": "证据原文片段"
    },
    {
      "text": "从六个派系招募船员、配置军械，并发动血腥的敌舰登船战",
      "dimension": "玩法",
      "excerpt": "Enlist crew from six different factions. Customize them with a vast array of wargear and engage in bloody, strategic boarding actions against enemy craft.",
      "url": "https://store.steampowered.com/app/2853590/",
      "label": "证据原文片段"
    }
  ],
