  "hooks": [
    {
      "text": "在翁布背上的有限空间规划并优化村庄生产链",
      "dimension": "玩法",
      "excerpt": "Build your settlement and expand it over Onbu’s back. Plan production chains and optimise them to utilise the limited space as efficiently as possible.",
      "url": "https://store.steampowered.com/app/1121640/",
      "label": "证据原文片段"
    },
    {
      "text": "在互利共生与寄生式利用之间决定村庄和翁布的关系",
      "dimension": "题材",
      "excerpt": "Will you live in symbiosis, bond with Onbu and survive on mutual trust? Or will you become a parasite, only aiming to ensure a better life for your villagers? The choice is yours.",
      "url": "https://store.steampowered.com/app/1121640/",
      "label": "证据原文片段"
    },
    {
      "text": "跨越多种生物群落适应气候威胁，并派采集队寻找稀缺资源与古代遗物",
      "dimension": "玩法",
      "excerpt": "Continuously adapt your village as you travel through a multitude of different biomes, each with its unique climate zones, opportunities and threats. Scout your environments and send out foraging missions to gather rare resources and ancient artefacts.",
      "url": "https://store.steampowered.com/app/1121640/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "背景音乐内容不足。",
      "dimension": "音频",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "I was disappointed by the lack of bgm music in this game, or voice acting.",
          "url": "https://steamcommunity.com/profiles/76561199476735536/recommended/1121640/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "美术风格很吸引人。",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "an alluring art style",
          "url": "https://store.steampowered.com/curator/28625128-Skill-Up-Curates.../",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "美术风格受到喜爱。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "I liked the art style",
          "url": "https://steamcommunity.com/profiles/76561199476735536/recommended/1121640/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "地区随机切换拖慢游玩节奏。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "切换的随机性导致游玩节奏会变得很拖沓",
          "url": "https://steamcommunity.com/profiles/76561198846355800/recommended/1121640/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "进入新生物群落后必须逐个手动切换生产设施。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Must always manually change all farms, water collectors, fisheries, etc etc whenever a new biome is entered, one by one...",
          "url": "https://steamcommunity.com/id/Plantrigo/recommended/1121640/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "治疗所AI会优先取食物而不搬药草。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "治疗所的那9个人一直跑去拿食物,连草药都不搬",
          "url": "https://steamcommunity.com/id/liaoran/recommended/1121640/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "即使大量建设农场，食物生产仍不足",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "我把草地都建成农场,依然吃不饱.",
          "url": "https://steamcommunity.com/id/liaoran/recommended/1121640/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "大地图随机事件种类太少。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "大地图探险看上去很新颖，但随机事件种类实在太少了。",
          "url": "https://steamcommunity.com/id/doublemasky/recommended/1121640/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "首轮后缺乏再次游玩的动力。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Didn't feel like playing again after the first run",
          "url": "https://steamcommunity.com/id/Plantrigo/recommended/1121640/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "资源种类过多且用途重复。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "way too many type of resources yet some of them has pretty much the same usage.",
          "url": "https://steamcommunity.com/profiles/76561199476735536/recommended/1121640/",
          "label": "证据原文片段"
        }
      ]
    }
