  "hooks": [
    {
      "text": "每站必须在时限内启动保险丝并赶回末班地铁，超时会引来此前站点累积的尸潮。",
      "dimension": "玩法",
      "excerpt": "Only by activating the fuse at each stop within the time limit can you move on. Fail… and a brutal fight for survival awaits.",
      "url": "https://store.steampowered.com/app/3827830/",
      "label": "证据原文片段"
    },
    {
      "text": "战斗中收集技能芯片，解锁能力并定制本轮roguelike构筑。",
      "dimension": "玩法",
      "excerpt": "Skill Chips & Upgrades Collect Skill Chips during combat to unlock powerful abilities and customize your build.",
      "url": "https://store.steampowered.com/app/3827830/",
      "label": "证据原文片段"
    },
    {
      "text": "作为末班地铁唯一乘客，逐站接近可能仍在市政厅等待的家人。",
      "dimension": "故事",
      "excerpt": "You boarded the final subway still in operation, bound for a single destination: City Hall , where your family might still be waiting. But this train isn’t just your escape—it’s a gauntlet.",
      "url": "https://store.steampowered.com/app/3827830/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "音效兼具强烈冲击与怀旧街机感",
      "dimension": "音频",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the sound design is so visceral yet arcade-y and nostalgic",
          "url": "https://steamcommunity.com/id/tgirlsunny420/recommended/3827830/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "敌人刷出数量过多",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "HOLY enemy spam",
          "url": "https://steamcommunity.com/profiles/76561199642796515/recommended/3827830/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "互动键固定为F且无法修改",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "WHY IS F THE INTERACT BUTTON AND WHY CANT I CHANGE IT.",
          "url": "https://steamcommunity.com/profiles/76561198862532634/recommended/3827830/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "游戏很快变得疲倦和重复",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the game gets tired and repetitive almost immediately",
          "url": "https://steamcommunity.com/profiles/76561198030784015/recommended/3827830/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "武器响应灵敏且种类丰富",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the weapons, while goofy and funny (im looknig at you quintuple-barrel shotgun) are responsive and plentiful",
          "url": "https://steamcommunity.com/id/tgirlsunny420/recommended/3827830/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "关掉脑子射击的循环完成度很高",
