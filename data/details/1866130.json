  "hooks": [
    {
      "text": "战斗中一键无缝切换三名英雄，把各自技能串成连续连招",
      "dimension": "玩法",
      "excerpt": "At the press of a button, seamlessly shapeshift mid‑combat between Flux, Ekku, and Vekta — each with unique abilities, playstyles, and special attacks. Chain attacks and master dozens of combos to turn every run into a seamless, lethal choreography.",
      "url": "https://store.steampowered.com/app/1866130/",
      "label": "证据原文片段"
    },
    {
      "text": "每条路线都以强调时机、适应力与稳定操作的电影化首领战收束",
      "dimension": "玩法",
      "excerpt": "Each path you take culminates in epic boss encounters where timing, adaptability, and composure are critical to survival.",
      "url": "https://store.steampowered.com/app/1866130/",
      "label": "证据原文片段"
    },
    {
      "text": "每轮重塑角色与构筑，长期成长外还能用恶魔交易和试炼换高风险奖励",
      "dimension": "玩法",
      "excerpt": "Evolve your characters and refine your build each run, so every attempt feels fresh and challenging. Lasting meta‑progression keeps every run meaningful. Risk powerful Devil’s Bargains or tackle Operator’s Trials for high‑stakes rewards!",
      "url": "https://store.steampowered.com/app/1866130/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
