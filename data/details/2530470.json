  "hooks": [
    {
      "text": "每战从随机法术、升级与遗物池重新塑造流派",
      "dimension": "玩法",
      "excerpt": "Shape your build from a randomized pool of spells, upgrades, and relics, and outsmart the other witches that stand in your way.",
      "url": "https://store.steampowered.com/app/2530470/",
      "label": "证据原文片段"
    },
    {
      "text": "每名女巫都有独立招式，必须读动作并精确反击",
      "dimension": "玩法",
      "excerpt": "Every witch has distinct attack patterns, and they won’t go down easily. Study their movements, time your counterattacks, and use everything in your arsenal to win them over.",
      "url": "https://store.steampowered.com/app/2530470/",
      "label": "证据原文片段"
    },
    {
      "text": "死亡不是清零，而是解锁能力与永久成长",
      "dimension": "玩法",
      "excerpt": "Each death is a step forward, unlocking new abilities and permanent growth.",
      "url": "https://store.steampowered.com/app/2530470/",
      "label": "证据原文片段"
    }
  ],
