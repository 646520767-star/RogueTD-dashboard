  "hooks": [
    {
      "text": "收集会彼此联动的强力装备，用聪明构筑刺穿死灵谷",
      "dimension": "玩法",
      "excerpt": "Into the Necrovale is an Action RPG in which you collect powerful items that interact with one another. You must be clever with your build if you hope to pierce the mysteries and dangers of the Necrovale, where a thousand generations of miscreants and criminals have been banished.",
      "url": "https://store.steampowered.com/app/1717090/",
      "label": "证据原文片段"
    },
    {
      "text": "沿着前人遗骸搜集武器、护甲、图腾、书籍与各种古怪遗物",
      "dimension": "玩法",
      "excerpt": "The Necrovale is filled with powerful relics left behind by those whose story ended in the depths. Collect these weapons, armor, shields, staffs, jewelry, totems, hats, books, and other tchotchkes as you follow in their footsteps.",
      "url": "https://store.steampowered.com/app/1717090/",
      "label": "证据原文片段"
    },
    {
      "text": "作为被神选中的死刑犯，决定保存这个疲惫世界还是亲手毁灭它",
      "dimension": "故事",
      "excerpt": "Your fate hangs in the balance as The Stranger, a condemned criminal chosen by the All-Father himself. Preserve this tired world or destroy it, and the choice is yours.",
      "url": "https://store.steampowered.com/app/1717090/",
      "label": "证据原文片段"
    }
  ],
