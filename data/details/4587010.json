  "hooks": [
    {
      "text": "在食物、金币与路线风险间取舍，安全行进也可能慢慢饿死",
      "dimension": "玩法",
      "excerpt": "Manage your food, gold, and risks as you travel. Take risks for greater rewards, or play it safe and starve a little slower.",
      "url": "https://store.steampowered.com/app/4587010/",
      "label": "证据原文片段"
    },
    {
      "text": "招募乞丐、流浪汉与恶棍，并承担各自债务与麻烦",
      "dimension": "玩法",
      "excerpt": "Assemble a party of beggars, vagrants, and scoundrels. Each will have their own strengths, as well as their own debts, troubles, and shady pasts.",
      "url": "https://store.steampowered.com/app/4587010/",
      "label": "证据原文片段"
    },
    {
      "text": "在主教区、商会与强盗三方势力间维持危险平衡",
      "dimension": "玩法",
      "excerpt": "Balance Power Between Factions Manage the complex relationships between the Bishopric, the Merchant Guilds, and the Bandits: The Bishopric: power, order, and moral flexibility Merchant Guilds: wealth, power, and backroom deals Bandits: freedom, violence, and strong opinions Support one, anger the others, or try to juggle all three. Carefully.",
      "url": "https://store.steampowered.com/app/4587010/",
      "label": "证据原文片段"
    }
