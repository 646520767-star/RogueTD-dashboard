  "hooks": [
    {
      "text": "从战斗奖励中组合卡牌与遗物，用兵种协同补牌组弱点并打击敌方漏洞",
      "dimension": "玩法",
      "excerpt": "Choose your battle rewards wisely, and craft your own deck by combining a wide array of cards and relics. From cavalry units that break through enemy lines, to unyielding dwarves of steel, feral beasts, and ghostly legions—various synergies await your command. Build the perfect synergy, cover your deck’s weaknesses, and strike at the enemy’s vulnerabilities as they grow stronger with every stage.",
      "url": "https://store.steampowered.com/app/2697930/",
      "label": "证据原文片段"
    },
    {
      "text": "旅途事件可进入诡异实验自定义卡牌，也可转向寻找强力遗物",
      "dimension": "玩法",
      "excerpt": "You’ll also have the chance to take part in eerie experiments to customize your own cards—or simply enjoy the thrill of discovering powerful relics.",
      "url": "https://store.steampowered.com/app/2697930/",
      "label": "证据原文片段"
    },
    {
      "text": "历史传奇统帅被投入充满魔法、诅咒、矮人与巨龙的幻想战场",
      "dimension": "题材",
      "excerpt": "Legendary commanders from history return to the battlefield—this time in a fantasy world teeming with magic, curses, dwarves, and dragons.",
      "url": "https://store.steampowered.com/app/2697930/",
      "label": "证据原文片段"
    }
