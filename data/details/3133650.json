  "hooks": [
    {
      "text": "围绕怪物地牢建设城镇，用探索收益增建市场、酒馆、赌场和公会来吸引英雄。",
      "dimension": "玩法",
      "excerpt": "Create a thriving city around monster-filled dungeons. Bring in wealth from exploring and dungeon delving, then use it to shape the town to your wishes. Add markets, taverns, gambling halls, and guilds to attract even more heroes to fight for your cause!",
      "url": "https://store.steampowered.com/app/3133650/",
      "label": "证据原文片段"
    },
    {
      "text": "冒险者只忠于金币，必须以财富与荣耀招募，再派他们执行讨伐、防守和探索任务。",
      "dimension": "玩法",
      "excerpt": "These adventurers won’t work for free, their loyalty lies with gold! You’ll have to recruit them with promises of gold and glory, then send them on quests to kill, defend, explore, and more.",
      "url": "https://store.steampowered.com/app/3133650/",
      "label": "证据原文片段"
    },
    {
      "text": "神兽需要亲自抚摸、梳理和管教，才能逐步成长、进化并学会强力法术。",
      "dimension": "玩法",
      "excerpt": "Your pet may be filled with divine power, but it still needs guidance. Pet, brush, and discipline it so it can grow, evolve, and learn powerful spells!",
      "url": "https://store.steampowered.com/app/3133650/",
      "label": "证据原文片段"
    }
  ],
