          "url": "https://steamcommunity.com/profiles/76561198375843268/recommended/3839250/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "难度提升仅靠增敌减己。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "提高难度简单粗暴的减玩家属性，加怪的伤害血量",
          "url": "https://steamcommunity.com/profiles/76561198099537540/recommended/3839250/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "当前熔炼功能缺乏实际意义。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "目前熔炼功能是个摆设",
          "url": "https://steamcommunity.com/profiles/76561198427193682/recommended/3839250/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "后期阶段材料收益没有随难度增长。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The first level rewards essentially the same upgrade materials as the higher-level areas",
          "url": "https://steamcommunity.com/id/1770/recommended/3839250/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "局外成长单次提升过少。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "一局下来，局外成长只能点1-2级",
          "url": "https://steamcommunity.com/profiles/76561198099537540/recommended/3839250/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "游戏会卡死并闪退。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "游戏不稳定，致pc端完全卡死，弹窗闪退",
          "url": "https://steamcommunity.com/profiles/76561198427193682/recommended/3839250/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "同一资源被多个成长系统争抢。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "many of them compete for the same limited resources.",
          "url": "https://steamcommunity.com/id/1770/recommended/3839250/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "背包容量小到令人发指。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "背包是金角大王腰带吗？小得令人发指",
          "url": "https://steamcommunity.com/id/cunpao/recommended/3839250/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "搜打撤中的搜索内容过浅。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "搜的部分做的太浅了",
          "url": "https://steamcommunity.com/profiles/76561198427193682/recommended/3839250/",
          "label": "证据原文片段"
        }
      ]
    },
