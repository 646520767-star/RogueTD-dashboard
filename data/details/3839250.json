  "hooks": [
    {
      "text": "用Sacred Remains和Sword Embryo锻造理想武器，但撤离前仍可能永久丢失",
      "dimension": "玩法",
      "excerpt": "In the underworld, defeat your foes, gather the Sacred Remains and Sword Embryos they drop, and forge the weapon you desire—exactly as you envision it. Yet remember: even in the underworld, you may still lose the weapon in your grasp.",
      "url": "https://store.steampowered.com/app/3839250/",
      "label": "证据原文片段"
    },
    {
      "text": "地图中的Backpack Shard扩容背包并提高地下世界祝福，Tailor还能附加魔法",
      "dimension": "玩法",
      "excerpt": "Your backpack capacity is crucial. Do not forget to search for Backpack Shards ​ in the map to expand it—this will allow you to carry more back with you, while also granting richer boons within the underworld. At times, the Tailor may even bestow enchanted magic upon your backpack—there’s no need to hurry.",
      "url": "https://store.steampowered.com/app/3839250/",
      "label": "证据原文片段"
    },
    {
      "text": "定时出现的矿车可提前运回稀有材料和改变法术的特殊物品",
      "dimension": "玩法",
      "excerpt": "In the underworld, you will occasionally come across peculiar items—some serve as crafting materials, while others can trigger wondrous changes to your spells. Take care not to lose them lightly, for you can transport them back using the mine carts that appear at regular intervals. Hang on—at least until the mine cart arrives.",
      "url": "https://store.steampowered.com/app/3839250/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "背景音乐很有感觉。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "加上背景音乐，很有感觉。",
