  "hooks": [
    {
      "text": "探索真正无限且程序生成的技能树，不断开放新扇区让成长结构自行扩张。",
      "dimension": "玩法",
      "excerpt": "In an abstract world ruled by numbers, you’ll grow exponentially stronger through a truly infinite, procedurally generated skill tree.",
      "url": "https://store.steampowered.com/app/4210010/",
      "label": "证据原文片段"
    },
    {
      "text": "角色会自动开火，玩家唯一需要持续操作的是管理不断扩张的技能树。",
      "dimension": "玩法",
      "excerpt": "You fire automatically. No action is required other than interacting with the skill tree.",
      "url": "https://store.steampowered.com/app/4210010/",
      "label": "证据原文片段"
    },
    {
      "text": "数字同时代表生命与体型；失败会跌回“1”，但已经取得的升级会保留。",
      "dimension": "玩法",
      "excerpt": "Your number isn’t just your Health —it’s also your size . The bigger your number, the larger and more powerful you become. But be careful: one defeat sends you all the way back to “1” , though you’ll keep your upgrades when you restart.",
      "url": "https://store.steampowered.com/app/4210010/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "极简视觉保持了信息清晰易读。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the minimalist visuals ensure that information remains easy to read.",
          "url": "https://steamcommunity.com/id/xxadonisxx/recommended/4210010/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "技能点短缺会拖累体验。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "skill point shortage hold it back.",
          "url": "https://vaporlens.app/app/4210010/incremental_infinity",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "后期成长速度过慢。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Progression slows too much later.",
          "url": "https://steamcommunity.com/profiles/76561198056230225/recommended/4210010/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "购买升级会稀释能力强度，反而提高难度。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Buying upgrades makes the game harder, since your ability power gets diluted.",
          "url": "https://steamcommunity.com/profiles/76561198056230225/recommended/4210010/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "约一小时后就容易感到无聊。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Became bored after the first hour.",
          "url": "https://steamcommunity.com/profiles/76561198860375574/recommended/4210010/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "技能树缺少搜索功能。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "please add a search function to the skill tree",
          "url": "https://steamcommunity.com/profiles/76561199219041740/recommended/4210010/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "技能树扩大后难以导航。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "navigation can become cumbersome.",
          "url": "https://steamcommunity.com/id/xxadonisxx/recommended/4210010/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "挂机推进缺少实际奖励。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "No real reward for idling to get to the next wave.",
          "url": "https://steamcommunity.com/profiles/76561198056230225/recommended/4210010/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "任务会引导玩家进行有针对性的属性专精。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The quests can guide you to min-max one stat specifically for a while",
          "url": "https://steamcommunity.com/profiles/76561199069067270/recommended/4210010/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "多重射击形成了舒缓的清场体验。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Has that soothing effect of watching all your problems burst away...",
          "url": "https://steamcommunity.com/profiles/76561199069067270/recommended/4210010/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
