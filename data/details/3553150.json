  "hooks": [
    {
      "text": "把元素能力充入硬币后投入不断演化的弹珠机柜，用物理碰撞触发爆炸连锁。",
      "dimension": "玩法",
      "excerpt": "Charge coins with elemental abilities, drop them into evolving pinball-style cabinets, and trigger explosive chain reactions.",
      "url": "https://store.steampowered.com/app/3553150/",
      "label": "证据原文片段"
    },
    {
      "text": "每轮赚取 tickets 解锁机台内 Trinket，并在技能树中永久升级后叠加成跨局构筑。",
      "dimension": "玩法",
      "excerpt": "Earn tickets with every run to unlock Trinkets hidden across the machines. Each one grants elemental-infused bonuses you can upgrade permanently through a skill tree, ensuring long-term progression. Stack multiple Trinkets to forge stronger builds and push toward the final machine where Fortuna, the Goddess of Fortune, awaits.",
      "url": "https://store.steampowered.com/app/3553150/",
      "label": "证据原文片段"
    },
    {
      "text": "首枚硬币会随取回次数获得经验并永久进化，每轮结束前必须把它从机台赢回来。",
      "dimension": "玩法",
      "excerpt": "The very first coin Fortuna gives you is unlike any other. It gains experience each time you win it back out of the machine , permanently unlocking new powers as it grows. This coin journeys through every cabinet, evolving with you across runs. To level it up, you’ll need to win it back before each round ends —a risky challenge that makes every playthrough feel fresh.",
      "url": "https://store.steampowered.com/app/3553150/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
