  "hooks": [
    {
      "text": "无限融合卡牌生成更强单位，突破传统回合制卡牌限制",
      "dimension": "玩法",
      "excerpt": "You can infinitely merge cards to create more potent tokens, breaking free from the confines of traditional turn-based mechanics.",
      "url": "https://store.steampowered.com/app/1397130/",
      "label": "证据原文片段"
    },
    {
      "text": "高等级卡战败后退化为原始形态而非直接销毁",
      "dimension": "玩法",
      "excerpt": "Face the unique challenge where high-level cards, upon defeat, transform back into their original forms rather than being destroyed.",
      "url": "https://store.steampowered.com/app/1397130/",
      "label": "证据原文片段"
    },
    {
      "text": "用伤害堆与弃牌堆双墓地分别管理被击败和弃置的卡",
      "dimension": "玩法",
      "excerpt": "Primateria introduces a dual graveyard system – the \"Damage Pile\" and \"Discard Pile,\" adding complexity to the management of defeated and discarded cards and introducing a new strategic element to the gameplay.",
      "url": "https://store.steampowered.com/app/1397130/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "音乐表现有活力。",
      "dimension": "音频",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the music is bumpin'",
          "url": "https://steamcommunity.com/profiles/76561198040854864/recommended/1397130/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "体验漫无目的且不满足",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "It feels aimless and unsatisfying.",
          "url": "https://steamcommunity.com/id/bullno1/recommended/1397130/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "其他有趣策略的可行性明显更差。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "There are other interesting strategies but they don't seem to be as viable.",
          "url": "https://steamcommunity.com/id/bullno1/recommended/1397130/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "规则易懂但组合过程仍复杂且有挑战。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Simple to figure out yet complex and challenging!",
          "url": "https://steamcommunity.com/profiles/76561198040854864/recommended/1397130/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "卡牌能力提供了大量组合潜力。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Every card has interesting abilities that allow for a lot of interesting combo potential.",
          "url": "https://steamcommunity.com/profiles/76561198008997731/recommended/1397130/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "DBG构筑深度与可玩度很高。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "游戏中卡牌的DBG构筑深度和可玩度都相当高。",
          "url": "https://steamcommunity.com/profiles/76561199076083099/recommended/1397130/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "卡牌融合创造快速而华丽的出牌节奏。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Card fusions made for faced paced flashy gameplay",
          "url": "https://steamcommunity.com/profiles/76561198008997731/recommended/1397130/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "独特组合循环非常容易上瘾。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Really addicting game play loop that focuses on unique card combos.",
          "url": "https://steamcommunity.com/profiles/76561198040854864/recommended/1397130/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "战役内容被评价为不错。",
      "dimension": "剧情",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "a good campaign",
          "url": "https://store.steampowered.com/curator/32667891-We-love-JRPG%2527s/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "作为致敬游戏王的作品很受粉丝认可。",
      "dimension": "主题",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "A love letter to Yu-Gi-Oh fans and a fantastic tribute to it!",
          "url": "https://store.steampowered.com/curator/44760646-Zeus-Reviews/",
          "label": "证据原文片段"
        }
