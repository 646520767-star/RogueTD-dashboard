  "hooks": [
    {
      "text": "两百余技能叠加元素反应与技能共鸣，形成高自由度割草构筑",
      "dimension": "玩法",
      "excerpt": "There are more than 200 skills to choose from, and there are also elemental reactions and skill resonances, allowing you to beat the six-eared macaque in a fancy way!",
      "url": "https://store.steampowered.com/app/2450100/",
      "label": "证据原文片段"
    },
    {
      "text": "割草生存与种田建造并列成双模式，战斗外还能种灵草、做工具、盖房子",
      "dimension": "玩法",
      "excerpt": "The game consists of two main parts: survival mode (offering simple, ordinary, difficult levels as well as hellish challenges) and farming mode (allowing players to cultivate crops including spiritual grasses), craft tools and build houses; continuous updates aim to enhance these aspects further.",
      "url": "https://store.steampowered.com/app/2450100/",
      "label": "证据原文片段"
    },
    {
      "text": "以《西游记》人物为底，混入洪荒修仙世界观做荒诞再创作",
      "dimension": "题材",
      "excerpt": "The storyline draws inspiration from the four classic novels \"Journey to the West\" and incorporates traditional Honghuang Xixian world views.",
      "url": "https://store.steampowered.com/app/2450100/",
      "label": "证据原文片段"
    }
  ],
