  "hooks": [
    {
      "text": "每回合唯一的移动决策只有向右或向下，用极简方向约束塑造卡牌地牢路线选择。",
      "dimension": "玩法",
      "excerpt": "On each turn, the only decision you can make is to go right or down!",
      "url": "https://store.steampowered.com/app/2228010/",
      "label": "证据原文片段"
    },
    {
      "text": "掷出的骰子既可放到敌人身上造成击杀，也可嵌入技能触发额外骰子或治疗等效果。",
      "dimension": "玩法",
      "excerpt": "In the player turn, roll the dice and place them on the enemies to defeat them! You can also place the dice in your skills to obtain different effects, like rolling more dice or healing yourself.",
      "url": "https://store.steampowered.com/app/2228010/",
      "label": "证据原文片段"
    },
    {
      "text": "六名英雄、百余件遗物和三十个各带新规则的地牢共同扩展跑局，另有随机条件的每日模式。",
      "dimension": "玩法",
      "excerpt": "Unlock 6 heroes with different starting artifacts and skills to create your custom run! More than 100 artifacts with a wide variety of effects that you can unlock with every game you play! 30 different dungeons. Each one adds a new rule to the game and will increase its difficulty! Daily Mode with randomly generated conditions!",
      "url": "https://store.steampowered.com/app/2228010/",
      "label": "证据原文片段"
    }
  ],
