  "hooks": [
    {
      "text": "在编辑器中用方块和挂件搭建浮空岛，并配置武器、护盾、反应堆与电池。",
      "dimension": "玩法",
      "excerpt": "Build your powerful island from loads of blocks and attachments with the island editor.",
      "url": "https://store.steampowered.com/app/1162470/",
      "label": "证据原文片段"
    },
    {
      "text": "战斗可通过摧毁浮力装置让敌岛坠落，或击爆跃迁核心直接炸毁整座岛。",
      "dimension": "玩法",
      "excerpt": "Take out all their floatrons to make them fall out of the sky or destroy their warp core and watch their island explode in a fiery inferno!",
      "url": "https://store.steampowered.com/app/1162470/",
      "label": "证据原文片段"
    },
    {
      "text": "装备可跨品阶锻造并注入科技，改变穿透、生命与冷却等具体属性。",
      "dimension": "玩法",
      "excerpt": "Forge items together to upgrade them from the bronze tier to the crystal tier! Every single item has the potential to be unique, and almost every property can be upgraded by tech. Infuse tech into items to give them cool buffs like damage penetration, increased health, or reduced cooldowns!",
      "url": "https://store.steampowered.com/app/1162470/",
      "label": "证据原文片段"
    }
  ],
