  "hooks": [
    {
      "text": "角色升级时选择天赋，可把单一方向堆到极致，也能分散投资应对多种威胁。",
      "dimension": "玩法",
      "excerpt": "Create your character, then level up and choose the talents that define your approach. Specialize in one area to overwhelm enemies with focused power, or diversify your strategy to withstand any threat - the choice is yours, for better or worse…",
      "url": "https://store.steampowered.com/app/3966890/",
      "label": "证据原文片段"
    },
    {
      "text": "冒险途中可添加、改写、复制、升级或删除卡牌，让牌组随遭遇持续重塑。",
      "dimension": "玩法",
      "excerpt": "Add, alter, copy, upgrade or remove cards as you progress and try to go toe-to-toe with the perils of Aethos.",
      "url": "https://store.steampowered.com/app/3966890/",
      "label": "证据原文片段"
    },
    {
      "text": "除主线外还有Sunforge快速Boss轮抽模式、每周积分挑战与高难度炼狱入侵。",
      "dimension": "玩法",
      "excerpt": "Play Dawncaster in the alternative fastphased Bossrun draft mode called the Sunforge, discover hidden bosses, play weekly challenges to compete against the very best players for points or enable the Infernal Invasions for an even more challenging experience!",
      "url": "https://store.steampowered.com/app/3966890/",
      "label": "证据原文片段"
    }
  ],
