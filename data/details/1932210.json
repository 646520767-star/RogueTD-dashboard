  "hooks": [
    {
      "text": "四个可解锁种族各自驾驶专属飞船，从矮人、人类、兽人到精灵形成不同开局",
      "dimension": "玩法",
      "excerpt": "Choose from four unlockable races, each with its ship: The fearless Dwarves , the intuitive Humans , the mystical Orks, or the glamorous Elves!",
      "url": "https://store.steampowered.com/app/1932210/",
      "label": "证据原文片段"
    },
    {
      "text": "连击可赚额外经验，清空敌人波次会回满电池，甚至能让回合持续不断",
      "dimension": "玩法",
      "excerpt": "Earn extra XP in combat by doing a chain of COMBOS! Plan and make your turns never end: Defeating a wave of enemies recharges your batteries. You might even resort to using your whole ship as a weapon!",
      "url": "https://store.steampowered.com/app/1932210/",
      "label": "证据原文片段"
    },
    {
      "text": "事件回应会生成不同Karma，同时改写角色声望与牌组走向",
      "dimension": "玩法",
      "excerpt": "Your response to events influences your reputation and deck: Karma will be generated during your interactions.",
      "url": "https://store.steampowered.com/app/1932210/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "美术风格受到明确肯定。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "美术风格挺好",
          "url": "https://steamcommunity.com/id/44361023/recommended/1932210/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "需要一段时间才会感到角色变强",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "it takes a while to feel like you're getting stronger.",
          "url": "https://store.steampowered.com/curator/43939029-The-Game-Report/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "战斗UI质量很差",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "战斗ui真的是依托",
          "url": "https://steamcommunity.com/id/44361023/recommended/1932210/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "所有地图节点都能访问，使移动段落被过度拉长。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the fact that you can visit every node on the map really drags out the travel segments.",
          "url": "https://steamcommunity.com/id/millionpede/recommended/1932210/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "中文翻译质量不佳。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "中翻不行",
          "url": "https://steamcommunity.com/id/44361023/recommended/1932210/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "战场单位偶尔会全部不显示。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "有时还会有战场上所有单位都不显示的bug",
          "url": "https://steamcommunity.com/profiles/76561198189697398/recommended/1932210/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "大量视觉效果会造成眼睛不适。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "a lot of effects, I'm not epileptic, but even my eyes hurt.",
          "url": "https://steamcommunity.com/id/Ghostbuster_Ray/recommended/1932210/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "明确协同的卡牌不多",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "there aren’t many cards with explicit synergies",
          "url": "https://steamcommunity.com/id/millionpede/recommended/1932210/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "核心玩法循环容易上瘾。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The gameplay loop is addictive",
          "url": "https://store.steampowered.com/curator/43939029-The-Game-Report/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "卡牌种类和策略选项丰富。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Love the card variety and strategic options.",
          "url": "https://store.steampowered.com/curator/43939488-Gamer-Detective/",
          "label": "证据原文片段"
        }
      ]
    }
