  "hooks": [
    {
      "text": "最多4人本地合作，队友复活简化以减少死亡后的等待时间",
      "dimension": "玩法",
      "excerpt": "Reviving team members made easy, keeping all players in the game without too much down time between deaths.",
      "url": "https://store.steampowered.com/app/2925450/",
      "label": "证据原文片段"
    },
    {
      "text": "程序生成房间中清敌升级拿战利品，即使失败也能获得局外成长奖励",
      "dimension": "玩法",
      "excerpt": "Dungeon crawl through procedurally generated rooms, kill all enemies, level up, and get that sweet, SWEET, loot! Struggling with your run and need a boost? We got you. Get rewarded at the end of each run, even if you fail. Rewards can unlock meta progression upgrades to make your runs easier.",
      "url": "https://store.steampowered.com/app/2925450/",
      "label": "证据原文片段"
    },
    {
      "text": "每日挑战会重组修正、角色和敌人，同时禁用局外升级保持同一起跑线",
      "dimension": "玩法",
      "excerpt": "A procedurally generated ruleset our servers generate that changes the gameplay experience everyday, adding different gameplay modifiers, allowing for only certain characters to be used, mixes up enemies spawned, and ether increases the player's power scaling fantasy, or gives you a real hard time. How far will you make it? Equal playing field: Meta progression upgrades are disabled in this mode.",
      "url": "https://store.steampowered.com/app/2925450/",
      "label": "证据原文片段"
    }
  ],
