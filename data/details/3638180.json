  "hooks": [
    {
      "text": "抢到甜甜圈就喂给鹿脸神秘妻子，让她在每局中逐级变强变大",
      "dimension": "玩法",
      "excerpt": "Steal donuts! Feed them to your cryptid wife to build her strength!",
      "url": "https://store.steampowered.com/app/3638180/",
      "label": "证据原文片段"
    },
    {
      "text": "七种武器贯穿七个独立关卡，支撑快节奏俯视角近身乱斗",
      "dimension": "玩法",
      "excerpt": "Try out 7 unique weapons across 7 unique levels!",
      "url": "https://store.steampowered.com/app/3638180/",
      "label": "证据原文片段"
    },
    {
      "text": "在镇外树林追查神秘异动，把荒诞抢劫旅程推向轻度恐怖谜团",
      "dimension": "故事",
      "excerpt": "Uncover some mysterious goings-on in the woods outside town...",
      "url": "https://store.steampowered.com/app/3638180/",
      "label": "证据原文片段"
    }
  ],
