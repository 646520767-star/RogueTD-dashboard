  "hooks": [
    {
      "text": "在吸血鬼与僵尸盘踞的城堡里，弩、霰弹枪甚至火箭筒都能清怪",
      "dimension": "玩法",
      "excerpt": "As you climb to the top of the Keep, you’ll face zombies, vampires, and other creatures that lurk in the darkness. Use crossbows, shotguns, or even a rocket launcher to dispose of them!",
      "url": "https://store.steampowered.com/app/3231520/",
      "label": "证据原文片段"
    },
    {
      "text": "同行女巫Juliet既强化能力、出售道具，也能协助现场制作武器",
      "dimension": "玩法",
      "excerpt": "Juliet, a sorceress loyal to the king (or maybe just a certain knight in armor) will assist Edward on his journey. She can upgrade your abilities and sell you items or even help you craft weapons!",
      "url": "https://store.steampowered.com/app/3231520/",
      "label": "证据原文片段"
    },
    {
      "text": "解锁生存模式后不仅能用Edward和Juliet，还能直接扮演四名Boss",
      "dimension": "玩法",
      "excerpt": "Unlockable survival mode allowing you to play as Edward, Juliet, and 4 of the game's bosses!",
      "url": "https://store.steampowered.com/app/3231520/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
