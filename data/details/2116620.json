  "hooks": [
    {
      "text": "快节奏回合制角斗可单挑或双人组队，还要躲开尖刺坑与陷阱",
      "dimension": "玩法",
      "excerpt": "Fast paced turn-based arena combat. Fight one-on-one or in teams of two, dodge spiked pits and traps on your way to victory",
      "url": "https://store.steampowered.com/app/2116620/",
      "label": "证据原文片段"
    },
    {
      "text": "四肢能被斩断或直接斩首，失去手脚后角斗士仍可继续战斗",
      "dimension": "玩法",
      "excerpt": "Limb severing and decapitations! Sever arms and legs and keep on fighting as your gladiator finds the strength to endure",
      "url": "https://store.steampowered.com/app/2116620/",
      "label": "证据原文片段"
    },
    {
      "text": "可随时在重制与经典画面间切换，角色、背景和商人都会同步变化",
      "dimension": "画风",
      "excerpt": "Switch between redux and classic graphics at any time, from gladiators to backgrounds to shopkeepers!",
      "url": "https://store.steampowered.com/app/2116620/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
