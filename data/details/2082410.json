  "hooks": [
    {
      "text": "一维战场压缩移动空间，以侧翼、背刺和围困争夺位置优势",
      "dimension": "玩法",
      "excerpt": "Anomaly Collapse thrusts you into an innovative one-dimensional battlefield grid, where movements are minimized, but strategy is maximized. Plan your moves and outmaneuver your foes by mastering the art of flanking, backstabbing, and cornering them in thrilling face-offs!",
      "url": "https://store.steampowered.com/app/2082410/",
      "label": "证据原文片段"
    },
    {
      "text": "为角色装备主动或被动“异常物”，在关键回合混搭效果逆转战局",
      "dimension": "玩法",
      "excerpt": "Equip your furry warriors with \"abnormalities\" – artifacts that possess active or passive effects. Delve into a vast collection of these power-ups scattered throughout the game, each with unique abilities. Leverage the power of these abnormalities at critical moments to turn the tide of battle, and mix and match them to craft the ultimate battle strategy!",
      "url": "https://store.steampowered.com/app/2082410/",
      "label": "证据原文片段"
    },
    {
      "text": "三个队伍槽位组合不同职业与特质，并在技能协同中解锁成员背景",
      "dimension": "玩法",
      "excerpt": "Craft a team of adorable yet formidable furry fighters, each boasting distinct classes and powerful traits. With three slots available, your choices will make or break your strategy. Devise innovative ways to synergize their skills, strategize combinations, all while unlocking their intriguing backstories.",
      "url": "https://store.steampowered.com/app/2082410/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "可爱美学表现出色",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "a cute aesthetic. It looks great",
          "url": "https://store.steampowered.com/curator/31828950-GoldGrabbers/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "角色视觉设计各具特色。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Each of the characters seemed to possess unique bios, play styles, and visual designs",
          "url": "https://steamcommunity.com/profiles/76561199222670473/recommended/2082410/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "东风、西风与黑洞等随机因素令人烦躁。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "如果没有东风、西风、死了原地僵挺一回合、重力黑洞就更好了",
          "url": "https://steamcommunity.com/id/callofAS/recommended/2082410/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "特殊敌人和增援会无限持续生成。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "it won't stop, they'll keep spawning",
          "url": "https://steamcommunity.com/id/Valencecrux/recommended/2082410/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "过度强调局外成长使前几局注定痛苦。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "作为一款肉鸽却过于强调局外成长，导致前期玩的几把注定是折磨",
          "url": "https://steamcommunity.com/profiles/76561199526250558/recommended/2082410/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "多数角色只有一个真正有效的构筑。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "everyone pretty much has 1 \"real\" build",
          "url": "https://steamcommunity.com/profiles/76561198000706716/recommended/2082410/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "随机队友机制会迫使玩家拿取不适配角色。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "队员选项你不是三选一 你不拿不加战力 拿了和队伍不适配",
          "url": "https://steamcommunity.com/profiles/76561198324884833/recommended/2082410/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "后期敌人、环境与增援叠加导致场地拥挤。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "a lot of enemies in the later zones, environmental hazards, enemies that split into more enemies and a crammed area",
          "url": "https://steamcommunity.com/id/Valencecrux/recommended/2082410/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "随机遗物强度跨度过大。",
