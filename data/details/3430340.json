  "hooks": [
    {
      "text": "在骰子工厂里把点数一路滚到一百万，才能找到逃生机会",
      "dimension": "玩法",
      "excerpt": "Dice A Million is a roguelike deckbuilder about rolling dice to try and get to a million points. That's the whole point . (get it?!) You're trapped in this dice rolling facility, so let's get rolling and try to escape.",
      "url": "https://store.steampowered.com/app/3430340/",
      "label": "证据原文片段"
    },
    {
      "text": "组合120多种骰子效果，用骰袋协同跨过不断上涨的债务与Boss",
      "dimension": "玩法",
      "excerpt": "Combine the effects of more than 120 different dice and discover powerful synergies . Get through ever-increasing debts and challenging bosses that will require perfect symbiosis in your bag in order to be beaten.",
      "url": "https://store.steampowered.com/app/3430340/",
      "label": "证据原文片段"
    },
    {
      "text": "为手牌装备80多枚常驻戒指，让被动效果不断改写骰子结果",
      "dimension": "玩法",
      "excerpt": "Gear up your hand with more than 80 unique rings with that will act as your passive items. They're always active and trigger wacky effects in your dice.",
      "url": "https://store.steampowered.com/app/3430340/",
      "label": "证据原文片段"
    }
