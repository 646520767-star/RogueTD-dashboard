  "hooks": [
    {
      "text": "点击既是采集、战斗和经营资源，但每天总共只有 20 次",
      "dimension": "玩法",
      "excerpt": "Use clicks to harvest resources, fight enemies and manage your village, but use them wisely as you only get 20 clicks every day!",
      "url": "https://store.steampowered.com/app/2751050/",
      "label": "证据原文片段"
    },
    {
      "text": "点击树木、敌人与迷雾执行不同动作，建筑还能把单次点击放大为更多产出",
      "dimension": "玩法",
      "excerpt": "For example, click a tree to get wood, click enemies to damage them or click the fog to reveal more of the map. Use structures to get the maximum out of your clicks. For example, build a quarry that automatically mines 3 stone per click or build click factories to obtain more clicks.",
      "url": "https://store.steampowered.com/app/2751050/",
      "label": "证据原文片段"
    },
    {
      "text": "每局赚取商店金币，用来购买新塔和快速点击等升级延长生存",
      "dimension": "玩法",
      "excerpt": "Each run gives you coins to spend in the shop. Buy new towers and upgrades like rapid click to survive longer!",
      "url": "https://store.steampowered.com/app/2751050/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "建筑和敌人设计可爱",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "每个建筑和敌人都设计得十分可爱",
