  "hooks": [
    {
      "text": "买卖的是基于模拟外星婴儿人生的股票，可押注寿命并在中银河彩票时套现",
      "dimension": "玩法",
      "excerpt": "You buy stocks BASED on the simulated lives of babies, profiting from their misery and cashing out the moment they win the Galactic Lottery! Step into the shoes of baby traders across the universe in a fast-paced series of mini-campaigns. Unlock unique character endings, bet on the lifespans of digitally simulated alien children, and snatch up as many credits as you can, as fast as you can.",
      "url": "https://store.steampowered.com/app/3642000/",
      "label": "证据原文片段"
    },
    {
      "text": "交易日前雇佣古怪顾问，收集目标数据以提高短时Trading Rush决策质量",
      "dimension": "玩法",
      "excerpt": "Purchase the services of strange consultants, gathering data on your trading targets and building your fortune one Trading Rush at a time.",
      "url": "https://store.steampowered.com/app/3642000/",
      "label": "证据原文片段"
    },
    {
      "text": "七颗行星分别生成外星婴儿股票，并用不同社会利润标准改写市场",
      "dimension": "玩法",
      "excerpt": "Seven distinct planets to trade procedurally generated alien baby stocks on, each showcasing unique ideas of what it means to be profitable and productive to society.",
      "url": "https://store.steampowered.com/app/3642000/",
      "label": "证据原文片段"
    }
