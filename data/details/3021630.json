  "hooks": [
    {
      "text": "突刺或劈砍、单手或双手等4种风格与6类变化组合出数百套武器方案",
      "dimension": "玩法",
      "excerpt": "Thrusting or slashing, one-handed or two-handed, choose from four styles and six variations with hundreds of possible combinations – exploit the full potential of your weapons.",
      "url": "https://store.steampowered.com/app/3021630/",
      "label": "证据原文片段"
    },
    {
      "text": "战斗材料既可在铁匠处强化装备，也可献给神像换取额外神恩",
      "dimension": "玩法",
      "excerpt": "Use the resources you obtain during your fights to bolster your weapons, improve your equipment at the blacksmith's, and make offerings to the divine statue to garner additional favors.",
      "url": "https://store.steampowered.com/app/3021630/",
      "label": "证据原文片段"
    },
    {
      "text": "解锁90种以上神圣祝福，并同步定制天赋、技能和装备形成长期构筑",
      "dimension": "玩法",
      "excerpt": "Pledge your allegiance, unlock over 90 divine blessing powers, customize your talents and skills, and upgrade your equipment in a gameplay experience packed with replayability!",
      "url": "https://store.steampowered.com/app/3021630/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "美术风格获得满分评价。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Art style: 10/10",
          "url": "https://steamcommunity.com/id/TalibanHeadquarters/recommended/3021630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "角色设计获得满分评价。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Character design: 10/10",
          "url": "https://steamcommunity.com/id/TalibanHeadquarters/recommended/3021630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "游戏很快变得重复乏味",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "it gets repetitive quick",
          "url": "https://steamcommunity.com/profiles/76561198041396838/recommended/3021630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "内容量不足，只有三个关卡。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "There is just not enough content here. There is 3 levels.",
          "url": "https://steamcommunity.com/profiles/76561198004413401/recommended/3021630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "肉鸽元素不足以改变每局打法。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the rogue like elements, while interesting in a vacuum, don't do enough to spice up each run",
          "url": "https://steamcommunity.com/profiles/76561197982775469/recommended/3021630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "高难度的速度要求会大幅压缩可行选择",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "At high ascension (/heat), the game requires speed, so the choice is dramatically reduced",
          "url": "https://steamcommunity.com/id/FerZb/recommended/3021630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "攻击判定和闪避帧不可靠。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The hit detection and dodge frames in this game are absolute garbage and don't make sense at all.",
          "url": "https://steamcommunity.com/profiles/76561198030351964/recommended/3021630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "武器和饰品效果对构筑有明显影响。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the effects of each weapon and each trinket have a noticeable impact",
          "url": "https://steamcommunity.com/profiles/76561197995911051/recommended/3021630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "核心战斗打磨充分且质量很高。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The core combat is so polished and high quality",
          "url": "https://steamcommunity.com/profiles/76561197982775469/recommended/3021630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "战斗节奏较慢但仍有趣且令人满意。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "its combat is slower but still very interesting and satisfying",
          "url": "https://steamcommunity.com/id/lasagna-eater/recommended/3021630/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
