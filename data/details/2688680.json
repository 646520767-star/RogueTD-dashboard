  "hooks": [
    {
      "text": "随从卡各有技能和种族效果，凑出种族联动会直接强化对应属性。",
      "dimension": "玩法",
      "excerpt": "The game features dozens of minion cards, each with unique skills and effects, showcasing their individual characteristics. Every minion possesses distinct racial effects that, when activated, enhance different racial attributes, making battles significantly more manageable.",
      "url": "https://store.steampowered.com/app/2688680/",
      "label": "证据原文片段"
    },
    {
      "text": "不同女性主角会展开各自故事线，换主角重开能得到不同冒险体验。",
      "dimension": "故事",
      "excerpt": "There are four main female protagonists in the game, each forming diverse and engaging storylines. Try starting the game with different protagonists for varied experiences.",
      "url": "https://store.steampowered.com/app/2688680/",
      "label": "证据原文片段"
    },
    {
      "text": "城镇不是菜单背景，和NPC互动并升级城镇会持续改变冒险的新鲜度。",
      "dimension": "玩法",
      "excerpt": "Towns play a crucial role in the game. By interacting with NPCs and upgrading the town, players can significantly enhance the freshness of gameplay.",
      "url": "https://store.steampowered.com/app/2688680/",
      "label": "证据原文片段"
    }
  ],
