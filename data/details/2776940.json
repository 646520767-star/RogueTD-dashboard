  "hooks": [
    {
      "text": "攻防快速转换与精准反击会累积敌人架势条，击溃防御后才能释放致命攻击",
      "dimension": "玩法",
      "excerpt": "Through rapid transitions between offense and defense, and precise counterattacks, players can build up the enemy's momentum bar, causing their defenses to collapse. Once an opportunity is seized, players can unleash deadly attacks, experiencing a high-intensity battle that seamlessly integrates offense and defense.",
      "url": "https://store.steampowered.com/app/2776940/",
      "label": "证据原文片段"
    },
    {
      "text": "三星堆遗址与京剧被直接融入首领造型和场景布局",
      "dimension": "画风",
      "excerpt": "The game deeply incorporates traditional Chinese culture, featuring elements such as the Sanxingdui ruins and Peking opera. The designs of the bosses and the arrangement of the scenes reflect the unique essence of traditional culture.",
      "url": "https://store.steampowered.com/app/2776940/",
      "label": "证据原文片段"
    },
    {
      "text": "唢呐、琵琶、古琴、古筝与打击乐共同构成传统中国乐器配乐",
      "dimension": "画风",
      "excerpt": "The game’s soundtrack features traditional Chinese instruments like the suona, pipa, guqin, and guzheng, combined with the unique sounds of percussion instruments, presenting the charm of traditional Chinese music.",
      "url": "https://store.steampowered.com/app/2776940/",
      "label": "证据原文片段"
    }
  ],
