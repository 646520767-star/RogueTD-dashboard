  "hooks": [
    {
      "text": "培育有不同性格与潜力的Crabling，让它们筑珊瑚、抗威胁并收集迁徙食物",
      "dimension": "玩法",
      "excerpt": "Nurture their personalities and potential as they worship you, build mighty coral reefs, fend off threats, and collect food for the journey ahead.",
      "url": "https://store.steampowered.com/app/2289390/",
      "label": "证据原文片段"
    },
    {
      "text": "护送神卵向深海迁徙时必须平衡殖民地成长与蛋的安全，失守就退回浅海重来",
      "dimension": "玩法",
      "excerpt": "Balance the growth of your colony with the safety of your egg, otherwise, you will need to return to the shallows and start the migration anew.",
      "url": "https://store.steampowered.com/app/2289390/",
      "label": "证据原文片段"
    },
    {
      "text": "游戏内修复珊瑚礁的进度会通过dots.eco转化为现实海洋保护贡献",
      "dimension": "题材",
      "excerpt": "Working with dots.eco, your in-game progression will help contribute to actual ocean conservation efforts.",
      "url": "https://store.steampowered.com/app/2289390/",
      "label": "证据原文片段"
    }
  ],
