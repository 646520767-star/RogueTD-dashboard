  "hooks": [
    {
      "text": "守住“Mushtower”，用有限法力部署动物盟友，顶住持续敌潮直到击败首领。",
      "dimension": "玩法",
      "excerpt": "Protect it from the waves of incoming enemies. The enemies will keep coming until their boss is defeated. Use limited mana wisely to send animal allies against the foes and utilize skills to push back the front lines.",
      "url": "https://store.steampowered.com/app/3001330/",
      "label": "证据原文片段"
    },
    {
      "text": "白昼到黑夜敌人持续变强，通过动物卡、强化帽、精灵技能卡与神器共同扩充牌组成长。",
      "dimension": "玩法",
      "excerpt": "Obtain better animal cards and equip them with hats that provide enhancement effects. Elf skill cards and Artifacts are also crucial to your strategy for victory!",
      "url": "https://store.steampowered.com/app/3001330/",
      "label": "证据原文片段"
    },
    {
      "text": "扮演守护精灵，带领动物盟友与蘑菇魔法净化被怨恨橡树诅咒的森林。",
      "dimension": "题材",
      "excerpt": "However, a deeply resentful oak has cursed and corrupted the forest. As a guardian elf, rally animal allies and use mushroom skills to defend your base and purify the forest!",
      "url": "https://store.steampowered.com/app/3001330/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "强成长构筑成型后胜负失去悬念。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Once you get one of these cards, the run is an inevitable win",
          "url": "https://steamcommunity.com/id/Verisimilitude/recommended/3001330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "最终战只容许很少的有效卡牌与战术。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "a very limited amount of cards and tactics that will be able to viably add value to the final fight.",
          "url": "https://steamcommunity.com/id/rogers37044/recommended/3001330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "部分操作不够人性化。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "这个游戏有些操作并不人性化",
          "url": "https://steamcommunity.com/profiles/76561199070493259/recommended/3001330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "整体平衡差，过于容易破坏难度。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Really unbalanced as it is, it is so easy to break the game that there is no difficulty at all.",
          "url": "https://steamcommunity.com/id/Fataelis/recommended/3001330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "只有少数强成长卡值得拿，严重限制卡牌可用性。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "~90% of cards aren't worth taking.",
          "url": "https://steamcommunity.com/id/Verisimilitude/recommended/3001330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "塔防、牌组构筑与肉鸽的融合令人上瘾。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "perfect mix between TD and deckbuilder. Now add roguelike to it and you have a perfectly addictive game.",
          "url": "https://store.steampowered.com/curator/38553778-All-about-Strategy-Games/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "随机事件的选择过程有趣。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The event decision making was fun",
          "url": "https://steamcommunity.com/profiles/76561198054382565/recommended/3001330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "相比同类作品具有更深的策略性。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "it has a much deeper strategy",
          "url": "https://steamcommunity.com/id/elijahjns/recommended/3001330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "难度设置方式获得玩家认可。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "I like this method of challenge",
          "url": "https://steamcommunity.com/profiles/76561198054382565/recommended/3001330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "温馨战斗游戏的主题受到喜爱。",
      "dimension": "主题",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "I love those cosy combat games.",
          "url": "https://store.steampowered.com/curator/45146471-TheCozyCafe/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
