  "hooks": [
    {
      "text": "连续击杀维持连击链，直接放大经验、金币与稀有掉落收益",
      "dimension": "玩法",
      "excerpt": "The chain combo system is a core game mechanic which boosts your hero's rewards! Completing chain combos is a great way to increase experience gained, gold find, and magic find!",
      "url": "https://store.steampowered.com/app/948820/",
      "label": "证据原文片段"
    },
    {
      "text": "每个职业从12项独特天赋中混搭，定向塑造角色优势",
      "dimension": "玩法",
      "excerpt": "Class Depth: Blend 12 unique talents per class to customize your hero’s strengths!",
      "url": "https://store.steampowered.com/app/948820/",
      "label": "证据原文片段"
    },
    {
      "text": "九百余独特装备与28套套装构成高密度寻宝和套装加成追求",
      "dimension": "玩法",
      "excerpt": "In addition to items with randomized properties, there are over 900 uniquely designed items that can be discovered. You can even find items from 28 different sets which provide passive bonuses as you equip more pieces!",
      "url": "https://store.steampowered.com/app/948820/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "向玩家提供的信息不足。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Complete lack of information given to the player:",
          "url": "https://steamcommunity.com/id/Veriok/recommended/948820/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "缺少自动释放技能。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "什麽年代了自動釋放技能都沒有 玩笑了",
          "url": "https://steamcommunity.com/profiles/76561198305534687/recommended/948820/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "便利性功能不足。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Complete lack of QoL:",
          "url": "https://steamcommunity.com/id/Veriok/recommended/948820/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "稀有装备被独特装备全面替代，装备层级冗余。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "why have rare gear with randomized stats when uniques are just straight up better",
          "url": "https://steamcommunity.com/id/Veriok/recommended/948820/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "商店标注的中文支持不可信。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "语言写着有中文 不就纯诈骗",
          "url": "https://steamcommunity.com/profiles/76561198301525733/recommended/948820/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "大量职业缺少真正专精差异。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "A ton of classes that don't really specialize.",
          "url": "https://steamcommunity.com/id/Veriok/recommended/948820/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "角色成长与易操作性的组合很好。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The accessibility plus character progression focused gameplay is a really nice mix for me.",
          "url": "https://steamcommunity.com/profiles/76561198026074229/recommended/948820/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "战斗虽然混乱，但很有趣。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "combat is considerably more chaotic, yet fun.",
          "url": "https://steamcommunity.com/profiles/76561198273254344/recommended/948820/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "只用一只手操作鼠标也能轻松游玩。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "This is a chill game that can be played with just your hand on the mouse",
          "url": "https://steamcommunity.com/profiles/76561198026074229/recommended/948820/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
