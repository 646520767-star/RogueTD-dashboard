          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "敌人高度同质化。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the enemies are all very samey",
          "url": "https://steamcommunity.com/id/chemlab/recommended/3047370/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "关卡设计几乎不存在。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The level design is basically nonexistent.",
          "url": "https://steamcommunity.com/id/chemlab/recommended/3047370/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "缺少节点模拟或预览功能。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the game would benefit from a simulation or preview system for the nodes",
          "url": "https://steamcommunity.com/id/olivergame/recommended/3047370/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "复杂范围遍历会造成严重卡顿。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "范围遍历一多以后好卡",
          "url": "https://steamcommunity.com/profiles/76561198222329556/recommended/3047370/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "移动键偶尔会卡住。",
