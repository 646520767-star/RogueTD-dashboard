  "hooks": [
    {
      "text": "用190多个拖拽式编程节点可视化编写攻击算法，再让代码在实时弹幕战中执行。",
      "dimension": "玩法",
      "excerpt": "Net.Attack() is a bullet-heaven roguelite where you visually program your own attack algorithms using 190+ drag-and-drop nodes, then watch them execute in real-time combat against security system hordes.",
      "url": "https://store.steampowered.com/app/3047370/",
      "label": "证据原文片段"
    },
    {
      "text": "挑战强调确定性：胜负取决于逻辑设计与操作能力，而非随机数托底。",
      "dimension": "玩法",
      "excerpt": "No RNG Excuses - Deterministic challenge where logic and skill beats luck",
      "url": "https://store.steampowered.com/app/3047370/",
      "label": "证据原文片段"
    },
    {
      "text": "每次芯片提取获得DarkBits，在黑市解锁新干员与跨局永久强化。",
      "dimension": "玩法",
      "excerpt": "Collect DarkBits# with each chip extraction and exchange them on the DarkMarket for new operatives and permanent power upgrades across runs.",
      "url": "https://store.steampowered.com/app/3047370/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "敌人种类不足，容易引发无聊。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "lack of diversity in foes could lead to boredom",
          "url": "https://youtu.be/kc_-O5sVeXk",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "难度存在残酷尖峰。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "brutal difficulty spikes",
          "url": "https://vaporlens.app/app/3047370/net_attack_code_or_die",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "长期成长刷取速度极慢。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "that progression treadmill is sloooooooow",
          "url": "https://steamcommunity.com/id/chemlab/recommended/3047370/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "每个关卡几乎完全相同。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Every level is nearly identical",
          "url": "https://steamcommunity.com/id/chemlab/recommended/3047370/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "配件池扩大后更难获得目标配件。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "解锁配件池多了以后反而很难玩到想玩的配件了",
          "url": "https://steamcommunity.com/profiles/76561198222329556/recommended/3047370/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "教程过长且难以理解。",
