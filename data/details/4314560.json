  "hooks": [
    {
      "text": "通过折叠纸张改变棋盘位置与地形关系，甚至能不直接攻击就完成战斗",
      "dimension": "玩法",
      "excerpt": "Overcome the odds on a disadvantageous battlefield and defeat enemies in your own way through paper folding! You can even claim victory without attacking directly.",
      "url": "https://store.steampowered.com/app/4314560/",
      "label": "证据原文片段"
    },
    {
      "text": "每场战斗后从不同奖励中选择Pebble与技能，持续拼装独特角色构筑",
      "dimension": "玩法",
      "excerpt": "Wisely choose your rewards from every varying battle victory, and combine various Pebbles and Skills to create your own unique character.",
      "url": "https://store.steampowered.com/app/4314560/",
      "label": "证据原文片段"
    },
    {
      "text": "纸片英雄进入祖父的故事，整个纸香世界中最强武器不是剑或魔法，而是玩家亲手折纸",
      "dimension": "题材",
      "excerpt": "You become a paper hero in the world of Cartapli and embark on an adventure into your grandfather's story. In this world filled with the scent of paper, your most powerful weapon is neither sword nor magic, but your own hands folding paper.",
      "url": "https://store.steampowered.com/app/4314560/",
      "label": "证据原文片段"
    }
  ],
