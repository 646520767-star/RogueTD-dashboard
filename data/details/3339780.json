  "hooks": [
    {
      "text": "游戏直接覆盖真实桌面运行，鼠标光标化身英雄在屏幕上迎战敌潮",
      "dimension": "玩法",
      "excerpt": "PLAY ON YOUR DESKTOP Desktop Survivors 98 doesn’t play in a window — it plays over your desktop. Enemies, upgrades, and chaos unfold across your real screen.",
      "url": "https://store.steampowered.com/app/3339780/",
      "label": "证据原文片段"
    },
    {
      "text": "可随时一键切换暂停或恢复，适合在其他桌面任务间快速插入一轮",
      "dimension": "玩法",
      "excerpt": "With its fast-paced rounds and the ability to toggle the game at any moment, you’re always just a click away from diving back into the action.",
      "url": "https://store.steampowered.com/app/3339780/",
      "label": "证据原文片段"
    },
    {
      "text": "光标在随机地牢房间中进行弹幕战，边探索边获取并升级武器",
      "dimension": "玩法",
      "excerpt": "SURVIVE, EXPLORE, REPEAT Survive against waves of enemies in quick, intense rounds as you explore the randomly generated dungeons. Your cursor becomes the hero, battling against foes in a bullet hell frenzy that tests your reflexes, precision, and decision-making.",
      "url": "https://store.steampowered.com/app/3339780/",
      "label": "证据原文片段"
    }
  ],
