  "hooks": [
    {
      "text": "白班砍树积累进度，班次结束购买加速工具，夜班则会遭遇更多守护者",
      "dimension": "玩法",
      "excerpt": "Start your shift and chip down the Tree. Once your shift is over, buy tools that help you cut it faster. Be careful, at night even more Protectors will try to defend the Tree.",
      "url": "https://store.steampowered.com/app/3536160/",
      "label": "证据原文片段"
    },
    {
      "text": "必须在砍树工作与击退守护者之间分配时间，任一侧失衡都可能被解雇",
      "dimension": "玩法",
      "excerpt": "Don't let the Protectors stop you. Find the balance between working and fighting to avoid getting fired.",
      "url": "https://store.steampowered.com/app/3536160/",
      "label": "证据原文片段"
    },
    {
      "text": "海狸工人被当作可随时替换的消耗品，失败后雇主会直接派下一只继续盈利",
      "dimension": "题材",
      "excerpt": "Get hired as one of the many disposable beavers tasked with cutting down Tree of Life and defeating its Protectors . Work nonstop, day and night shifts, to bring the tree down and make your employers some money. And if you don't make it, don't worry. The next one will.",
      "url": "https://store.steampowered.com/app/3536160/",
      "label": "证据原文片段"
    }
  ],
