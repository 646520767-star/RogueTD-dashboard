  "hooks": [
    {
      "text": "固定十四张牌重新解释麻将，用吃、碰与对子完成每回合组合",
      "dimension": "玩法",
      "excerpt": "In this strategic turn-based system, you reinterpret classic mahjong gameplay using a fixed set of 14 tiles to form combinations such as Chi (Chow), Pong (Pung), and Pair.",
      "url": "https://store.steampowered.com/app/3332060/",
      "label": "证据原文片段"
    },
    {
      "text": "打破传统限制一次摆出十四张东风牌，并按八个方位安置风水宝物",
      "dimension": "玩法",
      "excerpt": "Break traditional limitations and experience the joy of playing all 14 East tiles at once. Place mystical treasures across the eight directional slots while minding Feng Shui Dos and Don'ts.",
      "url": "https://store.steampowered.com/app/3332060/",
      "label": "证据原文片段"
    },
    {
      "text": "技能牌可改牌、加分或重写宝物效果，宝物联动后形成不同构筑流派",
      "dimension": "玩法",
      "excerpt": "Collect and use skill cards to manipulate tiles, increase scores, or modify treasure effects. Treasures interact to create powerful synergies, enabling varied deck-building paths and playstyles.",
      "url": "https://store.steampowered.com/app/3332060/",
      "label": "证据原文片段"
    }
