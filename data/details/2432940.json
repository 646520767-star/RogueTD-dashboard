  "hooks": [
    {
      "text": "时间是唯一资源，占旗扩张领土并直接缩短机器人和坦克生产时间",
      "dimension": "玩法",
      "excerpt": "Flags mean victory! Time is your only resource! Capture the flags to conquer territories and reduce your production time! Unlock secret weapons and hidden technologies! The more flags you secure, the faster your robots and tanks are produced.",
      "url": "https://store.steampowered.com/app/2432940/",
      "label": "证据原文片段"
    },
    {
      "text": "夺取核弹井后可发动终极核打击，但未爆炸弹能被敌方拦截击落",
      "dimension": "玩法",
      "excerpt": "And finally, the cherry on the cake - the Nuke ☢️ Take control of the nuclear silo to access the ultimate weapon of the game! Rain down destruction on your enemies and obliterate their fort! The Nuke is a high-risk, high-reward weapon! Enemies can react and shoot down the unexploded bomb, so plan your attack carefully. Distract them and strike when they least expect it!",
      "url": "https://store.steampowered.com/app/2432940/",
      "label": "证据原文片段"
    },
    {
      "text": "夜晚僵尸会夺取无人防守领土，一口即可感染机器人，摧毁墓地才能止住刷新",
      "dimension": "玩法",
      "excerpt": "Day and night change and weather effects! Be on guard as night falls and zombies lurk! Each night, zombies appear around the map, threatening to take over your unprotected territories. Keep your robot soldiers protected, as one bite can turn them instantly into more undead! Destroy the graveyards to stop the menace!",
      "url": "https://store.steampowered.com/app/2432940/",
      "label": "证据原文片段"
    }
  ],
