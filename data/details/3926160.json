  "hooks": [
    {
      "text": "烤串就是防御塔，可拖放上场并射击、弹射、溅射甚至把敌人推出场外",
      "dimension": "玩法",
      "excerpt": "Drag, drop, and watch your tasty skewers jump into battle. Shoot, bounce, and splash. You can even boop enemies right off the field.",
      "url": "https://store.steampowered.com/app/3926160/",
      "label": "证据原文片段"
    },
    {
      "text": "20多名烧烤大师各带独特天赋，每人都能成为一种流派核心",
      "dimension": "玩法",
      "excerpt": "20+ Grillmasters, each with unique talents Every Grillmaster can become the core of a different playstyle, letting you craft your own exclusive skewer squad!",
      "url": "https://store.steampowered.com/app/3926160/",
      "label": "证据原文片段"
    },
    {
      "text": "40多种食材效果与100多种随机调味料叠加，让每局烤串队伍重新组合",
      "dimension": "玩法",
      "excerpt": "40+ tasty and powerful foods Whether they split, bounce, or knock enemies back, combine these effects to master your signature playstyle! 100+ powerful seasonings and items spawn randomly, adding constant depth to your playstyle and making every run a brand new experience!",
      "url": "https://store.steampowered.com/app/3926160/",
      "label": "证据原文片段"
    }
  ],
