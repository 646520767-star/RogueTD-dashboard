  "hooks": [
    {
      "text": "统治核心是在军事力量与政治阴谋间保持平衡，同时防范顾问暗中背叛。",
      "dimension": "玩法",
      "excerpt": "Find the delicate balance between military might and cunning political intrigues, as not all battles are won with strength. Skillfully manage your advisors to solidify your rule, but beware, as they may engage in their own treacherous game behind your back.",
      "url": "https://store.steampowered.com/app/2515030/",
      "label": "证据原文片段"
    },
    {
      "text": "社区故事模式既能游玩其他玩家创作的传说，也能用编辑器制作并分享自己的冒险。",
      "dimension": "故事",
      "excerpt": "The cherry on top? Community Stories Mode, where you can dive into the tales crafted by other players, as well as compose and share your own adventures using a convenient editor.",
      "url": "https://store.steampowered.com/app/2515030/",
      "label": "证据原文片段"
    },
    {
      "text": "手绘画面以阴郁王国、层叠阴影和细节场景强化黑暗统治叙事。",
      "dimension": "画风",
      "excerpt": "The hand-crafted visuals of the game plunge you deep into the ambiance of a brooding kingdom. Every detail, every shadow speaks of a world built with care and passion, ensuring a visually captivating journey intertwined with riveting narratives.",
      "url": "https://store.steampowered.com/app/2515030/",
      "label": "证据原文片段"
    }
  ],
