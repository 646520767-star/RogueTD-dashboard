  "hooks": [
    {
      "text": "同时规划地牢布局、陷阱位置、雇佣怪物和宝藏诱饵，为来访英雄设计完整冒险路线",
      "dimension": "玩法",
      "excerpt": "You not only design the layout, but choose the best places for whatever traps you decide to use, which monsters you will hire to face the heroes, and what treasures await those skilled enough to claim victory.",
      "url": "https://store.steampowered.com/app/3090980/",
      "label": "证据原文片段"
    },
    {
      "text": "观察英雄访客的实际行为来迭代地牢设计，并向他们出售药水等辅助品获取经营收益",
      "dimension": "玩法",
      "excerpt": "Inspect and watch your visitors to see how you can further improve your design. Sell potions and other various aids to your visitors.",
      "url": "https://store.steampowered.com/app/3090980/",
      "label": "证据原文片段"
    },
    {
      "text": "召唤并升级守关生物，同时通过研究持续解锁新的地牢改造方式",
      "dimension": "玩法",
      "excerpt": "Summon and upgrade powerful creatures to challenge heroes in their pursuit to find the treasures that lay within the dungeon. Research new stuff to unlock new ways of improving your dungeon.",
      "url": "https://store.steampowered.com/app/3090980/",
      "label": "证据原文片段"
    }
  ],
