  "hooks": [
    {
      "text": "每波获得随机地块并旋转铺设敌人路线",
      "dimension": "玩法",
      "excerpt": "Monster Tiles TD features a unique tower defense mechanic where you manually rotate and place a randomly generated tile after each wave to control the enemy path.",
      "url": "https://store.steampowered.com/app/2447060/",
      "label": "证据原文片段"
    },
    {
      "text": "三十五种怪物塔可进化并触发站位协同",
      "dimension": "玩法",
      "excerpt": "Over 35 monster tower types to build, each with unique skills and synergies. Evolve monsters to greater forms for powerful stat and skill bonuses.",
      "url": "https://store.steampowered.com/app/2447060/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "在线模式具有付费取胜问题。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the online gamemode is pay to win",
          "url": "https://store.steampowered.com/curator/44911430-Cheap-Games-for-Rich-Memories/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "成长与付费系统鼓励通过消费缓解刷取。",
