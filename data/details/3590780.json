  "hooks": [
    {
      "text": "Handler与NANO的关系强度会直接决定安卓伙伴的成长、效率和潜力。",
      "dimension": "玩法",
      "excerpt": "As a Handler , your bond with your NANO determines its growth, efficiency, and potential. The stronger your connection, the more your NANO thrives - and so does the world around you.",
      "url": "https://store.steampowered.com/app/3590780/",
      "label": "证据原文片段"
    },
    {
      "text": "可给NANO安排制作、采集、科研协助和特殊任务，获得收入用于更多外观定制。",
      "dimension": "玩法",
      "excerpt": "Assign your NANO different tasks and jobs - whether it’s crafting, gathering, assisting with research, or even taking on unique missions. They can earn rewards and income for you to spend on more customisation!",
      "url": "https://store.steampowered.com/app/3590780/",
      "label": "证据原文片段"
    },
    {
      "text": "Discord服务器可直接变成游戏社交空间，朋友即使没有游戏也能进入互动。",
      "dimension": "玩法",
      "excerpt": "Turn your Discord server into living social hubs. Jump in with your friends, explore, and play together inside Nano Neighbors — even if they don’t own the game.",
      "url": "https://store.steampowered.com/app/3590780/",
      "label": "证据原文片段"
    }
