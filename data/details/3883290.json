  "hooks": [
    {
      "text": "战斗消耗行动点，每次胜利后只能从少数选项中学习或强化一项技能",
      "dimension": "玩法",
      "excerpt": "Combat relies on your skills and AP (action points). After each victory, you'll have the option of learning or enhancing a single skill out of a select few.",
      "url": "https://store.steampowered.com/app/3883290/",
      "label": "证据原文片段"
    },
    {
      "text": "探索同时消耗饥饿资源，未及时进食会把惩罚带入战斗",
      "dimension": "玩法",
      "excerpt": "Exploration is likewise a struggle against hunger. Fail to nourish yourself, and you'll be met with penalties during combat.",
      "url": "https://store.steampowered.com/app/3883290/",
      "label": "证据原文片段"
    },
    {
      "text": "迷宫中的混沌会污染灵魂，腐化累积至上限便直接结束游戏",
      "dimension": "玩法",
      "excerpt": "Even the slightest misstep can soil your soul, and once corruption reaches its limit you'll be swallowed up by a game over.",
      "url": "https://store.steampowered.com/app/3883290/",
      "label": "证据原文片段"
    }
  ],
