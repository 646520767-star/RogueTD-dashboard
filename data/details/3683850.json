  "hooks": [
    {
      "text": "喊叫、哼唱、吟诵、咳嗽甚至意外喷嚏都能触发真实技能，把麦克风中的任何声音变成战斗输入",
      "dimension": "玩法",
      "excerpt": "This is a co-op voice-controlled chaos simulator where yelling, humming, chanting, coughing, or accidentally sneezing can all trigger actual in-game skills.",
      "url": "https://store.steampowered.com/app/3683850/",
      "label": "证据原文片段"
    },
    {
      "text": "攻击、治疗和终极技能分别绑定不同声音，玩家要在实战中保持可辨识的发声指令",
      "dimension": "玩法",
      "excerpt": "Want to attack? Make a noise. Want to heal? Make a different noise. Want to cast your ultimate? Good luck keeping a straight face.",
      "url": "https://store.steampowered.com/app/3683850/",
      "label": "证据原文片段"
    },
    {
      "text": "2至4人合作的笑点来自声音误触：喷嚏可能被当攻击，笑声甚至会意外释放大招",
      "dimension": "玩法",
      "excerpt": "…but the game shines when 2–4 players team up and attempt “communication.” Expect conversations like： “Was that your attack or your sneeze?” “Stop laughing, you’re triggering your ultimate!” “Bro your mic sensitivity is a war crime.”",
      "url": "https://store.steampowered.com/app/3683850/",
      "label": "证据原文片段"
    }
  ],
