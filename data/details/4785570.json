  "hooks": [
    {
      "text": "在弹幕潮中寻找射击窗口，同时守住基地核心，融合塔防布阵与主动射击。",
      "dimension": "玩法",
      "excerpt": "Enemies swarm like tidal waves. You must choose skills wisely, find your firing window amidst the bullet chaos, and never forget to defend your base core.",
      "url": "https://store.steampowered.com/app/4785570/",
      "label": "证据原文片段"
    },
    {
      "text": "枪械、火、冰、雷与能量天赋可叠加触发连锁反应，并针对敌人组合克制流派。",
      "dimension": "玩法",
      "excerpt": "The game offers multiple talent paths: Gunslinging DPS, Fire, Ice, Lightning, Energy — each can stack and trigger chain reactions with one another. Craft your own Fire-Lightning Storm, Ice Explosion, Machine Gun Physical DPS build… different builds, completely different experiences!",
      "url": "https://store.steampowered.com/app/4785570/",
      "label": "证据原文片段"
    },
    {
      "text": "灵体伙伴、不同弹道手感的枪械与专属天赋英雄共同决定开局和中期转型。",
      "dimension": "玩法",
      "excerpt": "Fantom – A spirit unit that fights alongside you, providing passive bonuses and an active skill. Gun System – Different weapon types offer unique bullet patterns and handling. Multiple Characters – Each with their own unique talent skill, affecting your early-game strategy and mid-game transitions.",
      "url": "https://store.steampowered.com/app/4785570/",
      "label": "证据原文片段"
    }
  ],
