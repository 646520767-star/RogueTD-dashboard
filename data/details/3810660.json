  "hooks": [
    {
      "text": "猫薄荷限时强化可连续叠加，让火力随存活时间升级至清屏规模",
      "dimension": "玩法",
      "excerpt": "Stack time-limited power-ups to transform from a fragile space cat into a screen-clearing force of destruction. The longer you survive, the stronger you become.",
      "url": "https://store.steampowered.com/app/3810660/",
      "label": "证据原文片段"
    },
    {
      "text": "弹幕走位同时穿越激光网、坍塌结构、火焰陷阱与浮岛环境危机",
      "dimension": "玩法",
      "excerpt": "Dodge, weave, and survive as the screen fills with projectiles, environmental hazards, and enemies that do not care about your plans. Thread your way through laser grids, collapsing structures, fire traps, and floating islands, while blasting everything in your path.",
      "url": "https://store.steampowered.com/app/3810660/",
      "label": "证据原文片段"
    },
    {
      "text": "90年代可爱射击风格把明亮角色与荒诞敌人包进高强度弹幕战",
      "dimension": "画风",
      "excerpt": "A cute-em-up is a bullet hell where adorable meets absolute chaos. Bright visuals, charming characters, and absurd enemies wrap around fast, precise gameplay where survival, positioning, and mastery still matter.",
      "url": "https://store.steampowered.com/app/3810660/",
      "label": "证据原文片段"
    }
  ],
