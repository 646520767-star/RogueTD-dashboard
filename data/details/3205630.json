  "hooks": [
    {
      "text": "每次选择元素之门都会改写生物、事件、奖励和最终 Boss，终极敌人由玩家一路塑造。",
      "dimension": "玩法",
      "excerpt": "Every elemental gate you pass through will alter the creatures, events, rewards, and final boss. As you ascend the Arcane Tower, you will be the one to shape the ultimate enemy.",
      "url": "https://store.steampowered.com/app/3205630/",
      "label": "证据原文片段"
    },
    {
      "text": "法术牌组与炼金神器共同构筑，要求针对自己造出的挑战持续调整策略。",
      "dimension": "玩法",
      "excerpt": "Build a powerful spell deck, craft artifacts through alchemy, and adapt your strategy to overcome the challenge you yourself have forged.",
      "url": "https://store.steampowered.com/app/3205630/",
      "label": "证据原文片段"
    },
    {
      "text": "失败不会清零成长：带回的资源可锻造永久遗物，再次挑战高塔。",
      "dimension": "玩法",
      "excerpt": "Use the resources you’ve gathered from your failed attempts to forge relics of unimaginable power and challenge the tower once again.",
      "url": "https://store.steampowered.com/app/3205630/",
      "label": "证据原文片段"
    }
  ],
