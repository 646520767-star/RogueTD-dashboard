  "hooks": [
    {
      "text": "被困地下厨房后必须持续为墙中半厨师怪物配餐，在赌博式高分中换取逃生机会。",
      "dimension": "题材",
      "excerpt": "A horror roguelike bento-builder. You're trapped in an underground kitchen, forced to feed a half-chef monster. Gamble with your life, assemble meals, and master your multipliers.",
      "url": "https://store.steampowered.com/app/3930510/",
      "label": "证据原文片段"
    },
    {
      "text": "在不同形状与尺寸的便当格中压缩食材，用空间布局、组合和修正器抬高得分。",
      "dimension": "玩法",
      "excerpt": "Assemble your ingredients on a variety of bento shapes and sizes to maximize space and flavor. Master unique combos and modifiers to raise your score to ever increasing heights. Choose ingredients wisely and optimize your layout to fit as much as possible.",
      "url": "https://store.steampowered.com/app/3930510/",
      "label": "证据原文片段"
    },
    {
      "text": "十顶帽子与百余工具支撑大量流派，还要不断权衡追求连击时的风险与收益。",
      "dimension": "玩法",
      "excerpt": "With 10 unique hats and over 100 tools, there's limitless build possibilities to experiment wtih. Push your luck to the limit and weigh your risks and rewards.",
      "url": "https://store.steampowered.com/app/3930510/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "游戏平衡需要明显调整",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Needs some serious rebalancing imo.",
          "url": "https://steamcommunity.com/profiles/76561199166997681/recommended/3930510/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "游戏每十分钟左右冻结并丢失本轮进度",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "game keeps freezing every 10 minutes, and it doesn't save progress into the round when this happens.",
          "url": "https://steamcommunity.com/id/NawrasH/recommended/3930510/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "分数成长经常在严重不足和大幅溢出之间摆动",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "most runs you either horrible lack scaling for the score, or over shoot by a ton",
          "url": "https://steamcommunity.com/profiles/76561199730119165/recommended/3930510/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "高难度只是更烦人和更受限制，而非更具挑战",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "it doesnt get more dificult, just more anoying and more restricting.",
          "url": "https://steamcommunity.com/profiles/76561199730119165/recommended/3930510/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "玩法扎实、具有挑战且多样",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Solid, challenging, and varied gameplay.",
          "url": "https://youtu.be/fMx9pV1CCZs",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "便当拼装循环很容易令人上瘾",
