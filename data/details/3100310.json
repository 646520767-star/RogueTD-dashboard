  "hooks": [
    {
      "text": "五条机械圣臂同时挥舞远近武器清扫地狱尸潮",
      "dimension": "玩法",
      "excerpt": "Fire ranged and melee weapons simultaneously using up to 5 sacred 'arms' . As you face hordes of demons, you gain strength - sanctify your weapons and use mechanical arms to fulfill God's will upon the mortal realm and save it from the infernal conflagration.",
      "url": "https://store.steampowered.com/app/3100310/",
      "label": "证据原文片段"
    },
    {
      "text": "60种武器可升级合并成单件怪物级组合",
      "dimension": "玩法",
      "excerpt": "Choose from 60 unique weapons - both ranged and melee - and learn ruthless ways to upgrade and merge several of them into a single monstrosity, creating builds so powerful they erase demon hordes and towering bosses back into the abyss. Mix weapons with upgrades to forge even more surprising combinations and uncover hidden synergies.",
      "url": "https://store.steampowered.com/app/3100310/",
      "label": "证据原文片段"
    },
    {
      "text": "夺回大教堂后，把训练场、军械库、炼金室和钟楼建成局外枢纽",
      "dimension": "玩法",
      "excerpt": "Once liberated, this sacred bastion becomes your strategic hub for meta-progression . Hone your skills in the Training Ground to enhance your meta-stats, forge mighty weapons in the Armory , boost your in-game abilities in the Alchemy Chamber , and summon new valiant heroes from the Bell Tower .",
      "url": "https://store.steampowered.com/app/3100310/",
      "label": "证据原文片段"
    }
  ],
