  "hooks": [
    {
      "text": "主动封路截停怪物，让守卫获得更高效的集火窗口",
      "dimension": "玩法",
      "excerpt": "Player block road, monster stop. Stopped monster, defenders hit easy.",
      "url": "https://store.steampowered.com/app/603320/",
      "label": "证据原文片段"
    },
    {
      "text": "24种差异化守卫应对会耍花招的敌人与多变战场",
      "dimension": "玩法",
      "excerpt": "Defenders. 24 kinds. Different. Think long to choose. Enemy sneaky. Enemy use trick. Hard for defender to protect. Must win in different places. Must adapt.",
      "url": "https://store.steampowered.com/app/603320/",
      "label": "证据原文片段"
    },
    {
      "text": "海量怪物与强悍守卫共同构成荒诞搞笑的卡通防线",
      "dimension": "画风",
      "excerpt": "There are tons of monsters and tough defenders in the game each of which fits perfectly into a funny cartoonish setting.",
      "url": "https://store.steampowered.com/app/603320/",
      "label": "证据原文片段"
    }
  ],
