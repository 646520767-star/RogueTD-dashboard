  "hooks": [
    {
      "text": "在末日中结盟、招募并训练士兵，从单纯求生推进到重建社会。",
      "dimension": "玩法",
      "excerpt": "Build alliances, recruit and train soldiers, and restore society from the ashes of the apocalypse. With larger maps, human allies, and an evolving zombie threat, this installment pushes you to think beyond the battlefield.",
      "url": "https://store.steampowered.com/app/3015510/",
      "label": "证据原文片段"
    },
    {
      "text": "在丧尸城市中逐街区收复领地，搜寻资源并加固据点，在蛮力与规划之间权衡。",
      "dimension": "玩法",
      "excerpt": "Reclaim it block by block. Navigate treacherous streets crawling with zombies, uncover hidden resources, and fortify key locations. With every district you liberate, the stakes rise, forcing you to balance brute force and careful planning.",
      "url": "https://store.steampowered.com/app/3015510/",
      "label": "证据原文片段"
    },
    {
      "text": "中世纪篇把枪战换成剑术，加入攻城器械、城堡防御与黑暗奇幻怪物。",
      "dimension": "题材",
      "excerpt": "Defend a kingdom overrun by mythical monsters, storm enemy fortresses, and master medieval combat in a brutal, fantasy-driven twist on the series. With siege weapons, castle defense, and a rich dark-fantasy setting, this game offers a new take on the series.",
      "url": "https://store.steampowered.com/app/3015510/",
      "label": "证据原文片段"
    }
  ],
