  "hooks": [
    {
      "text": "四名巫师协作对抗成千怪物，共同完成随机团队目标并升级法术",
      "dimension": "玩法",
      "excerpt": "The Spell Brigade combines the Survivors-like gameplay you love with good old multiplayer madness. Fight thousands of weird monsters together. Complete random team-based objectives and upgrade spells together. Survive together!",
      "url": "https://store.steampowered.com/app/2904000/",
      "label": "证据原文片段"
    },
    {
      "text": "友军伤害会误杀队友，但死亡可配合复活核心把全队炸回战场",
      "dimension": "玩法",
      "excerpt": "FRIENDLY FIRE BULLET HEAVEN Taking on entire armies is risky business, even with your friends at your side! Fighting as a team has many perks, but you will inevitably step on each other’s toes. But fear not! You can use your deaths to your advantage, and use Revive Cores to (literally) blast yourself and your teammates back into action!",
      "url": "https://store.steampowered.com/app/2904000/",
      "label": "证据原文片段"
    },
    {
      "text": "用元素灌注、附魔、任务、卷轴和队伍人数叠加失控法术协同",
      "dimension": "玩法",
      "excerpt": "MASTER YOUR SPELLS Improve, augment and infuse your spells with different kinds of elements and upgrades. Combine this with your Enchantments, Quests, Scrolls, and the amount of wizards in your squad, and the potential for pure, unhinged chaos is endless!",
      "url": "https://store.steampowered.com/app/2904000/",
      "label": "证据原文片段"
    }
  ],
