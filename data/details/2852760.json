  "hooks": [
    {
      "text": "仅用鼠标操控推进器与抓钩，在复杂关卡中高速弹射穿行",
      "dimension": "玩法",
      "excerpt": "This Is No Cave is a minimalist, fast-paced 2d platformer playable with just your mouse (controller supported still). Propel and sling yourself through a multitude of intricate levels with your suit's thrusters and grapple hook, leveraging the strange alien fauna and flora.",
      "url": "https://store.steampowered.com/app/2852760/",
      "label": "证据原文片段"
    },
    {
      "text": "快速复活支持反复修正轨迹，以毫秒差冲击竞速榜",
      "dimension": "玩法",
      "excerpt": "Quick respawns ensure you're never far from the action, encouraging rapid iteration and mastery of your trajectory. Compete for supremacy on the leaderboard by shaving precious milliseconds off your best times.",
      "url": "https://store.steampowered.com/app/2852760/",
      "label": "证据原文片段"
    },
    {
      "text": "无尽模式持续躲避巨虫，每次自我强化也会同步强化追猎者",
      "dimension": "玩法",
      "excerpt": "Try to go as far as possible in a neverending chase with the worms in endless mode, picking up bonuses along the way. But be warned, each time you buff yourself the worm gets stronger too!",
      "url": "https://store.steampowered.com/app/2852760/",
      "label": "证据原文片段"
    }
  ],
