  "hooks": [
    {
      "text": "用企业招聘话术包装气候崩溃中的行星采矿与利润竞赛",
      "dimension": "题材",
      "excerpt": "At DrillCore, we're not just mining minerals; we're safeguarding the future. We're looking for strategic minds and resourceful leaders to manage our cutting-edge operations. Do you have what it takes to make every decision count in the race to profits & earnings against climate collapse?",
      "url": "https://store.steampowered.com/app/2821800/",
      "label": "证据原文片段"
    },
    {
      "text": "调度矿工、搬运工和守卫开采矿物并维持钻井平台供能",
      "dimension": "玩法",
      "excerpt": "As a Platform Manager at DrillCore, you'll oversee a dedicated team of miners, carriers, and guards. Your mission? Navigate them through perilous missions to extract vital minerals and power our drill platform. Every strategic decision will test your planning and resource management skills.",
      "url": "https://store.steampowered.com/app/2821800/",
      "label": "证据原文片段"
    },
    {
      "text": "夜间用防御炮塔抵挡本地生物，同时权衡利润、船员生命与生态多样性",
      "dimension": "玩法",
      "excerpt": "Nighttime is when the real excitement begins. This is when the planet's fauna usually clash directly with our company’s safety commitments. Your job? To maintain profits while safeguarding both the lives of your crew and the biodiversity of the planet you’re drilling. Sometimes tough choices need to be made, and that’s why DrillCore equips you with state-of-the-art defensive turrets .",
      "url": "https://store.steampowered.com/app/2821800/",
      "label": "证据原文片段"
    }
  ],
