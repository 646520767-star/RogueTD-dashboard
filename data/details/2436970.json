  "hooks": [
    {
      "text": "在扩张棋盘布置动植物与昆虫，让捕食和协同触发生态链反应",
      "dimension": "玩法",
      "excerpt": "The deckbuilder where cards are plants, animals, and insects that can synergize and prey on each other. Place your cards on an expanding board to trigger satisfying chain reactions and shape an interconnected ecosystem.",
      "url": "https://store.steampowered.com/app/2436970/",
      "label": "证据原文片段"
    },
    {
      "text": "组建支持者参加市长选举，抗议与Boss战会临时改写竞选规则",
      "dimension": "题材",
      "excerpt": "Lead your campaign, rally supporters, and outvote your rivals to become the Mayor of Wild City. As you progress through your electoral campaign, you will face Protests and Boss Fights that shake up the rules, forcing you to quickly adapt to new obstacles and debuffs.",
      "url": "https://store.steampowered.com/app/2436970/",
      "label": "证据原文片段"
    },
    {
      "text": "关键词系统让同一张卡承担多种用途，所有组件彼此连接后放大组合",
      "dimension": "玩法",
      "excerpt": "Thanks to a keyword-based system, a single card can be used in many different ways as each building block interconnects. As every piece of your build comes together, you will reach heights you did not think were possible!",
      "url": "https://store.steampowered.com/app/2436970/",
      "label": "证据原文片段"
    }
  ],
