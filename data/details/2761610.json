  "hooks": [
    {
      "text": "不绑目标地结婚、偷窃、耕作、钓鱼、锻造、炼药和造城",
      "dimension": "玩法",
      "excerpt": "Explore the world full of adventures, interact with its inhabitants, marry, steal, do farming and fishing, blacksmithing and forging, mix potions, build towns without being tied to any goal!",
      "url": "https://store.steampowered.com/app/2761610/",
      "label": "证据原文片段"
    },
    {
      "text": "每次新档都重生成世界、城镇、居民、冒险者与地牢",
      "dimension": "玩法",
      "excerpt": "More than that, the world map, all towns, inhabitants, adventurers, and dungeons are randomly generated for each new game, providing a fresh game experience each time.",
      "url": "https://store.steampowered.com/app/2761610/",
      "label": "证据原文片段"
    },
    {
      "text": "站位、视野、天气和昼夜随时改变战局",
      "dimension": "玩法",
      "excerpt": "During battles, the situation can change any moment depending on the characters' positions, visibility, weather, time of day, etc. Use different equipment, skills, and items with various characteristics to overcome difficult situations and defeat your enemies!",
      "url": "https://store.steampowered.com/app/2761610/",
      "label": "证据原文片段"
    }
