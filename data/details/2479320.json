  "hooks": [
    {
      "text": "40余项属性与角色专属特质共同塑造每轮割草构筑",
      "dimension": "玩法",
      "excerpt": "Create Overpowered Builds You are the bullet hell! Grow an arsenal of ridiculous weapons and craft your own unique build with a combination of 40+ stats. Additionally, each character has their own unique traits that keep runs fresh.",
      "url": "https://store.steampowered.com/app/2479320/",
      "label": "证据原文片段"
    },
    {
      "text": "种田、钓鱼和采矿同时产出金币与经验，扩建地块可强化三类生产",
      "dimension": "玩法",
      "excerpt": "Farm, Fish, and Mine Earn vital gold and experience from growing crops, catching fish, and mining. Expand your plot to harvest huge quantities of crops and build carefully to enhance your farming, fishing, and mining capabilities.",
      "url": "https://store.steampowered.com/app/2479320/",
      "label": "证据原文片段"
    },
    {
      "text": "招募宠物自动经营农场、捡取战利品并直接击杀敌人",
      "dimension": "玩法",
      "excerpt": "Automate Your Farm With Pets Recruit friendly pets that will enhance your farm, collect loot, and kill enemies.",
      "url": "https://store.steampowered.com/app/2479320/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "敌人视觉混成难辨的一团。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the enemies all blend into an insipid clump of nothingness",
          "url": "https://steamcommunity.com/id/magerama/recommended/2479320/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "相关活动重复且很快令人厌倦",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "it's all the same so it gets old fast.",
          "url": "https://steamcommunity.com/id/magerama/recommended/2479320/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "需要的内容经常不出现",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "缺啥啥不来",
          "url": "https://steamcommunity.com/profiles/76561198221249724/recommended/2479320/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "角色打法趋同，难度差异主要只是数值变化。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "虽然角色多，但是打法千篇一律，难度区别也只是怪物血量伤害的区别",
          "url": "https://steamcommunity.com/profiles/76561198099030486/recommended/2479320/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "角色数量多但多数仅由属性差异构成。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "角色虽然多但是都是硬凑属性出的",
          "url": "https://steamcommunity.com/id/1923078701/recommended/2479320/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "经营系统把原本简单的运营步骤复杂化",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "只是把其他游戏里简单的运营步骤复杂化了",
          "url": "https://steamcommunity.com/profiles/76561198099030486/recommended/2479320/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "大多数升级附带负面效果，削弱爽感。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "升级有负面 不够爽",
          "url": "https://steamcommunity.com/profiles/76561198221249724/recommended/2479320/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "武器效果和伤害数字不够明显。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Most of the weapon effects and projectiles are barely noticeable, so are the damage numbers.",
          "url": "https://steamcommunity.com/id/magerama/recommended/2479320/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "清理虫群缺乏冲击与满足感。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Mowing the hordes doesn't feel satisfying",
          "url": "https://steamcommunity.com/id/magerama/recommended/2479320/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "整体休闲且具有良性成瘾感。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "it feels really casual and addictive in a good way.",
          "url": "https://steamcommunity.com/profiles/76561199218109155/recommended/2479320/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
