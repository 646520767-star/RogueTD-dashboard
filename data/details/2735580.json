  "hooks": [
    {
      "text": "通过格挡、闪避与幽冥冲刺规避攻击，再把握时机致命反击",
      "dimension": "玩法",
      "excerpt": "Parry, dodge, and execute Ethereal Dash to evade attacks, then counter with lethal strikes. Every decision—timing, resource allocation, and positioning—deepens the strategic depth of encounters.",
      "url": "https://store.steampowered.com/app/2735580/",
      "label": "证据原文片段"
    },
    {
      "text": "与剑士、游侠、守卫和盗贼四名亡魂契约，穿障、伏击或移维避死",
      "dimension": "玩法",
      "excerpt": "The Soul Companion system offers diverse combat strategies, featuring four distinct spectral allies: Swordsman, Ranger, Guardian, and Rogue. Harness their abilities to phase through obstacles, ambush foes from the netherworld, or evade fatal blows by shifting dimensions.",
      "url": "https://store.steampowered.com/app/2735580/",
      "label": "证据原文片段"
    },
    {
      "text": "手持连接人间与冥界的禁忌冥灯，与战死同伴灵魂缔结契约",
      "dimension": "题材",
      "excerpt": "Control the survivor of a catastrophic disaster, wielding the Nether Lantern—a forbidden artifact bridging the mortal realm and the netherworld—to forge pacts with the souls of deceased allies.",
      "url": "https://store.steampowered.com/app/2735580/",
      "label": "证据原文片段"
    }
  ],
