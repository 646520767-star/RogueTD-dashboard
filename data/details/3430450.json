  "hooks": [
    {
      "text": "白天经营墓园生意，夜晚架设防线亲自抵挡僵尸潮",
      "dimension": "玩法",
      "excerpt": "Manage your Graveyard by day as you bury and cremate bodies, maintain graves, fulfill visitor requests, grow crops, run a shop and unlock upgrades. When night falls, face relentless zombie hordes as you build defenses to protect your work and fight to survive in Zombie Graveyard Simulator!",
      "url": "https://store.steampowered.com/app/3430450/",
      "label": "证据原文片段"
    },
    {
      "text": "维护墓碑、鲜花与礼拜环境，用访客满意度推动墓园收益",
      "dimension": "玩法",
      "excerpt": "After processing the bodies, visitors will return to check on their loved ones. Your duty is to keep graves intact while providing fresh flowers and maintaining a welcoming environment. Every visit rewards you with valuable bonuses to help your business thrive.",
      "url": "https://store.steampowered.com/app/3430450/",
      "label": "证据原文片段"
    },
    {
      "text": "从铁丝网升级到火焰喷射塔，在血月等特殊夜晚守住墓园",
      "dimension": "玩法",
      "excerpt": "Some nights may be even more dangerous with special events like the Blood Moon. From basic defenses like barbed wires and fences to advanced machines like flamethrower turrets, keep your defenses upgraded, repaired, and fully stocked with ammo to withstand the night.",
      "url": "https://store.steampowered.com/app/3430450/",
      "label": "证据原文片段"
    }
  ],
