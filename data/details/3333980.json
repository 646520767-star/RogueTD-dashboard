  "hooks": [
    {
      "text": "击杀遗骸会化为Bones，清场越快收获越多，并可在Astrarium换取杀戮武器",
      "dimension": "玩法",
      "excerpt": "In the Void, blood is cheap, but Bones are the only currency that matters. Violence rewards you with the remains of the fallen, and the faster your clearence, the richer the harvest. Return your spoils to the Astrarium to trade with the Smith , the Huntress, and the Twins to unlock the sacred instruments of slaughter.",
      "url": "https://store.steampowered.com/app/3333980/",
      "label": "证据原文片段"
    },
    {
      "text": "宽范围劈砍、前冲撞击和钩向猎物组成持续前压的近身连杀机动",
      "dimension": "玩法",
      "excerpt": "Carve through packed enemies in wide, bloody sweeps, crush anything in your path with brutal forward charges. Hook into prey and drag yourself straight into the kill before the first body hits the floor.",
      "url": "https://store.steampowered.com/app/3333980/",
      "label": "证据原文片段"
    },
    {
      "text": "敌我多为一击毙命，快速叠杀会把速度凝成可抵消下一次致命伤的momentum",
      "dimension": "玩法",
      "excerpt": "You die in one hit. Most things you fight do too . The difference is who reaches the killing blow first. Stack kills quickly enough and your speed condenses into momentum, a sliver of grace that eats the next fatal blow for you. Lose it, and you are back to the same fragile thing the enemies are.",
      "url": "https://store.steampowered.com/app/3333980/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "配乐极具冲击力，让玩家边玩边甩头。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The soundtrack absolutely shreds. I found myself headbanging while playing",
          "url": "https://steamcommunity.com/id/natqn/recommended/3333980/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "浓烈色彩有时会让玩家迷失目标。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Sometimes you get lost in all the colors",
          "url": "https://steamcommunity.com/id/dx0ne/recommended/3333980/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "获得超高速能力后，游戏体验开始显出亮点",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "It starts to shine once you start getting ultra speed.",
          "url": "https://steamcommunity.com/id/dx0ne/recommended/3333980/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "近战系统精炼到能带来极强的力量感。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "its the melee combat of hotline refined to the point I feel like a god made of blades and blood its awesome",
          "url": "https://steamcommunity.com/id/Sonki-boy/recommended/3333980/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "追求最高奖牌和排行榜名次具有成瘾性并增加重玩价值。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the race to grab all the highest medals and earn a spot on the leaderboards is addictive and adds replayability.",
          "url": "https://steamcommunity.com/profiles/76561198275157347/recommended/3333980/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "挑战性与回报感兼具，每关完成都有成就感。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The gameplay is both challenging and rewarding. Each time you finish a level a sense of accomplishment washes over you.",
          "url": "https://steamcommunity.com/id/AceAurora/recommended/3333980/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "即时重生让反复挑战保持流畅。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "respawning is instantaneous so you can just go and go and go.",
          "url": "https://steamcommunity.com/id/natqn/recommended/3333980/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "玩家投入度高，一直玩到通关",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "I couldn't stop playing it until I rolled credits",
          "url": "https://steamcommunity.com/profiles/76561198275157347/recommended/3333980/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "宇宙观与背景故事不易理解。",
      "dimension": "剧情",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "there's a whole cosmology and lore to the story that went right over my head",
          "url": "https://steamcommunity.com/id/natqn/recommended/3333980/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "Hotline Miami与重金属柯南式组合带来强烈爽感。",
      "dimension": "主题",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "its like hotline miami and a heavy metal conan had a baby! 11/10 on the dopamine scale.",
          "url": "https://steamcommunity.com/profiles/76561198723613881/recommended/3333980/",
          "label": "证据原文片段"
        }
      ]
    }
