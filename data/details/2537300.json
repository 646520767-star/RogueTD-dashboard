  "hooks": [
    {
      "text": "无魔低武江湖强调生存与选择代价",
      "dimension": "题材",
      "excerpt": "这是一个“无魔低武”的武侠世界，你无法像修仙那样结金丹修成神佛，也无法像绝世高手那样信手移山填海，你所能做的，就是先幸存下来，一点点探究这个世界真实的规则，最后再决定，是否要当一个大侠。但记住，人被杀就会死，任何选择都有代价。",
      "url": "https://store.steampowered.com/app/2537300/",
      "label": "证据原文片段"
    },
    {
      "text": "六类兵器二百五十八招预排套路应敌",
      "dimension": "玩法",
      "excerpt": "你需要从你的武技库里选择最适合当前战斗的技能，组合成套路，用于应敌。刀剑枪锤棍叉6类兵器，258种不同招式，搭配独特的装备和天赋，见招拆招还是以不变应万变，发挥你的聪明才智，让我们拭目以待！",
      "url": "https://store.steampowered.com/app/2537300/",
      "label": "证据原文片段"
    },
    {
      "text": "轮回模式重开积累实力并改变敌人与选择",
      "dimension": "玩法",
      "excerpt": "如果你选择轮回模式，你将会体验到全部游戏内容，从一次次的轮回中重新开始，积累实力，强化自身，做出不同的选择，面对不同的敌人，每一次开始都是全新的！",
      "url": "https://store.steampowered.com/app/2537300/",
      "label": "证据原文片段"
    }
  ],
