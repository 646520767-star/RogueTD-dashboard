  "hooks": [
    {
      "text": "困在2018年的北欧福利公寓，在长期失业与社会隔绝循环中求生",
      "dimension": "题材",
      "excerpt": "The year is 2018, you are trapped in a single-bedroom apartment somewhere in an undisclosed Nordic welfare state. Your objective is to survive in the mind-numbing loop of long-term unemployment and social isolation.",
      "url": "https://store.steampowered.com/app/3252360/",
      "label": "证据原文片段"
    },
    {
      "text": "同时管理身体需求与心理健康，并维持多巴胺避免“无聊致死”",
      "dimension": "玩法",
      "excerpt": "You have stats to manage: the physiological needs of the body, and your mental health. Maintain high dopamine levels to avoid a literal death by boredom.",
      "url": "https://store.steampowered.com/app/3252360/",
      "label": "证据原文片段"
    },
    {
      "text": "睡眠成为现实逃生口，梦中可化身上班族、丈夫或英雄，直到闹钟再次响起",
      "dimension": "故事",
      "excerpt": "You’ll find an escape in your dreams. It’s when you sleep that you are most alive. In fact, you can be anything in your dreams. A salaryman. A husband. A hero! Until the alarm goes off again.",
      "url": "https://store.steampowered.com/app/3252360/",
      "label": "证据原文片段"
    }
  ],
