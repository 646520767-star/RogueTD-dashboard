  "hooks": [
    {
      "text": "建筑不仅挡怪，还承担控场、续航与伤害职责；资源有限，地图布局本身就是武器。",
      "dimension": "玩法",
      "excerpt": "Structures aren’t just defenses - they're tactical tools for crowd control, sustain, and damage that can turn the tide of battle. But remember - your resources are limited. Build smart, and you’ll live longer.",
      "url": "https://store.steampowered.com/app/2922410/",
      "label": "证据原文片段"
    },
    {
      "text": "解锁15名以上希腊传奇幸存者，每位英雄都拥有独立的招牌能力和战斗风格。",
      "dimension": "玩法",
      "excerpt": "Unlock over 15 legendary survivors. Play as Achilles or one of a growing cast of mythical heroes, each with unique power and playstyle.",
      "url": "https://store.steampowered.com/app/2922410/",
      "label": "证据原文片段"
    },
    {
      "text": "完成挑战获取恩惠并购买永久升级，即使本轮失败也会增强下一次尝试。",
      "dimension": "玩法",
      "excerpt": "Complete challenges, earn Favors, and unlock permanent upgrades - get stronger with every attempt, even in defeat.",
      "url": "https://store.steampowered.com/app/2922410/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "写实3D画面是玩家明显偏爱的部分。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "realistic 3D graphics - my real favour",
          "url": "https://steamcommunity.com/profiles/76561198415412604/recommended/2922410/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "建筑玩法没有带来足够满足感。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the building aspect is different but it didn't really feel all that satisfying",
          "url": "https://steamcommunity.com/profiles/76561199402266401/recommended/2922410/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "后期地图建筑位置受限。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "limited construction sites especially in later maps",
          "url": "https://steamcommunity.com/profiles/76561198415412604/recommended/2922410/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "多数角色缺少自动瞄准，增加不必要操作负担。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The lack of auto target for like 80% of the playable characters in this game really hurts it",
          "url": "https://steamcommunity.com/id/parmvt/recommended/2922410/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "主角移动感迟缓笨重。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the MC just felt sluggish and clunky",
          "url": "https://steamcommunity.com/profiles/76561199402266401/recommended/2922410/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "职业差异主要只是额外数值。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the classes are nothing more than extended bonus stats",
          "url": "https://steamcommunity.com/profiles/76561198415412604/recommended/2922410/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "希腊神话引用提升了参与感。",
      "dimension": "主题",
