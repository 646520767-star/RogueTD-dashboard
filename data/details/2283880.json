  "hooks": [
    {
      "text": "同时操控持剑机器人与持枪太空青蛙，把近战和远程角色合为一个操作组合。",
      "dimension": "玩法",
      "excerpt": "Simultaneously control a sword-wielding robot and a gunslinging space frog in Shoulders of Giants, an explosively colourful sci-fi roguelike designed to put your teamwork to the test.",
      "url": "https://store.steampowered.com/app/2283880/",
      "label": "证据原文片段"
    },
    {
      "text": "既可单人操控双角色，也可双人分工控制青蛙和机器人，并扩展到四人在线合作。",
      "dimension": "玩法",
      "excerpt": "Play solo, or team up with a friend, each taking control of either the frog or the robot. Battle the forces of entropy in four-player online co-op. Is your teamwork strong enough to survive?",
      "url": "https://store.steampowered.com/app/2283880/",
      "label": "证据原文片段"
    },
    {
      "text": "从抓钩到发光手雷的拾取物会显著改变能力，再通过混搭组成自定义动作套装。",
      "dimension": "玩法",
      "excerpt": "From grappling hooks to glowing grenades, each new pickup can radically alter your power and playstyle. Mix and match abilities to create a moveset that’s all your own!",
      "url": "https://store.steampowered.com/app/2283880/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "环境设计会显得重复。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The environments can feel a bit repetitive",
          "url": "https://steamcommunity.com/id/UnitedCritics-Mich/recommended/2283880/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "整体呈现具有活力",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Vibrant",
          "url": "https://steamcommunity.com/id/UnitedCritics-Mich/recommended/2283880/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "视觉呈现更护眼、容易观看",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "It's also much easier on the eyes",
          "url": "https://steamcommunity.com/profiles/76561197984510327/recommended/2283880/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "重复跑图问题明显。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "repetitive runs.",
          "url": "https://nichegamer.com/reviews/shoulders-of-giants-ultimate-review/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "局内缺少成长性。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "局内没有任何成长性",
          "url": "https://steamcommunity.com/id/492047626/recommended/2283880/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "近距离射击有命中但不结算伤害的Bug。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "there's a bug when shooting too close an enemy where the bullet hits but the damage doesn't register.",
          "url": "https://steamcommunity.com/id/dudetalisker/recommended/2283880/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "高难度成长只是同步增加敌人生命与枪械伤害，缺少实质变化。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "As the HEAT level increases, the mobs' HP and your gun damage simply increase. Nothing else changes.",
          "url": "https://steamcommunity.com/profiles/76561198052266479/recommended/2283880/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "故事流程仅约三点五小时，内容量不足。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The game lasts 3.5 hours. That's the entire storyline.",
          "url": "https://steamcommunity.com/profiles/76561198052266479/recommended/2283880/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "视角镜头缺乏打磨。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "视角镜头欠打磨",
          "url": "https://steamcommunity.com/id/CoZBC619/recommended/2283880/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "风险回报机制提供了合适挑战和奖励。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The risk/reward factor for saving a planet (completing a run) adds a nice challenge and indeed rewards you well",
          "url": "https://steamcommunity.com/profiles/76561197984510327/recommended/2283880/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
