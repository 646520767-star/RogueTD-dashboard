  "hooks": [
    {
      "text": "怪物、道具乃至草叶都先以真实黏土雕刻，再扫描进游戏，累计超过300件实体雕塑",
      "dimension": "画风",
      "excerpt": "Every monster, every item, every blade of grass is completely hand sculpted and scanned into the game! We’ve made over 300 sculptures to help bring the unique world of Sculplings to life, with plenty more on the way!",
      "url": "https://store.steampowered.com/app/3062680/",
      "label": "证据原文片段"
    },
    {
      "text": "每局重排路线、怪物与区域，玩家必须选路争取抵达冠军竞技场",
      "dimension": "玩法",
      "excerpt": "Each run of Sculplings features a new set of randomized paths. Players must strategically choose which path to go down to have the best chance of reaching the Champion’s Arena. In addition, each run features random monsters and a variety of zones players can enter, each with its own set of unique Sculplings to capture!",
      "url": "https://store.steampowered.com/app/3062680/",
      "label": "证据原文片段"
    },
    {
      "text": "一百余只手工怪物各自对应独立策略与打法，队伍选择决定能否走到终点",
      "dimension": "玩法",
      "excerpt": "Sculplings features over 100 unique, hand-sculpted monsters to discover and collect, each with their own strategies and playstyles. The trick is to discover which collection of Sculplings will give you the best chances of reaching the end!",
      "url": "https://store.steampowered.com/app/3062680/",
      "label": "证据原文片段"
    }
  ],
