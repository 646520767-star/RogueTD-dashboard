  "hooks": [
    {
      "text": "屏幕单词既是攻击指令，也用于破防和闪避；输入速度与准确度直接提高伤害。",
      "dimension": "玩法",
      "excerpt": "Type the words displayed on the screen to attack, break through defenses, or dodge enemy strikes. The faster and more precise you are, the more damage you inflict.",
      "url": "https://store.steampowered.com/app/4252830/",
      "label": "证据原文片段"
    },
    {
      "text": "以掷骰逐格推进的桌游式 Roguelite，在活体哥特手抄本世界中遭遇商店、事件和战术选择。",
      "dimension": "玩法",
      "excerpt": "Advance through a typing game inspired by board games and roguelites , square by square, rolling dice each turn. Encounter monsters, chests, shops, events, and tactical choices in a world drawn like a living Gothic manuscript.",
      "url": "https://store.steampowered.com/app/4252830/",
      "label": "证据原文片段"
    },
    {
      "text": "胜利、宝箱和事件都会授予卡牌，卡牌可带来永久加成、诅咒、独特效果或英雄能力并组成构筑。",
      "dimension": "玩法",
      "excerpt": "Every victory, every chest, and every event grants you a card: permanent bonuses, curses, unique effects, or heroic abilities. Combine them to create devastating or utterly chaotic builds.",
      "url": "https://store.steampowered.com/app/4252830/",
      "label": "证据原文片段"
    }
  ],
