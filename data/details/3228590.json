  "hooks": [
    {
      "text": "三人小队可标记集火目标、同步手雷轰炸并共同强攻被占领的飞船",
      "dimension": "玩法",
      "excerpt": "Adventure on your own, or conquer the ship in a co-op squad of up to 3 players. Mark enemies for focused fire, synchronize grenade strikes, and storm enemies with overwhelming force.",
      "url": "https://store.steampowered.com/app/3228590/",
      "label": "证据原文片段"
    },
    {
      "text": "三十多种枪械可附加元素与升级，把霰弹枪改成虚空扩散或让冲锋枪倾泻冰雹",
      "dimension": "玩法",
      "excerpt": "Master over 30 powerful weapons, each modifiable with elemental affixes and upgrades. Turn a shotgun into a void-spreading crowd crusher, or a submachine gun into a room clearing hail of ice.",
      "url": "https://store.steampowered.com/app/3228590/",
      "label": "证据原文片段"
    },
    {
      "text": "数十种强化可把打法改造成远射、潜行或强化近战，并继续叠加永久升级",
      "dimension": "玩法",
      "excerpt": "Transform your combat approach through dozens of augments, perks, and items. Dominate from afar, strike from the shadows with stealth, or get close with enhanced melee. Your choices offer a unique experience against the mechanical onslaught. Use permanent upgrades to reshape yourself into a killing machine. Boost your shields, amplify elemental chaos, and tear bots apart with satisfying fury. Forge a path that matches your playstyle.",
      "url": "https://store.steampowered.com/app/3228590/",
      "label": "证据原文片段"
    }
  ],
