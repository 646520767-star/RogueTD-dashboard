  "hooks": [
    {
      "text": "八名赏金猎人各带专属武器、绝招与截然不同的战斗套路",
      "dimension": "玩法",
      "excerpt": "Eight playable hunters, Eight deadly playstyle. From Kyle’s trickshot gunplay, Diddo’s chaotic worm swarms, Rudy’s Plasma Burst, Dhala’s spirit spear, Xane’s lightning-fast claw attacks, Gorogozo’s brutal Mega Slash, Kingka’s minigun mayhem, to Jaz’s rhythm-powered rocket launcher — every hunter brings unique weapons, Specials, and combat styles to the hunt.",
      "url": "https://store.steampowered.com/app/3097510/",
      "label": "证据原文片段"
    },
    {
      "text": "套索不仅跨越地形，还能操纵环境并重创失衡敌人",
      "dimension": "玩法",
      "excerpt": "Signature Lasso Mechanics: Grapple across gaps, manipulate the environment, and deal massive damage to staggered enemies.",
      "url": "https://store.steampowered.com/app/3097510/",
      "label": "证据原文片段"
    },
    {
      "text": "Boss倒下后合作立刻终止，队友互斗只争一顶蠢王冠",
      "dimension": "玩法",
      "excerpt": "Final Showdown: Boss goes down, friendships go out the window. One winner. No bonus loot. Just a stupid crown and the eternal right to call everyone else the clown. Because you're the crowned clown now.",
      "url": "https://store.steampowered.com/app/3097510/",
      "label": "证据原文片段"
    }
  ],
