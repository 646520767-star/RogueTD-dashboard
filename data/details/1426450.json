  "hooks": [
    {
      "text": "自研SwarmTech可让屏幕同时呈现超过7万名敌方单位的梦魇浪潮",
      "dimension": "玩法",
      "excerpt": "Leveraging an internally developed technology called ‘SwarmTech’ allows the game to render over 70,000 enemy units on the screen at one time.",
      "url": "https://store.steampowered.com/app/1426450/",
      "label": "证据原文片段"
    },
    {
      "text": "用光照夺回程序生成领土，对抗会藏匿敌人并持续吸取部队生命的活体死亡雾",
      "dimension": "玩法",
      "excerpt": "Light up a rich, complex, procedurally generated map to claim territory back from ‘The Veil’. A dynamic living death fog that conceals enemies and drains life from your troops.",
      "url": "https://store.steampowered.com/app/1426450/",
      "label": "证据原文片段"
    },
    {
      "text": "每次死亡之夜随机施加恶咒；成功守住后再从三个祝福中选择反击力量",
      "dimension": "玩法",
      "excerpt": "Borrowing from the the roguelite genre, Malices are random afflictions placed on the player during every Death Night, unraveling the best made plans. Conversely, if a Death Night is survived, you may decide between three randomly selected Blessings, enriching the experience and giving your army a much needed edge.",
      "url": "https://store.steampowered.com/app/1426450/",
      "label": "证据原文片段"
    }
  ],
