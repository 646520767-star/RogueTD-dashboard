  "hooks": [
    {
      "text": "加入太空监狱帮派，通过争斗晋升并把藏身处扩展成越狱资源",
      "dimension": "玩法",
      "excerpt": "Rise up the ranks of a prison gang, with unique alien members who have their own stories and fighting styles. Unlock a gang hideout that will expand your tools and means of escape. Climb up the ranks by fighting your way up the hierarchy to become the new boss.",
      "url": "https://store.steampowered.com/app/1865930/",
      "label": "证据原文片段"
    },
    {
      "text": "拆监狱设施搜集废料，制作违禁工具武器并藏过安检",
      "dimension": "玩法",
      "excerpt": "Scavenge for scrap, destroy prison property, upgrade your cell - craft illegal tools, weapons and materials to equip you and your squad. Keep contraband concealed to not get caught at security checkpoints.",
      "url": "https://store.steampowered.com/app/1865930/",
      "label": "证据原文片段"
    },
    {
      "text": "死亡后把意识转移到新的外星身体，但牢房与暗藏违禁品继续保留",
      "dimension": "玩法",
      "excerpt": "Should you be taken out, the rogue-lite recovery system will bring you back. However, your mind must be transferred into a new body, perhaps more alien than before. At least your cell is the same, all your hidden contraband exactly where you left it.",
      "url": "https://store.steampowered.com/app/1865930/",
      "label": "证据原文片段"
    }
  ],
