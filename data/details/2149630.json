  "hooks": [
    {
      "text": "每次失败都会积累力量，直到最终从火星逃回地球",
      "dimension": "玩法",
      "excerpt": "Grow stronger every time you fail until you are able to escape back to Earth.",
      "url": "https://store.steampowered.com/app/2149630/",
      "label": "证据原文片段"
    },
    {
      "text": "密集PvE敌群与Boss战之间穿插小游戏，持续切换节奏",
      "dimension": "玩法",
      "excerpt": "You can expect many intense PvE battles with feudalistic Martian mobs and bosses with many minigames sprinkled in-between.",
      "url": "https://store.steampowered.com/app/2149630/",
      "label": "证据原文片段"
    },
    {
      "text": "亿万富豪把火星改造成封建王国，主角坠入中世纪伦敦式殖民地",
      "dimension": "题材",
      "excerpt": "This Mars has been terraformed and colonized by a trillionaire antagonist with a vision to restart feudalism on a new planet to be a true king. When Trait and Stoney land they find themselves in what seems to be a medieval version of London.",
      "url": "https://store.steampowered.com/app/2149630/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "配乐充满高质量曲目。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Soundtrack packed with bangers",
          "url": "https://steamcommunity.com/profiles/76561198073146527/recommended/2149630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "音乐表现极具冲击力。",
      "dimension": "音频",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the music in this game goes hard!",
          "url": "https://steamcommunity.com/profiles/76561199155432367/recommended/2149630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "冲刺机制像半成品，在Boss战外常常弊大于利。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the dash mechanic in the level is weird, it feels sort of half baked and seems to cause more harm than good outside of boss fights",
          "url": "https://steamcommunity.com/profiles/76561198989933435/recommended/2149630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "多数小游戏难度令人感觉无法完成。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "most of the mini-games so far seem unbeatable",
          "url": "https://steamcommunity.com/profiles/76561198989933435/recommended/2149630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "首个30分钟目标过长并加重挫败感",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "30 minutes being the first goal is a lot and is definitely adding to my frustration",
          "url": "https://steamcommunity.com/profiles/76561198989933435/recommended/2149630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "声波攻击相较其他武器过强。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the sound wave attack is a hella overpowered compared to all the other weapons",
          "url": "https://steamcommunity.com/profiles/76561198989933435/recommended/2149630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "Boss战表现出色。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Epic boss battles",
          "url": "https://steamcommunity.com/profiles/76561198073146527/recommended/2149630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "核心肉鸽循环扎实且具有重玩价值。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Awesome core gameplay loop with roguelite replayability",
          "url": "https://steamcommunity.com/profiles/76561198073146527/recommended/2149630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "Boss战带来极强满足感",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "one of the most satisfying boss fights I’ve ever played",
          "url": "https://steamcommunity.com/profiles/76561198073146527/recommended/2149630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "小游戏、支线和Boss战让内容类型非常丰富。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the mini-games, side quests, and boss fights make this feel like 25 games in one.",
          "url": "https://steamcommunity.com/profiles/76561198073146527/recommended/2149630/",
          "label": "证据原文片段"
        }
      ]
    }
