  "hooks": [
    {
      "text": "把球形伙伴Nubby投入钉板，通过Plinko弹跳不断制造更大的数字",
      "dimension": "玩法",
      "excerpt": "In this plinko-style roguelike, you'll launch your spherical friend, Nubby, down a pegboard to rack up increasingly large numbers.",
      "url": "https://store.steampowered.com/app/3191030/",
      "label": "证据原文片段"
    },
    {
      "text": "必须完成持续上涨的生产配额，一次失误甚至会让太阳立即爆炸",
      "dimension": "玩法",
      "excerpt": "To make stakes even higher, your work at the number factory is directly responsible for keeping the fabric of space and time intact. One screw up could cause the sun to immediately explode.",
      "url": "https://store.steampowered.com/app/3191030/",
      "label": "证据原文片段"
    },
    {
      "text": "五十多件魔法物品可互相协同，为不断膨胀的配额设计不同解法",
      "dimension": "玩法",
      "excerpt": "Luckily, you can increase your output of numbers by harnessing the magical powers of over 50 unique items. You can use these items to create diverse and creative solutions to surpass your ever-expanding quotas.",
      "url": "https://store.steampowered.com/app/3191030/",
      "label": "证据原文片段"
    }
  ],
