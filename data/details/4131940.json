  "hooks": [
    {
      "text": "每轮仅有10步，以连续吃子维持连击并累乘分数",
      "dimension": "玩法",
      "excerpt": "You only have 10 moves. Every capture counts for scoring. Build huge combo chains, multiply your score, and push your run as far as possible.",
      "url": "https://store.steampowered.com/app/4131940/",
      "label": "证据原文片段"
    },
    {
      "text": "构筑可围绕连击延长、棋子专精、走法改变与区域计分展开",
      "dimension": "玩法",
      "excerpt": "Create runs focused on: combo extensions piece specialization movement changing upgrades zone based scoring boosts more enemy pieces more moves end combo effects",
      "url": "https://store.steampowered.com/app/4131940/",
      "label": "证据原文片段"
    },
    {
      "text": "Boss会直接改写棋子冷却、可移动棋种或出子顺序",
      "dimension": "玩法",
      "excerpt": "Boss encounters introduce mechanics that disrupt your strategy and force you to adapt on the fly. Every few stages, the game changes.",
      "url": "https://store.steampowered.com/app/4131940/",
      "label": "证据原文片段"
    }
  ],
