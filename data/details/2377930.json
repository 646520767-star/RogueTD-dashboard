          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "功法和术法效果整体不平衡。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "功法、术法效果虽然多，但总体并不平衡。",
          "url": "https://steamcommunity.com/profiles/76561198407187445/recommended/2377930/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "沙盒自由度过低，多数时候只能跟随剧本推进。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "目前沙盒自由度太低，大多数时候仍然只能跟着剧本走",
          "url": "https://steamcommunity.com/id/gamegame123/recommended/2377930/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "EA阶段只有一条主线可完整通关，多分支尚未兑现。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "EA依然只有一条主线能够完整通关。所谓多分支，目前更多停留在噱头层面",
          "url": "https://steamcommunity.com/id/gamegame123/recommended/2377930/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "地图可探索内容极少。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "地图可供探索的内容非常、非常、非常、非常少。",
          "url": "https://steamcommunity.com/profiles/76561198407187445/recommended/2377930/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "真正值得围绕构筑的技能比例过低。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "真正好用、值得围绕构筑的核心技能，我看连5%都不到",
          "url": "https://steamcommunity.com/id/gamegame123/recommended/2377930/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "筑基后的炼丹循环枯燥无味。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "到了筑基以后……嗯，毫无规律可循，就是单纯的数值大龙虾，枯燥无味地买丹方，往里放草药然后量产",
          "url": "https://steamcommunity.com/profiles/76561198407187445/recommended/2377930/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "核心造化法宝在筑基期就能加完全部效果，后续缺少可选成长内容。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "游戏核心的造化法宝，在筑基期就已经能把所有的加点都加完了",
          "url": "https://steamcommunity.com/profiles/76561198407187445/recommended/2377930/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "核心操作退化为反复点击推进，缺少策略。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "你需要的操作就是不断地点鼠标推剧情，然后就偷对手地技能，物品，说白了不如直接用鼠标连点器，策略性为零",
          "url": "https://steamcommunity.com/profiles/76561198929195202/recommended/2377930/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
