  "hooks": [
    {
      "text": "巨型机械同时是交通工具、家园和移动堡垒，整座基地会随探索不断前进。",
      "dimension": "玩法",
      "excerpt": "Navigate the ever-changing world aboard the colossal Machine that doubles as your fortress, homestead, and transport.",
      "url": "https://store.steampowered.com/app/1601330/",
      "label": "证据原文片段"
    },
    {
      "text": "结合跑酷、滑翔翼和滑索穿越复杂地形，抵达常规路线够不到的隐藏区域。",
      "dimension": "玩法",
      "excerpt": "Look around and plan your steps to find the way through the parkour challenges and use personal transport options like gliders and ziplines to explore even the most daunting terrains and hard-to-reach places.",
      "url": "https://store.steampowered.com/app/1601330/",
      "label": "证据原文片段"
    },
    {
      "text": "夜幕降临后尸潮围攻移动基地，玩家要用近战、远程、大炮和弩炮守住机械。",
      "dimension": "玩法",
      "excerpt": "When the night comes, be prepared for the hordes of zombies trying to assault your Machine and take you by surprise. Prepare your Machine for a fight and fortify your base, before another wave strikes you. It’s time to find out how well-prepared you are to approach another attack! Use your arsenal of choice, from melee to ranged, and deploy special artillery like cannons and ballistae to secure your surroundings.",
      "url": "https://store.steampowered.com/app/1601330/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "低多边形环境具有魅力",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Low Poly graphics with charming environments.",
          "url": "https://www.youtube.com/watch?v=8ORf9HE_5VM&t=377s",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "机器内部与载具上的机械动画很讨喜",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "I love the mechanical animations in the engine room and even around the craft.",
          "url": "https://steamcommunity.com/id/Shit-just-hit-the-fan/recommended/1601330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "移动基地细节丰富",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Big ass machine, it's pretty cool, very detailed.",
          "url": "https://steamcommunity.com/id/Shit-just-hit-the-fan/recommended/1601330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "性能差到妨碍完成推进所需的跳跃谜题",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "It ran so poorly that I could not complete the jumping puzzles required to get the items and blueprints needed to progress the game.",
          "url": "https://steamcommunity.com/id/CommanderA/recommended/1601330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "移动基地限制玩家活动范围",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "You don’t drive the machine or do anything significant with it; instead, it limits your movement.",
          "url": "https://steamcommunity.com/profiles/76561198161311730/recommended/1601330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "核心循环很快变得乏味",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The core gameplay loop gets stale fast",
          "url": "https://steamcommunity.com/profiles/76561198161311730/recommended/1601330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "建造系统过于基础且缺乏深度",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The building in this game is super basic and really simplistic and just completely lacks depth.",
          "url": "https://steamcommunity.com/profiles/76561199560690445/recommended/1601330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "僵尸波次需要长时间等待，过程很无聊",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The \"waves\" of zombies if you can even call it that are so boring, the zombies spawn miles away so you are just sat waiting for them to approach for ages",
          "url": "https://steamcommunity.com/profiles/76561199560690445/recommended/1601330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "与家人合作游玩很欢乐",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "I played this game with my father and we had a blast.",
          "url": "https://steamcommunity.com/id/Shit-just-hit-the-fan/recommended/1601330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "前几个小时很有趣",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the first few hours are fun",
          "url": "https://steamcommunity.com/profiles/76561198161311730/recommended/1601330/",
          "label": "证据原文片段"
        }
      ]
    }
