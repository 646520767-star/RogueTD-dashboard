  "hooks": [
    {
      "text": "扫雷棋盘会程序化生成并不断变大变危险，独特修正持续改变传统规则。",
      "dimension": "玩法",
      "excerpt": "As the grid grows, so do the challenges. Procedurally generated boards grow larger and deadlier with unique modifiers shifting the dynamics of gameplay.",
      "url": "https://store.steampowered.com/app/3161400/",
      "label": "证据原文片段"
    },
    {
      "text": "清盘赚取金币，在商店组合格子升级、永久强化和一次性救场卡。",
      "dimension": "玩法",
      "excerpt": "Earn gold as you clear each board and visit the shops to purchase upgrades. Tile upgrades introduce new elements to the grid. Permanent upgrades provide lasting advantages. Single-use cards add consumable effects that can save you in an emergency and turn the tide of the battle.",
      "url": "https://store.steampowered.com/app/3161400/",
      "label": "证据原文片段"
    },
    {
      "text": "每四关出现一次首领战，把常规扫雷转化为限时的速度、精度与压力挑战。",
      "dimension": "玩法",
      "excerpt": "Boss battles every four stages will turn the usual gameplay into high stakes strategy.",
      "url": "https://store.steampowered.com/app/3161400/",
      "label": "证据原文片段"
    }
  ],
