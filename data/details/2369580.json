  "hooks": [
    {
      "text": "国王用禁忌魔法复活王后却无法驾驭生死力量，最终失去理智并让王国陷落",
      "dimension": "故事",
      "excerpt": "The Kingdom has fallen to the Mad King, who has used forbidden magic to try to resuscitate the queen. But the powers of life and death were too big to handle for him, and as a consequence, the King lost his sanity.",
      "url": "https://store.steampowered.com/app/2369580/",
      "label": "证据原文片段"
    },
    {
      "text": "四名可玩角色各有专属战斗风格、可调属性和可探索背景故事",
      "dimension": "玩法",
      "excerpt": "Each of the 4 playable characters comes with their signature combat styles, customizable stats that impact gameplay, and detailed backstories to discover.",
      "url": "https://store.steampowered.com/app/2369580/",
      "label": "证据原文片段"
    },
    {
      "text": "以老派清版操作和复古手感为底层，再加入立体场景的3D机制",
      "dimension": "玩法",
      "excerpt": "Drawing inspiration from beloved classics, we've crafted a beat'em'up experience that combines old-school controls and retro feelings with innovative 3D mechanics.",
      "url": "https://store.steampowered.com/app/2369580/",
      "label": "证据原文片段"
    }
