  "hooks": [
    {
      "text": "逐台攻破企业服务器，把拆解资本主义写成黑客任务目标",
      "dimension": "题材",
      "excerpt": "Your mission: dismantle capitalism one computer server at a time.",
      "url": "https://store.steampowered.com/app/3304110/",
      "label": "证据原文片段"
    },
    {
      "text": "数据本身就是货币，从巨企夺回情报才能支付黑客程序",
      "dimension": "玩法",
      "excerpt": "Data is currency, money, moola 🤑 The MegaCorps have too much info on me, you, and everyone. You’ll be taking it back. After all, progs aren’t cheap!",
      "url": "https://store.steampowered.com/app/3304110/",
      "label": "证据原文片段"
    },
    {
      "text": "断线次数过多整次任务重置，但每轮都能窃取新招再挑战主机",
      "dimension": "玩法",
      "excerpt": "Get disconnected too many times, and your mission starts from scratch. The Big Three’s defenses are strong, Hacker, but you can be stronger. Pick up new tricks on every run, use the MegaCorps' progs to change the world, and find that Mainframe!",
      "url": "https://store.steampowered.com/app/3304110/",
      "label": "证据原文片段"
    }
  ],
