  "hooks": [
    {
      "text": "四人本地合作允许拳打、投掷甚至“意外”牺牲队友，把互相干扰变成生存机制。",
      "dimension": "玩法",
      "excerpt": "Smash through enemies, survive bullet storms, and embrace glorious trolling as you punch, throw, and ‘accidentally’ sacrifice your friends to survive relentless waves of horrors.",
      "url": "https://store.steampowered.com/app/2522160/",
      "label": "证据原文片段"
    },
    {
      "text": "每日挑战由服务器生成全新规则，限制角色、重混敌人和调整成长倍率，并配套 24 小时榜单。",
      "dimension": "玩法",
      "excerpt": "A procedurally generated ruleset our servers generate that changes the gameplay experience everyday, adding different gameplay modifiers, allowing for only certain characters to be used, mixes up enemies spawned, and ether increases the player's power scaling fantasy.",
      "url": "https://store.steampowered.com/app/2522160/",
      "label": "证据原文片段"
    },
    {
      "text": "宝石可永久升级 50 种以上技能，且角色、武器和能力会按击杀分别积累最多 50 级成长。",
      "dimension": "玩法",
      "excerpt": "Use gem currency (awarded by playing) to upgrade 50+ skills to all your characters permanently. The more you kill with an ability, weapon and character, the more experience they'll get. Each having 50 levels, permanently making them stronger!",
      "url": "https://store.steampowered.com/app/2522160/",
      "label": "证据原文片段"
    }
  ],
