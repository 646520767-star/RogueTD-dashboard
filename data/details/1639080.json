  "hooks": [
    {
      "text": "无论远征成败，商队都要把记忆装进晶球，由旅行甲虫送回首都传给后来者。",
      "dimension": "玩法",
      "excerpt": "Regardless of the success or failure of their mission, the caravans must send the memories they have gained back to the capital, using the crystospheres carried by traveling beetles.",
      "url": "https://store.steampowered.com/app/1639080/",
      "label": "证据原文片段"
    },
    {
      "text": "天气直接限制商队移动并改变战斗结果，酸雨、风暴与热浪本身就是生存威胁。",
      "dimension": "玩法",
      "excerpt": "Don't underestimate the weather! It conditions the movements of caravanners and the outcome of confrontations.",
      "url": "https://store.steampowered.com/app/1639080/",
      "label": "证据原文片段"
    },
    {
      "text": "远征不仅要打怪，还要建立外交与贸易关系，并在荒漠中种下一座新的树城庇护盟友。",
      "dimension": "故事",
      "excerpt": "Their mission: to establish diplomatic and trade relations, to explore and reclaim the lands left to the mercy of monsters and pirates, and, most importantly, to plant a new tree city that can become a refuge for the Mka and their allies.",
      "url": "https://store.steampowered.com/app/1639080/",
      "label": "证据原文片段"
    }
  ],
