  "hooks": [
    {
      "text": "海盗用异常伸长的双臂抓取物体，甚至能拆门、搬家具或破坏岛屿搜刮财宝",
      "dimension": "玩法",
      "excerpt": "You are quite an unusual sailor! I bet you can grab just about anything with those pairs of hands. Dismantle doors, grab furniture, or destroy the island for all I care!",
      "url": "https://store.steampowered.com/app/4317790/",
      "label": "证据原文片段"
    },
    {
      "text": "最多四名船员必须协作、沟通并在怪物环伺的岛上为船长完成搜刮",
      "dimension": "玩法",
      "excerpt": "You and up to three of your closest mates will work together, communicate, and survive as you try to make your ol’ captain rich and happy!",
      "url": "https://store.steampowered.com/app/4317790/",
      "label": "证据原文片段"
    },
    {
      "text": "深入神秘岛屿会提高冒险收益，但只要至少一名船员活着把黄金带回船上即可",
      "dimension": "玩法",
      "excerpt": "Feel the adventurous drive push you deeper into the mysterious island, but make sure that at least one of you lives to carry out the gold.",
      "url": "https://store.steampowered.com/app/4317790/",
      "label": "证据原文片段"
    }
  ],
