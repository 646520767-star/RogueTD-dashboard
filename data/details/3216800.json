  "hooks": [
    {
      "text": "惩罚性战斗要求及时反应并权衡每次选择，武器不足时还能用数十种物品诅咒或迷惑敌人。",
      "dimension": "玩法",
      "excerpt": "Heresy Supreme revolves around a combat system that is punishing yet rewarding Every choice must be weighed; react in time or face a violent end. And when weapons are not enough, turn to dozens of items to curse, confuse, and drive your enemies into despair.",
      "url": "https://store.steampowered.com/app/3216800/",
      "label": "证据原文片段"
    },
    {
      "text": "手工情境与任务由半程序系统不断重排，敌人、掉落和属性也会随机变化。",
      "dimension": "玩法",
      "excerpt": "Built from a large pool of handcrafted situations and quests, constantly rearranged by a semi-procedural system. Enemies, drops, and stats are randomized. Expect no patterns. Expect no mercy.",
      "url": "https://store.steampowered.com/app/3216800/",
      "label": "证据原文片段"
    },
    {
      "text": "艺术朋克图形、注定毁灭的黑暗世界与沉重末日金属共同塑造末世气质。",
      "dimension": "画风",
      "excerpt": "Mesmerizing art-punk graphic style A wretched world doomed by an unavoidable apocalypse A brutal, haunting doom metal soundtrack",
      "url": "https://store.steampowered.com/app/3216800/",
      "label": "证据原文片段"
    }
