  "hooks": [
    {
      "text": "乘客不开心会把列车长扔下车",
      "dimension": "玩法",
      "excerpt": "The passengers on your train will work diligently at your command, but be careful: if you don't manage their happiness properly, they might throw you off the train.",
      "url": "https://store.steampowered.com/app/2735630/",
      "label": "证据原文片段"
    },
    {
      "text": "途经城市用重吊无人机扩充车厢牌组",
      "dimension": "玩法",
      "excerpt": "Each time you pass through a city, you'll be able to add new train cars by launching a heavy lift drone. Be careful with each choice you make. If you are lucky, you'll be able to build a better, more synergized, happily-ever-after train deck, but it won't always go as you planned.",
      "url": "https://store.steampowered.com/app/2735630/",
      "label": "证据原文片段"
    },
    {
      "text": "穿越毒区并逃离身后逼近的暴风雪",
      "dimension": "玩法",
      "excerpt": "You'll have to pass through toxic areas, and a severe storm is brewing behind you.",
      "url": "https://store.steampowered.com/app/2735630/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "难度曲线较陡，理解玩法需要数小时。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "It took me a few hours for me to clock on to what the game wanted from me, and the difficulty curve is definitely pretty steep.",
          "url": "https://steamcommunity.com/id/kazdog71/recommended/2735630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "GPU占用接近满载。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "将近100%的GPU使用率",
          "url": "https://steamcommunity.com/profiles/76561198304445693/recommended/2735630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "部分协同明显优于其他协同。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Some of the synergies are just always going to be better than others.",
          "url": "https://steamcommunity.com/id/kazdog71/recommended/2735630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "初期挑战感良好。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "it does give you a good sense of challenge, particularly when you're starting out.",
          "url": "https://steamcommunity.com/id/kazdog71/recommended/2735630/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "管理与策略玩法简单而有娱乐性。",
