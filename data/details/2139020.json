  "hooks": [
    {
      "text": "两名玩家被吞入受诅咒的棋盘游戏，在充满魔法与怪物的世界中合作寻找出口。",
      "dimension": "故事",
      "excerpt": "What would happen if you and a friend were swallowed by a cursed board game? You’d get a 2-person co-op roguelite filled with magic powers, non-stop action, and lots and lots of monsters – that’s what.",
      "url": "https://store.steampowered.com/app/2139020/",
      "label": "证据原文片段"
    },
    {
      "text": "三名角色可规划互补升级；即使死亡也能继续协助队友，坚持到对方完成复活。",
      "dimension": "玩法",
      "excerpt": "Choose between Dead by Daylight’s Dwight, Claudette, or Feng Min and strategize your upgrades to build loadouts that complement each other. Then stay in the action even after you die, helping your partner tough it out until they can revive you.",
      "url": "https://store.steampowered.com/app/2139020/",
      "label": "证据原文片段"
    },
    {
      "text": "战斗、平台跳跃与目标推进结合：击杀赚取Bloodpoints，寻找并维修发电机，再激活符文强化角色。",
      "dimension": "玩法",
      "excerpt": "Destroy swarms of enemies and take down bosses to earn Bloodpoints. Platform across dangerous terrain to find and repair Generators. Activate their runes to upgrade your character.",
      "url": "https://store.steampowered.com/app/2139020/",
      "label": "证据原文片段"
    }
  ],
