  "hooks": [
    {
      "text": "三名强盗必须躲过攻击并找齐十件隐藏宝物，形成潜入搜刮式团队胜利条件",
      "dimension": "玩法",
      "excerpt": "Survive the Trapper attacks and find all 10 hidden treasures to claim victory!",
      "url": "https://store.steampowered.com/app/2982360/",
      "label": "证据原文片段"
    },
    {
      "text": "捕手把机关藏进家具，可在监控塔远程触发，也能进入机关家具亲自攻击提高伤害",
      "dimension": "玩法",
      "excerpt": "Use the Trapper Towers to keep watch and strategically place a wide variety of traps hidden in furniture. Activate your traps remotely from Trapper Towers or enter trapped furniture and attack bandits directly for more damage.",
      "url": "https://store.steampowered.com/app/2982360/",
      "label": "证据原文片段"
    },
    {
      "text": "强盗队伍赛前组合装备、特长与战术，局内再用扫描器和工具寻找隐藏财宝并反制机关",
      "dimension": "玩法",
      "excerpt": "Strategise with your crew, choose the right gear, perks and map out tactics before the match starts. Choose wisely and outsmart the Trapper with the right setup! Evade traps, fight the Trapper and master a huge variety of scanners and tools to loot hidden treasures.",
      "url": "https://store.steampowered.com/app/2982360/",
      "label": "证据原文片段"
    }
  ],
