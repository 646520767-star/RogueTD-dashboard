  "hooks": [
    {
      "text": "边射击边管理鼠军推进Ratineer攻入敌方基地",
      "dimension": "玩法",
      "excerpt": "You must manage and fight alongside your army to push back the tide of the enemy and get your Ratineer into their base. Sounds simple but it won't be easy.",
      "url": "https://store.steampowered.com/app/3167260/",
      "label": "证据原文片段"
    },
    {
      "text": "搭建五类防御工事反压TechnoRat敌军",
      "dimension": "玩法",
      "excerpt": "Defend Your Base: Build turrets, shrines, walls, resource generators and missile launchers to counter and overwhelm the armies of TechnoRat.",
      "url": "https://store.steampowered.com/app/3167260/",
      "label": "证据原文片段"
    },
    {
      "text": "手绘血腥鼠族动画复现90年代硬派像素感",
      "dimension": "画风",
      "excerpt": "Inspired by games such as Kingdom: New Lands and Futurecop LAPD's Precinct Assault mode (now generally considered to be the first ever MOBA) delivered in a package that evokes the brutal, gory 90s gaming sprites of old, it's a non-stop bloody action game with lovingly hand-drawn art and animation.",
      "url": "https://store.steampowered.com/app/3167260/",
      "label": "证据原文片段"
    }
  ],
