  "hooks": [
    {
      "text": "僵尸潮随存活时间变得更多更强，但掉落与神器也同步升级，形成持续加码的风险收益。",
      "dimension": "玩法",
      "excerpt": "The longer you survive, the stronger and more numerous the zombies become. But the loot and artifacts also become stronger and more numerous.",
      "url": "https://store.steampowered.com/app/2224120/",
      "label": "证据原文片段"
    },
    {
      "text": "选择炮塔升级路线并叠加效果，把移动船只改造成专属僵尸绞肉机。",
      "dimension": "玩法",
      "excerpt": "Choose your upgrade path, combine turret effects and create your own zombie death machine.",
      "url": "https://store.steampowered.com/app/2224120/",
      "label": "证据原文片段"
    },
    {
      "text": "救援、招募并管理拥有独特能力的船员，把合适人才分配给关键岗位维持最后之船。",
      "dimension": "玩法",
      "excerpt": "Manage, rescue, and hire crew members with unique skills and abilities. Every role is important for the survival of the ship and assigning the right crew member with the right talents is key to survival.",
      "url": "https://store.steampowered.com/app/2224120/",
      "label": "证据原文片段"
    }
  ],
