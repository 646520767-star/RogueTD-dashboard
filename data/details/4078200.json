  "hooks": [
    {
      "text": "挖得越狠灾难越多，还得让跑腿矮人把黄金活着运回家",
      "dimension": "玩法",
      "excerpt": "The more damage your greedy dwarves deal to the mountain, the more calamities it unleashes upon the wobbling beards below! Balance mining with hauling your gold home—before the sky falls on your head.",
      "url": "https://store.steampowered.com/app/4078200/",
      "label": "证据原文片段"
    },
    {
      "text": "炸药手、弩炮、激光炮与酿酒师组成多路线生产军团",
      "dimension": "玩法",
      "excerpt": "Many buildings and dwarves, each with various strengths and weaknesses, such as dynamite throwers, ballistas, flamers, laser cannons, spelunkers, runesmiths, brewmasters, bulldozers, gyrocopters and more!",
      "url": "https://store.steampowered.com/app/4078200/",
      "label": "证据原文片段"
    },
    {
      "text": "120件塑造流派的神器叠加96项声望重开升级",
      "dimension": "玩法",
      "excerpt": "Collect 120+ ancient artifacts and display them in your gallery, each with build-shaping effects Unlock 96+ prestige upgrades to replay, accelerate progress, and discover new synergies",
      "url": "https://store.steampowered.com/app/4078200/",
      "label": "证据原文片段"
    }
  ],
