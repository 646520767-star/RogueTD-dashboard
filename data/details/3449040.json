  "hooks": [
    {
      "text": "融合进化后的魔法，制造疯狂且不可预期的技能组合",
      "dimension": "玩法",
      "excerpt": "Take your magic beyond the absurd by fusing them to create insane and unexpected combos.",
      "url": "https://store.steampowered.com/app/3449040/",
      "label": "证据原文片段"
    },
    {
      "text": "平行宇宙饰品同时改造玩法、奖励与魔法鸡外观",
      "dimension": "玩法",
      "excerpt": "They change your playstyle, grant unexpected bonuses, twist reality — and above all, make your chicken look absolutely stylish.",
      "url": "https://store.steampowered.com/app/3449040/",
      "label": "证据原文片段"
    },
    {
      "text": "集齐神圣遗物碎片后，在战场释放鸡神力量清剿蛙群",
      "dimension": "玩法",
      "excerpt": "Once complete, bring them to the battlefield to channel this ancient power and unleash the chicken gods’ energy to obliterate frogs mercilessly.",
      "url": "https://store.steampowered.com/app/3449040/",
      "label": "证据原文片段"
    }
  ],
