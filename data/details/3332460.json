  "hooks": [
    {
      "text": "繁育时会混合双亲特征，生成能力与外观都不同的独一史莱姆伙伴",
      "dimension": "玩法",
      "excerpt": "Discover endless possibilities as you breed different slimes, combining traits from both parents to create new, one-of-a-kind slime companions with unique abilities and appearances.",
      "url": "https://store.steampowered.com/app/3332460/",
      "label": "证据原文片段"
    },
    {
      "text": "通过喂养、提升属性和解锁能力培养史莱姆，照料质量直接决定队伍能否扛过生存挑战",
      "dimension": "玩法",
      "excerpt": "Strengthen your slimes by feeding them, raising their stats, and unlocking new abilities. Proper care is essential for building a powerful team that can endure the challenges of survival.",
      "url": "https://store.steampowered.com/app/3332460/",
      "label": "证据原文片段"
    },
    {
      "text": "每次岛屿旅程都会重新生成挑战、敌人和奖励，让史莱姆队持续探索下一座岛",
      "dimension": "玩法",
      "excerpt": "Prepare your slime team for an ever-evolving island survival adventure, where every journey is unique. Face procedurally generated challenges, enemies, and rewards as you explore island after island.",
      "url": "https://store.steampowered.com/app/3332460/",
      "label": "证据原文片段"
    }
  ],
