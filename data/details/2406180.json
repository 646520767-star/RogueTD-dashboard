  "hooks": [
    {
      "text": "任务推进会同时给玩家与敌人随机强化，存活越久双方能力越疯狂。",
      "dimension": "玩法",
      "excerpt": "Progressing through a mission grants randomized modifiers for both you and your enemies. The longer you survive, the crazier the powers get, keeping each run fresh and unique.",
      "url": "https://store.steampowered.com/app/2406180/",
      "label": "证据原文片段"
    },
    {
      "text": "为武器与护甲装配模组，自由拼出自己的职业而非锁定预设兵种。",
      "dimension": "玩法",
      "excerpt": "Create your own class by equipping gear mods for your various weapons and armor to enhance your preferred playstyle.",
      "url": "https://store.steampowered.com/app/2406180/",
      "label": "证据原文片段"
    },
    {
      "text": "移动始终由玩家掌控，剑与枪也随时可用，让近战和射击无需切换姿态。",
      "dimension": "玩法",
      "excerpt": "Free-form combat: maintain control of your movement while always having access to your sword and firearm",
      "url": "https://store.steampowered.com/app/2406180/",
      "label": "证据原文片段"
    }
  ],
