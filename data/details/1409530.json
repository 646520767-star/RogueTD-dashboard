  "hooks": [
    {
      "text": "战斗间可重排法术栏，从贴身奥术旋刃切换到远距离阳光射线",
      "dimension": "玩法",
      "excerpt": "Learn new spells and equip them to your spell bar between combat to suit your playstyle . Get up close and personal with whirling blades of arcane energy or harness an intense beam of sunlight to destroy your enemies from afar.",
      "url": "https://store.steampowered.com/app/1409530/",
      "label": "证据原文片段"
    },
    {
      "text": "法术、徽记和属性加成必须组合成协同构筑，搭配正确与否直接决定生死",
      "dimension": "玩法",
      "excerpt": "Choosing the right combination of spells, emblems, and stat bonuses for your build will be the difference between victory and death.",
      "url": "https://store.steampowered.com/app/1409530/",
      "label": "证据原文片段"
    },
    {
      "text": "二十二种法术、七十多枚徽记与十二类可升级属性组成三层成长池",
      "dimension": "玩法",
      "excerpt": "22 unique spells 70+ unique emblems 12 upgradable stat types to bolster your offense, defense, and utility",
      "url": "https://store.steampowered.com/app/1409530/",
      "label": "证据原文片段"
    }
  ],
