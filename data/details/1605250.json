  "hooks": [
    {
      "text": "拾取的强化与武器直接决定配装风格，战术射击之外还能近身踢飞敌人",
      "dimension": "玩法",
      "excerpt": "Moros Protocol combines relentless action with adaptability and customization. Shape your loadout and let the augments and weapons you find dictate your fighting style. And yes, you can kick your enemies.",
      "url": "https://store.steampowered.com/app/1605250/",
      "label": "证据原文片段"
    },
    {
      "text": "手工场景与程序生成混合重组布局和挑战，使每次深入废弃战舰都不同",
      "dimension": "玩法",
      "excerpt": "Each run is shaped by a combination of handcrafted environments and procedural generation. New layouts. New challenges to face. No two runs will feel the same.",
      "url": "https://store.steampowered.com/app/1605250/",
      "label": "证据原文片段"
    },
    {
      "text": "好友可随时加入并肩体验完整流程，共同对抗战舰噩梦",
      "dimension": "玩法",
      "excerpt": "DROP-IN CO-OP Team up with a friend for backup. Adapt and survive together as you battle through the nightmare. Experience the full game side by side, sharing the fight against the enemy.",
      "url": "https://store.steampowered.com/app/1605250/",
      "label": "证据原文片段"
    }
  ],
