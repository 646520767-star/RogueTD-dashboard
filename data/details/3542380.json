  "hooks": [
    {
      "text": "用真实物理投掷魔法骰，相同骰子融合后自动寻找同类引爆连锁",
      "dimension": "玩法",
      "excerpt": "Launch dice across enchanted battlefields where realistic physics meets ancient magic. Matching dice fuse into a more powerful one that seeks its equals, triggering devastating chain combos.",
      "url": "https://store.steampowered.com/app/3542380/",
      "label": "证据原文片段"
    },
    {
      "text": "八种职业拥有专属骰子与魔法，同职业多英雄也从不同组合开局",
      "dimension": "玩法",
      "excerpt": "Pick from 8 unique classes, each with special dice and magical abilities. Every class offers multiple heroes with different starting combinations, ensuring each adventure feels completely different.",
      "url": "https://store.steampowered.com/app/3542380/",
      "label": "证据原文片段"
    },
    {
      "text": "把骰子、遗物与符文串成构筑，还能在古代祭坛赌上骰子换取升级",
      "dimension": "玩法",
      "excerpt": "Craft a powerful combination of dice, relics, and runes that work together to define your playstyle. Collect magical dice through combat victories and shop purchases, discover game-changing relics that provide permanent enhancements, and gather tactical runes for battlefield manipulation. Visit ancient altars where you can risk your dice for upgrades, or play it safe and build your arsenal gradually.",
      "url": "https://store.steampowered.com/app/3542380/",
      "label": "证据原文片段"
    }
  ],
