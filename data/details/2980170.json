  "hooks": [
    {
      "text": "每项任务前搜刮资源、制作武器和道具，再按任务特性选择专用负载",
      "dimension": "玩法",
      "excerpt": "Scavenge for resources, craft weapons and items and carefully select your loadouts to overcome each unique mission.",
      "url": "https://store.steampowered.com/app/2980170/",
      "label": "证据原文片段"
    },
    {
      "text": "一百多种工具覆盖跳跃靴、陷阱与炸药，可击退敌人、培育资源或照亮断电站点",
      "dimension": "玩法",
      "excerpt": "Find utility items like jumping boots, traps, and improvised explosives, or craft them yourself in your homebase. With over 100 items available, you can repel enemies, grow resources or light your way through dark powerless stations. There's a tool for everything!",
      "url": "https://store.steampowered.com/app/2980170/",
      "label": "证据原文片段"
    },
    {
      "text": "每轮空间站会随机遭遇断电、辐射或失重条件，迫使战术随环境改写",
      "dimension": "玩法",
      "excerpt": "Every run is different , some stations are plunged into darkness by power failures, some are saturated with radiation, and some force you to fight through facilities without gravity.",
      "url": "https://store.steampowered.com/app/2980170/",
      "label": "证据原文片段"
    }
