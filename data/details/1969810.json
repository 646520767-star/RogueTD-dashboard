  "hooks": [
    {
      "text": "玩家一动，冻结的敌人与空中子弹才同步行动，可在弹幕间逐步规划。",
      "dimension": "玩法",
      "excerpt": "Between each turn, bullets hang in mid-air and enemies are frozen. When you move, so does everything else.",
      "url": "https://store.steampowered.com/app/1969810/",
      "label": "证据原文片段"
    },
    {
      "text": "把不同世界的武器、装备与装置混搭，构造激光、跳弹甚至外星卵爆破等组合。",
      "dimension": "玩法",
      "excerpt": "Mix weapons, gear and gadgets from different worlds to create powerful builds.",
      "url": "https://store.steampowered.com/app/1969810/",
      "label": "证据原文片段"
    },
    {
      "text": "每个吞噬世界形成独立生态、敌人、目标与装备，深入后还会遭遇物理扭曲。",
      "dimension": "题材",
      "excerpt": "Every chronosphere contains biomes from the worlds it has consumed, each with its own enemies, objectives and gear.",
      "url": "https://store.steampowered.com/app/1969810/",
      "label": "证据原文片段"
    }
  ],
