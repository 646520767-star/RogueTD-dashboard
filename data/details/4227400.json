  "hooks": [
    {
      "text": "割草、建塔与守城全程同时进行，不暂停选建筑",
      "dimension": "玩法",
      "excerpt": "Fight hordes of the Khmar, level up your hero, collect weapons and artifacts and build structures and towers right in the middle of combat. There are no calm pauses for decisions - combat, building and survival all happen at the same time.",
      "url": "https://store.steampowered.com/app/4227400/",
      "label": "证据原文片段"
    },
    {
      "text": "2至4人分工守线、救队友或出城抢战利品",
      "dimension": "玩法",
      "excerpt": "Revive fallen allies, split roles and decide who holds the line while another player pushes out for loot.",
      "url": "https://store.steampowered.com/app/4227400/",
      "label": "证据原文片段"
    },
    {
      "text": "离信标越远风险越高，稀有资源回报也越大",
      "dimension": "玩法",
      "excerpt": "Venture beyond the base to search for rare resources, chests, altars, trials and enemy lairs. The farther you go from the Beacon, the greater the risk - and the more valuable the reward.",
      "url": "https://store.steampowered.com/app/4227400/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "后期满屏特效会遮挡玩家位置。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "后期满屏的特效糊脸",
          "url": "https://steamcommunity.com/profiles/76561198188682829/recommended/4227400/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "Boss红色攻击透明度过高，视觉辨识困难。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "red attacks are often way too transparent",
          "url": "https://steamcommunity.com/profiles/76561198790018230/recommended/4227400/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "多人地图资源不共享",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "局内的所有地图资源都是不共享的",
          "url": "https://steamcommunity.com/id/Exdeathy/recommended/4227400/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "射击缺少命中反馈。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Shots currently lack any impact",
          "url": "https://steamcommunity.com/profiles/76561198790018230/recommended/4227400/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "菜单极其混乱且逻辑不一致。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The menu is extremely confusing and inconsistent",
          "url": "https://steamcommunity.com/profiles/76561198790018230/recommended/4227400/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "敌人或坐骑会直接生成在玩家体内",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "mounts or enemies should absolutely never spawn directly inside the player",
          "url": "https://steamcommunity.com/profiles/76561198790018230/recommended/4227400/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "塔防单位升级后仍几乎没有作用。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The towers do absolutely nothing, even upgraded.",
          "url": "https://steamcommunity.com/id/Gorgeous_B/recommended/4227400/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "多人后期特效密集时优化很差。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "游戏优化很差 尤其是多人联机的时候怪一多",
          "url": "https://steamcommunity.com/profiles/76561198188682829/recommended/4227400/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "地形无法阻挡敌人，使塔防机制名不副实。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The tower defense isn't real, considering everything can just walk over all the terrain.",
          "url": "https://steamcommunity.com/id/Gorgeous_B/recommended/4227400/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "多人模式故障严重。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The multiplayer is completely broken.",
          "url": "https://steamcommunity.com/profiles/76561198040540687/recommended/4227400/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
