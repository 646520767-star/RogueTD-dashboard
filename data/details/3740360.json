  "hooks": [
    {
      "text": "可在狙击枪加武士刀的精准组合与火箭筒混战之间切换整套战斗节奏",
      "dimension": "玩法",
      "excerpt": "Set your combat pace by cycling through a colossal arsenal of devastating weapons. Go for a sniper and a katana for deadly precision… or embrace chaos with a bazooka in hand.",
      "url": "https://store.steampowered.com/app/3740360/",
      "label": "证据原文片段"
    },
    {
      "text": "工业设施逐区配置更强且怪诞的专属敌人与Boss，从机器人妈妈到机械恐龙",
      "dimension": "玩法",
      "excerpt": "Raid distinct industrial facilities, each with enemies and bosses that grow increasingly challenging and… unique. An overprotective robot mom who mistakes love for mass destruction? We’ve got it. A Segway-riding robot trying to play mall cop? Also, yes. A ravenous robotic dinosaur in a post-apocalyptic zoo? Absolutely.",
      "url": "https://store.steampowered.com/app/3740360/",
      "label": "证据原文片段"
    },
    {
      "text": "解救被算法束缚的猫咪即可获得一支猫军团，对抗广告与垃圾信息统治",
      "dimension": "题材",
      "excerpt": "Stop the robots from monetizing hypnotic cat videos. Free the fluffballs from the algorithm’s chains and earn the lifelong loyalty of an entire feline army.",
      "url": "https://store.steampowered.com/app/3740360/",
      "label": "证据原文片段"
    }
  ],
