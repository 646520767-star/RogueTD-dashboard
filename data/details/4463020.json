    {
      "text": "在随机生成的群岛上临场布防，抵挡一波波海盗抢掠",
      "dimension": "玩法",
      "excerpt": "Build defenses on randomly generated archipelagos and fend off waves of pirates!",
      "url": "https://store.steampowered.com/app/4463020/",
      "label": "证据原文片段"
    },
    {
      "text": "扩张六角岛屿地块并合成防御塔，用宝藏持续强化群岛",
      "dimension": "玩法",
      "excerpt": "Expand land plots, combine defense towers, and collect treasures to strengthen your islands.",
      "url": "https://store.steampowered.com/app/4463020/",
      "label": "证据原文片段"
    },
    {
      "text": "战败后带宝石返回港口，解锁更强开局构筑和建筑再度出航",
      "dimension": "玩法",
      "excerpt": "After each defeat, return to the harbor with your accumulated gems to unlock stronger starting builds and structures — and take on even greater challenges!",
      "url": "https://store.steampowered.com/app/4463020/",
      "label": "证据原文片段"
    }
  ],
