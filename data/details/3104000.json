  "hooks": [
    {
      "text": "无需编程即可制作自定义战斗少女，并上传创意工坊供其他玩家使用。",
      "dimension": "玩法",
      "excerpt": "No coding knowledge is required; the operation is extremely simple. You can use it to create your own battle girls, integrate them into the game, and even upload them to the Creative Workshop for other players to use.",
      "url": "https://store.steampowered.com/app/3104000/",
      "label": "证据原文片段"
    },
    {
      "text": "三名相同少女可升级并选择路线，同阵营组合还能激活阵营加成。",
      "dimension": "玩法",
      "excerpt": "Maiden Leveling: Collect three of the same maiden to upgrade to a stronger version, with multiple paths for you to choose from. Faction Activation: Gather maidens with the same faction to activate faction bonuses and increase your team’s combat power.",
      "url": "https://store.steampowered.com/app/3104000/",
      "label": "证据原文片段"
    }
  ],
