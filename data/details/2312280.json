  "hooks": [
    {
      "text": "非对称4对1模式允许玩家选择幸存者阵营守住人类希望，或成为Zombie Hive Master统领尸群。",
      "dimension": "玩法",
      "excerpt": "Choose : Be one of the brave survivors and fight for what remains of humanity or be the dominating Zombie Hive Master and purge all humanity on earth.",
      "url": "https://store.steampowered.com/app/2312280/",
      "label": "证据原文片段"
    },
    {
      "text": "幸存者要搜刮建材后占领并加固建筑，在可破坏体素世界中布设陷阱抵挡连续尸潮。",
      "dimension": "玩法",
      "excerpt": "Build : Locate and fortify a nearby structure with the resources you scavenged. Lay down traps and bolster your defenses as waves of the undead come for you in this destructible voxel world.",
      "url": "https://store.steampowered.com/app/2312280/",
      "label": "证据原文片段"
    },
    {
      "text": "尸群主宰可从空中指挥视角侦察基地、规划召唤点并下达协同命令，也能附身单只僵尸亲自作战。",
      "dimension": "玩法",
      "excerpt": "Strategize : From the sky in command view, search and find the survivors' base. Plan where your horde will be summoned from and dominate the field by giving them orders during the bloodmoon. Command : Give orders to your horde to strategize a coordinated attack. Possess : Take possession of zombies in third person to fight the survivors on the field.",
      "url": "https://store.steampowered.com/app/2312280/",
      "label": "证据原文片段"
    }
  ],
