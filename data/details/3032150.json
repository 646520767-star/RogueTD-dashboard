  "hooks": [
    {
      "text": "从小营地经营为繁荣边境聚落，招募居民并分派耕作、制作、采集与防卫工作。",
      "dimension": "玩法",
      "excerpt": "Start with a small camp and grow it into a thriving frontier settlement shaped by your leadership. Recruit NPC settlers and assign daily work, farming, crafting, gathering and defense, to keep your town running. Lead well and your community thrives; neglect it and the frontier will catch up.",
      "url": "https://store.steampowered.com/app/3032150/",
      "label": "证据原文片段"
    },
    {
      "text": "可在猎人、商人、建造者、匪徒与执法者之间选择生活方式，并由行为塑造边境声望。",
      "dimension": "玩法",
      "excerpt": "Live your Wild West fantasy your way. Become a hunter, trader, builder, bandit, lawman or something in between. Your choices shape your reputation in the frontier.",
      "url": "https://store.steampowered.com/app/3032150/",
      "label": "证据原文片段"
    },
    {
      "text": "在荒野发现、驯服并训练属性能力各异的野马，让坐骑参与旅行与生存。",
      "dimension": "玩法",
      "excerpt": "Discover wild horses roaming the land, then tame and train them into trusted companions. Each horse has unique attributes and abilities, making them valuable allies and key for traveling, surviving and thriving in the frontier.",
      "url": "https://store.steampowered.com/app/3032150/",
      "label": "证据原文片段"
    }
  ],
