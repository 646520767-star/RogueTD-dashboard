  "hooks": [
    {
      "text": "角色攻击与特效完全模块化，跑图途中可按局势随时替换。",
      "dimension": "玩法",
      "excerpt": "The player's own attacks and special effects can be exchanged midway through runs as the situation demands, or simply for fun.",
      "url": "https://store.steampowered.com/app/1825250/",
      "label": "证据原文片段"
    },
    {
      "text": "三名角色、四档主难度和可自由开关的挑战/降难选项共同支持自定义难度。",
      "dimension": "玩法",
      "excerpt": "There are a lot of ways to approach the game, with three playable characters, four major difficulty options, and a myriad of challenges and difficulty-lowering options that can be enabled or disabled at will.",
      "url": "https://store.steampowered.com/app/1825250/",
      "label": "证据原文片段"
    },
    {
      "text": "每种失败都配有专门写作的坏结局笑话，共计 60 个，让失败局也产生叙事回报。",
      "dimension": "故事",
      "excerpt": "And 60 bad endings uniquely written for every possible loss! Never a run wasted if there's a new dumb joke at the end!",
      "url": "https://store.steampowered.com/app/1825250/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "美术极具个性，并能有力传达剧情情绪。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the art is incredibly charismatic and conveys the emotion of the plot amazingly well",
          "url": "https://steamcommunity.com/profiles/76561198381230913/recommended/1825250/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "难度曲线后期突然失控。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "这难度曲线确实有点诡异了，从五面开始初见端倪到七面彻底放飞自我",
          "url": "https://steamcommunity.com/profiles/76561199353489486/recommended/1825250/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "后期存在明显性能问题。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "there are fairly sizable performance issues, especially at the end of the game",
          "url": "https://steamcommunity.com/id/akyuuposting/recommended/1825250/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "保留东方弹幕挑战的同时允许夸张多样的角色构筑。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "manages to capture the challenge of the OG shmups while still allowing for wild character builds.",
          "url": "https://store.steampowered.com/curator/43135575-Dominic-Tarason%2527s-Opinionation-Station/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "作为肉鸽本身有大量可享受的玩法要素。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "a perfectly fine rogue-like with plenty of elements to enjoy from strictly a point of view of gameplay.",
          "url": "https://steamcommunity.com/id/akyuuposting/recommended/1825250/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "多个结局令人高度不满足。",
      "dimension": "剧情",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "highly unsatisfying conclusions.",
          "url": "https://steamcommunity.com/id/akyuuposting/recommended/1825250/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "叙事最终留下持续的挫败与不满。",
      "dimension": "剧情",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "I walked away with a lingering sense of frustration and dissatisfaction.",
          "url": "https://steamcommunity.com/id/akyuuposting/recommended/1825250/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "完成真结局带来强烈情感冲击，令人难忘。",
      "dimension": "剧情",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "I'm bawling my eyes out having just truly completed the story, a game I will not soon—or never—forget.",
          "url": "https://steamcommunity.com/id/LOVEV4MP1R3/recommended/1825250/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "写作质量极其出色。",
      "dimension": "剧情",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the quality of the writing is genuinely outstanding",
          "url": "https://steamcommunity.com/profiles/76561198381230913/recommended/1825250/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "作品对东方Project的热爱与投入非常鲜明。",
      "dimension": "主题",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Tremendous passion for Touhou.",
          "url": "https://store.steampowered.com/curator/45462293-Vintagecoats/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
