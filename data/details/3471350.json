  "hooks": [
    {
      "text": "选择英雄并以12种战斗流派构筑，在十余张地图上调整自动战斗策略。",
      "dimension": "玩法",
      "excerpt": "You will choose your favorite hero, build your heroes with 12 different combat genres, and adjust your strategy corresponding to 10+ different maps.",
      "url": "https://store.steampowered.com/app/3471350/",
      "label": "证据原文片段"
    },
    {
      "text": "每局与另外七名机器人或真人玩家竞争，目标成为最终胜者。",
      "dimension": "玩法",
      "excerpt": "battle the other 7 Bots or Players to be the winner.",
      "url": "https://store.steampowered.com/app/3471350/",
      "label": "证据原文片段"
    },
    {
      "text": "对局还加入选秀与神器系统，为英雄构筑提供额外争夺和强化来源。",
      "dimension": "玩法",
      "excerpt": "There is also drafting and artifacts involved.",
      "url": "https://store.steampowered.com/app/3471350/",
      "label": "证据原文片段"
    }
  ],
