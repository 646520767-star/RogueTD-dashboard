  "hooks": [
    {
      "text": "把灾变前的物资囤积与灾变后的据点经营连接成前后两阶段生存循环。",
      "dimension": "玩法",
      "excerpt": "Survival Log fuses two distinct phases of survival: the desperate scramble to hoard before the outbreak and the relentless challenge of managing your stronghold after.",
      "url": "https://store.steampowered.com/app/4164790/",
      "label": "证据原文片段"
    },
    {
      "text": "选择工人、学生或仓库职员等前世身份；每次失败化为经验，带着记忆重生追查灾变真相。",
      "dimension": "玩法",
      "excerpt": "Choose your past—a worker, a student, or a warehouse clerk. Every identity changes the game. Every failure becomes experience. Reborn with your memories, uncover the disaster's truth.",
      "url": "https://store.steampowered.com/app/4164790/",
      "label": "证据原文片段"
    }
  ],
