  "hooks": [
    {
      "text": "每局沿不同动物进化路线，创造外形与机制都独一无二的生物",
      "dimension": "玩法",
      "excerpt": "Make animal inspired evolutionary choices to concoct your own unique creature every run, both mechanically and visually.",
      "url": "https://store.steampowered.com/app/3526710/",
      "label": "证据原文片段"
    },
    {
      "text": "从125种能力中拼接腿、钳、翅膀、毛皮与触手，造出荒诞嵌合体",
      "dimension": "玩法",
      "excerpt": "Over 125 abilities combine to create a plethora of different builds and playstyles: Become a wily trickster, a ferocious predator, a gregarious leader, a nimble nomad, or take on any number of other survival strategies. Legs! Claws! Pincers! Wings! More Legs! Fur! Tail! Scales! Tentacles! I SAID MORE LEGS!!! Build your formidable, visually awkward chimera or get Darwin'd in the process.",
      "url": "https://store.steampowered.com/app/3526710/",
      "label": "证据原文片段"
    },
    {
      "text": "混合遗传起始角色，在开局前就生成不同的进化底盘",
      "dimension": "玩法",
      "excerpt": "Genetics (starting Characters), which can be combined to create endless starting character combinations",
      "url": "https://store.steampowered.com/app/3526710/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "游戏缺少存档，退出会丢失本局进度。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "这游戏没有存档功能的救赎感，退出去就算你这一把白玩了",
          "url": "https://steamcommunity.com/profiles/76561199028371158/recommended/3526710/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "玩法深度严重不足。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "深度完全不足",
          "url": "https://steamcommunity.com/profiles/76561199174481224/recommended/3526710/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "高压力等级只剩下困难感。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "until high pressure levels - then it's just hard",
          "url": "https://steamcommunity.com/profiles/76561198054235008/recommended/3526710/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "高压力玩法变成耗时碰运气的重复刷取。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "压力5以上的游玩全是些堆砌时间碰运气的重复刷取工作",
          "url": "https://steamcommunity.com/profiles/76561198119892670/recommended/3526710/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "主动技能种类反复且不足。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "主动技能翻来覆去就那几个",
          "url": "https://steamcommunity.com/profiles/76561198287895912/recommended/3526710/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "各局内容不足且体验趋同。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "There's not enough to do for all the runs to end up feeling basically the same",
          "url": "https://steamcommunity.com/id/thexmanlight/recommended/3526710/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "体验多个流派后很快变得无聊。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "after a few runs with each different playstyle, it gets pretty boring",
          "url": "https://steamcommunity.com/id/thexmanlight/recommended/3526710/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "移速天赋极难获得。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "非常非常难见到加速度的天赋",
          "url": "https://steamcommunity.com/profiles/76561198119892670/recommended/3526710/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "难以完成完整构筑。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "根本就没办法完成完整的构筑",
          "url": "https://steamcommunity.com/profiles/76561198287895912/recommended/3526710/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "除物理叠甲外的其他流派难以获得爽感。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "其他流派:叠毒，群攻，远程的也好，这些都爽不起来",
          "url": "https://steamcommunity.com/profiles/76561199174481224/recommended/3526710/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
