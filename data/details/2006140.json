    {
      "text": "每晚重新生成并改变布局的维多利亚宅邸",
      "dimension": "玩法",
      "excerpt": "Withering Rooms is a challenging 2.5D horror RPG set in a procedurally generated Victorian mansion that changes each night.",
      "url": "https://store.steampowered.com/app/2006140/",
      "label": "证据原文片段"
    },
    {
      "text": "通过仪式跨夜保留物品或获得永久升级",
      "dimension": "玩法",
      "excerpt": "Take the sting out of death by performing rituals to preserve items from night to night or permanently level up.",
      "url": "https://store.steampowered.com/app/2006140/",
      "label": "证据原文片段"
    },
    {
      "text": "用壁橱诅咒陷阱、附魔盔甲与自身诱饵分身施法",
      "dimension": "玩法",
      "excerpt": "Cast a wide variety of spells - create hex traps on closet doors, enchant suits of armor to assist you, or create a decoy mimic of yourself.",
      "url": "https://store.steampowered.com/app/2006140/",
      "label": "证据原文片段"
    }
  ],
