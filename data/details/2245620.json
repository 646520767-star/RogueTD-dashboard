  "hooks": [
    {
      "text": "女巫可移动职业塔，并给塔装备、合成物品来获得主动能力和独特构筑",
      "dimension": "玩法",
      "excerpt": "Strategic tower defense where you play a witch, place class-based towers, equip them with items that grant powerful abilities, combine them, create unique builds & deal ridiculous amounts of damage! Customize your builds with a deep stat system and giant skill tree! M ove around Towers, Fight Big Bosses!",
      "url": "https://store.steampowered.com/app/2245620/",
      "label": "证据原文片段"
    },
    {
      "text": "超过100件物品可被装备和组合，扩展防御塔的效果搭配",
      "dimension": "玩法",
      "excerpt": "Equip and Combine over 100 different items.",
      "url": "https://store.steampowered.com/app/2245620/",
      "label": "证据原文片段"
    },
    {
      "text": "防御者、弓手和治疗者各有技能树，无尽模式敌潮难度指数增长",
      "dimension": "玩法",
      "excerpt": "Three classes with unique skill sets. Defender, Archer and Healer. A Skill Tree for each class to progress through and grow more powerful. Endless Mode. Test your strategy against waves of enemies that become exponentially more difficult.",
      "url": "https://store.steampowered.com/app/2245620/",
      "label": "证据原文片段"
    }
