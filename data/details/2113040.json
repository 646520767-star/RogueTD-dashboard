  "hooks": [
    {
      "text": "英雄与敌人同步自动行动，玩家必须在实时混战中快速判断出牌时机",
      "dimension": "玩法",
      "excerpt": "Idle battles. Your hero and enemies act simultaneously, so timing your moves will be crucial in many situations. Being able to strategize is cool and all, but can you do it quickly?",
      "url": "https://store.steampowered.com/app/2113040/",
      "label": "证据原文片段"
    },
    {
      "text": "出牌不受回合或资源上限限制，一场遭遇可以连续打出一百张牌",
      "dimension": "玩法",
      "excerpt": "Non restricted card-play. Have you ever wanted to play 100 cards during one encounter? Well, now you can.",
      "url": "https://store.steampowered.com/app/2113040/",
      "label": "证据原文片段"
    },
    {
      "text": "关卡旅程会重新组合事件、装备、神器和药水，让每次流程获得不同资源组合",
      "dimension": "玩法",
      "excerpt": "Randomized journey. The game is devided into levels, but you will encounter different events, get different gear, artifacts and potions that will make every run unique",
      "url": "https://store.steampowered.com/app/2113040/",
      "label": "证据原文片段"
    }
  ],
