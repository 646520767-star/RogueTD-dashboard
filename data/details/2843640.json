  "hooks": [
    {
      "text": "两个同级水果合成下一级，价值按1、2、4、8持续指数翻倍",
      "dimension": "玩法",
      "excerpt": "Combine two fruits of the same tier into the next one. 1$, 2$, 4$, 8$... This process generates an exponential amount of money as you make your way up to bigger fruits.",
      "url": "https://store.steampowered.com/app/2843640/",
      "label": "证据原文片段"
    },
    {
      "text": "从手动浇水收获起步，随后招募数千生物自动完成采集、施肥、砍伐、种植和造机器",
      "dimension": "玩法",
      "excerpt": "You will start with a sapling that you'll have to manually water and harvest, but soon enough you'll be able to recruit thousands of naïve creatures to assist you in your endeavor. They collect, fertilize, chop down, plant trees, create machines... and they love it!",
      "url": "https://store.steampowered.com/app/2843640/",
      "label": "证据原文片段"
    },
    {
      "text": "献祭整座殖民地换取强力科技，让下一轮经济从更高基础重新增长",
      "dimension": "玩法",
      "excerpt": "Sacrifice your colony to access powerful technologies and go even further next time!",
      "url": "https://store.steampowered.com/app/2843640/",
      "label": "证据原文片段"
    }
  ],
