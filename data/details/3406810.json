  "hooks": [
    {
      "text": "键入的指令会在现实中执行并反噬玩家电脑",
      "dimension": "玩法",
      "excerpt": "Whatever you type becomes reality and is inflicted upon you. You might be asked to run programs you don't want to, or even hack your own system in an act of self-destruction. You might have to watch in horror as your computer breaks down before your very eyes.",
      "url": "https://store.steampowered.com/app/3406810/",
      "label": "证据原文片段"
    },
    {
      "text": "在不合理契约下借古老游戏猫逃离眼球主持人",
      "dimension": "故事",
      "excerpt": "A pair of creepy, mysterious eyeballs is your game master. You'll follow their instructions to progress through a typing game... but also be forced to sign a rather unreasonable contract. Whatever you type becomes reality and is inflicted upon you. You might be asked to run programs you don't want to, or even hack your own system in an act of self-destruction. You might have to watch in horror as your computer breaks down before your very eyes. There's not much you can really do to fight against this, especially in a typing game... But with the help of a cat awakened from an ancient game, perhaps you can escape.",
      "url": "https://store.steampowered.com/app/3406810/",
      "label": "证据原文片段"
    },
    {
      "text": "以无血腥跳吓的第四墙恐怖威胁现实边界",
      "dimension": "题材",
      "excerpt": "Game features: Gameplay and horror that breaks the fourth wall and threatens to affect reality. Horror without gore or jumpscares.",
      "url": "https://store.steampowered.com/app/3406810/",
      "label": "证据原文片段"
    }
  ],
