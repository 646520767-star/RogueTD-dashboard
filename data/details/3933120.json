  "hooks": [
    {
      "text": "数织谜题随深入从5×5扩张至20×20，深度同时提高风险与奖励",
      "dimension": "玩法",
      "excerpt": "Increasing difficulty The deeper you go into the dungeon, the more complex the puzzles become. Solve procedurally generated nonograms of various grid sizes from 5x5 to 20x20. Risk grows with depth, but so do the rewards.",
      "url": "https://store.steampowered.com/app/3933120/",
      "label": "证据原文片段"
    },
    {
      "text": "每层分叉路径最终汇向Boss，其专属能力会迫使玩家改变解数织的方法",
      "dimension": "玩法",
      "excerpt": "Face powerful bosses in procedurally generated dungeons Each floor offers multiple paths, all leading to a deadly boss. Every boss has a unique power that forces you to adapt your strategy and rethink how you approach nonograms.",
      "url": "https://store.steampowered.com/app/3933120/",
      "label": "证据原文片段"
    },
    {
      "text": "神器可自动填列、提高奖励或减慢时间，组合后形成局内协同",
      "dimension": "玩法",
      "excerpt": "Use the power of artifacts and items Collect powerful artifacts and items that change how you play. Automatically fill columns, increase rewards, slow down time, and more. Combine their effects to create devastating synergies during your run.",
      "url": "https://store.steampowered.com/app/3933120/",
      "label": "证据原文片段"
    }
