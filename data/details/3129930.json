  "hooks": [
    {
      "text": "接合同、处理遭遇、打捞回收、整备舰队，返航后还要结算账单与税费。",
      "dimension": "玩法",
      "excerpt": "Take a contract → choose how to handle encounters → salvage & recycle → refit your fleet → return, settle the bill, and head out again for bigger risks and bigger rewards.",
      "url": "https://store.steampowered.com/app/3129930/",
      "label": "证据原文片段"
    },
    {
      "text": "常规战斗可交给AI，也能手动集火和重定位；撤退本身是取胜条件的一部分。",
      "dimension": "玩法",
      "excerpt": "Let the AI handle routine combat, or take manual control to focus fire and reposition for an edge:",
      "url": "https://store.steampowered.com/app/3129930/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "AI生成背景缺乏作品灵魂。",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "A.I. Generated backgrounds, which is what you're going to be looking at most of the time. Just play FTL instead, this is a low-budget copy without any of the soul.",
          "url": "https://store.steampowered.com/curator/45016979-A.I.-Police/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "复古美术具有魅力。",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Charming retro aesthetics",
          "url": "https://vaporlens.app/app/3129930/nonentity_galaxy",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "舰船与配件拖拽操作费劲且存在Bug。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "舰船和配件的拖拽特别特别费劲，一个一个拖就算了拖拽还有bug巨难受真的",
          "url": "https://steamcommunity.com/profiles/76561198816403061/recommended/3129930/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "缺少战斗加速功能。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "什么时候增加战斗加速功能",
          "url": "https://steamcommunity.com/profiles/76561198375367866/recommended/3129930/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "配件装配缺少快捷方式。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "装配件也没有快捷方式也是一个一个拖",
          "url": "https://steamcommunity.com/profiles/76561198816403061/recommended/3129930/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "游戏重复度过高。",
