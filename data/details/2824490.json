  "hooks": [
    {
      "text": "每三天从三十余名首领池中生成新猎手，必须先研究其能力再针对性换装",
      "dimension": "玩法",
      "excerpt": "Every three days, a terrifying new minion of the Demon King begins his hunt, drawn from a pool of over 30 potential bosses. Study each monster’s strengths and unique powers, and adapt your build accordingly.",
      "url": "https://store.steampowered.com/app/2824490/",
      "label": "证据原文片段"
    },
    {
      "text": "有限背包迫使构筑在当前猎手与下一名强敌之间持续权衡，不能只优化眼前战斗",
      "dimension": "玩法",
      "excerpt": "There are a plethora of options for each threat, with a variety of powerful combinations to be discovered and exploited at your disposal among the countless items, and constant tradeoffs between the near and long-term threats – with limited space in your inventory, you must choose wisely and adapt constantly.",
      "url": "https://store.steampowered.com/app/2824490/",
      "label": "证据原文片段"
    },
    {
      "text": "Kingmaker让自己的英雄异步挑战他人构筑，也可与朋友实时备战并每三天决斗一次",
      "dimension": "玩法",
      "excerpt": "Seek out the fallen Demon King’s crown in asynchronous multiplayer mode \"Kingmaker\" – the ultimate test of your strategies where your champion faces off against the powerful builds of other players – or challenge your friend to duel in real-time, exploring the world to prepare builds and face each other every three days until a victor is crowned.",
      "url": "https://store.steampowered.com/app/2824490/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "结果过度依赖随机地图和随机奖励。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "too dependent on the random map layout + the random available rewards",
          "url": "https://steamcommunity.com/profiles/76561198059488747/recommended/2824490/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "能击败Boss的组合过少，流程像碰运气。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "hoping for one of the 3 or 4 combinations that can beat the boss",
          "url": "https://steamcommunity.com/id/thisisnttheurlyouarelookingfor/recommended/2824490/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "自动战斗移除了过多选择。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Autobattling feels like it removes too many choices",
          "url": "https://steamcommunity.com/profiles/76561198059488747/recommended/2824490/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "挑战模式缺少最低可玩性的随机保护。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "there's no weighted RNG or guardrails in place",
          "url": "https://steamcommunity.com/id/thisisnttheurlyouarelookingfor/recommended/2824490/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "运气操控手段不足。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "that sort of luck manipulation, but barely so.",
          "url": "https://steamcommunity.com/id/thisisnttheurlyouarelookingfor/recommended/2824490/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "地图知识会持续改善每一步决策。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "uncovering new map knowledge informs your decision making at every step.",
          "url": "https://steamcommunity.com/id/reddragon1988/recommended/2824490/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "核心循环具有强烈再来一局吸引力。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Just one more run...",
          "url": "https://steamcommunity.com/profiles/76561198418675113/recommended/2824490/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "图鉴中的隐藏目标方便解锁物品。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "hidden objectives laid out in the compendium. That makes unlocking all of the items way easier!!",
          "url": "https://steamcommunity.com/profiles/76561198216486839/recommended/2824490/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "循环容易学习但难以精通。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The gameplay loop is easy to learn, but difficult to master.",
          "url": "https://steamcommunity.com/profiles/76561198216486839/recommended/2824490/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "玩家对移动与拾取的直接控制感良好。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the more direct player agency regarding where you move and what you pick",
          "url": "https://steamcommunity.com/id/reddragon1988/recommended/2824490/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
