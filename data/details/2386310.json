  "hooks": [
    {
      "text": "El Huervo设计的迷幻科幻美术与神秘配乐",
      "dimension": "画风",
      "excerpt": "Grounded in science fiction, ULTROS comes wrapped in an eccentric art style and a mystical soundtrack from the visionary El Huervo, renowned for his work on Hotline Miami.",
      "url": "https://store.steampowered.com/app/2386310/",
      "label": "证据原文片段"
    },
    {
      "text": "激烈近战与植物培育并置，照料植物可打开隐藏路径",
      "dimension": "玩法",
      "excerpt": "Yet this intense combat is juxtaposed with cultivating the greenery and tending to plant life in The Sarcophagus, providing precious moments of contemplation and peace. In turn, this grants deeper access to obscured paths.",
      "url": "https://store.steampowered.com/app/2386310/",
      "label": "证据原文片段"
    },
    {
      "text": "在关键故事节点重启循环，解锁秘密、区域与分支技能",
      "dimension": "玩法",
      "excerpt": "A unique loop-based mechanic will allow you to start over at key moments in the story, providing opportunities to unfold such secrets, unlock different areas of the world and new abilities on a branching skill tree.",
      "url": "https://store.steampowered.com/app/2386310/",
      "label": "证据原文片段"
    }
  ],
