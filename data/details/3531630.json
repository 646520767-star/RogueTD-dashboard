  "hooks": [
    {
      "text": "键盘上的每个字母都承载不可预测的魔法，组合成单词后直接化为攻防手段。",
      "dimension": "玩法",
      "excerpt": "Your keyboard is your arsenal. Your words are your weapons. Tomb of the Bloodletter is a strategic word roguelike where each letter of your keyboard channels unpredictable Magicks.",
      "url": "https://store.steampowered.com/app/3531630/",
      "label": "证据原文片段"
    },
    {
      "text": "异端者、冒险者、学者和先知各有扭曲规则的特性与能力，改变战斗思路。",
      "dimension": "玩法",
      "excerpt": "Whether you play as the Heretic, Adventurer, Scholar, or Prophet, every character brings quirks and abilities that twist the rules of the game and change your approach to combat.",
      "url": "https://store.steampowered.com/app/3531630/",
      "label": "证据原文片段"
    },
    {
      "text": "每层开局先造词决定前进路线，在强化、治疗和重掷变化等房间之间取舍。",
      "dimension": "玩法",
      "excerpt": "At the start of each floor, you’ll craft a word to form your path. Choose between rooms that strengthen your arsenal, restore your health, or twist your Magick rerolls.",
      "url": "https://store.steampowered.com/app/3531630/",
      "label": "证据原文片段"
    }
  ],
