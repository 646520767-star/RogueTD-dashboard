  "hooks": [
    {
      "text": "每个班次先核对订单，再持手电深入黑暗仓库取货，逗留越久周围威胁越危险",
      "dimension": "玩法",
      "excerpt": "Start each shift by reviewing incoming orders, then venture into the warehouse to retrieve the items. Armed with a flashlight and basic tools, move quickly, avoid lingering, and complete your tasks while the shadows around you grow darker and more dangerous.",
      "url": "https://store.steampowered.com/app/2259310/",
      "label": "证据原文片段"
    },
    {
      "text": "每次死亡都会被投放到新的仓库，动态事件重新组合不可预测的生存挑战",
      "dimension": "玩法",
      "excerpt": "Each death places you in a new warehouse where dynamic events create unpredictable challenges.",
      "url": "https://store.steampowered.com/app/2259310/",
      "label": "证据原文片段"
    },
    {
      "text": "工资既用于升级工具和效率，也必须保障唯一陪伴者猫咪的安全与幸福",
      "dimension": "玩法",
      "excerpt": "Use your earnings to upgrade your tools, improve efficiency, and, most importantly, ensure your furry friend is happy and safe. Keep him alive at all costs, because he's all you've got in this eerie, lonely world.",
      "url": "https://store.steampowered.com/app/2259310/",
      "label": "证据原文片段"
    }
  ],
