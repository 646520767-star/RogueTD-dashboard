  "hooks": [
    {
      "text": "在机场桌面堆叠整理失物，根据旅客描述找出正确物品并归还",
      "dimension": "玩法",
      "excerpt": "In a top-down table, you are an officer who collects the lost items in an airport. Organize those items in the table. When people who lost their items request them, see if you have the item, then give it to them.",
      "url": "https://store.steampowered.com/app/3204250/",
      "label": "证据原文片段"
    },
    {
      "text": "可以选择诚实归还贵重物品，也能偷走并卖到黑市牟利",
      "dimension": "玩法",
      "excerpt": "You are expected to be an honest officer, but there is expensive, tempting items, which you are able to steal and sell in the black market.",
      "url": "https://store.steampowered.com/app/3204250/",
      "label": "证据原文片段"
    },
    {
      "text": "暂时找不到失物时记下电话号码，之后物品出现可主动打电话通知领取",
      "dimension": "玩法",
      "excerpt": "If you don’t, take their number and send them on their way If the item comes in another day, call them to come to pick it up and keep it safe for them",
      "url": "https://store.steampowered.com/app/3204250/",
      "label": "证据原文片段"
    }
  ],
