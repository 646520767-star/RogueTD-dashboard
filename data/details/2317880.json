  "hooks": [
    {
      "text": "每次跑局以生存500秒为明确终点，在固定时长内承受不断涌来的敌人。",
      "dimension": "玩法",
      "excerpt": "Fend off an onslaught of enemies, level up, and create unique builds every run while trying to survive 500 seconds!",
      "url": "https://store.steampowered.com/app/2317880/",
      "label": "证据原文片段"
    },
    {
      "text": "升级时可从七十五种以上能力中选择，并持续解锁角色、枪械和背部装备来扩展构筑。",
      "dimension": "玩法",
      "excerpt": "Rogue-like: As you play, you will unlock new characters, guns, and backgear! Level up and choose from over 75 powerups!",
      "url": "https://store.steampowered.com/app/2317880/",
      "label": "证据原文片段"
    },
    {
      "text": "每名兔子英雄都有独立超级技能与被动，从投掷磁铁到血液爆发法术形成不同战斗体验。",
      "dimension": "玩法",
      "excerpt": "Characters are unique with their own supers and passives. From magnet throwing bunnies to blood bursting spells, each character offers a different experience.",
      "url": "https://store.steampowered.com/app/2317880/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
