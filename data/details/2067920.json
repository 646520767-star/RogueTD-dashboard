  "hooks": [
    {
      "text": "同屏可出现数百名敌人，以高密度持续围攻构成核心生存压力。",
      "dimension": "玩法",
      "excerpt": "Fend against vast enemy forces, reaching hundreds of foes on screen at any given time",
      "url": "https://store.steampowered.com/app/2067920/",
      "label": "证据原文片段"
    },
    {
      "text": "三百多种被动升级与五十多种武器共同构成大规模跑局构筑池。",
      "dimension": "玩法",
      "excerpt": "Make your build from more than 300+ passive upgrades and 50+ weapons.",
      "url": "https://store.steampowered.com/app/2067920/",
      "label": "证据原文片段"
    },
    {
      "text": "路线选择允许主动挑战强敌或前往商店休整，让玩家决定Rog每段冒险的风险节奏。",
      "dimension": "玩法",
      "excerpt": "You can choose which path Rog takes. Feel brave enough to take on a powerful foe, or would you prefer to rest at the shop? The choice is yours!",
      "url": "https://store.steampowered.com/app/2067920/",
      "label": "证据原文片段"
    }
  ],
