  "hooks": [
    {
      "text": "营救受害者并转化邪恶生物",
      "dimension": "玩法",
      "excerpt": "You will have to explore each map to free the victims of the Inquisition and welcome them into your cult. They'll soon become fierce and lеwd werewolves, succubs, etc, thanks to your demonic powers. And if you're not afraid to wander into cemeteries, why not curse a few corpses and rise zombies and vampires?",
      "url": "https://store.steampowered.com/app/2683040/",
      "label": "证据原文片段"
    },
    {
      "text": "地狱石碑兼作塔、法术与墙体",
      "dimension": "玩法",
      "excerpt": "Summon hellish monoliths like towers and odd structures, to defend your base, cast spells on the battlegrounds or erect very 𝗌𝖾𝗑𝗒 walls.",
      "url": "https://store.steampowered.com/app/2683040/",
      "label": "证据原文片段"
    },
    {
      "text": "管理仪式群体为石碑魔法供能",
      "dimension": "玩法",
      "excerpt": "You will have to manage a growing 𝗈𝗋𝗀𝗒 to feed your monoliths with the power of love. It's the only way to use their magic, but who's gonna complain?",
      "url": "https://store.steampowered.com/app/2683040/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
