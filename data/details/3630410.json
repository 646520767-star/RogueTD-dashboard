  "hooks": [
    {
      "text": "八名魔法守护者组成近战护卫与远程弹幕阵线，八层攻击效果可叠加成爆发协同。",
      "dimension": "玩法",
      "excerpt": "Melee protectors shield you in close combat while ranged allies flood the battlefield with dazzling barrages. Witness eight layers of attack effects converging in explosive synergy, instantly setting the entire battlefield ablaze with magical fury!",
      "url": "https://store.steampowered.com/app/3630410/",
      "label": "证据原文片段"
    },
    {
      "text": "守护者强度取决于装备位置，同一守护者的双技能会随槽位切换，从精确狙击转向范围清场。",
      "dimension": "玩法",
      "excerpt": "Each Guardian's power is determined by their equipped position! Dual skills toggle based on gear placement! Seamlessly shift combat styles - execute precision sniping or unleash area-clearing devastation, mastering two tactical dimensions in battle!",
      "url": "https://store.steampowered.com/app/3630410/",
      "label": "证据原文片段"
    },
    {
      "text": "守护者体系包含 500 种以上进化路径、橙色神级单位与 150 种以上图鉴角色，并通过商店魔法蛋获取高阶单位。",
      "dimension": "玩法",
      "excerpt": "Craft your Mythic-tier Guardian Corps through 500+ evolution paths! Discover Orange-tier Divine Guardian Envoys! Every match brings fresh mystic eggs stocked in the shop! Invest gold to hatch them, with chances to unleash high-tier celestial guardians! Complete the Codex to unlock 150+ wondrous protectors brimming with arcane power!",
      "url": "https://store.steampowered.com/app/3630410/",
      "label": "证据原文片段"
    }
  ],
