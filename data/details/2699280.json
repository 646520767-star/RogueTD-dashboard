  "hooks": [
    {
      "text": "从十二种职业组建四人队，并用职业变体调整开局配置",
      "dimension": "玩法",
      "excerpt": "Build your party of four champions from 12 classic fantasy hero classes, each with distinct roles and playstyles. Unlock new class variants and loadout to customize your team before embarking on the adventure ahead.",
      "url": "https://store.steampowered.com/app/2699280/",
      "label": "证据原文片段"
    },
    {
      "text": "有限行动点配合敌方反应动作，考验出手时机",
      "dimension": "玩法",
      "excerpt": "With limited action points each turn, you must carefully deploy hero skills and items to create powerful synergies. Find the right moment to strike and unleash devastating blows on enemies while exploiting their reactive actions.",
      "url": "https://store.steampowered.com/app/2699280/",
      "label": "证据原文片段"
    },
    {
      "text": "混沌模式自定义规则，精通系统记录通关过的每种构筑",
      "dimension": "玩法",
      "excerpt": "Newly added to the game is the sandbox-esque Chaos Mode with customizable modifiers for the ultimate challenge and reward, and the new Mastery System recording each and every build option you have successfully beat a run with.",
      "url": "https://store.steampowered.com/app/2699280/",
      "label": "证据原文片段"
    }
