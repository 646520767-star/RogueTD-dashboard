  "hooks": [
    {
      "text": "时间是核心资源，玩家必须在延长剩余时间与提升杀伤力之间持续取舍。",
      "dimension": "玩法",
      "excerpt": "Time is your ultimate resource, but your hero’s lethality is just as vital. Every choice matters: forge your character and sharpen your strategy. You must strike a balance between gaining time and boosting your firepower.",
      "url": "https://store.steampowered.com/app/3596470/",
      "label": "证据原文片段"
    },
    {
      "text": "地下城探索获得的资源、武器和法术会转化为村庄防御能力，两种阶段协同推进破局。",
      "dimension": "玩法",
      "excerpt": "Master the synergy between dungeon crawling and village defense to finally break the loop and save your kin. Experience a unique hybrid of Dungeon Crawler and Action-RPG, featuring intense village defense phases",
      "url": "https://store.steampowered.com/app/3596470/",
      "label": "证据原文片段"
    },
    {
      "text": "神秘时钟迫使主角反复经历村庄毁灭，通过循环积累力量以违抗命运并拯救亲族。",
      "dimension": "故事",
      "excerpt": "A mystical clock now looms amidst the ruins, forcing you to relive the massacres from the past in a relentless loop. In these dreams, time is short and always runs out. Will you seize this cycle to defy fate and save your kin?",
      "url": "https://store.steampowered.com/app/3596470/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "局外成长显得缓慢且需要刷取。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Meta progression seems grindy/slow",
          "url": "https://steamcommunity.com/id/toastyraven/recommended/3596470/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "核心循环很有吸引力，让玩家想再开一局。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The core gameplay loop keeps you wanting to return for \"just one more run\"",
          "url": "https://steamcommunity.com/id/toastyraven/recommended/3596470/",
          "label": "证据原文片段"
        }
      ]
    }
