  "hooks": [
    {
      "text": "每次拉动老虎机都会重新决定敌人与物品落位",
      "dimension": "玩法",
      "excerpt": "Slot & Dungeons is a solo deck-building roguelike where enemy and item placements change based on slot mechanics.",
      "url": "https://store.steampowered.com/app/3160090/",
      "label": "证据原文片段"
    },
    {
      "text": "把沿途敌人与通关资源收编为老虎机符号",
      "dimension": "玩法",
      "excerpt": "Enemies along the way and resources needed to conquer the dungeon will be incorporated into the slot draw as \"symbols\". Symbols can be obtained by stepping on each floor or by various effects in the floor.",
      "url": "https://store.steampowered.com/app/3160090/",
      "label": "证据原文片段"
    },
    {
      "text": "战士与法师拥有不同能力及专属符号池",
      "dimension": "玩法",
      "excerpt": "Each character has unique abilities and symbols, such as the Warrior , who excels at melee attacks and high durability, and the Mage , who specializes in spell-based extermination.",
      "url": "https://store.steampowered.com/app/3160090/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
