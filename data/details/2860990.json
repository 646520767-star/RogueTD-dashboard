  "hooks": [
    {
      "text": "航行到未知岛屿寻找可升级前哨，同时谨慎管理货舱资源以增强舰船。",
      "dimension": "玩法",
      "excerpt": "Journey to uncharted islands to find upgradable outposts to bolster your naval might. The seas are treacherous, so manage your cargo carefully!",
      "url": "https://store.steampowered.com/app/2860990/",
      "label": "证据原文片段"
    },
    {
      "text": "十艘可解锁船只拥有不同能力和玩法，十四名船员还能晋升以定制构筑。",
      "dimension": "玩法",
      "excerpt": "10 unlockable seacrafts with different abilities and gameplay styles 14 crew members that can be promoted to customize your build",
      "url": "https://store.steampowered.com/app/2860990/",
      "label": "证据原文片段"
    },
    {
      "text": "单局约二十分钟，程序化海图搭配自动开火武器形成高速海战流程。",
      "dimension": "玩法",
      "excerpt": "Nautical Survival is a high-speed arena shooter featuring quick gameplay and high customization. The Early Access version will feature the following content on release: ~20 minute runs Procedural maps 10 unlockable seacrafts with different abilities and gameplay styles 14 crew members that can be promoted to customize your build 17 specialized auto-firing weapons",
      "url": "https://store.steampowered.com/app/2860990/",
      "label": "证据原文片段"
    }
