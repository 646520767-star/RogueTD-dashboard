  "hooks": [
    {
      "text": "生命槽会持续漏血，必须游进被击败敌人的血液中补满血瓶，把进攻路线直接变成续命路线",
      "dimension": "玩法",
      "excerpt": "BLOOD VIAL is a vampiric, retro-inspired FPS with a leaking health bar. Swim through the blood of your fallen enemies to keep your vial full.",
      "url": "https://store.steampowered.com/app/3648730/",
      "label": "证据原文片段"
    },
    {
      "text": "血液不仅回血，还能作为移动介质，用来爬墙、穿过栅格和跨越缺口",
      "dimension": "玩法",
      "excerpt": "Dive through spilled blood to climb walls, swim through grates, and leap over gaps.",
      "url": "https://store.steampowered.com/app/3648730/",
      "label": "证据原文片段"
    },
    {
      "text": "霰弹枪偏向混乱近战、左轮强调精确处决，还能解锁更多武器并在关卡间签订神圣契约获得力量",
      "dimension": "玩法",
      "excerpt": "Get messy with the shotgun, or execute with precision using the revolver. Unlock more weapons and experiment with your play style. Seal sacred pacts to gain power between each level.",
      "url": "https://store.steampowered.com/app/3648730/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "红色像素视觉风格鲜明难忘",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the visuals deliver a striking, memorable look",
          "url": "https://store.steampowered.com/curator/44992692-Fun-Fan-Fair/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "重复完成几次后体验变得乏味",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Once you have completed the game once or twice with each gun (and even then who cares), its a little dull.",
