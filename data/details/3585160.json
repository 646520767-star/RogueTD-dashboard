  "hooks": [
    {
      "text": "操控陀螺碰撞把对手撞出场，或在持久旋转中耗到最后，以不同胜法完成竞技",
      "dimension": "玩法",
      "excerpt": "Use your spinning top to knock your opponents out or simply out last them in a battle of attrition.",
      "url": "https://store.steampowered.com/app/3585160/",
      "label": "证据原文片段"
    },
    {
      "text": "特殊陀螺能重击、筑墙防守或飞向高空再俯冲，让传统碰撞对战加入主动技能",
      "dimension": "玩法",
      "excerpt": "But these aren't your regular old battling tops, these ones have abilities. Smash at them with full force, build a wall between to defend yourself, Fly high to the sky and strike and many more abilities to choose from!",
      "url": "https://store.steampowered.com/app/3585160/",
      "label": "证据原文片段"
    },
    {
      "text": "收集并合并不同陀螺组成理想组合，再为队伍搭配能够产生协同的遗物",
      "dimension": "玩法",
      "excerpt": "Collect new tops and Combine them together to create your perfect combination and pair them up with a suitable relic !",
      "url": "https://store.steampowered.com/app/3585160/",
      "label": "证据原文片段"
    }
  ],
