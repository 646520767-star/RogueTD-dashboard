  "hooks": [
    {
      "text": "牌组只容纳六颗骰子，但每颗都能改点数、贴两张效果贴纸，再由神器整体强化。",
      "dimension": "玩法",
      "excerpt": "Your deck fits only 6 dice—but combos aplenty. Buy randomly generated dice from the shop. Upgrade dice values through modifications, attach stickers (up to two!) for special effects, or get artifacts to enhance your entire dice deck.",
      "url": "https://store.steampowered.com/app/3636060/",
      "label": "证据原文片段"
    },
    {
      "text": "地牢里的小怪与Boss不一定只会被击败，还有机会成为冒险同伴。",
      "dimension": "玩法",
      "excerpt": "Fight mobs and bosses who (may) become friends to aid your adventure.",
      "url": "https://store.steampowered.com/app/3636060/",
      "label": "证据原文片段"
    },
    {
      "text": "兔女郎、奶昔史莱姆、忍者与魔法少女会以不同性格、行为甚至画风攻击或聊天。",
      "dimension": "题材",
      "excerpt": "Characters with different personality, behaviors, and even art styles will attack or chat with you.",
      "url": "https://store.steampowered.com/app/3636060/",
      "label": "证据原文片段"
    }
