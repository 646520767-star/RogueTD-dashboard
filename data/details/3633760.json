  "hooks": [
    {
      "text": "四键极简操作既可挑战闪电反应，也能切到有限步数的战术玩法",
      "dimension": "玩法",
      "excerpt": "Find your flow to test your lightning reflexes, or play it tactical with limited moves. With a minimalist 4-button setup, there are no excuses!",
      "url": "https://store.steampowered.com/app/3633760/",
      "label": "证据原文片段"
    },
    {
      "text": "主题不只是换皮，每个主题都自带专属强化并改变每局打法",
      "dimension": "玩法",
      "excerpt": "Themes aren’t just for looks. Each one has its own special power-up, giving you fun new ways to play and shake up every run.",
      "url": "https://store.steampowered.com/app/3633760/",
      "label": "证据原文片段"
    },
    {
      "text": "负面诅咒可能藏着强化收益，但选错会直接把进度打回第一轮",
      "dimension": "玩法",
      "excerpt": "Do not underestimate maluses as they can provide hidden power-ups along the way, but the wrong one could spell an early repeat to round one.",
      "url": "https://store.steampowered.com/app/3633760/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "视觉表现优秀且风格鲜明。",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "excellent visuals",
          "url": "https://vaporlens.app/app/3633760/kaz",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "激光与闪电效果非常有冲击力。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the lasers and lightning effects go absolutely hard",
          "url": "https://steamcommunity.com/id/TrexemLIVE/recommended/3633760/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "游戏特效表现极其出色。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "potentially the juiciest game effects ive ever seen in a video game",
          "url": "https://steamcommunity.com/id/MattGoode/recommended/3633760/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "成长过程需要更平滑。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Progression could be improved for smoother runs",
          "url": "https://steamcommunity.com/id/Cardgamer270/recommended/3633760?snr=1_5_9__402",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "节奏要求会快速造成手臂疲劳。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "this game will make your arm tired pretty quickly.",
          "url": "https://steamcommunity.com/profiles/76561198007765784/recommended/3633760/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "每轮缺乏变强感，只要求更快操作。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "I don't feel stronger with each round I just feel i need to click faster",
          "url": "https://steamcommunity.com/profiles/76561198007765784/recommended/3633760/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "后期更依赖是否拿到正确卡牌，而非技巧表达。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "later rounds start feeling more like \"did you get the right cards\" than actual skill expression",
          "url": "https://steamcommunity.com/id/TrexemLIVE/recommended/3633760/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "高强度操作容易导致手部疼痛。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "have to take a break cuze my hand hurts",
          "url": "https://steamcommunity.com/profiles/76561199512346285/recommended/3633760/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "游戏鼓励掌握机制而非无脑按键。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "It rewards mastering its mechanics instead of simply button mashing.",
          "url": "https://store.steampowered.com/curator/42708084-Potato-Coalition/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "每次攻击反馈令人满足。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Every hit feels satisfying",
          "url": "https://steamcommunity.com/id/TrexemLIVE/recommended/3633760/",
          "label": "证据原文片段"
        }
      ]
    }
