  "hooks": [
    {
      "text": "感染地块会持续蔓延，迫使堡垒不断向外扩张时同步重排攻防。",
      "dimension": "玩法",
      "excerpt": "Infected tiles grow gradually forcing constant adaptation.",
      "url": "https://store.steampowered.com/app/2143600/",
      "label": "证据原文片段"
    },
    {
      "text": "把炮塔、陷阱与机器人军团混进同一防线，而非只依赖固定塔楼。",
      "dimension": "玩法",
      "excerpt": "Mix towers, traps, and robot armies into the mix of your arsenal of tools to conquer.",
      "url": "https://store.steampowered.com/app/2143600/",
      "label": "证据原文片段"
    },
    {
      "text": "程序地图、分支塔楼、升级链、外星强化与改局消耗品彼此咬合，让每轮结构重组。",
      "dimension": "玩法",
      "excerpt": "Interlocking systems, procedural maps, branching towers, upgrade chains, alien upgrades, unique enemies and game changing consumables make no run the same.",
      "url": "https://store.steampowered.com/app/2143600/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "强化和遗物池混入大量低价值选项",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the upgrades and relics, which have some good ones, weren't packed with crap",
          "url": "https://steamcommunity.com/id/cagebot/recommended/2143600/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "数轮后容易发生崩溃",
