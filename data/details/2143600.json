      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Can't even play more then maybe 5-8 rounds before it just crashes.",
          "url": "https://steamcommunity.com/profiles/76561198020463426/recommended/2143600/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "游戏内容似乎只有一张地图",
