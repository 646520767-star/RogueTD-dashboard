  "hooks": [
    {
      "text": "沿巨树树干与枝杈向上建城，用滑索楼梯连接层级",
      "dimension": "玩法",
      "excerpt": "Build your city upwards, utilizing both trunk and bough. Limited horizontal space requires a strategy; construct zip lines and stairways to connect your growing settlement layers.",
      "url": "https://store.steampowered.com/app/3132870/",
      "label": "证据原文片段"
    },
    {
      "text": "迷雾让居民疯狂，必须靠光路、光能武器和Solium反推黑暗",
      "dimension": "玩法",
      "excerpt": "Fog drives your citizens to madness and conceals stalking terrors. Fight back by illuminating paths, crafting light-powered weapons , and mastering the raw energy of Solium.",
      "url": "https://store.steampowered.com/app/3132870/",
      "label": "证据原文片段"
    },
    {
      "text": "小决定也会滚成惨烈后果，20小时战役走向分支叙事",
      "dimension": "故事",
      "excerpt": "Shape your citizens' destiny through morally complex decisions . Witness various dramatic storylines. Navigate choices where even small actions can spiral into grim consequences. Campaign Mode: 20+ hours of single-player, story-driven gameplay with quests, branching narratives, and high-stakes choices.",
      "url": "https://store.steampowered.com/app/3132870/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "配音表现令人感觉怪异。",
      "dimension": "音频",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Voice acting is... weird to put it mildly",
          "url": "https://steamcommunity.com/profiles/76561198826638608/recommended/3132870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "长距离防护资源链与资源耗尽后频繁迁移的要求互相冲突。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The game asks you to build long protected resource chains across the map, but at the same time resources get depleted and you constantly have to move gathering areas.",
          "url": "https://steamcommunity.com/profiles/76561198265738906/recommended/3132870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "大地图镜头移动太慢，且缺少足够的缩放视野。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The overworld map camera is too slow and lack a decent zoom out view.",
          "url": "https://steamcommunity.com/profiles/76561198826638608/recommended/3132870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "中文文本缺字严重，直接影响剧情与对话阅读。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "中文版出现严重的缺字情况（角色对话、剧情等），超级影响阅读不知道想说什么",
          "url": "https://steamcommunity.com/profiles/76561198829744551/recommended/3132870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "大量敌人相关漏洞会破坏正常流程。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The game has a lot of bugs, especially when it comes to enemies.",
          "url": "https://steamcommunity.com/profiles/76561198826638608/recommended/3132870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "战役后半段的节奏与难度成长很差。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Terrible pacing and difficulty scaling after the halfway mark of the campaign.",
          "url": "https://steamcommunity.com/profiles/76561198826638608/recommended/3132870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "理解系统后能获得真正愉快的游玩时刻。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "I did have some genuinely enjoyable moments once I started to understand how everything works.",
          "url": "https://steamcommunity.com/profiles/76561198265738906/recommended/3132870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "总体玩法被评价为确实好玩。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the gameplay is genuinely enjoyable",
          "url": "https://steamcommunity.com/profiles/76561198124621223/recommended/3132870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "基础建造机制直观，易于理解。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Most base mechanics are nice and intuitive.",
          "url": "https://steamcommunity.com/profiles/76561198826638608/recommended/3132870/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "原料直接使用或等待精炼的取舍增加了基地管理决策。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The advanced resources are a nice touch for base management decisions, use the inefficient raw materials or wait to refine them first?",
          "url": "https://steamcommunity.com/profiles/76561198826638608/recommended/3132870/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
