  "hooks": [
    {
      "text": "海量敌潮配合荒诞武器持续扩张火力",
      "dimension": "玩法",
      "excerpt": "Thousands — or even hundreds of thousands of defeated enemies in a single match, taken down by all kinds of methods: from a good old shotgun to complete absurdity like dual miniguns and lasers shooting from your eyes.",
      "url": "https://store.steampowered.com/app/4279790/",
      "label": "证据原文片段"
    },
    {
      "text": "角色枪械与三类武器在局内同步成长",
      "dimension": "玩法",
      "excerpt": "Throughout the match, you upgrade not only your Shadow Cat Warrior and their ShadowGun, but also gain access to an entire arsenal of magical, melee, and firearms that will help you give the darkness a worthy fight.",
      "url": "https://store.steampowered.com/app/4279790/",
      "label": "证据原文片段"
    },
    {
      "text": "死亡后继续解锁物品并重组下局",
      "dimension": "玩法",
      "excerpt": "Die and be reborn — because every match will unlock more and more new items and artifacts, all accompanied by random generation, making every run truly unique.",
      "url": "https://store.steampowered.com/app/4279790/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "独立游戏画面表现出乎意料地好。",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the graphics are surprisingly good for an indie title.",
          "url": "https://store.steampowered.com/curator/38771580-Escape-to-Game/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "学习曲线有时较陡。",
