  "hooks": [
    {
      "text": "让利尼维亚勇士与黑暗军团暂时结盟，共同对抗新生巨敌",
      "dimension": "故事",
      "excerpt": "As a formidable evil arises, an unexpected alliance is taking shape! It will take the finest warriors of Linirea and the relentless Dark Army together to stop it. Beware! They may journey side by side for now, but the ever-changing winds of fate could swiftly alter their course.",
      "url": "https://store.steampowered.com/app/2849080/",
      "label": "证据原文片段"
    },
    {
      "text": "每关同时部署两名英雄并升级能力，让双英雄共同加固防线",
      "dimension": "玩法",
      "excerpt": "15 Epic Heroes; Play with 2 heroes in each stage, upgrade them to unleash their powerful abilities and bolster your defense. Who knew heroes could be such close roommates?",
      "url": "https://store.steampowered.com/app/2849080/",
      "label": "证据原文片段"
    },
    {
      "text": "用17座带专属技能的塔混搭弓手、圣骑士与恶魔坑战术",
      "dimension": "玩法",
      "excerpt": "32 upgradeable characters: 17 Towers with special skills. Create a wide range of strategies by building towers such as precise archers, lethal paladins, and even demon pits.",
      "url": "https://store.steampowered.com/app/2849080/",
      "label": "证据原文片段"
    }
  ],
