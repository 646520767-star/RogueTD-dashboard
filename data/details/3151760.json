  "hooks": [
    {
      "text": "用身体侧闪弹幕和等离子火力，并以冲刺、滑行、磨轨穿越峡谷与城市",
      "dimension": "玩法",
      "excerpt": "Feel the most kinetic combat available in a headset as you sprint, slide, and grind across scorched canyons and futuristic cities. Total Immersion: Physically weave through bullet hell, dodge incoming plasma fire with your own body, and return the favor with pinpoint precision.",
      "url": "https://store.steampowered.com/app/3151760/",
      "label": "证据原文片段"
    },
    {
      "text": "霰弹枪后坐、拉弓和近战均为实体交互，武器还需手动换弹",
      "dimension": "玩法",
      "excerpt": "Visceral Firepower: Feel the kick of high-powered shotguns, physically draw back a high-tension bow, or shred bots up close with razor-sharp melee weapons. Master Your Tools: Utilize interactive weapon handling and manual reloading to stay in the fight.",
      "url": "https://store.steampowered.com/app/3151760/",
      "label": "证据原文片段"
    },
    {
      "text": "动态生成敌军遭遇让关卡持续变化，机器人会适应并由巨型Boss收尾",
      "dimension": "玩法",
      "excerpt": "The Chaos Never Repeats Blast through levels that shift and evolve with dynamically generated enemy encounters. The bots adapt, and so must you. Discover hidden secrets, face down colossal bosses, and uncover the mysteries of a long-forgotten civilization.",
      "url": "https://store.steampowered.com/app/3151760/",
      "label": "证据原文片段"
    }
  ],
