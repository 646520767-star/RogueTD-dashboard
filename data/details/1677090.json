  "hooks": [
    {
      "text": "同一回合可召唤攻辅治疗单位、施放复活附魔毒术，并改造地块进行增益阻挡传送",
      "dimension": "玩法",
      "excerpt": "Will you summon auto-battling units that attack, buff, or heal? Will you cast spells to resurrect, enchant or poison targets? Will you terraform the map with tiles that boost, block or teleport units?",
      "url": "https://store.steampowered.com/app/1677090/",
      "label": "证据原文片段"
    },
    {
      "text": "战斗间选择路线和升级，必须为下一场拼出最优协同构筑",
      "dimension": "玩法",
      "excerpt": "Between battles, choose your path and upgrades wisely to find the optimal synergetic build for your next fight.",
      "url": "https://store.steampowered.com/app/1677090/",
      "label": "证据原文片段"
    },
    {
      "text": "每轮结束解锁永久升级，最终以摧毁十块大陆决定整个世界命运",
      "dimension": "玩法",
      "excerpt": "Unlock permanent upgrades after each run to destroy the ten continents and decide the fate of the world!",
      "url": "https://store.steampowered.com/app/1677090/",
      "label": "证据原文片段"
    }
  ],
