  "hooks": [
    {
      "text": "程序生成地图中的虫巢细胞会持续扩散进化，一旦触发就孵化成包围机甲的虫群",
      "dimension": "玩法",
      "excerpt": "At the start of every expedition, the map is procedurally generated , and it's crawling with alien bugs. The cells constantly spread and evolve. When triggered, the bugs burst out from the cells to swarm you down!",
      "url": "https://store.steampowered.com/app/1375900/",
      "label": "证据原文片段"
    },
    {
      "text": "每局最多装备五项自动主动技或被动技，分别升级后再组合出专属协同构筑",
      "dimension": "玩法",
      "excerpt": "Equip up to five skills each run: active ones that strike automatically or passive ones that boost your abilities. Upgrade each skill differently to maximize their potential. Discover unique synergies between skills and upgrades to optimize your build.",
      "url": "https://store.steampowered.com/app/1375900/",
      "label": "证据原文片段"
    },
    {
      "text": "利用废弃采矿系统收集升级零件，并从外星矿物中提取Bioshard",
      "dimension": "玩法",
      "excerpt": "Dive into the tamed sectors, use the mining system to collect upgrade parts and extract the Bioshards from alien minerals.",
      "url": "https://store.steampowered.com/app/1375900/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "击杀敌人不直接获得经验，成长反馈缺失。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "missing the joy of gaining exp from killing enemies.",
          "url": "https://youtu.be/OmJWgJpNQM8",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "不同角色强度差距较大。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "较大的角色差距",
          "url": "https://steamcommunity.com/profiles/76561199085055845/recommended/1375900/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "本地化存在明显机翻和错误表述。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "翻译中存在较重的机翻痕迹，有模糊甚至错误的表述",
          "url": "https://steamcommunity.com/profiles/76561199085055845/recommended/1375900/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "职业成长目标过度浪费时间。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "it's grindy in a way that is incredibly disrespectful of your time.",
          "url": "https://steamcommunity.com/id/valore/recommended/1375900/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "快节奏幸存者玩法加入的新机制带来惊喜。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "A more fast-paced survivor-like game that adds a few new mechanics in the mix which positively surprised me.",
          "url": "https://www.youtube.com/watch?v=7ouC_24Hc08",
          "label": "证据原文片段"
        }
