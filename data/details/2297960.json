  "hooks": [
    {
      "text": "动力手套既能扫描敌人与资源，也能推拉敌人并操纵遗迹环境。",
      "dimension": "玩法",
      "excerpt": "Scan for enemies and resources using your AVARITE POWERED GLOVES ! Have fun pushing and pulling enemies through lairs and ruins. Use this same ability to manipulate your environment!",
      "url": "https://store.steampowered.com/app/2297960/",
      "label": "证据原文片段"
    },
    {
      "text": "在巢穴与遗迹采集稀有资源，制作移动医疗站和钻机升级等科技。",
      "dimension": "玩法",
      "excerpt": "Collect rare resources throughout the lairs and ruins then use them to craft technology like mobile medical bays and upgrades for the drilling rig.",
      "url": "https://store.steampowered.com/app/2297960/",
      "label": "证据原文片段"
    },
    {
      "text": "每次向星球深处钻探都会生成新的环境、敌人与宝藏组合。",
      "dimension": "玩法",
      "excerpt": "With our PROCEDURALLY GENERATED LEVELS , each descent is a new challenge, presenting new environments, enemies, and treasures.",
      "url": "https://store.steampowered.com/app/2297960/",
      "label": "证据原文片段"
    }
  ],
