  "hooks": [
    {
      "text": "挂机可自动推进，但高手要靠英雄站位触发协同与特殊能力争取效率",
      "dimension": "玩法",
      "excerpt": "Although Idle Hero TD is an idle game that can mostly play itself (which is perfect for casual players without much time), it was also designed to be extremely strategic and rewarding for those who play actively and efficiently. The most powerful bonuses in the game revolve around optimizing the placements of your Heroes to activate their synergies and special abilities.",
      "url": "https://store.steampowered.com/app/2897580/",
      "label": "证据原文片段"
    },
    {
      "text": "48名英雄各有独立技能组，塔防成败取决于英雄组合与技能协同",
      "dimension": "玩法",
      "excerpt": "Unlock 48 unique heroes, all of which have different skill sets that make tower synergy crucial to success.",
      "url": "https://store.steampowered.com/app/2897580/",
      "label": "证据原文片段"
    },
    {
      "text": "PC与手机跨平台续玩，可在电脑开局后转到移动设备继续同一进度",
      "dimension": "玩法",
      "excerpt": "Idle Hero TD fully supports cross-play and cross-platform functionality. Start the game on your PC, then load it up on your mobile device to continue your progress while out of the house.",
      "url": "https://store.steampowered.com/app/2897580/",
      "label": "证据原文片段"
    }
  ],
