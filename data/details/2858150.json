  "hooks": [
    {
      "text": "从重装战列舰、灵活旋翼机到带护盾科研船，以舰型优劣决定整套战术",
      "dimension": "玩法",
      "excerpt": "Pick the slow but powerful Battleship, the nimble Copter, or the Science Vessel with its railgun and energy shield. Build a strategy around their strengths and weaknesses.",
      "url": "https://store.steampowered.com/app/2858150/",
      "label": "证据原文片段"
    },
    {
      "text": "航线节点同时改变敌人、奖励、升级与阵营关系，甚至可结交邪教获得援助",
      "dimension": "玩法",
      "excerpt": "Different destinations have pros and cons in terms of what enemies you fight, the rewards you get, the available upgrades, and your relationships with local factions. For example, you can befriend cultists, gaining their Worm Blessings and their aid in future battles.",
      "url": "https://store.steampowered.com/app/2858150/",
      "label": "证据原文片段"
    },
    {
      "text": "舰炮、模块、船员训练与战术学说分层叠加，组合出清场型空舰构筑",
      "dimension": "玩法",
      "excerpt": "Equip your ship with cannons, rockets, aerial torpedoes, mines, gatling guns, and more. Strengthen it with modules like ammo elevators, guard barracks, command posts. Host strange temples. Improve your ship with training for your crew, more armor plating, or senior officers. Pick a doctrine to gain its advantages: terrify your enemies, dodge incoming attacks, make your money through trade. Find powerful combinations that lay waste to your enemies.",
      "url": "https://store.steampowered.com/app/2858150/",
      "label": "证据原文片段"
    }
  ],
