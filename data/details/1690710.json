      "label": "证据原文片段"
    },
    {
      "text": "六英雄共享技能，还能捕捉培养百余怪物",
      "dimension": "玩法",
      "excerpt": "Share unique skills among your six heroes to create dynamic strategies. Capture over 100 monsters and enhance their abilities through leveling up to strengthen your team.",
      "url": "https://store.steampowered.com/app/1690710/",
      "label": "证据原文片段"
    },
    {
      "text": "Rebirth强化英雄，Ascension重置整个世界",
      "dimension": "玩法",
      "excerpt": "Rebirth your heroes to gain powerful progression boosts, starting fresh but stronger each time. Prestige the entire world through Ascension , unlocking even more content and stronger boosts.",
      "url": "https://store.steampowered.com/app/1690710/",
      "label": "证据原文片段"
    }
  ],
