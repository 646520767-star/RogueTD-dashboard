  "hooks": [
    {
      "text": "厨师、裁缝和雕塑匠把职业手艺直接转化为不同战斗机制",
      "dimension": "玩法",
      "excerpt": "Select your Crafter Choose from a variety of crafters and artisans with their own unique set of skills and mechanics, for different gameplay experiences. Between cooking your enemies, sewing them together or building statues that will crush your foes, there will always be a crafty way to defend your home!",
      "url": "https://store.steampowered.com/app/2137760/",
      "label": "证据原文片段"
    },
    {
      "text": "把敌人掉落材料投入村庄升级，解锁新角色、增益与更高战力",
      "dimension": "玩法",
      "excerpt": "Upgrade your Village and get more Powerful Gather materials from enemies and use them to upgrade your village, unlocking new characters, extra buffs and grow your power even further.",
      "url": "https://store.steampowered.com/app/2137760/",
      "label": "证据原文片段"
    },
    {
      "text": "每项技能可独立切换手动或自动施放，自由混合操作负担",
      "dimension": "玩法",
      "excerpt": "Craft Your Own Way to Play Toggle skills between manual and auto casting individually! Find the ones that work best in each mode, mixing and matching to fit your own playstyle! Everything on manual? All Skills on auto? Or a mix of both? It is up to you!",
      "url": "https://store.steampowered.com/app/2137760/",
      "label": "证据原文片段"
    }
  ],
