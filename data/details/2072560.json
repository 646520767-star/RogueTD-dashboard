  "hooks": [
    {
      "text": "四对四争夺战中角色会随单局成长，逐步解锁足以改变战局的攻击与能力",
      "dimension": "玩法",
      "excerpt": "Enter the world of Dragon Ball by bringing your favorite characters' earth-shaking strength to the battlefield, and join up with your friends and allies to defeat your opponents and dominate the objectives. Grow your strength throughout each round, unlock game-changing attacks and abilities, and obliterate enemy players and bosses alike.",
      "url": "https://store.steampowered.com/app/2072560/",
      "label": "证据原文片段"
    },
    {
      "text": "英雄明确分成输出、坦克与技术支援三种职责，围绕击杀、承伤和增益干扰协作",
      "dimension": "玩法",
      "excerpt": "Pick heroes with unique abilities and skills to fulfill strategic roles for your team: - DAMAGE: Simple but effective, super aggressive play style with a focus to take down the enemy - TANK: Persistent and hard to K.O., help your team hold the field and soak up the enemy's attacks - TECHNICAL: Versatile support, maximize your team's chances by boosting your allies and disrupting the enemy",
      "url": "https://store.steampowered.com/app/2072560/",
      "label": "证据原文片段"
    },
    {
      "text": "角色外观不仅能换皮肤，还能定制入场动画与专属终结技演出",
      "dimension": "画风",
      "excerpt": "Personalize your favorite heroes in your own style with character skins, entrance animations, and special finisher animations.",
      "url": "https://store.steampowered.com/app/2072560/",
      "label": "证据原文片段"
    }
  ],
