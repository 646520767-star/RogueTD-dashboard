  "hooks": [
    {
      "text": "战场就是画布、敌人就是颜料，打完一关留下的画作会成为玩家自己的收藏。",
      "dimension": "题材",
      "excerpt": "The battlefield is your canvas, the enemies are your paint. Literally. The art you make is yours to keep.",
      "url": "https://store.steampowered.com/app/1418390/",
      "label": "证据原文片段"
    },
    {
      "text": "厚画笔稳重缓慢，滚筒快速灵活，武器选择直接改变移动与攻击节奏。",
      "dimension": "玩法",
      "excerpt": "Choose from a variety of brushes and characters. From a slow and steady thick brush to a quick and nimble paint roller - we've got you covered.",
      "url": "https://store.steampowered.com/app/1418390/",
      "label": "证据原文片段"
    },
    {
      "text": "完成画作会获得桶伙伴、颜料炮塔、胡子恶作剧或机器人化等荒诞能力。",
      "dimension": "玩法",
      "excerpt": "Finishing a painting rewards you with versatile items. Enlist the help of a friendly painting bucket, install some paint turrets, give your enemies moustaches or become a robot.",
      "url": "https://store.steampowered.com/app/1418390/",
      "label": "证据原文片段"
    }
  ],
