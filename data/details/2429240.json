  "hooks": [
    {
      "text": "西部奇幻炼狱中对抗收割灵魂的黑帮",
      "dimension": "题材",
      "excerpt": "You are a gunslinger in limbo, involved in a gritty war against \"The Cartel\", a ruthless organization harvesting souls to break free of the shackles of the afterlife.",
      "url": "https://store.steampowered.com/app/2429240/",
      "label": "证据原文片段"
    },
    {
      "text": "每局锻造武器并在Haven解锁永久升级",
      "dimension": "玩法",
      "excerpt": "Forge your own destiny with every run by crafting powerful weapons and unlocking permanent upgrades in Haven.",
      "url": "https://store.steampowered.com/app/2429240/",
      "label": "证据原文片段"
    },
    {
      "text": "故事会根据肉鸽玩法中的行动变化",
      "dimension": "故事",
      "excerpt": "The story adapts to what you do in the roguelike gameplay",
      "url": "https://store.steampowered.com/app/2429240/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
