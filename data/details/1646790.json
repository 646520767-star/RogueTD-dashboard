  "hooks": [
    {
      "text": "每局生成可无限扩展的技能树，路线能重连、重掷、退款并随时停用节点",
      "dimension": "玩法",
      "excerpt": "Each run gives you a new unique skill tree to explore Combine melee, ranged and more, like pet skills, for nearly infinite builds Dynamic expanding skilltree depending on your skill pathway Additional meta progression skilltree Shape the infinite Skilltree Collect skillgems and shape your skilltree Reconnect skill pathways Reroll skills, or the entire skilltree and alter the outcome Refund skills and flexible skill deactivation system",
      "url": "https://store.steampowered.com/app/1646790/",
      "label": "证据原文片段"
    },
    {
      "text": "战斗中动态切换近战与远程武器，并分别管理两套攻击资源",
      "dimension": "玩法",
      "excerpt": "Active dual combat system with aim & attack (mouse, keys or controller) Dynamically switch between melee and ranged weapons during fights Powerful active abilities like shapeshifting and massive AoE attacks Dual resource system to manage melee and ranged attacks Dodge system to evade enemy attacks",
      "url": "https://store.steampowered.com/app/1646790/",
      "label": "证据原文片段"
    },
    {
      "text": "打造的回响武器会进入其他玩家战利品池，还能自定义外观与署名",
      "dimension": "玩法",
      "excerpt": "Craft echo weapons that get added to the lootpool for other players to find Empower your echoes, design the visual appearance of your weapons Embed your personal inscription to share your message with other players",
      "url": "https://store.steampowered.com/app/1646790/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "美术表现仍是明显短板。",
