  "hooks": [
    {
      "text": "冲刺、滑铲与蹬墙跑贯穿地下城、熔岩洞和血色遗迹，把高速移动同时用于跑酷与闪避",
      "dimension": "玩法",
      "excerpt": "Dash, slide, and wall-run through ancient underground cities, lava filled caves, blood soaked ruins, dark castles, and massive tombs. Slay demons to receive themed powerups to your different weapons and follow their upgrade paths to create devastating builds. Use a wide variety of movement abilities to platform and avoid attacks.",
      "url": "https://store.steampowered.com/app/2072660/",
      "label": "证据原文片段"
    },
    {
      "text": "击杀恶魔会为不同武器掉落主题强化，并沿各自升级路线塑造成毁灭性枪械构筑",
      "dimension": "玩法",
      "excerpt": "Slay demons to receive themed powerups to your different weapons and follow their upgrade paths to create devastating builds.",
      "url": "https://store.steampowered.com/app/2072660/",
      "label": "证据原文片段"
    },
    {
      "text": "每次死亡后以永久能力和武器升级重生，把必然失败转化为持续进化",
      "dimension": "玩法",
      "excerpt": "Grow stronger with every rebirth with permanent abilites and weapon upgrades as you face inevitable death.",
      "url": "https://store.steampowered.com/app/2072660/",
      "label": "证据原文片段"
    }
  ],
