  "hooks": [
    {
      "text": "贴身轰碎机器人大军，每摧毁一台敌机都会让角色继续变强。",
      "dimension": "玩法",
      "excerpt": "Gun down hordes of enemy machines with relentless and punishing close-range combat in which every bot destroyed makes you stronger.",
      "url": "https://store.steampowered.com/app/1421290/",
      "label": "证据原文片段"
    },
    {
      "text": "击败霸主后夺取核心，把敌人的力量改造成新的战斗风格与外观。",
      "dimension": "玩法",
      "excerpt": "Steal the Overlords’ Cores and harness their powers to craft and transform both your playstyle and appearance.",
      "url": "https://store.steampowered.com/app/1421290/",
      "label": "证据原文片段"
    },
    {
      "text": "把陷阱、强化装置和黑客手段部署进霸主高塔，主动改造每场攻塔战。",
      "dimension": "玩法",
      "excerpt": "Deploy your own traps, power-ups and hacks in each Overlord’s tower to turn the tides of battle in your favor.",
      "url": "https://store.steampowered.com/app/1421290/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "科幻肉鸽FPS呈现流畅且富有个性。",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "incredibly slick, personality-infused presentation",
          "url": "https://store.steampowered.com/curator/28625128-Skill-Up-Curates.../",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "枪械音效有吸引力且令人满足。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "shot effects for weapons sounding particularly engaging and satisfying",
          "url": "https://steamcommunity.com/profiles/76561198023006605/recommended/1421290/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "美术风格色彩鲜明且辨识度高。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "a very colorful and distinguishable art style",
          "url": "https://steamcommunity.com/id/rockoxx/recommended/1421290/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "视觉和美术风格非常出色。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The visuals are great, and the art style is fantastic all the way.",
          "url": "https://steamcommunity.com/profiles/76561198023006605/recommended/1421290/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "数值和人物成长解锁曲线存在较大问题。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "数值以及人物成长的解锁曲线，有着较大的问题",
          "url": "https://steamcommunity.com/profiles/76561198100103157/recommended/1421290/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "近战击飞方向与移动方向绑定，操作不直观。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "终结敌人的击飞方向居然和移动方向挂钩，而不是瞄准方向",
          "url": "https://steamcommunity.com/profiles/76561198100103157/recommended/1421290/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "部分解锁武器弱于初始武器。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "you grind for weapons that turn out worse than your starting ones",
          "url": "https://steamcommunity.com/profiles/76561198114221912/recommended/1421290/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "单局耗时九十分钟到两小时。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "A run's 90 minutes to two hours.",
          "url": "https://steamcommunity.com/profiles/76561198114221912/recommended/1421290/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "近战缺少辅助瞄准。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "近战没有一定的辅助瞄准",
          "url": "https://steamcommunity.com/profiles/76561198100103157/recommended/1421290/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "基础能力需要多局才能解锁。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "武器回收，冲刺CD这种比较基础的能力，需要花几局的时间来解锁",
          "url": "https://steamcommunity.com/profiles/76561198100103157/recommended/1421290/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
