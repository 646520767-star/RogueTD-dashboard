  "hooks": [
    {
      "text": "每局先选一名规则独特的船长，再围绕专属效果组队",
      "dimension": "玩法",
      "excerpt": "Begin each game by selecting a Captain with its own unique effect. Will you choose Dorothy to help complete her friends’ quests? Or Dragonmother to discover what hatches from her Mysterious Egg?",
      "url": "https://store.steampowered.com/app/3062740/",
      "label": "证据原文片段"
    },
    {
      "text": "先摆位、算回合，再看童话角色阵容自动对战",
      "dimension": "玩法",
      "excerpt": "Recruit characters and cast spells each round to prepare for your next challenge. Carefully position your cards while planning your turn—then enjoy their auto-battle against other captains and crews!",
      "url": "https://store.steampowered.com/app/3062740/",
      "label": "证据原文片段"
    },
    {
      "text": "无倒计时异步挑战真人历史阵容，也可开6人实时房",
      "dimension": "玩法",
      "excerpt": "No timers, no pressure. Galaxy's matchmaking and async-multiplayer mean you can battle fun-but-challenging opponents whenever you want. Face real boards from other human players’ earlier games. Your finished run will join the opponent pool for others to challenge.",
      "url": "https://store.steampowered.com/app/3062740/",
      "label": "证据原文片段"
    }
  ],
