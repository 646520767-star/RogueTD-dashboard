  "hooks": [
    {
      "text": "囚犯坠毁在最高垃圾山，只带廉价引擎复制品与手枪寻找失落能源来换取自由",
      "dimension": "故事",
      "excerpt": "You are a prisoner, forced into the tallest trash-mountain, tasked with finding the Engine. Your ship CRASHES! Leaving you armed with only a cheap replica of the Engine and a cheaper gun. Success will mean your freedom. If you survive...",
      "url": "https://store.steampowered.com/app/2084300/",
      "label": "证据原文片段"
    },
    {
      "text": "八项主属性、二百三十余遗物、六十余武器、全武器模组与二十六位神祇叠出构筑",
      "dimension": "玩法",
      "excerpt": "8 Main Stats to invest in as you level up, with too many secondary stats to count 230+ Relics to power you up with interesting and synergistic effects 60+ weapons ranging from practical to insane Special weapon Mods that apply to ALL carried weapons 26 Gods that must be appeased – earning their favor for unique boons",
      "url": "https://store.steampowered.com/app/2084300/",
      "label": "证据原文片段"
    },
    {
      "text": "切换频率匹配彩色弹幕即可穿过对应子弹，新房间还会暂停以避免无解受伤",
      "dimension": "玩法",
      "excerpt": "Inspired by Ikaruga , you can dodge colored bullets by matching their frequency New rooms start Paused to avoid unfair placements and unavoidable damage",
      "url": "https://store.steampowered.com/app/2084300/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "手绘视觉与独特气质让作品显得新鲜。",
      "dimension": "画风",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "entirely hand drawn graphics. one of the most unique and freshest entries",
          "url": "https://store.steampowered.com/curator/42578071-Effortlessly-Cool-Indie-Games/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "枪械偏好被迫集中于范围与穿墙能力。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "枪械偏好就完全偏向于aoe外加穿墙",
          "url": "https://steamcommunity.com/profiles/76561199115909339/recommended/2084300/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "当前武器平衡令人担忧。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "目前平衡性堪忧。",
          "url": "https://steamcommunity.com/profiles/76561199115909339/recommended/2084300/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "缺少角色与基地局外成长。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Lacks character and home development",
          "url": "https://steamcommunity.com/id/efefefwasq/recommended/2084300/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "系统过多且没有自然融合。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "all these mechanics come together nicely, but rather are added on top of one another.",
          "url": "https://steamcommunity.com/profiles/76561198028215265/recommended/2084300/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "某项核心机制可以被完全忽略",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "I never needed to worry about one of the main mechanics",
          "url": "https://steamcommunity.com/profiles/76561198028215265/recommended/2084300/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "3D打印机叠加物品可以轻易破坏平衡。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "print it max amount of times and insta-kill everything in the room.",
          "url": "https://steamcommunity.com/profiles/76561198028215265/recommended/2084300/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "机制密集但仍然容易接近。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "mechanically dense yet surprisingly accessible",
          "url": "https://store.steampowered.com/curator/42578071-Effortlessly-Cool-Indie-Games/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "高自定义角色构筑让游戏过程很有趣",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "High customisation of character building makes this bizarre game really enjoyable",
          "url": "https://www.youtube.com/watch?v=YhlDTYPg7Ks",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "总体完成度与可玩性优于多数同类。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "比市面上大部分此类rouge都好玩，完成度也不错",
          "url": "https://steamcommunity.com/profiles/76561199115909339/recommended/2084300/",
          "label": "证据原文片段"
        }
      ]
    }
