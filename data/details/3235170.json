  "hooks": [
    {
      "text": "每回合从四个行动中选一张；最右卡效果更强，使用后移到最左，卡序循环决定决策时机。",
      "dimension": "玩法",
      "excerpt": "A turn consists of executing one of the four available actions, each with its own unique functionality. The order of the cards plays a key role, with the rightmost card offering a stronger effect. After completing your turn, the chosen card moves to the leftmost position, pushing the others one step forward.",
      "url": "https://store.steampowered.com/app/3235170/",
      "label": "证据原文片段"
    },
    {
      "text": "用村庄经济支撑塔防：塔要吃食物维持，并消耗木材与石料升级，位置配置决定防线效率。",
      "dimension": "玩法",
      "excerpt": "Allocate your towers in strategic positions, sustain them with food, upgrade them with wood and stone, and ensure a strong defense against the slimes.",
      "url": "https://store.steampowered.com/app/3235170/",
      "label": "证据原文片段"
    },
    {
      "text": "王国被迷雾覆盖，通过探索行动揭开地图、获取资源、扩展攻击塔视野并发现宝藏。",
      "dimension": "玩法",
      "excerpt": "The mist has covered your entire kingdom! You start the game with an unexplored map, ready to be revealed! Use the exploration action to reach new resources, gain visibility for your attack towers, and discover hidden treasures!",
      "url": "https://store.steampowered.com/app/3235170/",
      "label": "证据原文片段"
    }
  ],
