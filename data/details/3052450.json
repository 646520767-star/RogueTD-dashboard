  "hooks": [
    {
      "text": "四个Realm各自改写玩法机制，配合一百八十五张以上卡牌支持强攻或精密连招构筑",
      "dimension": "玩法",
      "excerpt": "Four distinctive Realms —each with unique gameplay mechanics—form the backbone of your experience, supported by an ever-expanding library of 185+ cards and counting. Whether you prefer overwhelming force or razor-thin combos, the depth of options lets you build exactly the deck you want, and pull off victories that feel truly earned!",
      "url": "https://store.steampowered.com/app/3052450/",
      "label": "证据原文片段"
    },
    {
      "text": "美丽觉醒者与直观肉体恐怖并置，让每场遭遇在唯美和畸变之间切换",
      "dimension": "画风",
      "excerpt": "Beautiful where it wants to be, and deeply wrong where it doesn't— from strikingly beautiful Awakeners to visceral body horror, no two encounters look the same.",
      "url": "https://store.steampowered.com/app/3052450/",
      "label": "证据原文片段"
    },
    {
      "text": "分章节展开的悲怆故事与配乐会把玩家逐步带入疯狂、绝望和深渊真相",
      "dimension": "故事",
      "excerpt": "Haunting soundtracks and heart-rending stories draw you deeper, episode by episode, into madness, despair, and the abyss of truth, illuminating the full spectrum of human nature: from the depths of despair to the last flicker of hope.",
      "url": "https://store.steampowered.com/app/3052450/",
      "label": "证据原文片段"
    }
  ],
