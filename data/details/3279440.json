  "hooks": [
    {
      "text": "从炮艇俯视指挥地面小队绕开陷阱，再用重火力点杀高价值目标",
      "dimension": "玩法",
      "excerpt": "Guide your squads as they advance through hostile environments to achieve mission objectives. Command with precision, helping them avoid traps and eliminating high-priority threats with your overwhelming firepower.",
      "url": "https://store.steampowered.com/app/3279440/",
      "label": "证据原文片段"
    },
    {
      "text": "派小队进建筑搜资源与研究文件，停留越久越可能被围攻全灭",
      "dimension": "玩法",
      "excerpt": "Send your ground squads into buildings or key areas to collect vital resources and research documents—but this comes with risk. Stay too long, and you may lose your squad to overwhelming enemy forces. Decide when to extract and when to push your luck for valuable rewards.",
      "url": "https://store.steampowered.com/app/3279440/",
      "label": "证据原文片段"
    },
    {
      "text": "回到基地后同时升级炮艇、小队和武器，还要管理弹药生产与科技研究",
      "dimension": "玩法",
      "excerpt": "Between missions back at base, upgrade your gunship, squads, and weapons. Manage your ammo production and research new technologies to improve your chances in the field.",
      "url": "https://store.steampowered.com/app/3279440/",
      "label": "证据原文片段"
    }
