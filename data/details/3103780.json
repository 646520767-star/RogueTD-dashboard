    {
      "text": "吞下岩石、熔岩乃至房屋转化为神龙成长",
      "dimension": "玩法",
      "excerpt": "This food-loving dragon eats anything and transforms it into her own power. Meat, fish, rocks, iron... no, even lava, mountains, and other people's houses become fine delicacies in her eyes.",
      "url": "https://store.steampowered.com/app/3103780/",
      "label": "证据原文片段"
    },
    {
      "text": "用百余技能组合强攻、治疗防御与中毒流派",
      "dimension": "玩法",
      "excerpt": "Will you fight with powerful attacks? Use defense and healing skills? Or weaken them gradually with poison? Combine over 100 different skills to create synergies and build your own unique strategy.",
      "url": "https://store.steampowered.com/app/3103780/",
      "label": "证据原文片段"
    },
    {
      "text": "一年养成方式改变外貌、性格与多重结局",
      "dimension": "故事",
      "excerpt": "Depending on how you raise her, her appearance and personality will change over time. The people she interacts with and the way she spends her year will determine the various possible endings to the story.",
      "url": "https://store.steampowered.com/app/3103780/",
      "label": "证据原文片段"
    }
