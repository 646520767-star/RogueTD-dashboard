  "hooks": [
    {
      "text": "诸神黄昏令世界树几乎失去维系九界的能量，少数英雄必须在世界终结中求生。",
      "dimension": "故事",
      "excerpt": "During Ragnarok, Yggdrasil, the Tree of Life, lost almost all of its energy to sustain the Nine Realms. Only a few heroes will be able to survive the End of the World.",
      "url": "https://store.steampowered.com/app/2068280/",
      "label": "证据原文片段"
    },
    {
      "text": "角色星座能力树负责单人属性成长，世界树则承担跨局元进度，再由角色精通继续提升潜力。",
      "dimension": "玩法",
      "excerpt": "Skill tree in the form of character constellations, to improve the stats of each survivor. Yggdrasil as a meta-progress tree to boost different features that will make you feel more powerful in your adventure. Character Masteries to upgrade your characters to their maximum potential.",
      "url": "https://store.steampowered.com/app/2068280/",
      "label": "证据原文片段"
    },
    {
      "text": "九张地图分别取材于北欧九界，十余名角色各自拥有专属技能和武器。",
      "dimension": "玩法",
      "excerpt": "9 maps, inspired by each realm of Norse mythology. 10+ characters, with exclusive skills and weapons.",
      "url": "https://store.steampowered.com/app/2068280/",
      "label": "证据原文片段"
    }
  ],
