  "hooks": [
    {
      "text": "升级可解锁新英雄、宠物、技能甚至机甲，并通过营救生物扩建Forest Sanctuary取得永久强化",
      "dimension": "玩法",
      "excerpt": "Level up, unlock new heroes, pets, skills—even mechas—and rescue creatures to grow your Forest Sanctuary for permanent upgrades.",
      "url": "https://store.steampowered.com/app/3371770/",
      "label": "证据原文片段"
    },
    {
      "text": "不同Funguy各有独特能力，既能贴身冲进火海，也能保持距离进行战术输出",
      "dimension": "玩法",
      "excerpt": "Choose from a cast of silly funguys, each with their quirky charm and unique abilities. Whether you like getting up close and personal or prefer to keep things tactical from afar, there’s a funguy for every playstyle.",
      "url": "https://store.steampowered.com/app/3371770/",
      "label": "证据原文片段"
    },
    {
      "text": "局内升级可不断叠加夸张能力，把搞怪森林角色堆成自然力量驱动的清场怪物",
      "dimension": "玩法",
      "excerpt": "Grab upgrades mid-run and stack chaotic, over-the-top powers that turn your goofy forest friend into a full-blown nature-powered menace.",
      "url": "https://store.steampowered.com/app/3371770/",
      "label": "证据原文片段"
    }
  ],
