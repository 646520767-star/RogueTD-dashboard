  "hooks": [
    {
      "text": "把60多种随机魔法球两两融合，试出数百种超强或意外连锁",
      "dimension": "玩法",
      "excerpt": "The Ball Fusion system encourages explosive experimentation with over 60 randomized balls to equip and combine during your journey. Discover overpowered combinations and unexpected synergies from hundreds of possible outcomes.",
      "url": "https://store.steampowered.com/app/2062430/",
      "label": "证据原文片段"
    },
    {
      "text": "用70多座建筑重建新巴比伦，解锁强化与角色并自动生产资源",
      "dimension": "玩法",
      "excerpt": "Expand New Ballbylon with over 70 unique buildings that provide gameplay bonuses and unlock further power-ups, new characters, and more! As your community grows, task homebound heroes with automated tasks to keep the resources coming while you dive deeper into the pit.",
      "url": "https://store.steampowered.com/app/2062430/",
      "label": "证据原文片段"
    },
    {
      "text": "招募机制完全不同且可升级的寻宝英雄，持续改变弹球闯关打法",
      "dimension": "玩法",
      "excerpt": "As you explore the pit you’ll encounter fellow treasure hunters eager to add their skills to your expedition. Each character has unique, upgradable mechanics that totally change the way you play the game. Experimentation and adaptation are crucial to the success of New Ballbylon!",
      "url": "https://store.steampowered.com/app/2062430/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "满屏弹珠特效带来强烈视觉爽感。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "到后期满屏屏闪看着特别爽",
          "url": "https://steamcommunity.com/id/rongci77/recommended/2062430/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "视觉表现出色",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The gameplay, visuals, sound fx, and music are all great",
          "url": "https://steamcommunity.com/profiles/76561198871833476/recommended/2062430/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "游戏时间越长越卡，结算可卡数分钟。",
      "dimension": "技术/性能",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "结算卡几分钟才出来",
          "url": "https://steamcommunity.com/profiles/76561198180228181/recommended/2062430/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "中期频繁搬动建筑位置非常繁琐。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "需要不断更换建筑的位置让人物去撞击，非常繁琐",
          "url": "https://steamcommunity.com/id/rongci77/recommended/2062430/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "内容与构筑变化不足，重复感来得快。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "becomes repetitive extremely quickly",
          "url": "https://steamcommunity.com/id/nogaemz/recommended/2062430/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "后期可完全挂机，操作变成重复建造与摆位。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "游戏就可以通过融合两个角色的技能而完全挂机了",
          "url": "https://steamcommunity.com/id/rongci77/recommended/2062430/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "伤害计算存在明显错误。",
