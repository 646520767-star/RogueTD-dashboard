  "hooks": [
    {
      "text": "把卡牌首尾相连铺成吞噬路径，每条不可逆连接都要付代价",
      "dimension": "玩法",
      "excerpt": "Cards are not tools, But the fragments and extensions of your will; Paths are not choices, but corridors the world is compelled to surrender. At the cost of every irrevocable bond,",
      "url": "https://store.steampowered.com/app/2612690/",
      "label": "证据原文片段"
    },
    {
      "text": "数百张卡轮换组合，在资源、构筑、谜题和收集中平衡威胁",
      "dimension": "玩法",
      "excerpt": "With hundreds of cards at your disposal, craft shifting combinations and discover endless playstyles. Explore four distinct regions. Balance resource management, deck-building, puzzles, and card collection to overcome ever-evolving threats.",
      "url": "https://store.steampowered.com/app/2612690/",
      "label": "证据原文片段"
    },
    {
      "text": "干预人类命运并与7名关键角色结缘，开启隐藏故事与多结局",
      "dimension": "故事",
      "excerpt": "Encounter a diverse cast of humans. Choose to remain a silent observer or intervene in their lives. Build bonds with up to 7 key characters to unlock hidden stories and multiple endings.",
      "url": "https://store.steampowered.com/app/2612690/",
      "label": "证据原文片段"
    }
  ],
