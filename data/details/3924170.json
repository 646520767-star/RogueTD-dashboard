  "hooks": [
    {
      "text": "每轮严格运行二十分钟现实时间，世界末日倒计时直接限定整次探索窗口",
      "dimension": "玩法",
      "excerpt": "IMPORTANT : Each run lasts 20 real-time minutes, but exploring the world, uncovering its secrets, and realizing what was possible all along can keep you discovering for much longer.",
      "url": "https://store.steampowered.com/app/3924170/",
      "label": "证据原文片段"
    },
    {
      "text": "剧情散落在社区小事件、支线任务和谜团碎片中，需要靠自由探索拼合",
      "dimension": "故事",
      "excerpt": "Story through exploration – uncover small moments, side quests, and fragments of mystery woven into the neighborhood.",
      "url": "https://store.steampowered.com/app/3924170/",
      "label": "证据原文片段"
    },
    {
      "text": "没有存档也没有数值升级，唯一跨轮成长是记住世界规律与事件连接",
      "dimension": "玩法",
      "excerpt": "Built with replayability and speedrun in mind – no save system, no upgrades; your only progress is knowledge of how the world works and how everything connects.",
      "url": "https://store.steampowered.com/app/3924170/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "图形表现很有吸引力",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "ots the graphics thats did the nagic for me",
          "url": "https://steamcommunity.com/profiles/76561199050074960/recommended/3924170/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "收集全部风筝后没有奖励或反馈，令人失望。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "I gathered every single one and never got any reward or acknowledgment for it. That felt disappointing after putting in the extra effort.",
          "url": "https://steamcommunity.com/profiles/76561199193054808/recommended/3924170/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "操作手感很差，镜头平滑过强。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Controls are horrible (THE CAMERA SMOOTHING IS INSANE)",
          "url": "https://steamcommunity.com/id/TopKekHam/recommended/3924170/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "对话直接提示谜题解法，削弱发现乐趣。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "discovering them is no fun at all if the dialogues are literally telling you what to do or how to solve puzzles.",
          "url": "https://steamcommunity.com/id/FirenzeWarweik/recommended/3924170/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "二十分钟循环中的对话与发现鼓励再次探索。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "every conversation, discovery, and missed opportunity encourages you to see the neighborhood differently next time.",
          "url": "https://store.steampowered.com/curator/45601239-The-Ember-Archives/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "拼凑线索理解故事的过程受到喜爱。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "I personally loved piecing everything together.",
          "url": "https://steamcommunity.com/profiles/76561199193054808/recommended/3924170/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "主题表达被认为表面且直白灌输。",
      "dimension": "剧情",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The themes are superficial and plain, and also spoon-fed.",
          "url": "https://steamcommunity.com/id/FirenzeWarweik/recommended/3924170/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "忧郁、东欧式的怀旧氛围令人舒适且印象深刻。",
      "dimension": "主题",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The atmosphere is fantastic. It's melancholic, a bit depressing, and somehow captures that distinct Eastern European vibe that makes everything feel nostalgic and strangely comforting at the same time.",
          "url": "https://steamcommunity.com/profiles/76561199193054808/recommended/3924170/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
