  "hooks": [
    {
      "text": "最多八人乱斗中，每轮结束随机选择一种能力，持续拼出离谱甚至反噬自己的构筑。",
      "dimension": "玩法",
      "excerpt": "Invite and play with up to 7 friends in an all out brawl. Pick a random power after every round and craft the most ridiculous (or regrettable) build possible.",
      "url": "https://store.steampowered.com/app/2226280/",
      "label": "证据原文片段"
    },
    {
      "text": "战斗强调流畅移动与可躲避攻击，失误主要取决于玩家能否及时闪开。",
      "dimension": "玩法",
      "excerpt": "Tight, free-flowing combat that’ll have you screaming for your mom to get the camera. Everything is dodgeable so if you get clapped, that’s on you.",
      "url": "https://store.steampowered.com/app/2226280/",
      "label": "证据原文片段"
    },
    {
      "text": "既能用疯狂规则创建自定义对局，也能加入社区服务器；不设匹配和排位，主打自由混乱的派对体验。",
      "dimension": "玩法",
      "excerpt": "Set up custom games with wild rulesets, or jump into community-run servers and embrace the chaos. No matchmaking. No ranks. Just pure, dumb fun.",
      "url": "https://store.steampowered.com/app/2226280/",
      "label": "证据原文片段"
    }
  ],
