  "hooks": [
    {
      "text": "用卡牌操纵三消网格，连锁完成攻击、防御、资源获取与削弱",
      "dimension": "玩法",
      "excerpt": "Combining deckbuilding and chain-3 mechanics puts you in control of the battle! Collect and wield powerful cards to manipulate the grid and unleash devastating combos upon your foes while chaining tiles to attack, defend, gather resources or decrease your enemy’s power.",
      "url": "https://store.steampowered.com/app/1600910/",
      "label": "证据原文片段"
    },
    {
      "text": "收集超过200张卡牌构筑牌组",
      "dimension": "玩法",
      "excerpt": "Discover over 200 cards to create the ultimate deck!",
      "url": "https://store.steampowered.com/app/1600910/",
      "label": "证据原文片段"
    },
    {
      "text": "每局重组敌人、物品、随机卡牌与抉择事件，并逐步揭开世界秘密",
      "dimension": "玩法",
      "excerpt": "Unique enemy encounters, items, and randomly dropped cards are generated with each run. Discover chance events where you’ll make interesting choices, meet strange creatures, and uncover hidden secrets about the world, ensuring near-endless replayability.",
      "url": "https://store.steampowered.com/app/1600910/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "卡牌抽取与棋盘抽取的双重随机拖累战斗",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "you wait for [b]two[/b] RNGs to line up: both your card draw and the board draw",
          "url": "https://steamcommunity.com/profiles/76561198054725871/recommended/1600910/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "很难形成滚雪球式强力组合",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "There's very little in the way of snowballing OP combos",
          "url": "https://steamcommunity.com/profiles/76561198054725871/recommended/1600910/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "三消机制拖慢单局节奏",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The chain 3 mechanics are...interesting, but ultimately, they slow the run down",
          "url": "https://steamcommunity.com/id/cagebot/recommended/1600910/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "卡牌与三消之间联系不好",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "卡牌和三消之间的联系不好",
          "url": "https://steamcommunity.com/profiles/76561198125265489/recommended/1600910/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "三消机制吸引力不足",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "they're not all that captivating",
          "url": "https://steamcommunity.com/id/cagebot/recommended/1600910/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "强力连锁通常只带来单回合优势",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "killer chains, but they usually only amount to single-turn advantages in this game",
          "url": "https://steamcommunity.com/profiles/76561198054725871/recommended/1600910/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "三消与战斗的联动有新意",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "三消机制和战斗的联动还是比较有新意的",
          "url": "https://steamcommunity.com/id/lovcrimson/recommended/1600910/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "卡牌操纵三消棋盘的方式很有意思",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "many cards can manipulate the puzzle grid in interesting ways",
          "url": "https://steamcommunity.com/profiles/76561197992512352/recommended/1600910/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "理解机制后游玩非常有满足感",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "once you wrap your head around the mechanics, Demon's Mirror is super satisfying",
          "url": "https://steamcommunity.com/profiles/76561197972432520/recommended/1600910/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "高难度策略与计算挑战性强",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "高难度下对于策略和计算的要求甚至比很多经典DBG还要高，玩起来很有挑战性",
          "url": "https://steamcommunity.com/id/lovcrimson/recommended/1600910/",
          "label": "证据原文片段"
        }
      ]
    }
