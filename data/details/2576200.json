  "hooks": [
    {
      "text": "每张牌既发动效果又生成VIM资源，让坏手牌也能转化为指令爆发",
      "dimension": "玩法",
      "excerpt": "We designed a unique dual-resource system where each card is played for its effect while simultaneously generating Virtual Memory (VIM), which allows the player to take advantage of even the most suboptimal hands. Use your VIM to activate your Commands during battle and obliterate your enemies’ defenses!",
      "url": "https://store.steampowered.com/app/2576200/",
      "label": "证据原文片段"
    },
    {
      "text": "地图探索不断在战斗或撤退、即时兑现或延迟收益之间做风险决策",
      "dimension": "玩法",
      "excerpt": "Fight or flee? Visit this area now or later? Cash in a reward immediately, or hold on to it for an even bigger payoff? The choice is yours, as well as the punishment and the profit.",
      "url": "https://store.steampowered.com/app/2576200/",
      "label": "证据原文片段"
    },
    {
      "text": "用硬件模组与特长定制黑客Console，使其贴合个人牌组和操作风格",
      "dimension": "玩法",
      "excerpt": "As a hacker, your Console is an extension of your mind and body. Customize it to match your playstyle by unlocking hardware mods and perks. The more you hone your skills, the more options you’ll discover!",
      "url": "https://store.steampowered.com/app/2576200/",
      "label": "证据原文片段"
    }
  ],
