  "hooks": [
    {
      "text": "操作重点是走位穿梭，并把自身位置与武器射击图案和触发时机对齐来最大化伤害",
      "dimension": "玩法",
      "excerpt": "Intuitive movement-focused controls allow you to focus on dodging and weaving through your enemies while you fire your weapons at the swarm. Coordinate your positioning to align with your firing patterns and timing to maximize your damage.",
      "url": "https://store.steampowered.com/app/2000980/",
      "label": "证据原文片段"
    },
    {
      "text": "通过武器与升级协同构筑，在倒计时结束前击败世界首领",
      "dimension": "玩法",
      "excerpt": "Obtain new weapons and upgrades to create powerful builds and experiment with diverse synergies in order to defeat the world boss before time runs out.",
      "url": "https://store.steampowered.com/app/2000980/",
      "label": "证据原文片段"
    },
    {
      "text": "硬核与恶魔模式提高技巧门槛，无尽模式用于持久生存刷永久升级，极速模式压缩局长考验反应",
      "dimension": "玩法",
      "excerpt": "Complete levels and challenges to unlock the skill-testing challenge modes, Hardcore and Demon mode. Alter your experience with the Endless and Turbo modes. See how long you can survive and farm permanent upgrades in Endless mode. Shorten run times and test your reflexes with Turbo mode.",
      "url": "https://store.steampowered.com/app/2000980/",
      "label": "证据原文片段"
    }
  ],
