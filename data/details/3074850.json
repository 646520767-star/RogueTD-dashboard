  "hooks": [
    {
      "text": "二十余角色混编挑战五十余剧情任务",
      "dimension": "玩法",
      "excerpt": "Mix and match flashy combat techniques, gameplay-altering equippables, and evolvable abilities. Create an unstoppable team from the 20+ playable characters to blast through 50+ story missions and more in this action-packed adventure.",
      "url": "https://store.steampowered.com/app/3074850/",
      "label": "证据原文片段"
    },
    {
      "text": "新增全语音场景扩写角色与世界",
      "dimension": "故事",
      "excerpt": "The primary story mode follows the plot of Utawarerumono: Mask of Truth , including many new, fully-voiced scenes original to Utawarerumono: ZAN 2 that expand the breadth of the world and the depth of the characters!",
      "url": "https://store.steampowered.com/app/3074850/",
      "label": "证据原文片段"
    },
    {
      "text": "据点内互动推进剧情并强化角色功能",
      "dimension": "玩法",
      "excerpt": "Meanwhile, the new base system allows you to explore Oshtor's estate in Ennakamuy, where you can interact with your companions, progress the story, strengthen your characters, and more. You can even upgrade the base's functionality using points obtained in the course of gameplay!",
      "url": "https://store.steampowered.com/app/3074850/",
      "label": "证据原文片段"
    }
  ],
