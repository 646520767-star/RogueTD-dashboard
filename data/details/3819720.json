  "hooks": [
    {
      "text": "回合制地牢战要求谨慎规划接战方式，并把手头每项资源都投入到对抗强敌和生存选择中。",
      "dimension": "玩法",
      "excerpt": "Be thoughtful of your approach to the turn-based battles, powerful enemies lurk everywhere in the dungeon, so you must use every resource you can to survive. It's up to you how to defeat your enemies!",
      "url": "https://store.steampowered.com/app/3819720/",
      "label": "证据原文片段"
    },
    {
      "text": "死亡会丢失全部随身物品，但完成区域后可把战利品存入仓库带到后续跑局，森林居民也可能协助撤离。",
      "dimension": "玩法",
      "excerpt": "Death is costly, you will lose everything you're carrying and start all over. After completing an area, however, you will be able to stash anything you looted from the forest, and keep it for next runs. Some of the denizens of the forest may also help you extract your items.",
      "url": "https://store.steampowered.com/app/3819720/",
      "label": "证据原文片段"
    },
    {
      "text": "职业、能力与装备可任意混搭，从牛头人狂战士到施法精灵、潜行哥布林或携兽德鲁伊都能构成独立流派。",
      "dimension": "玩法",
      "excerpt": "Play as anything you want, from a minotaur berserker jumping straight into the fray, to a book wielding spellcasting elf ready to fling spells at their enemies, or a sneaky goblin hidding from their enemies and killing from the shadows, or a druid fighting with animal companions. Use any combination of classes, abilities and equipment, it's up to you.",
      "url": "https://store.steampowered.com/app/3819720/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "法术元素仅更换烟雾颜色，视觉区分不足",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "all elements feel the same; they all leave the same colored \"smoke\" effect",
          "url": "https://steamcommunity.com/id/noblezdomain/recommended/3819720/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "玩法循环仅是不断击杀更高数值怪物",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The gameplay loop is essentially: kill monsters, level up, kill monsters with bigger numbers.",
          "url": "https://steamcommunity.com/profiles/76561198026718272/recommended/3819720/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "两种模式都严重失衡",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Both modes are incredibly unbalanced.",
          "url": "https://steamcommunity.com/id/noblezdomain/recommended/3819720/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "缺少任务、Boss与最终目标",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "There is no quests, no bosses, no final objective",
          "url": "https://steamcommunity.com/profiles/76561198026718272/recommended/3819720/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "属性成长规则缺乏一致性",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Scaling makes no sense",
          "url": "https://steamcommunity.com/id/noblezdomain/recommended/3819720/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "孤狼模式下施法者体验糟糕",
