  "hooks": [
    {
      "text": "先选四行之一，再随机落到该行四格中的怪物、宝箱或致命陷阱",
      "dimension": "玩法",
      "excerpt": "On the combat grid, choose one of four rows to move into. You'll then land randomly on one of the four tiles in that row: will it be a monster that harms you? A chest full of gold? Or perhaps a deadly poison trap?",
      "url": "https://store.steampowered.com/app/2738490/",
      "label": "证据原文片段"
    },
    {
      "text": "石牙改写规则与概率，金属牙触发致命诅咒和连锁组合来操控运气",
      "dimension": "玩法",
      "excerpt": "Stone teeth that change the game’s rules and probabilities to tip the scales in your favor Metal teeth that trigger devastating curses and combos",
      "url": "https://store.steampowered.com/app/2738490/",
      "label": "证据原文片段"
    },
    {
      "text": "深入随机生成的地下世界，追寻已经失落无数年的太阳",
      "dimension": "题材",
      "excerpt": "In Sol Cesto, your goal is to descend through the levels of a randomly generated underground world, diving ever deeper in search of the sun, lost for countless years.",
      "url": "https://store.steampowered.com/app/2738490/",
      "label": "证据原文片段"
    }
  ],
