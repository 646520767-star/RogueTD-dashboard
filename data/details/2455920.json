  "hooks": [
    {
      "text": "与宝箱交谈并比对它们的陈述，找出说谎的拟态怪后只开启安全宝箱；误开拟态怪会立即结束游戏",
      "dimension": "玩法",
      "excerpt": "Listen to what the boxes have to say, find the lying Mimics, and open up the remaining boxes to collect treasure! If you accidentally open up a Mimic, it's game over!",
      "url": "https://store.steampowered.com/app/2455920/",
      "label": "证据原文片段"
    },
    {
      "text": "从安全宝箱取得装备和道具，再把解谜收益转化为击败敌人、征服地牢的战斗能力",
      "dimension": "玩法",
      "excerpt": "Use the gear and items you've collected from treasure boxes to beat enemies and conquer the dungeon.",
      "url": "https://store.steampowered.com/app/2455920/",
      "label": "证据原文片段"
    },
    {
      "text": "每轮逻辑题都由程序重新生成，可反复面对新的宝箱证词组合",
      "dimension": "玩法",
      "excerpt": "The puzzles are procedurally generated, so you can solve them to your heart's content!",
      "url": "https://store.steampowered.com/app/2455920/",
      "label": "证据原文片段"
    }
  ],
