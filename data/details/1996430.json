  "hooks": [
    {
      "text": "从100余只手绘奇美拉中组队，按坦克、速攻等能力定位适配战斗",
      "dimension": "玩法",
      "excerpt": "Build a team from over 100 unique, hand-drawn Chimera to suit your playstyle. Unlock all the talismans to uncover the mystical secrets behind the Chimeras’ existence. With a large variety of Chimeras to befriend and command, you'll need to strategize and adapt your playstyle to suit each battle. From tough tanks to speedy attackers, each Chimera brings a unique set of abilities to the table.",
      "url": "https://store.steampowered.com/app/1996430/",
      "label": "证据原文片段"
    },
    {
      "text": "自定义骰子并控制双方行动顺序，主动削弱随机掷骰影响",
      "dimension": "玩法",
      "excerpt": "Customize your dice for maximum influence over your Chimeras’ attacks and abilities. Control the order in which battles play out and choose when parties take action. Dicefolk defies RNG and gives you unprecedented influence on the roll of the dice!",
      "url": "https://store.steampowered.com/app/1996430/",
      "label": "证据原文片段"
    },
    {
      "text": "每轮遭遇的奇美拉与奖励不同，阵容策略随可招募成员重组",
      "dimension": "玩法",
      "excerpt": "Each playthrough offers its own rewards, and the Chimeras you encounter in one run can be entirely different than those you find in another. With different Chimeras comes different strategies to assemble your team for the perfect run!",
      "url": "https://store.steampowered.com/app/1996430/",
      "label": "证据原文片段"
    }
  ],
