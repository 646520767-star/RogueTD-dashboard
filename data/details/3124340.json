  "hooks": [
    {
      "text": "把圣武士、术士、游侠等经典D&D职业压缩成可随时开局的快速冒险",
      "dimension": "玩法",
      "excerpt": "From recognizable settings and classic D&D classes – like paladin, sorcerer, ranger, fighter, bard, and rogue – to fiery explosions and divine healing, Battlemarked delivers quick, pick-up-and-play action for players of every level.",
      "url": "https://store.steampowered.com/app/3124340/",
      "label": "证据原文片段"
    },
    {
      "text": "卡牌能力驱动回合战斗，每次抽牌都要重新组合技能并调整控场策略",
      "dimension": "玩法",
      "excerpt": "Use unique card abilities and adapt your approach in turn-based battles that reward strategic planning – combine abilities, control the battlefield, and adjust your tactics with every draw to overcome ever-changing challenges.",
      "url": "https://store.steampowered.com/app/3124340/",
      "label": "证据原文片段"
    },
    {
      "text": "最多四人协作布置陷阱和联动技能，单人时则独自指挥整支英雄小队",
      "dimension": "玩法",
      "excerpt": "Up to 4 players can tackle adventures together – coordinating moves, setting traps, and combining abilities for maximum impact. Teamwork isn’t optional – it’s your most powerful weapon. Prefer to go alone? You can also command your party of multiple heroes in single player mode.",
      "url": "https://store.steampowered.com/app/3124340/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "元素反应特效很好看。",
      "dimension": "画风",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "元素反应的特效也做的很好看。",
          "url": "https://steamcommunity.com/profiles/76561199011593363/recommended/3124340/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "整体难度仍然过低。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the game is still too easy overall.",
          "url": "https://steamcommunity.com/id/canapin/recommended/3124340/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "地牢遭遇重复度高。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "encounters are often very repetitive (especially in dungeons)",
          "url": "https://steamcommunity.com/profiles/76561198343268986/recommended/3124340/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "角色创建仅是预设角色换色。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Character \"creation\" is nothing more than recolor of the premade cookie cutter toons.",
          "url": "https://steamcommunity.com/profiles/76561198032175971/recommended/3124340/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "任务战斗间无法保存。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Inability to save.",
          "url": "https://steamcommunity.com/profiles/76561198032175971/recommended/3124340/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "卡牌战斗系统过于简单。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The card-based combat system is nice but far too simplistic",
          "url": "https://steamcommunity.com/profiles/76561198343268986/recommended/3124340/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "单人模式只有主角色获得经验。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "单人游戏队伍里只有第一个选择的角色能够获得经验",
          "url": "https://steamcommunity.com/profiles/76561199403100441/recommended/3124340/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "敌人会无限重生。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "Unending respawn of enemies.",
          "url": "https://steamcommunity.com/profiles/76561198032175971/recommended/3124340/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "随机骰子结果令人极度不满。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "The RNG they made is ABSOLUTE C.R.A.P.",
          "url": "https://steamcommunity.com/profiles/76561198032175971/recommended/3124340/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "支线技能检定几乎没有意义。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the importance of side events (like skill tests) is practically nonexistent.",
          "url": "https://steamcommunity.com/profiles/76561198343268986/recommended/3124340/",
          "label": "证据原文片段"
        }
      ]
    }
  ],
