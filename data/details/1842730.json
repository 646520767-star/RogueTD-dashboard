  "hooks": [
    {
      "text": "先识别怪物标志性动作，熟练后用精确招架反杀强敌",
      "dimension": "玩法",
      "excerpt": "Powerful monsters will get in your way. Identify their characteristic movements. If you're used to it, parry their attacks and defeat them.",
      "url": "https://store.steampowered.com/app/1842730/",
      "label": "证据原文片段"
    },
    {
      "text": "从多种武器中选三把轮换，切换顺序要围绕武器间协同设计",
      "dimension": "玩法",
      "excerpt": "You can use various weapons. Choose a weapon considering your taste and the synergy between each weapon. Swap between the weapons of your choice and fight effectively.",
      "url": "https://store.steampowered.com/app/1842730/",
      "label": "证据原文片段"
    },
    {
      "text": "死亡只是从梦境起点重来，但每次重启都会改变整场梦的结构",
      "dimension": "玩法",
      "excerpt": "Oh my, you died. But don't worry. It's a dream. The opportunities are endless. There are just minor issues that go back to the beginning and change the structure of the dream.",
      "url": "https://store.steampowered.com/app/1842730/",
      "label": "证据原文片段"
    }
