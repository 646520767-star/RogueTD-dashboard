  "hooks": [
    {
      "text": "每局是40分钟高压生存赛，把俯视角射击、基地建设与生存策略压进同一局内循环",
      "dimension": "玩法",
      "excerpt": "Enter the radiation scorched ruins where every match is a 40 minute race for survival. Wasteland Outpost blends the intensity of a top down shooter with the depth of base building and survival strategy .",
      "url": "https://store.steampowered.com/app/4278330/",
      "label": "证据原文片段"
    },
    {
      "text": "搜集资源后可搭建自动炮塔、陷阱、生产工坊和高墙，把临时营地逐步变成可升级堡垒",
      "dimension": "玩法",
      "excerpt": "Use gathered resources to build: Automated Turrets and deadly traps to catch enemies off guard. Production Workshops to upgrade your arsenal mid-match. Impregnable Walls to turn a simple camp into a fortress.",
      "url": "https://store.steampowered.com/app/4278330/",
      "label": "证据原文片段"
    },
    {
      "text": "夜晚突变体潮会加入玩家对抗，还能把Boss引向敌方基地或借辐射风暴突袭其城墙",
      "dimension": "玩法",
      "excerpt": "As night falls, the mutant hordes emerge. Use the environment to your advantage: lure a boss into the enemy’s base or strike their walls under the cover of a toxic radiation storm",
      "url": "https://store.steampowered.com/app/4278330/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "前哨建设、居民管理和防御威胁的组合很有吸引力。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Строительство аванпоста, управление поселенцами и защита от угроз создают увлекательную смесь стратегии и выживания.",
          "url": "https://store.steampowered.com/curator/32826090-Gaming-Grandma/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "用变异Boss诱敌进攻基地是很有满足感的策略。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Baiting an enemy's base with a mutant boss might be the most satisfying big-brain play I've pulled off in a shooter.",
          "url": "https://steamcommunity.com/profiles/76561199871308352/recommended/4278330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "PVPVE与真实基地建造的组合切实有效。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The concept PvPvE with real base building genuinely works",
          "url": "https://steamcommunity.com/profiles/76561199872763938/recommended/4278330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "对局混乱感让失败过程也有乐趣。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "even losing feels fun because of how chaotic the matches get",
          "url": "https://steamcommunity.com/profiles/76561199870947331/recommended/4278330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "基地建造系统有深度且决策有意义。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "The building system is deep and meaningful",
          "url": "https://steamcommunity.com/profiles/76561199871439716/recommended/4278330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "建造系统容易投入且不会让新玩家不知所措。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the building system pulls you in without overwhelming you",
          "url": "https://steamcommunity.com/profiles/76561199870947331/recommended/4278330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "昼夜搜集、建造和围攻循环让每场对局保持新鲜。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "the day/night Scavenge-Build-Siege cycle keeps every match feeling fresh",
          "url": "https://steamcommunity.com/profiles/76561199871439716/recommended/4278330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "随机事件让每场对局都有新变化，不易乏味。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "Random events mean every match throws something new at you airdrops, anomalies, traders so it never gets stale.",
          "url": "https://steamcommunity.com/profiles/76561199871577321/recommended/4278330/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "每场比赛都会形成自己的疯狂故事。",
      "dimension": "剧情",
      "source": "玩家观点",
      "polarity": "喜欢",
      "excerpts": [
        {
          "excerpt": "every match creates its own crazy story",
          "url": "https://steamcommunity.com/profiles/76561199872763938/recommended/4278330/",
          "label": "证据原文片段"
        }
      ]
    }
