  "hooks": [
    {
      "text": "瞄准后把英雄弹射并旋转穿过棋盘，连锁爆炸能清场，但一次误射也可能致命",
      "dimension": "玩法",
      "excerpt": "FLICK SHOT ROGUES is a super-satisfying roguelike dungeon crawler about lining up the perfect shot to send your hero spinning across the board. Trigger wickedly explosive combos and blast the battlefield apart, but don’t be hasty – a misfire could spell your doom!",
      "url": "https://store.steampowered.com/app/2427450/",
      "label": "证据原文片段"
    },
    {
      "text": "每次重新踏上岛屿都会洗牌敌人配置与奖励，使旅程的战斗条件持续变化",
      "dimension": "玩法",
      "excerpt": "Each new journey across the island will reshuffle the enemies and offer different rewards.",
      "url": "https://store.steampowered.com/app/2427450/",
      "label": "证据原文片段"
    },
    {
      "text": "诅咒带来额外风险，却能与物品和天赋组合出足以打破常规的强力互动",
      "dimension": "玩法",
      "excerpt": "Collect powerful items, talents, and curses, each with unique and game-changing effects. Brave the risks of the curse and supercharge your run with game breaking interactions.",
      "url": "https://store.steampowered.com/app/2427450/",
      "label": "证据原文片段"
    }
  ],
