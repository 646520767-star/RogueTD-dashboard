  "hooks": [
    {
      "text": "把连续冲刺、攻击、技能和强力招式串成强调动量的高速战斗流",
      "dimension": "玩法",
      "excerpt": "Your godlike speed is key to surviving the all-consuming Vortex threatening your world; stay aggressive and overwhelm the battlefield - before it overwhelms you. Chain dashes, strikes, abilities and devastating power moves together in hyper-fast combat built around flow.",
      "url": "https://store.steampowered.com/app/1911610/",
      "label": "证据原文片段"
    },
    {
      "text": "双持不同武器组合专属动作与Alterattack，再从170多项解锁物中配装",
      "dimension": "玩法",
      "excerpt": "Dual wield to combine unique weapon movesets, unleash powerful Alterattacks, and customize your build with over 170+ unlockables . The playstyle is yours to create: Mix fast melee weapons with heavy hitters (including the fan-favourite Crocojaw, known for its brutal bite!), ranged tools, status effects, mobility skills and more to become the unstoppable force on the battlefield.",
      "url": "https://store.steampowered.com/app/1911610/",
      "label": "证据原文片段"
    },
    {
      "text": "失败也能带回资源，在方舟解锁新武器与能力扩展后续构筑",
      "dimension": "玩法",
      "excerpt": "Every failed run lets you bring back valuable resources to unlock new weapons, powers and upgrades at the Ark, expanding future builds and playstyles. Learn enemy patterns, try a new loadout, and come back stronger every time. No drawback to experimenting, so go forward, Leaper!",
      "url": "https://store.steampowered.com/app/1911610/",
      "label": "证据原文片段"
    }
  ],
