  "hooks": [
    {
      "text": "每局从随机地块中铺出前进路线，并根据新升级和不断增强的敌潮调整战术。",
      "dimension": "玩法",
      "excerpt": "Dynamic Roguelike Gameplay: Every playthrough is a new adventure! Build your path out using randomly chosen tiles, discover powerful upgrades, and adapt your tactics to overcome increasingly challenging waves of foes.",
      "url": "https://store.steampowered.com/app/971220/",
      "label": "证据原文片段"
    },
    {
      "text": "孵化、升级和收集拥有独特能力的怪物守卫，再组成最终防守队伍。",
      "dimension": "玩法",
      "excerpt": "Monster Tower Defense: Hatch, Upgrade, Collect and command a variety of monster defenders, each with unique abilities, to fend off waves of relentless enemies. Assemble your ultimate party loadout and unleash havoc upon the invading forces.",
      "url": "https://store.steampowered.com/app/971220/",
      "label": "证据原文片段"
    },
    {
      "text": "玩家能力可在紧急时刻主动介入战局，使塔防过程持续需要即时操作。",
      "dimension": "玩法",
      "excerpt": "Active Gameplay: Engage in a dynamic and active playstyle where every moment counts. Unleash player abilities for clutch moments and enjoy more interactive and thrilling gameplay experiences than traditional tower defense.",
      "url": "https://store.steampowered.com/app/971220/",
      "label": "证据原文片段"
    }
  ],
