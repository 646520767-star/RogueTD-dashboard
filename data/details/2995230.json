  "hooks": [
    {
      "text": "每十年派出商贸外交车队穿越气候灾变，运输货物、经营部族关系并把旅途记忆留给继任者",
      "dimension": "故事",
      "excerpt": "Every decade, the tree city of Lecwasi sends a caravan of merchants and diplomats into the Phithi, the meteorological chaos ravaging the world of Uwando. Convoy goods to neighboring tribes, build relationships, survive the creatures that roam around the Phithi, and collect memories of your journey to send to your successors.",
      "url": "https://store.steampowered.com/app/2995230/",
      "label": "证据原文片段"
    },
    {
      "text": "遭遇可选择驯服敌对生物、营救难民、结盟互助，或走血路掠夺一切",
      "dimension": "玩法",
      "excerpt": "Tame hostile creatures, rescue refugees, seek allies for mutual aid, or follow the blood path and loot everything you can.",
      "url": "https://store.steampowered.com/app/2995230/",
      "label": "证据原文片段"
    },
    {
      "text": "寻找沃土建立新树城，并把知识传给下一支车队，最终修复破碎气候终止流浪",
      "dimension": "玩法",
      "excerpt": "Seek rich arable soil to plant a new tree city for your people. Progress by passing on your knowledge to a new caravan. Repair the broken climate, and put an end to centuries of wandering.",
      "url": "https://store.steampowered.com/app/2995230/",
      "label": "证据原文片段"
    }
  ],
