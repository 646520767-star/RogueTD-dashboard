  "hooks": [
    {
      "text": "不同角色以机械臂、暗精灵刀术、驼鹿冲锋或双持机枪改变战斗",
      "dimension": "玩法",
      "excerpt": "Punch gods in the face with your robot arm as the Cyberserker. Slice your way through mobs with the Dark Elf. Stampede your foes as a Viking Moose. Mine gold to upgrade your gear as the Dwarf, or dual wield miniguns twice your size as the manic Gnome.",
      "url": "https://store.steampowered.com/app/2154240/",
      "label": "证据原文片段"
    },
    {
      "text": "把追踪、酸液、治疗、弹射和冻结等效果拼进荒诞自制武器",
      "dimension": "玩法",
      "excerpt": "Want a minigun that shoots homing bullets covered in acid that heals you?... You got that! Want a crossbow that shoots 7 arrows at once, bounces around corners and freezes enemies?... You can do that!",
      "url": "https://store.steampowered.com/app/2154240/",
      "label": "证据原文片段"
    },
    {
      "text": "在末日维京未来反复挑战失控机械神，并一路击倒奥丁",
      "dimension": "题材",
      "excerpt": "Crazed AI robot Gods! RAGNAROK ROGUELITE Try, die and try again! Level up, amass firepower & hone your skills to fight your way through the post-apocalyptic Viking future and take down Odin!",
      "url": "https://store.steampowered.com/app/2154240/",
      "label": "证据原文片段"
    }
  ],
