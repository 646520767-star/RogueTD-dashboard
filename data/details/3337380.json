  "hooks": [
    {
      "text": "用长矛阵克制骑兵、保护弓手侧翼，并在数百单位会战中争夺地形",
      "dimension": "玩法",
      "excerpt": "Lead your troops in intense real-time battles where positioning, timing, and synergy determine victory. Form disciplined spear walls to counter cavalry, protect your archers from flanking maneuvers, and use the terrain to gain the upper hand. From small skirmishes to massive clashes with hundreds of units on screen, every encounter challenges your strategic instincts.",
      "url": "https://store.steampowered.com/app/3337380/",
      "label": "证据原文片段"
    },
    {
      "text": "维京精兵、兽人巨怪、精灵与矮人各自重写军队构筑方式",
      "dimension": "玩法",
      "excerpt": "Lead the elite infantry of the Vikings, the monstrous trolls and giants of the Orcs, agile and flashy Elves, stalwart Humans, resilient Dwarves, and so much more! Each faction comes with abilities that change how you craft your army and utilize them in battle.",
      "url": "https://store.steampowered.com/app/3337380/",
      "label": "证据原文片段"
    },
    {
      "text": "让桌面微缩战棋在实时战场上活起来",
      "dimension": "画风",
      "excerpt": "Battles unfold on a tabletop battlefield where every clash feels like a miniature wargame brought to life in real time.",
      "url": "https://store.steampowered.com/app/3337380/",
      "label": "证据原文片段"
    }
  ],
