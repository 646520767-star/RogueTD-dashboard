  "hooks": [
    {
      "text": "高速物理模拟强调自由操控，可挥剑、扫斧或投射火球完成对战动作",
      "dimension": "玩法",
      "excerpt": "The Joust is a highspeed, physics-rich simulation game with a specialty for freeform control. Swing swords, sweep axes, and sling fireballs as you follow your path to become Champion of The Joust!",
      "url": "https://store.steampowered.com/app/4744160/",
      "label": "证据原文片段"
    },
    {
      "text": "单人内容同时包含无限采集制作冒险、无尽肉鸽、双战役、五项体育模拟和4K电影工作室",
      "dimension": "玩法",
      "excerpt": "The Joust delivers a variety of singleplayer experiences including: 1. an infinite Adventure Mode with gathering and crafting! 2. a neverending, Roguelike gauntlet Heromaster mode, 3. two Campaign Modes available on launch: Medieval and Space Age 4. Baseball, Basketball, Golf, Boxing, and Pole Vault simulations 5. a cinematic studio mode capable of exporting 60 FPS video in 4K resolution",
      "url": "https://store.steampowered.com/app/4744160/",
      "label": "证据原文片段"
    },
    {
      "text": "可调整重力、移速、护甲和投射物尺寸，并创建自定义职业带入在线多人模式",
      "dimension": "玩法",
      "excerpt": "Control gravity, movement speed, armor strength, projectile sizes... and just about everything else you can think of, for real! Create a Class feature is also available for use in many game modes, including Online Multiplayer.",
      "url": "https://store.steampowered.com/app/4744160/",
      "label": "证据原文片段"
    }
  ],
