  "hooks": [
    {
      "text": "每轮通过观察敌人磨炼操作，主线推进后逐步加入新敌人与Boss机制",
      "dimension": "玩法",
      "excerpt": "Keeper’s Toll places a heavy focus on skill-based gameplay with ARPG elements. Each run allows you to study your enemies and hone your skills while progressing through the main quest. Once you have mastered the basics, Keeper’s Toll introduces unique enemy archetypes, intricate bosses, and fresh mechanics that will challenge any worthy hero.",
      "url": "https://store.steampowered.com/app/2002220/",
      "label": "证据原文片段"
    },
    {
      "text": "六名复生英雄各有决定玩法的专属机制、能力与成长树",
      "dimension": "玩法",
      "excerpt": "Keeper's Toll features 6 unique risen heroes: the Shadow Monk, Pyromancer, Blood Maiden, Necromancer, Ranger, and Bogatyr. Each hero has their own specialized game-defining mechanics, as well as completely unique abilities and progression trees.",
      "url": "https://store.steampowered.com/app/2002220/",
      "label": "证据原文片段"
    },
    {
      "text": "Boss、小Boss与入侵者各有机制变体，要求针对性规划角色强化",
      "dimension": "玩法",
      "excerpt": "Ferocious bosses and cutthroat invaders lie at the heart of Keeper’s Toll and its perilous lands. All of the bosses, mini bosses, and invaders you will encounter feature their own unique battle mechanics and twists on the core gameplay. Overcoming the bosses requires a keen sense of strategy, so strengthen your character with purpose or suffer a swift end to your journey.",
      "url": "https://store.steampowered.com/app/2002220/",
      "label": "证据原文片段"
    }
  ],
  "opinions": [
    {
      "text": "职业局内升级路线只有两到三条且相互重叠。",
      "dimension": "玩法",
      "source": "鉴赏家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "only really 2-3 upgrade paths in a run (which overlap a bit).",
          "url": "https://steamcommunity.com/profiles/76561197968658621/recommended/2002220",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "职业独特天赋树很浅。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "there is a unique tree but shallow",
          "url": "https://steamcommunity.com/profiles/76561197974326583/recommended/2002220/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "局外天赋树过于简单且提升很弱。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "天赋树做的过于简单，而且弱的不行",
          "url": "https://steamcommunity.com/profiles/76561198286119727/recommended/2002220/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "玩法缺少自身特色。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "这个幸存者没有啥自己的特点啊",
          "url": "https://steamcommunity.com/profiles/76561198096620866/recommended/2002220/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "可用角色平衡严重失调。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "the balance is completly off on playable characters",
          "url": "https://steamcommunity.com/profiles/76561198045886202/recommended/2002220/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "技能升级顺序随机，关键技能获取时机过于看运气。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "什么时间拿到能升几级就很看运气。",
          "url": "https://steamcommunity.com/profiles/76561198286119727/recommended/2002220/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "缺少改变构筑的肉鸽元素。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "为啥不缝合点能搭配和改变build的肉鸽元素进去啊",
          "url": "https://steamcommunity.com/profiles/76561198096620866/recommended/2002220/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "实际缺少ARPG与魂系元素。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "no arpg or souls-like elements at all.",
          "url": "https://steamcommunity.com/profiles/76561197974326583/recommended/2002220/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "Boss奖励正反馈过少。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "现在打完boss也基本没啥奖励，正反馈太少了。",
          "url": "https://steamcommunity.com/profiles/76561198096620866/recommended/2002220/",
          "label": "证据原文片段"
        }
      ]
    },
    {
      "text": "废技能会污染升级池。",
      "dimension": "玩法",
      "source": "玩家观点",
      "polarity": "需留意",
      "excerpts": [
        {
          "excerpt": "很多废物技能污染池子",
          "url": "https://steamcommunity.com/profiles/76561198286119727/recommended/2002220/",
          "label": "证据原文片段"
        }
      ]
    }
