  "hooks": [
    {
      "text": "连续七天用血下注掷骰，每天规则都会改变",
      "dimension": "玩法",
      "excerpt": "Gamble your life away — build a deck of dice and roll to survive seven days of high-stakes sessions. Sounds simple, but the rules change every day.",
      "url": "https://store.steampowered.com/app/3394770/",
      "label": "证据原文片段"
    },
    {
      "text": "允许作弊，以高风险高回报掷骰决定生死",
      "dimension": "玩法",
      "excerpt": "Cheating is allowed, she’s okay with that. Raise the stakes with high-risk, high-reward rolls that can mean the difference between life and death.",
      "url": "https://store.steampowered.com/app/3394770/",
      "label": "证据原文片段"
    },
    {
      "text": "用硬币购买止血包、重掷、食物与护符操控存活概率",
      "dimension": "玩法",
      "excerpt": "Earn coins after every successful session, and purchase items to tilt the odds in your favor — stop the bleeding with emergency health kits, store up re-rolls, eat food to replenish HP levels and equip defensive amulets to build up resolve.",
      "url": "https://store.steampowered.com/app/3394770/",
      "label": "证据原文片段"
    }
  ],
